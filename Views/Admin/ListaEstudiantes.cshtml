@model IEnumerable<ProyectoPAE.Models.Estudiante>

<div class="container mt-4">
    <!-- Encabezado con título y botón Volver alineado a la derecha -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold m-0" style="color: #2c3e50;">
            <i class="bi bi-file-earmark-person me-2"></i>Seleccionar Estudiante para Reporte
        </h2>

        <!-- Botón de regreso al Dashboard -->
        <a href="@Url.Action("Dashboard", "Home")" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Volver
        </a>
    </div>
    <hr class="mb-4" />

    <!-- Tabla de datos de estudiantes -->
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Nombre</th>
                <th>Apellido</th>
                <th>Correo</th>
                <th>Acción</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.nombre</td>
                    <td>@item.apellido</td>
                    <td>@item.email</td>
                    <td>
                        <a asp-action="DescargarReportePro" asp-route-id="@item.id_estudiante" class="btn btn-danger btn-sm">
                            <i class="bi bi-file-earmark-pdf me-1"></i>Generar PDF
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>