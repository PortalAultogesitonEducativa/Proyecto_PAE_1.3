@model IEnumerable<ProyectoPAE.Models.Notificacion>
@{
    ViewData["Title"] = "Gestión de Notificaciones y Comunicados";
}


<div class="container py-4">
    <!-- Encabezado con paleta Azul Marino y Naranja -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="fw-bold mb-1" style="color: #1b2a47;">
                <i class="bi bi-bell-fill me-2" style="color: #e67e22;"></i>Gestión de Notificaciones
            </h2>
            <p class="text-muted small mb-0">Publica avisos institucionales con filtros por rol de usuario.</p>
        </div>
        <a asp-controller="Home" asp-action="Dashboard" class="btn btn-outline-secondary rounded-pill px-4">
            <i class="bi bi-arrow-left me-1"></i> Volver al Dashboard
        </a>
    </div>


    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert" style="background-color: #d4edda; color: #155724;">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Exito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }


    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }


    <div class="row g-4">
        <!-- Formulario de publicación -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header text-white py-3 rounded-top-4" style="background: linear-gradient(135deg, #1b2a47 0%, #2c3e50 100%);">
                    <h5 class="card-title mb-0 fw-semibold">
                        <i class="bi bi-send-fill me-2" style="color: #e67e22;"></i> Publicar Nuevo Comunicado
                    </h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="CrearNotificacion" method="post">
                        <div class="mb-3">
                            <label class="form-label fw-medium text-secondary">Título del Comunicado</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-card-heading"></i></span>
                                <select id="txtTitulo" name="titulo" class="form-select border-start-0" required>
                                    <option value="" disabled selected>-- Selecciona un tipo de comunicado --</option>
                                    <option value="📢 Suspensión de Actividades Académicas">📢 Suspensión de Actividades Académicas</option>
                                    <option value="📅 Reunión de Padres de Familia y/o Acudientes">📅 Reunión de Padres de Familia y/o Acudientes</option>
                                    <option value="🎉 Celebración y Evento Institucional">🎉 Celebración y Evento Institucional</option>
                                    <option value="📝 Entrega de Boletines y Calificaciones">📝 Entrega de Boletines y Calificaciones</option>
                                    <option value="⚠️ Aviso de Seguridad y Convivencia">⚠️ Aviso de Seguridad y Convivencia</option>
                                    <option value="🏫 Cambio en el Horario Escolar">🏫 Cambio en el Horario Escolar</option>
                                    <option value="📌 Circular Informativa General">📌 Circular Informativa General</option>
                                    <option value="🩺 Jornada de Salud y Bienestar Estudiantil">🩺 Jornada de Salud y Bienestar Estudiantil</option>
                                    <option value="🎓 Acto de Graduación y Clausura">🎓 Acto de Graduación y Clausura</option>
                                    <option value="📚 Inicio / Fin del Período Académico">📚 Inicio / Fin del Período Académico</option>
                                    <option value="💻 Actividad de Formación Docente">💻 Actividad de Formación Docente</option>
                                    <option value="🏅 Reconocimiento y Premiación Estudiantil">🏅 Reconocimiento y Premiación Estudiantil</option>
                                    <option value="🌐 Semana Cultural y Deportiva">🌐 Semana Cultural y Deportiva</option>
                                    <option value="🔔 Recordatorio de Pago de Matrícula y Pensión">🔔 Recordatorio de Pago de Matrícula y Pensión</option>
                                    <option value="🚌 Comunicado sobre Transporte Escolar">🚌 Comunicado sobre Transporte Escolar</option>
                                    <option value="📣 Convocatoria y Proceso de Admisiones">📣 Convocatoria y Proceso de Admisiones</option>
                                    <option value="🏗️ Obras y Mantenimiento de Instalaciones">🏗️ Obras y Mantenimiento de Instalaciones</option>
                                    <option value="🌡️ Alerta Climática y Emergencia Escolar">🌡️ Alerta Climática y Emergencia Escolar</option>
                                </select>
                            </div>
                            <small class="form-text text-muted">Selecciona la categoría del comunicado institucional.</small>
                        </div>


                        <div class="mb-3">
                            <label class="form-label fw-medium text-secondary">Destinatarios (Filtro por Rol)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-people-fill"></i></span>
                                <select id="selRolDestino" name="rolDestino" class="form-select border-start-0" required>
                                    <option value="todos">🌐 Todos los Usuarios</option>
                                    <option value="estudiante">🎓 Únicamente Estudiantes</option>
                                    <option value="docente">👨‍🏫 Únicamente Docentes / Profesores</option>
                                    <option value="acudiente">👨‍👩‍👧 Únicamente Acudientes / Padres</option>
                                </select>
                            </div>
                            <small class="form-text text-muted">La notificación se mostrará en el perfil y dashboard del rol seleccionado.</small>
                        </div>


                        <div class="mb-3">
                            <label class="form-label fw-medium text-secondary">Prioridad</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-shield-exclamation"></i></span>
                                <select id="selPrioridad" name="prioridad" class="form-select border-start-0" required>
                                    <option value="leve">🟢 Leve (Avisos / El usuario puede marcarla como leída)</option>
                                    <option value="alta">🔴 Alta (Importante / No se puede dar a leída por usuarios)</option>
                                </select>
                            </div>
                            <small class="form-text text-muted">Prioridad Alta: los usuarios no le podrán dar a leído.</small>
                        </div>


                        <div class="mb-3">
                            <label class="form-label fw-medium text-secondary">Fecha de Expiración (Opcional)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-calendar-event"></i></span>
                                <input type="datetime-local" id="fechaExpiracion" name="fechaExpiracion" class="form-control border-start-0" />
                            </div>
                            <div id="feedbackFechaExp" class="text-danger small mt-1 fw-semibold" style="display:none;"></div>
                        </div>


                        <div class="mb-4">
                            <label class="form-label fw-medium text-secondary">
                                Mensaje / Contenido
                                <span class="badge bg-secondary ms-1" style="font-size:0.65rem;">Opcional</span>
                            </label>
                            <textarea id="txtMensaje" name="mensaje" class="form-control" rows="4" placeholder="(Opcional) Escribe aquí los detalles del anuncio..." maxlength="500" oninput="actualizarContadoresNotif()"></textarea>
                            <div class="d-flex justify-content-between text-muted small mt-1">
                                <span>Máximo 500 caracteres &bull; Campo opcional</span>
                                <span id="lblContadorMensaje">0 / 500</span>
                            </div>
                        </div>


                        <button type="submit" class="btn text-white w-100 py-2.5 rounded-3 fw-semibold shadow-sm btn-naranja">
                            <i class="bi bi-megaphone-fill me-2"></i> Publicar Comunicado
                        </button>
                    </form>
                </div>
            </div>
        </div>


        <!-- Historial de comunicados -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0 fw-semibold" style="color: #1b2a47;">
                        <i class="bi bi-journal-text me-2" style="color: #e67e22;"></i> Historial de Comunicados
                    </h5>
                    <span class="badge text-white px-3 py-2 rounded-pill" style="background-color: #1b2a47;">
                        Total: @Model.Count()
                    </span>
                </div>
                <div class="card-body p-3">
                    @if (!Model.Any())
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary opacity-50"></i>
                            <p class="mb-0">No se han emitido comunicados globales aún.</p>
                        </div>
                    }
                    else
                    {
                        <div class="vstack gap-3">
                            @foreach (var item in Model)
                            {
                                string badgeBg = item.RolDestino switch
                                {
                                    "estudiante" => "background-color: #6f42c1; color: white;",
                                    "docente" => "background-color: #2980b9; color: white;",
                                    "acudiente" => "background-color: #e67e22; color: white;",
                                    _ => "background-color: #1b2a47; color: white;"
                                };


                                string badgeLabel = item.RolDestino switch
                                {
                                    "estudiante" => "Estudiantes",
                                    "docente" => "Docentes",
                                    "acudiente" => "Acudientes",
                                    _ => "Todos"
                                };


                                string badgeIcon = item.RolDestino switch
                                {
                                    "estudiante" => "bi-mortarboard-fill",
                                    "docente" => "bi-person-badge-fill",
                                    "acudiente" => "bi-people-fill",
                                    _ => "bi-globe"
                                };


                                bool esPrioAlta = ((item.Prioridad ?? "").Trim().ToLower() == "alta");


                                <div class="card border border-light-subtle shadow-sm rounded-3" style="word-break: break-word; overflow-wrap: anywhere;">
                                    <div class="card-body p-3">
                                        <div class="d-flex justify-content-between align-items-start mb-2 gap-2">
                                            <div style="min-width: 0; flex: 1;">
                                                <span class="badge px-2.5 py-1 mb-2 shadow-sm" style="@badgeBg">
                                                    <i class="bi @badgeIcon me-1"></i> @badgeLabel
                                                </span>
                                                @if (esPrioAlta)
                                                {
                                                    <span class="badge bg-danger px-2.5 py-1 mb-2 ms-1 shadow-sm">
                                                        <i class="bi bi-exclamation-triangle-fill me-1"></i> Alta (No descartable)
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1 mb-2 ms-1">
                                                        <i class="bi bi-info-circle me-1"></i> Leve
                                                    </span>
                                                }
                                                <h6 class="fw-bold mb-1" style="color: #1b2a47; word-break: break-word; overflow-wrap: anywhere;">@item.Titulo</h6>
                                            </div>
                                            <form asp-action="EliminarNotificacion" method="post" onsubmit="return confirm('¿Seguro que deseas eliminar este comunicado?');">
                                                <input type="hidden" name="id" value="@item.ID_Notificacion" />
                                                <button type="submit" class="btn btn-outline-danger btn-sm rounded-circle p-1" title="Eliminar comunicado">
                                                    <i class="bi bi-trash-fill"></i>
                                                </button>
                                            </form>
                                        </div>
                                        <p class="card-text text-secondary mb-2 small" style="white-space: pre-line; word-break: break-word; overflow-wrap: anywhere;">@item.Mensaje</p>
                                        @if (item.FechaExpiracion.HasValue)
                                        {
                                            <div class="mb-2 small text-warning-emphasis">
                                                <i class="bi bi-hourglass-split text-warning me-1"></i> Expira: @item.FechaExpiracion.Value.ToString("dd/MM/yyyy hh:mm tt")
                                            </div>
                                        }
                                        <div class="d-flex justify-content-between align-items-center text-muted border-top pt-2 small">
                                            <span>
                                                <i class="bi bi-clock me-1" style="color: #e67e22;"></i> @item.FechaCreacion.ToString("dd/MM/yyyy hh:mm tt")
                                            </span>
                                            <span>
                                                <i class="bi bi-person-circle me-1"></i> Emisor: @(item.Emisor != null ? item.Emisor.NOMBRES + " " + item.Emisor.APELLIDOS : "Admin")
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>


<style>
    .btn-naranja {
        background-color: #e67e22 !important;
        border: none !important;
        transition: all 0.3s ease;
    }


    .btn-naranja:hover {
        background-color: #d35400 !important;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(230, 126, 34, 0.3) !important;
    }


    /* Bloqueo visual de fechas pasadas en el picker */
    #fechaExpiracion::-webkit-calendar-picker-indicator {
        cursor: pointer;
    }
    #fechaExpiracion:invalid {
        border-color: #dc3545;
        box-shadow: 0 0 0 0.2rem rgba(220,53,69,.15);
    }
</style>


<script>
    // ── Fecha mínima: bloquea visualmente fechas y horas pasadas ──────────────
    (function () {
        var campo = document.getElementById('fechaExpiracion');
        if (!campo) return;


        function getNowLocalISO() {
            // Genera el valor mínimo al minuto actual (sin segundos)
            var now = new Date();
            // Redondear al minuto actual (no permitir el minuto en curso hacia atrás)
            now.setSeconds(0, 0);
            // Formato requerido por datetime-local: YYYY-MM-DDTHH:MM
            var pad = function (n) { return n < 10 ? '0' + n : '' + n; };
            return now.getFullYear() + '-'
                + pad(now.getMonth() + 1) + '-'
                + pad(now.getDate()) + 'T'
                + pad(now.getHours()) + ':'
                + pad(now.getMinutes());
        }


        // Establecer min al cargar la página
        campo.min = getNowLocalISO();


        // Actualizar min cada minuto para que siga siendo preciso
        setInterval(function () {
            campo.min = getNowLocalISO();
            // Si el valor actual ya quedó en el pasado, lo limpiamos
            if (campo.value && campo.value < campo.min) {
                campo.value = campo.min;
            }
        }, 60000);


        // Validar al cambiar manualmente: si el usuario escribe una fecha pasada, corregir
        campo.addEventListener('change', function () {
            var minVal = getNowLocalISO();
            if (campo.value && campo.value < minVal) {
                campo.value = minVal;
                campo.classList.add('is-invalid');
                var feedback = document.getElementById('feedbackFechaExp');
                if (feedback) {
                    feedback.textContent = '⚠️ La fecha/hora seleccionada ya pasó. Se ajustó a la fecha y hora actual.';
                    feedback.style.display = 'block';
                }
                setTimeout(function () {
                    campo.classList.remove('is-invalid');
                    if (feedback) feedback.style.display = 'none';
                }, 3500);
            } else {
                campo.classList.remove('is-invalid');
                var feedback = document.getElementById('feedbackFechaExp');
                if (feedback) feedback.style.display = 'none';
            }
        });
    })();


    // ── Plantillas y Títulos Predeterminados ─────────────────────────────────
    var plantillasNotif = {
        suspension: {
            titulo: "Suspensión de Actividades Académicas",
            mensaje: "Se informa a toda la comunidad educativa que el día [Fecha] se suspenderán las actividades académicas presenciales por motivo de [Motivo]. Las clases se reanudarán con normalidad el día siguiente en su horario habitual.",
            rol: "todos",
            prioridad: "alta"
        },
        reunion_padres: {
            titulo: "Reunión General de Padres y Acudientes",
            mensaje: "Estimados padres y acudientes, se les convoca a la reunión general de seguimiento escolar el próximo [Fecha] a las [Hora] en las instalaciones de la institución. Su puntual asistencia es fundamental.",
            rol: "acudiente",
            prioridad: "alta"
        },
        entrega_boletines: {
            titulo: "Entrega de Informes y Boletines de Calificaciones",
            mensaje: "Se informa que la entrega oficial de boletines de calificaciones correspondiente al presente periodo se realizará el [Fecha]. Pueden verificar el reporte preliminar desde el portal institucional.",
            rol: "acudiente",
            prioridad: "leve"
        },
        jornada_pedagogica: {
            titulo: "Jornada Pedagógica de Docentes",
            mensaje: "Se convoca a todos los docentes a la jornada institucional de evaluación y planeación curricular el día [Fecha] a partir de las [Hora]. Recordamos llevar sus informes al día.",
            rol: "docente",
            prioridad: "leve"
        },
        renovacion_matricula: {
            titulo: "Recordatorio de Matrículas y Fechas Límite",
            mensaje: "Recordamos a la comunidad educativa que el plazo para la renovación de matrícula y formalización de documentos vence el [Fecha]. Por favor realizar el proceso a tiempo en secretaría o plataforma.",
            rol: "acudiente",
            prioridad: "leve"
        },
        mantenimiento_sistema: {
            titulo: "Mantenimiento Programado de la Plataforma PAE",
            mensaje: "El portal educativo PAE entrará en una ventana de mantenimiento preventivo y actualización técnica el [Fecha] entre [Hora Inicio] y [Hora Fin]. Durante este tiempo pueden presentarse intermitencias temporales.",
            rol: "todos",
            prioridad: "alta"
        },
        cambio_horario: {
            titulo: "Modificación Transitoria de Horario Escolar",
            mensaje: "Se informa que el día [Fecha] regirá un horario especial de actividades: el ingreso será a las [Hora Inicio] y la salida a las [Hora Fin] debido a programación institucional.",
            rol: "todos",
            prioridad: "leve"
        },
        circular_rectoria: {
            titulo: "Circular Informativa de Rectoría",
            mensaje: "Rectoría hace pública la circular del mes con disposiciones institucionales y académicas vigentes. Agradecemos su atenta lectura y estricto cumplimiento.",
            rol: "todos",
            prioridad: "alta"
        },
        evento_cultural: {
            titulo: "Convocatoria a Evento Deportivo / Cultural",
            mensaje: "Invitamos cordialmente a nuestros estudiantes y familias a participar en la jornada cultural y deportiva institucional a celebrarse el [Fecha]. ¡Ven y comparte con orgullo tus talentos!",
            rol: "estudiante",
            prioridad: "leve"
        },
        reconocimiento: {
            titulo: "Felicitaciones por Excelencia Académica",
            mensaje: "La institución felicita y exalta con orgullo a los estudiantes que obtuvieron un desempeño sobresaliente en el periodo académico. ¡Felicitaciones por su esfuerzo y dedicación!",
            rol: "todos",
            prioridad: "leve"
        },
        aviso_urgente: {
            titulo: "Aviso Importante / Alerta de Convivencia",
            mensaje: "Atención comunidad educativa: Por favor atender de manera prioritaria las directrices preventivas y de seguridad institucional comunicadas a continuación.",
            rol: "todos",
            prioridad: "alta"
        }
    };

    function aplicarPlantillaNotif(clave) {
        if (!clave || !plantillasNotif[clave]) return;
        var p = plantillasNotif[clave];

        var txtTitulo = document.getElementById('txtTitulo');
        var txtMensaje = document.getElementById('txtMensaje');
        var selRol = document.getElementById('selRolDestino');
        var selPrio = document.getElementById('selPrioridad');

        if (txtTitulo) txtTitulo.value = p.titulo;
        if (txtMensaje) txtMensaje.value = p.mensaje;
        if (selRol && p.rol) selRol.value = p.rol;
        if (selPrio && p.prioridad) selPrio.value = p.prioridad;

        actualizarContadoresNotif();
    }

    function limpiarFormularioNotif() {
        var form = document.getElementById('formNotificacion');
        if (form) form.reset();
        var selRapida = document.getElementById('selPlantillaRapida');
        if (selRapida) selRapida.value = "";
        actualizarContadoresNotif();
    }

    // ── Contadores de caracteres ───────────────────────────────────────────────
    function actualizarContadoresNotif() {
        var tit = document.getElementById('txtTitulo');
        var cntTit = document.getElementById('lblContadorTitulo');
        if (tit && cntTit) {
            cntTit.textContent = tit.value.length + ' / 100';
            if (tit.value.length >= 95) {
                cntTit.classList.add('text-danger', 'fw-bold');
            } else {
                cntTit.classList.remove('text-danger', 'fw-bold');
            }
        }

        var msg = document.getElementById('txtMensaje');
        var cntMsg = document.getElementById('lblContadorMensaje');
        if (msg && cntMsg) {
            cntMsg.textContent = msg.value.length + ' / 500';
            if (msg.value.length >= 480) {
                cntMsg.classList.add('text-danger', 'fw-bold');
            } else {
                cntMsg.classList.remove('text-danger', 'fw-bold');
            }
        }
    }

    document.addEventListener('DOMContentLoaded', function () {
        actualizarContadoresNotif();
    });
</script>
11