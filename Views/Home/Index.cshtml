@{
    ViewData["Title"] = "Portal de Autogestión Educativa";
}

<div class="container-fluid py-5" style="background: var(--pae-gradient-hero); border-radius: 0 0 50px 50px;">
    <div class="container py-5">
        <div class="row align-items-center">
            <div class="col-lg-6 text-white">
                <h1 class="display-3 fw-bold mb-4">Optimiza la Gestión de tu Institución</h1>
                <p class="lead mb-5 opacity-75">Centralice información académica, administrativa y docente en una sola plataforma segura e intuitiva. Diseñado para el sector educativo privado.</p>
                <div class="d-flex gap-3">
                    <a asp-action="Cursos" class="btn btn-lg btn-pae-edit px-4 text-white">
                        <i class="bi bi-grid-fill me-1"></i> Ver Módulos
                    </a>
                    <a asp-action="Contacto" class="btn btn-lg btn-outline-light px-4">
                        <i class="bi bi-chat-square-text me-1"></i> Solicitar Demo
                    </a>
                </div>
            </div>
            <div class="col-lg-6 text-center mt-5 mt-lg-0">
                <img src="~/images/logo2.png" alt="PAE System" class="img-fluid" style="max-height: 400px; filter: drop-shadow(0 0 20px rgba(255,255,255,0.2));">
            </div>
        </div>
    </div>
</div>

<section class="hero-bg">
    <div class="container-fluid my-5 py-5" style="background-color: var(--pae-bg-card);">
        <div class="text-center mb-5">
            <h2 class="fw-bold" style="color: var(--pae-primary);">¿Por qué elegir PAE?</h2>
            <p class="text-muted">La solución integral para la educación básica y media.</p>
        </div>

        <div class="row g-4 container mx-auto">
            <div class="col-md-4">
                <div class="p-4 text-center">
                    <div class="rounded-circle d-inline-flex p-3 mb-3" style="background-color: var(--pae-primary-subtle);">
                        <i class="bi bi-cloud-check fs-1" style="color: var(--pae-primary);"></i>
                    </div>
                    <h5 class="fw-bold" style="color: var(--pae-primary);">Información Centralizada</h5>
                    <p class="small text-muted">Acceda a datos de estudiantes, docentes y calificaciones desde cualquier lugar y dispositivo.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-4 text-center">
                    <div class="rounded-circle d-inline-flex p-3 mb-3" style="background-color: rgba(25, 135, 84, 0.1);">
                        <i class="bi bi-shield-lock fs-1 text-success"></i>
                    </div>
                    <h5 class="fw-bold" style="color: var(--pae-primary);">Seguridad y Privacidad</h5>
                    <p class="small text-muted">Protegemos la información sensible de la comunidad educativa con los más altos estándares.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-4 text-center">
                    <div class="rounded-circle d-inline-flex p-3 mb-3" style="background-color: var(--pae-secondary-light);">
                        <i class="bi bi-chat-dots fs-1" style="color: var(--pae-secondary);"></i>
                    </div>
                    <h5 class="fw-bold" style="color: var(--pae-primary);">Mejor Comunicación</h5>
                    <p class="small text-muted">Facilite el contacto entre padres, docentes y administrativos de forma ágil.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="container my-5 pb-4">
    <div class="p-4 p-md-5 rounded-4 shadow-sm" style="background: var(--pae-gradient-hero); color: #ffffff;">
        <div class="row align-items-center g-4">
            <div class="col-md-2 text-center">
                <img src="~/images/buho.png" alt="PAE App Móvil" class="img-fluid" style="max-height: 110px; filter: drop-shadow(0 6px 14px rgba(0,0,0,0.25));">
            </div>
            <div class="col-md-6">
                <span class="badge bg-light text-dark mb-2">Android · v1.0.0-beta</span>
                <h3 class="fw-bold mb-2">Descarga PAE App Móvil</h3>
                <p class="mb-0 opacity-75">
                    Lleva el Portal de Autogestión Educativa en tu celular para consultar notas, horarios, asistencia, actividades y citaciones.
                    Al abrir el archivo en Android, habilita <strong>"Instalar aplicaciones de orígenes desconocidos"</strong> si el sistema lo solicita.
                </p>
            </div>
            <div class="col-md-4 text-md-end text-center">
                <a asp-controller="Home" asp-action="DescargarAppMovil" class="btn btn-lg btn-pae-edit px-4 text-white shadow">
                    <i class="bi bi-android2 me-2"></i> Descargar APK
                </a>
            </div>
        </div>
    </div>
</section>

