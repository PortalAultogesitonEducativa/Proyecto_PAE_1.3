@{
    ViewData["Title"] = "Políticas de Tratamiento y Protección de Datos Personales";
}

<div class="container my-5 py-3" style="max-width: 1050px;">
    <!-- Encabezado Principal -->
    <div class="card border-0 shadow-sm rounded-4 text-white p-4 p-md-5 mb-4" 
         style="background: linear-gradient(135deg, #0d2a4a 0%, #1a4971 100%);">
        <div class="d-flex align-items-center gap-3 mb-2">
            <div class="rounded-circle d-flex align-items-center justify-content-center text-white" 
                 style="width: 58px; height: 58px; background: rgba(255,255,255,0.18); flex-shrink: 0;">
                <i class="bi bi-shield-check fs-2 text-warning"></i>
            </div>
            <div>
                <span class="badge bg-warning text-dark px-3 py-1 rounded-pill fw-bold mb-1">MARCO LEGAL COLOMBIANO</span>
                <h2 class="fw-bold mb-1">Política de Tratamiento y Protección de Datos Personales</h2>
                <small class="opacity-75">Habeas Data • Ley 1581 de 2012 • Decreto 1377 de 2013 • Ley 1098 de 2006</small>
            </div>
        </div>
        <p class="mb-0 mt-3 text-light opacity-90 small" style="line-height: 1.6;">
            En cumplimiento del Artículo 15 de la Constitución Política de Colombia, la <strong>Ley Estatutaria 1581 de 2012</strong>, 
            el <strong>Decreto Reglamentario 1377 de 2013</strong> y demás normas concordantes, el 
            <strong>Portal de Autogestión Educativa (PAE)</strong> adopta la presente política para garantizar la privacidad, 
            seguridad y el adecuado tratamiento de los datos personales de estudiantes, acudientes, docentes y personal institucional.
        </p>
    </div>

    <!-- Navegación Rápida / Resumen -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 h-100 bg-white border-start border-4 border-primary">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <i class="bi bi-file-earmark-lock-fill text-primary fs-4"></i>
                    <h6 class="fw-bold mb-0 text-dark">Régimen Legal</h6>
                </div>
                <p class="small text-muted mb-0">Cumplimiento estricto de las directrices de la Superintendencia de Industria y Comercio (SIC).</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 h-100 bg-white border-start border-4 border-warning">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <i class="bi bi-heart-pulse-fill text-warning fs-4"></i>
                    <h6 class="fw-bold mb-0 text-dark">Protección a Menores</h6>
                </div>
                <p class="small text-muted mb-0">Interés superior de niños, niñas y adolescentes conforme al Código de Infancia (Ley 1098 de 2006).</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 h-100 bg-white border-start border-4 border-success">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <i class="bi bi-key-fill text-success fs-4"></i>
                    <h6 class="fw-bold mb-0 text-dark">Tus Derechos Habeas Data</h6>
                </div>
                <p class="small text-muted mb-0">Derecho a conocer, actualizar, rectificar y suprimir tus datos en cualquier momento.</p>
            </div>
        </div>
    </div>

    <!-- Contenido Detallado Legal -->
    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white mb-4">
        
        <!-- 1. Identificación del Responsable -->
        <section class="mb-5">
            <h4 class="fw-bold text-dark border-bottom pb-2 mb-3 d-flex align-items-center gap-2">
                <span class="badge rounded-circle bg-primary text-white" style="width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center; font-size: 0.85rem;">1</span>
                Identificación del Responsable del Tratamiento
            </h4>
            <div class="table-responsive">
                <table class="table table-bordered table-sm align-middle small mb-0">
                    <tbody>
                        <tr>
                            <th class="bg-light text-dark" style="width: 30%;">Razón / Plataforma:</th>
                            <td>Portal de Autogestión Educativa (PAE)</td>
                        </tr>
                        <tr>
                            <th class="bg-light text-dark">Domicilio y País:</th>
                            <td>Bogotá D.C., República de Colombia</td>
                        </tr>
                        <tr>
                            <th class="bg-light text-dark">Correo Electrónico Oficial:</th>
                            <td><a href="mailto:paesml2025@gmail.com" class="text-primary fw-bold text-decoration-none">paesml2025@gmail.com</a></td>
                        </tr>
                        <tr>
                            <th class="bg-light text-dark">Canal de Atención WhatsApp:</th>
                            <td><a href="https://wa.me/573117398531" target="_blank" class="text-success fw-bold text-decoration-none">+57 311 739 8531</a></td>
                        </tr>
                        <tr>
                            <th class="bg-light text-dark">Canal PQR Interno:</th>
                            <td>Módulo oficial de Peticiones, Quejas, Reclamos y Solicitudes de la plataforma PAE</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>

        <!-- 2. Marco Normativo Aplicable -->
        <section class="mb-5">
            <h4 class="fw-bold text-dark border-bottom pb-2 mb-3 d-flex align-items-center gap-2">
                <span class="badge rounded-circle bg-primary text-white" style="width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center; font-size: 0.85rem;">2</span>
                Marco Legal y Normativa Aplicable
            </h4>
            <p class="text-secondary small" style="text-align: justify; line-height: 1.7;">
                La recolección, almacenamiento, uso, circulación y supresión de los datos personales tratados a través de PAE se fundamenta en:
            </p>
            <ul class="text-secondary small" style="line-height: 1.8;">
                <li><strong>Artículo 15 de la Constitución Política de Colombia:</strong> Consagra el derecho fundamental al Habeas Data, a la intimidad y al buen nombre.</li>
                <li><strong>Ley Estatutaria 1581 de 2012:</strong> Disposiciones generales para la protección de datos personales en el territorio colombiano.</li>
                <li><strong>Decreto Reglamentario 1377 de 2013:</strong> Reglamentación sobre la autorización del titular, avisos de privacidad y políticas de tratamiento.</li>
                <li><strong>Ley 1266 de 2008:</strong> Disposiciones sobre Habeas Data financiero y crediticio cuando resulte pertinente.</li>
                <li><strong>Ley 1098 de 2006 (Código de la Infancia y la Adolescencia):</strong> Protección integral y prevalencia de los derechos de los menores de edad.</li>
                <li><strong>Circulares y Guías de la Superintendencia de Industria y Comercio (SIC):</strong> Como autoridad nacional de vigilancia y protección de datos personales.</li>
            </ul>
        </section>

        <!-- 3. Finalidad del Tratamiento de Datos -->
        <section class="mb-5">
            <h4 class="fw-bold text-dark border-bottom pb-2 mb-3 d-flex align-items-center gap-2">
                <span class="badge rounded-circle bg-primary text-white" style="width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center; font-size: 0.85rem;">3</span>
                Finalidades Específicas del Tratamiento
            </h4>
            <p class="text-secondary small mb-2" style="text-align: justify; line-height: 1.7;">
                Los datos personales recolectados en el sistema son tratados exclusivamente con fines educativos, formativos y de gestión académica institucional:
            </p>
            <div class="row g-2">
                <div class="col-md-6">
                    <div class="p-3 bg-light rounded-3 small h-100 border">
                        <strong class="text-dark d-block mb-1"><i class="bi bi-mortarboard-fill text-primary me-1"></i>Gestión Académica y Curricular:</strong>
                        Registro de matrículas, historial académico, calificaciones por periodo, boletines, certificados oficiales con código de validación QR y observador del alumno.
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-3 bg-light rounded-3 small h-100 border">
                        <strong class="text-dark d-block mb-1"><i class="bi bi-people-fill text-primary me-1"></i>Comunicación con la Comunidad:</strong>
                        Notificaciones a acudientes sobre el rendimiento de sus hijos, citaciones institucionales, comunicados directivos y seguimiento a planes de mejora.
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-3 bg-light rounded-3 small h-100 border">
                        <strong class="text-dark d-block mb-1"><i class="bi bi-laptop-fill text-primary me-1"></i>Aula Virtual y Tareas:</strong>
                        Gestión de actividades pedagógicas tipo Classroom, entrega de tareas, retroalimentaciones docentes y cursos extracurriculares.
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-3 bg-light rounded-3 small h-100 border">
                        <strong class="text-dark d-block mb-1"><i class="bi bi-shield-lock-fill text-primary me-1"></i>Seguridad y Trazabilidad:</strong>
                        Autenticación segura de usuarios, control de accesos basados en roles, auditoría de cambios y prevención de suplantación de identidad.
                    </div>
                </div>
            </div>
        </section>

        <!-- 4. Tratamiento Especial de Datos de Menores de Edad -->
        <section class="mb-5">
            <h4 class="fw-bold text-dark border-bottom pb-2 mb-3 d-flex align-items-center gap-2">
                <span class="badge rounded-circle bg-warning text-dark" style="width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center; font-size: 0.85rem;">4</span>
                Tratamiento Especial de Datos de Menores de Edad (Niños, Niñas y Adolescentes)
            </h4>
            <div class="alert alert-warning border-warning-subtle rounded-4 p-3 small text-dark mb-3">
                <div class="d-flex align-items-center gap-2 mb-1">
                    <i class="bi bi-exclamation-triangle-fill text-warning fs-5"></i>
                    <strong>Principio de Interés Superior del Menor (Artículo 7 de la Ley 1581 de 2012):</strong>
                </div>
                El tratamiento de datos personales de menores de edad es de carácter rigurosamente protegido y reservado. Solo se tratarán datos que sean de naturaleza pública o que respondan y respeten el interés superior de los niños, niñas y adolescentes, y aseguren sin excepción el respeto de sus derechos fundamentales.
            </div>
            <p class="text-secondary small" style="text-align: justify; line-height: 1.7;">
                En concordancia con el Decreto 1377 de 2013, la autorización para el tratamiento de los datos personales de estudiantes menores de edad es otorgada expresamente por sus <strong>padres de familia, representantes legales o acudientes</strong> debidamente acreditados en la matrícula escolar institucional.
            </p>
        </section>

        <!-- 5. Derechos del Titular de la Información -->
        <section class="mb-5">
            <h4 class="fw-bold text-dark border-bottom pb-2 mb-3 d-flex align-items-center gap-2">
                <span class="badge rounded-circle bg-primary text-white" style="width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center; font-size: 0.85rem;">5</span>
                Derechos de los Titulares (Habeas Data)
            </h4>
            <p class="text-secondary small" style="text-align: justify; line-height: 1.7;">
                Conforme al Artículo 8 de la Ley 1581 de 2012, usted como titular de datos personales tiene los siguientes derechos:
            </p>
            <div class="row g-3 small text-secondary">
                <div class="col-md-6">
                    <ul style="line-height: 1.8;">
                        <li><strong>Conocer, actualizar y rectificar:</strong> Solicitar la actualización o corrección de datos inexactos, incompletos o desactualizados.</li>
                        <li><strong>Solicitar prueba de la autorización:</strong> Conocer el soporte del consentimiento otorgado para el tratamiento de su información.</li>
                        <li><strong>Ser informado del uso:</strong> Conocer detalladamente el uso y destino que se ha dado a sus datos personales.</li>
                    </ul>
                </div>
                <div class="col-md-6">
                    <ul style="line-height: 1.8;">
                        <li><strong>Revocar la autorización o solicitar supresión:</strong> Solicitar la eliminación de sus datos cuando en el tratamiento no se respeten los principios y garantías constitucionales.</li>
                        <li><strong>Presentar quejas ante la SIC:</strong> Interponer reclamos ante la Superintendencia de Industria y Comercio por presuntas infracciones legales.</li>
                        <li><strong>Acceso gratuito:</strong> Consultar sin costo sus datos personales objeto de tratamiento en el sistema.</li>
                    </ul>
                </div>
            </div>
        </section>

        <!-- 6. Procedimiento para Consultas, Reclamos y PQR -->
        <section class="mb-5">
            <h4 class="fw-bold text-dark border-bottom pb-2 mb-3 d-flex align-items-center gap-2">
                <span class="badge rounded-circle bg-primary text-white" style="width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center; font-size: 0.85rem;">6</span>
                Canales de Atención y Ejercicio de Derechos (PQR)
            </h4>
            <p class="text-secondary small" style="text-align: justify; line-height: 1.7;">
                Para ejercer sus derechos de consulta, actualización, rectificación o reclamo respecto a sus datos personales, el titular o su apoderado pueden dirigirse formalmente a través de cualquiera de los siguientes canales:
            </p>
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="card border rounded-3 p-3 bg-light text-center h-100">
                        <i class="bi bi-envelope-at-fill fs-2 text-primary mb-2"></i>
                        <h6 class="fw-bold text-dark mb-1">Correo Electrónico</h6>
                        <small class="text-muted d-block mb-2">Trámite directo de peticiones</small>
                        <a href="mailto:paesml2025@gmail.com" class="btn btn-outline-primary btn-sm rounded-pill mt-auto">paesml2025@gmail.com</a>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border rounded-3 p-3 bg-light text-center h-100">
                        <i class="bi bi-whatsapp fs-2 text-success mb-2"></i>
                        <h6 class="fw-bold text-dark mb-1">Línea WhatsApp</h6>
                        <small class="text-muted d-block mb-2">Atención institucional</small>
                        <a href="https://wa.me/573117398531" target="_blank" class="btn btn-outline-success btn-sm rounded-pill mt-auto">+57 311 739 8531</a>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border rounded-3 p-3 bg-light text-center h-100">
                        <i class="bi bi-chat-heart-fill fs-2 text-warning mb-2"></i>
                        <h6 class="fw-bold text-dark mb-1">Módulo PQR PAE</h6>
                        <small class="text-muted d-block mb-2">Radicación con radicado digital</small>
                        <a asp-controller="Pqr" asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill mt-auto">Radicar PQR</a>
                    </div>
                </div>
            </div>
            <small class="text-muted d-block mt-3" style="font-size: 0.8rem;">
                * Conforme a la Ley 1581 de 2012, las consultas serán atendidas en un término máximo de diez (10) días hábiles y los reclamos en quince (15) días hábiles contados a partir de su recepción completa.
            </small>
        </section>

        <!-- 7. Seguridad de la Información y Confidencialidad -->
        <section class="mb-5">
            <h4 class="fw-bold text-dark border-bottom pb-2 mb-3 d-flex align-items-center gap-2">
                <span class="badge rounded-circle bg-primary text-white" style="width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center; font-size: 0.85rem;">7</span>
                Medidas de Seguridad de la Información
            </h4>
            <p class="text-secondary small" style="text-align: justify; line-height: 1.7;">
                El sistema PAE implementa rigurosas medidas técnicas, organizativas y humanas para evitar la adulteración, pérdida, consulta, uso o acceso no autorizado o fraudulento de la información, tales como:
            </p>
            <ul class="text-secondary small" style="line-height: 1.8;">
                <li>Cifrado de contraseñas de acceso mediante algoritmos criptográficos unidireccionales seguros (BCrypt).</li>
                <li>Control estricto de accesos y permisos por roles institucionales (Administrador, Coordinador, Docente, Estudiante, Acudiente).</li>
                <li>Códigos alfanuméricos únicos y códigos QR criptográficos para validación de certificados de estudio y notas oficiales.</li>
                <li>Políticas de expiración y control de sesiones inactivas para salvaguardar estaciones de trabajo compartidas.</li>
            </ul>
        </section>

        <!-- 8. Propiedad Intelectual y Derechos Reservados -->
        <section>
            <h4 class="fw-bold text-dark border-bottom pb-2 mb-3 d-flex align-items-center gap-2">
                <span class="badge rounded-circle bg-primary text-white" style="width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center; font-size: 0.85rem;">8</span>
                Propiedad Intelectual y Derechos Reservados
            </h4>
            <p class="text-secondary small" style="text-align: justify; line-height: 1.7;">
                Todos los contenidos, diseños, código fuente, logotipos, estructuras de base de datos, módulos de software y elementos audiovisuales que componen la plataforma 
                <strong>Portal de Autogestión Educativa (PAE)</strong> son propiedad intelectual exclusiva de sus autores y de la institución educativa o se encuentran debidamente licenciados.
            </p>
            <div class="p-3 bg-light rounded-3 border text-center small text-muted">
                <strong>© @DateTime.Now.Year Portal de Autogestión Educativa - PAE. Todos los derechos reservados.</strong><br />
                Prohibida su reproducción total o parcial, transformación, descompilación o explotación comercial no autorizada sin el consentimiento expreso y por escrito de los titulares.
            </div>
        </section>

    </div>

    <!-- Botones de Acción / Navegación Inferior -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
            <i class="bi bi-arrow-left me-1"></i> Volver al Inicio
        </a>
        <a asp-controller="Home" asp-action="Contacto" class="btn text-white rounded-pill px-4" style="background-color: #e67e22;">
            <i class="bi bi-chat-dots-fill me-1"></i> Contáctanos
        </a>
    </div>
</div>
