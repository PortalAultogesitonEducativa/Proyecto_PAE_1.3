@model ProyectoPAE.Models.Usuario

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-primary text-white text-center py-4">
                    @if (!string.IsNullOrEmpty(Model.FOTO_URL))
                    {
                        <img src="@Model.FOTO_URL" class="rounded-circle border border-white border-3 shadow"
                             style="width: 120px; height: 120px; object-fit: cover;" alt="Foto de Perfil" />
                    }
                    else
                    {
                        <i class="bi bi-person-circle" style="font-size: 4rem;"></i>
                    }
                    <h2 class="mt-2">@Model.NOMBRES</h2>
                </div>

                <div class="card-body p-4">
                    <div class="mb-3">
                        <label class="text-muted small">Nombres y Apellidos</label>
                        <p class="h5 border-bottom pb-2">@Model.NOMBRES @Model.APELLIDOS</p>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="text-muted small">Correo Electrónico</label>
                            <p class="h6 border-bottom pb-2">@Model.CORREO_ELECTRONICO</p>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="text-muted small">Teléfono</label>
                            <p class="h6 border-bottom pb-2">@(Model.TELEFONO ?? "No registrado")</p>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="text-muted small">Dirección de Residencia</label>
                        <p class="h6 border-bottom pb-2">@(Model.DIRECCION ?? "No registrada")</p>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <label class="text-muted small d-block">Rol en el Sistema</label>
                            <span class="badge bg-info text-dark fs-6">@Model.ROL.ToUpper()</span>
                        </div>
                        <div class="text-end">
                            <label class="text-muted small d-block">Estado</label>
                            <span class="text-success fw-bold">
                                <i class="bi bi-check-circle-fill"></i> Activo
                            </span>
                        </div>
                    </div>

                    <div class="d-grid mt-4">
                        <a asp-action="EditarPerfil" asp-controller="Home" class="btn btn-primary">
                            <i class="bi bi-pencil-square me-2"></i>Actualizar mis datos
                        </a>
                    </div>

                    <hr class="mt-4" />

                    <div class="d-grid">
                        <button type="button" class="btn btn-outline-primary"
                                data-bs-toggle="modal" data-bs-target="#modalCambiarPassword">
                            <i class="bi bi-key me-2"></i>Cambiar contraseña
                        </button>
                    </div>
                </div>

                <div class="card-footer text-center bg-light">
                    <small class="text-muted">Miembro desde el sistema PAE</small>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ─── MODAL CAMBIAR CONTRASEÑA ─────────────────────────── -->
<div class="modal fade" id="modalCambiarPassword" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">

            @if (ViewBag.ExitoPassword != null)
            {
                <!-- Vista de ÉXITO: solo mensaje y botón cerrar -->
                <div class="modal-header" style="background-color:#0d2a4a ;">
                    <h5 class="modal-title text-white">
                        <i class="bi bi-check-circle me-2"></i>Contraseña actualizada
                    </h5>
                </div>
                <div class="modal-body text-center p-4">
                    <i class="bi bi-check-circle-fill" style="font-size: 3rem; color: #0d2a4a;"></i>
                    <p class="mt-3 fs-5">@ViewBag.ExitoPassword</p>
                </div>
                <div class="modal-footer justify-content-center">
                    <button type="button" class="btn px-4 text-white" style="background-color: #0d2a4a;" data-bs-dismiss="modal">
                        <i class="bi bi-x-circle me-1"></i>Cerrar
                    </button>
                </div>
            }
            else
            {
                <!-- Vista NORMAL: formulario -->
                <div class="modal-header" style="background-color: #0d2a4a;">
                    <h5 class="modal-title text-white">
                        <i class="bi bi-shield-lock me-2"></i>Cambiar contraseña
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    @if (ViewBag.ErrorPassword != null)
                    {
                        <div class="alert alert-danger">@ViewBag.ErrorPassword</div>
                    }
                    <form method="post" action="/Home/CambiarContrasena">
                        <div class="mb-3">
                            <label class="text-muted small">Contraseña actual</label>
                            <input type="password" name="contrasenaActual"
                                   class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label class="text-muted small">Nueva contraseña</label>
                            <input type="password" name="nuevaContrasena"
                                   class="form-control" minlength="8" required />
                        </div>
                        <div class="mb-3">
                            <label class="text-muted small">Confirmar nueva contraseña</label>
                            <input type="password" name="confirmar"
                                   class="form-control" minlength="8" required />
                        </div>
                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-key me-2"></i>Guardar nueva contraseña
                            </button>
                        </div>
                    </form>
                </div>
            }

        </div>
    </div>
</div>

@if (ViewBag.ErrorPassword != null || ViewBag.ExitoPassword != null)
{
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var modal = new bootstrap.Modal(document.getElementById('modalCambiarPassword'));
            modal.show();
        });
    </script>
}