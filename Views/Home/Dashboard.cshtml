    // --- FILTRADO + PAGINACIÓN DE MATRÍCULAS (20 por página) ---
    let matPaginaActual = 1;
    const MAT_POR_PAGINA = 20;

    function getFilasMatriculasFiltradas() {
        const selGrado = document.getElementById('filtroGrado');
        const selEstado = document.getElementById('filtroEstado');
        const valGrado  = selGrado  ? selGrado.value.toLowerCase().trim()  : 'todos';
        const valEstado = selEstado ? selEstado.value.toLowerCase().trim() : 'todos';

        const todasFilas = Array.from(document.querySelectorAll('#tbodyMatriculas tr.fila-mat'));
        return todasFilas.filter(fila => {
            const grado  = (fila.getAttribute('data-grado')  || '').toLowerCase();
            const estado = (fila.getAttribute('data-estado') || '').toLowerCase();
            const okGrado  = valGrado  === 'todos' || grado === valGrado;
            const okEstado = valEstado === 'todos' || estado.includes(valEstado) ||
                             (valEstado === 'activa' && (estado === 'activa' || estado === 'activo'));
            return okGrado && okEstado;
        });
    }

    function renderizarPaginacionMat() {
        const filasFiltradas = getFilasMatriculasFiltradas();
        const totalFilas = filasFiltradas.length;
        const totalPaginas = Math.max(1, Math.ceil(totalFilas / MAT_POR_PAGINA));

        // Ajustar página actual si se va de rango
        if (matPaginaActual > totalPaginas) matPaginaActual = totalPaginas;

        // Ocultar todas las filas primero
        document.querySelectorAll('#tbodyMatriculas tr.fila-mat').forEach(f => f.style.display = 'none');

        // Mostrar solo las de la página actual
        const inicio = (matPaginaActual - 1) * MAT_POR_PAGINA;
        const fin    = Math.min(inicio + MAT_POR_PAGINA, totalFilas);
        for (let i = inicio; i < fin; i++) {
            filasFiltradas[i].style.display = '';
        }

        // Info de página
        const info = document.getElementById('infoMatPagina');
        if (info) {
            if (totalFilas === 0) {
                info.textContent = 'Sin resultados para los filtros seleccionados';
            } else {
                info.textContent = `Mostrando ${inicio + 1}–${fin} de ${totalFilas} matrículas`;
            }
        }

        // Renderizar controles de paginación
        const ul = document.getElementById('paginacionMat');
        if (!ul) return;
        ul.innerHTML = '';

        if (totalPaginas <= 1) return;

        const crearLi = (label, pagina, activo, disabled) => {
            const li = document.createElement('li');
            li.className = `page-item${activo ? ' active' : ''}${disabled ? ' disabled' : ''}`;
            const a = document.createElement('a');
            a.className = 'page-link';
            a.innerHTML = label;
            a.href = '#';
            if (!disabled && !activo) {
                a.addEventListener('click', (e) => { e.preventDefault(); matPaginaActual = pagina; renderizarPaginacionMat(); });
            }
            li.appendChild(a);
            ul.appendChild(li);
        };

        crearLi('&laquo;', matPaginaActual - 1, false, matPaginaActual === 1);

        // Mostrar máximo 7 botones con elipsis
        const rango = 2;
        for (let p = 1; p <= totalPaginas; p++) {
            if (p === 1 || p === totalPaginas || (p >= matPaginaActual - rango && p <= matPaginaActual + rango)) {
                crearLi(p, p, p === matPaginaActual, false);
            } else if (p === matPaginaActual - rango - 1 || p === matPaginaActual + rango + 1) {
                crearLi('...', p, false, true);
            }
        }

        crearLi('&raquo;', matPaginaActual + 1, false, matPaginaActual === totalPaginas);
    }

    function filtrarMatriculas() {
        matPaginaActual = 1;
        renderizarPaginacionMat();
    }

