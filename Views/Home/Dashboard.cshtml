            <!-- Tabla Dinámica cargada desde la Base de Datos -->
            <div class="card border-0 shadow-sm overflow-hidden">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" id="tablaAsistencia">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Estudiante</th>
                                <th class="text-center" style="width: 220px;">Estado</th>
                                <th>Observación</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ViewBag.EstudiantesAsistencia != null && ((List<ProyectoPAE.Models.Usuario>)ViewBag.EstudiantesAsistencia).Any())
                            {
                                var listaEst = (List<ProyectoPAE.Models.Usuario>)ViewBag.EstudiantesAsistencia;
                                for (int i = 0; i < listaEst.Count; i++)
                                {
                                    var est = listaEst[i];
                                    var radId = i + 1;
                                    <tr>
                                        <td class="ps-3 fw-bold estudiante-nombre">
                                            <input type="hidden" name="estudiante_id_asistencia" value="@est.ID_Usuario" />
                                            @(!string.IsNullOrEmpty(est.NOMBRES) ? $"{est.NOMBRES} {est.APELLIDOS}".Trim() : est.NOMBRE_USUARIO)
                                        </td>
                                        <td class="text-center">
                                            <div class="btn-group btn-group-sm" role="group">
                                                <input type="radio" class="btn-check radio-estado-p" name="ast_@est.ID_Usuario" id="p_@radId" value="P">
                                                <label class="btn btn-outline-success fw-bold px-3" for="p_@radId" title="Presente">P</label>

                                                <input type="radio" class="btn-check" name="ast_@est.ID_Usuario" id="f_@radId" value="F">
                                                <label class="btn btn-outline-danger fw-bold px-3" for="f_@radId" title="Falla / Ausente">F</label>

                                                <input type="radio" class="btn-check" name="ast_@est.ID_Usuario" id="r_@radId" value="R">
                                                <label class="btn btn-outline-warning fw-bold px-3" for="r_@radId" title="Retardo / Llegada Tardía">R</label>
                                            </div>
                                        </td>
                                        <td>
                                            <input type="text" class="form-control form-control-sm" name="obs_@est.ID_Usuario" placeholder="Observación opcional...">
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" class="text-center text-muted py-4">No hay estudiantes registrados en la base de datos.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Botones de Acción: Reiniciar y Guardar Asistencia -->
                <div class="p-3 bg-light d-flex justify-content-between align-items-center border-top">
                    <button type="button" class="btn btn-outline-secondary fw-bold" onclick="reiniciarAsistencias()">
                        <i class="bi bi-arrow-counterclockwise me-2"></i>Reiniciar Calificación de Asistencias
                    </button>
                    <button type="button" class="btn btn-primary fw-bold px-4" onclick="guardarAsistenciaYObservaciones()">
                        <i class="bi bi-save me-2"></i>Guardar Asistencia y Observaciones
                    </button>
                </div>
            </div>
        </div>

        <!-- Módulo Oculto de Gestión de Cursos Extracurriculares (Docente) -->
        <div id="docente-cursosextra" class="d-none">
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
                <div>
                    <h3 class="fw-bold mb-0" style="color: #2980b9;">
                        <i class="bi bi-stars me-2"></i>Gestión de Cursos Extracurriculares
                    </h3>
                    <p class="text-muted small mb-0">Crea talleres institucionales, define temarios de aprendizaje, límites de cupos y consulta inscripciones en tiempo real.</p>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn text-white shadow-sm" style="background-color: #2980b9; border-radius: 8px;" data-bs-toggle="modal" data-bs-target="#modalCrearCursoExtra">
                        <i class="bi bi-plus-circle me-1"></i> Publicar Nuevo Curso
                    </button>
                    <button class="btn btn-outline-secondary btn-sm" onclick="volverDocente()" style="border-radius: 8px;">
                        <i class="bi bi-arrow-left me-1"></i> Volver
                    </button>
                </div>
            </div>

            <!-- KPIs de Cursos Extracurriculares -->
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm p-3 h-100 rounded-3" style="border-left: 4px solid #2980b9 !important;">
                        <span class="text-muted text-uppercase small fw-semibold">Cursos Registrados</span>
                        <h3 class="fw-bold mb-0 text-dark">@cursosExtraDocente.Count</h3>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm p-3 h-100 rounded-3" style="border-left: 4px solid #27ae60 !important;">
                        <span class="text-muted text-uppercase small fw-semibold">Cupos Totales Ofertados</span>
                        <h3 class="fw-bold mb-0 text-success">@cursosExtraDocente.Sum(c => c.CuposTotales)</h3>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm p-3 h-100 rounded-3" style="border-left: 4px solid #f39c12 !important;">
                        <span class="text-muted text-uppercase small fw-semibold">Cupos Disponibles Libres</span>
                        <h3 class="fw-bold mb-0 text-warning">@cursosExtraDocente.Sum(c => c.CuposDisponibles)</h3>
                    </div>
                </div>
            </div>

            @if (!cursosExtraDocente.Any())
            {
                <div class="card border-0 shadow-sm p-5 text-center rounded-4 bg-white">
                    <i class="bi bi-stars text-muted display-4 mb-3"></i>
                    <h5 class="fw-bold text-secondary">Aún no has publicado ningún curso extracurricular</h5>
                    <p class="text-muted small mb-4">Haz clic en el botón inferior para abrir las inscripciones a un nuevo taller o actividad extracurricular.</p>
                    <div>
                        <button class="btn text-white px-4 py-2 shadow-sm" style="background-color: #2980b9; border-radius: 8px;" data-bs-toggle="modal" data-bs-target="#modalCrearCursoExtra">
                            <i class="bi bi-plus-circle me-2"></i> Crear Primer Curso Extracurricular
                        </button>
                    </div>
                </div>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var curso in cursosExtraDocente)
                    {
                        var pctOcupacion = curso.CuposTotales > 0 ? (int)(((double)(curso.CuposTotales - curso.CuposDisponibles) / curso.CuposTotales) * 100) : 0;
                        var estadoClase = !curso.Activo ? "bg-secondary" : (curso.CuposDisponibles == 0 ? "bg-danger" : (curso.PeriodoInscripcionAbierto ? "bg-success" : "bg-warning text-dark"));
                        var estadoTexto = !curso.Activo ? "Inactivo / Pausado" : (curso.CuposDisponibles == 0 ? "Cupos Agotados" : (curso.PeriodoInscripcionAbierto ? "Inscripciones Abiertas" : "Fuera de Periodo"));

                        <div class="col-lg-6 mb-3">
                            <div class="card border-0 shadow-sm rounded-4 h-100 p-3 bg-white" style="border-top: 4px solid #2980b9 !important;">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h5 class="fw-bold text-dark mb-0">@curso.Nombre</h5>
                                    <span class="badge @estadoClase rounded-pill px-3 py-1">@estadoTexto</span>
                                </div>

                                <p class="text-muted small mb-2">
                                    <i class="bi bi-person-fill text-primary me-1"></i><strong>Instructor:</strong> @curso.Instructor
                                    @if (!string.IsNullOrEmpty(curso.Horario))
                                    {
                                        <span class="ms-2"><i class="bi bi-clock-fill text-secondary me-1"></i>@curso.Horario</span>
                                    }
                                </p>

                                <div class="p-3 bg-light rounded-3 mb-3">
                                    <h6 class="fw-bold text-secondary small mb-1"><i class="bi bi-journal-text me-1 text-primary"></i>¿Qué se va a aprender? / Temario:</h6>
                                    <p class="small text-muted mb-0" style="white-space: pre-line;">@(string.IsNullOrWhiteSpace(curso.Descripcion) ? "Sin descripción detallada." : curso.Descripcion)</p>
                                </div>

                                <div class="row g-2 small text-muted mb-3">
                                    <div class="col-6">
                                        <div class="border p-2 rounded-2 bg-white">
                                            <span class="d-block text-secondary fw-semibold"><i class="bi bi-calendar-event me-1"></i>Inscripciones:</span>
                                            <span class="fw-bold text-dark">@curso.FechaInicioInscripcion.ToString("dd/MM/yyyy") - @curso.FechaFinInscripcion.ToString("dd/MM/yyyy")</span>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="border p-2 rounded-2 bg-white">
                                            <span class="d-block text-secondary fw-semibold"><i class="bi bi-calendar-check me-1"></i>Clases del Curso:</span>
                                            <span class="fw-bold text-dark">@curso.FechaInicio.ToString("dd/MM/yyyy") - @curso.FechaFin.ToString("dd/MM/yyyy")</span>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <div class="border p-2 rounded-2 bg-white d-flex justify-content-between align-items-center">
                                            <span><i class="bi bi-mortarboard me-1 text-primary"></i>Grados admitidos:</span>
                                            <span class="badge bg-primary text-white">Grados @(curso.GradoMin ?? 6)° a @(curso.GradoMax ?? 11)°</span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Barra de cupos -->
                                <div class="mb-3">
                                    <div class="d-flex justify-content-between align-items-center small mb-1">
                                        <span class="text-muted fw-semibold">Disponibilidad de cupos:</span>
                                        <span class="fw-bold @(curso.CuposDisponibles > 0 ? "text-success" : "text-danger")">
                                            @curso.CuposDisponibles de @curso.CuposTotales disponibles (@(curso.CuposTotales - curso.CuposDisponibles) inscritos)
                                        </span>
                                    </div>
                                    <div class="progress" style="height: 8px;">
                                        <div class="progress-bar @(pctOcupacion >= 100 ? "bg-danger" : (pctOcupacion >= 80 ? "bg-warning" : "bg-primary"))" role="progressbar" style="width: @pctOcupacion%;" aria-valuenow="@pctOcupacion" aria-valuemin="0" aria-valuemax="100"></div>
                                    </div>
                                </div>

                                <div class="d-flex justify-content-between align-items-center pt-2 border-top mt-auto">
                                    <button class="btn btn-outline-primary btn-sm rounded-pill px-3" onclick="verInscritosCursoExtra(@curso.IdExtraCurso)">
                                        <i class="bi bi-people-fill me-1"></i> Ver Inscritos (@(curso.CuposTotales - curso.CuposDisponibles))
                                    </button>
                                    <div class="d-flex gap-1">
                                        <button class="btn btn-sm @(curso.Activo ? "btn-outline-warning" : "btn-outline-success") rounded-pill px-3" onclick="cambiarEstadoCursoExtra(@curso.IdExtraCurso, @(curso.Activo ? "false" : "true"))">
                                            @(curso.Activo ? "Pausar" : "Activar")
                                        </button>
                                        <button class="btn btn-outline-danger btn-sm rounded-pill px-2" title="Eliminar curso" onclick="eliminarCursoExtra(@curso.IdExtraCurso)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- MODAL: CREAR CURSO EXTRACURRICULAR -->
        <div class="modal fade" id="modalCrearCursoExtra" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
                    <div class="modal-header text-white" style="background-color: #2980b9; border-radius: 16px 16px 0 0;">
                        <h5 class="modal-title fw-bold"><i class="bi bi-stars me-2"></i>Publicar Nuevo Curso Extracurricular</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <form id="formCrearCursoExtra" onsubmit="guardarCursoExtra(event)">
                        <div class="modal-body p-4">
                            <div class="row g-3">
                                <div class="col-md-8">
                                    <label class="form-label fw-bold small">Nombre del Curso / Taller <span class="text-danger">*</span></label>
                                    <input type="text" name="Nombre" class="form-control" placeholder="Ej: Club de Robótica y Programación, Taller de Arte y Óleo..." required />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-bold small">Docente / Instructor</label>
                                    <input type="text" name="Instructor" class="form-control" value="@nombre" placeholder="Nombre del instructor" />
                                </div>

                                <div class="col-12">
                                    <label class="form-label fw-bold small">¿Qué se va a aprender? / Temario y Objetivos <span class="text-danger">*</span></label>
                                    <textarea name="Descripcion" class="form-control" rows="3" placeholder="Describe los contenidos del curso, competencias a desarrollar, materiales necesarios y dinámica de las sesiones..." required></textarea>
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label fw-bold small">Cupos Totales <span class="text-danger">*</span></label>
                                    <input type="number" name="CuposTotales" class="form-control" min="1" max="500" value="20" required />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-bold small">Grado Mínimo Permitido</label>
                                    <select name="GradoMin" class="form-select">
                                        <option value="6" selected>6° Grado</option>
                                        <option value="7">7° Grado</option>
                                        <option value="8">8° Grado</option>
                                        <option value="9">9° Grado</option>
                                        <option value="10">10° Grado</option>
                                        <option value="11">11° Grado</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-bold small">Grado Máximo Permitido</label>
                                    <select name="GradoMax" class="form-select">
                                        <option value="6">6° Grado</option>
                                        <option value="7">7° Grado</option>
                                        <option value="8">8° Grado</option>
                                        <option value="9">9° Grado</option>
                                        <option value="10">10° Grado</option>
                                        <option value="11" selected>11° Grado</option>
                                    </select>
                                </div>

                                <div class="col-md-12">
                                    <label class="form-label fw-bold small">Horario / Días de Clase</label>
                                    <input type="text" name="Horario" class="form-control" placeholder="Ej: Martes y Jueves de 3:30 PM a 5:00 PM (Aula de Informática)" />
                                </div>

                                <div class="col-md-6">
                                    <div class="card p-3 bg-light border-0 rounded-3">
                                        <h6 class="fw-bold small text-primary mb-2"><i class="bi bi-calendar-event me-1"></i>Periodo de Inscripción</h6>
                                        <div class="mb-2">
                                            <label class="form-label small mb-1">Fecha Inicio Inscripción:</label>
                                            <input type="date" name="FechaInicioInscripcion" class="form-control form-control-sm" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                                        </div>
                                        <div>
                                            <label class="form-label small mb-1">Fecha Cierre Inscripción:</label>
                                            <input type="date" name="FechaFinInscripcion" class="form-control form-control-sm" value="@DateTime.Now.AddDays(15).ToString("yyyy-MM-dd")" required />
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="card p-3 bg-light border-0 rounded-3">
                                        <h6 class="fw-bold small text-success mb-2"><i class="bi bi-calendar-check me-1"></i>Periodo de Clases</h6>
                                        <div class="mb-2">
                                            <label class="form-label small mb-1">Fecha Inicio del Curso:</label>
                                            <input type="date" name="FechaInicio" class="form-control form-control-sm" value="@DateTime.Now.AddDays(16).ToString("yyyy-MM-dd")" required />
                                        </div>
                                        <div>
                                            <label class="form-label small mb-1">Fecha Fin del Curso:</label>
                                            <input type="date" name="FechaFin" class="form-control form-control-sm" value="@DateTime.Now.AddMonths(3).ToString("yyyy-MM-dd")" required />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer bg-light" style="border-radius: 0 0 16px 16px;">
                            <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancelar</button>
                            <button type="submit" class="btn text-white rounded-pill px-4 shadow-sm" style="background-color: #2980b9;">
                                <i class="bi bi-check-circle me-1"></i> Publicar Curso
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- MODAL: VER ESTUDIANTES INSCRITOS -->
        <div class="modal fade" id="modalVerInscritosExtra" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
                    <div class="modal-header text-white" style="background-color: #2980b9; border-radius: 16px 16px 0 0;">
                        <h5 class="modal-title fw-bold" id="tituloModalInscritos"><i class="bi bi-people-fill me-2"></i>Estudiantes Inscritos</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-4">
                        <div id="resumenInscritos" class="d-flex justify-content-between align-items-center mb-3 p-3 bg-light rounded-3">
                            <span class="text-muted fw-semibold" id="conteoInscritos">Cargando inscritos...</span>
                            <span class="badge bg-primary px-3 py-1" id="badgeCuposModal">--</span>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>#</th>
                                        <th>Estudiante</th>
                                        <th>Documento / Código</th>
                                        <th>Correo Electrónico</th>
                                        <th>Fecha Inscripción</th>
                                        <th>Estado</th>
                                    </tr>
                                </thead>
                                <tbody id="tablaCuerpoInscritos">
                                    <tr>
                                        <td colspan="6" class="text-center py-4 text-muted">Cargando lista de inscritos...</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="modal-footer bg-light" style="border-radius: 0 0 16px 16px;">
                        <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Cerrar</button>
                    </div>
                </div>
            </div>
        </div>

    </div> <!-- Cierre definitivo del panel-docente general -->

    <div id="panel-acudiente" class="role-panel d-none">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 style="color: #27ae60;"><i class="bi bi-person-heart me-2"></i>Panel de Padres</h2>

            <div class="d-flex align-items-center bg-success text-white px-3 py-1 rounded-pill shadow-sm">
                <span class="small me-2 fw-bold">Hijo(a):</span>
                <select id="selectHijo" class="form-select form-select-sm border-0 bg-transparent text-white p-0 fw-bold" style="box-shadow: none; cursor: pointer; min-width: 150px;">
                    @if (ViewBag.ListaHijos != null)
                    {
                        foreach (var hijo in ViewBag.ListaHijos)
                        {
                            <option value="@hijo.ID_Usuario" class="text-dark">
                                @hijo.NOMBRES @hijo.APELLIDOS
                            </option>
                        }
                    }
                    else
                    {
                        <option class="text-dark">Cargando estudiantes...</option>
                    }
                </select>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-md-4">
                <div class="card p-4 text-center border-0 shadow-sm card-hover" style="border-top: 4px solid #27ae60 !important;">
                    <i class="bi bi-journal-text fs-2 mb-2" style="color: #27ae60;"></i>
                    <h5>Ver Calificaciones</h5>
                    <p class="small text-muted">Promedio actual: <strong class="text-success">@ViewBag.PromedioRapido</strong></p>
                    <a id="btnVerNotas" href="#" class="btn btn-sm btn-outline-success">
                        Ver Reporte
                    </a>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card p-4 text-center border-0 shadow-sm card-hover" style="border-top: 4px solid #27ae60 !important;">
                    <i class="bi bi-calendar-check fs-2 mb-2" style="color: #27ae60;"></i>
                    <h5>Asistencia</h5>
                    <p class="small text-muted">Fallas registradas: <strong class="text-danger">@ViewBag.FallasRapidas</strong></p>
                    <button class="btn btn-sm btn-outline-success" data-bs-toggle="modal" data-bs-target="#modalAsistencia">
                        Ver Detalle
                    </button>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card p-4 text-center border-0 shadow-sm card-hover" style="border-top: 4px solid #27ae60 !important;">
                    <i class="bi bi-chat-left-dots fs-2 mb-2" style="color: #27ae60;"></i>
                    <h5>Citaciones</h5>
                    <p class="small text-muted">Mensajes directos de los docentes.</p>
                    <button class="btn btn-sm btn-outline-success" data-bs-toggle="modal" data-bs-target="#modalCitaciones">
                        Ir a Mensajes
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div id="panel-estudiante" class="role-panel d-none">
        <div id="estudiante-main">
            <h2 class="mb-4" style="color: #6f42c1;"><i class="bi bi-mortarboard-fill me-2"></i>Mi Panel Académico</h2>

            <div class="row">
                <!-- 1. Horario de Clases -->
                <!-- Horario de Clases -->
                <div class="col-md-4 mb-4">
                    <div class="card p-4 text-center border-0 shadow-sm h-100 card-estudiante-limpia"
                         style="border-top: 4px solid #6f42c1 !important;">
                        <i class="bi bi-calendar3 fs-2 mb-2" style="color: #6f42c1;"></i>
                        <h5 style="color: #6f42c1; font-weight: bold;">Horario de Clases</h5>
                        <p class="small text-muted">Consulta tus materias y salones.</p>

                        <a href="@Url.Action("MiHorario", "Horario")"
                           class="btn btn-estudiante-solido btn-sm mt-auto w-100 text-white"
                           style="background-color: #6f42c1;">
                            Ver Horario
                        </a>
                    </div>
                </div>

                <!-- 2. Mis Calificaciones -->
                <div class="col-md-4 mb-4">
                    <div class="card p-4 text-center border-0 shadow-sm h-100 card-estudiante-limpia"
                         style="border-top: 4px solid #6f42c1 !important; cursor: pointer;"
                         onclick="location.href='@Url.Action("MisNotas", "Estudiante")'">
                        <i class="bi bi-file-earmark-bar-graph fs-2 mb-2" style="color: #6f42c1;"></i>
                        <h5 style="color: #6f42c1; font-weight: bold;">Mis Calificaciones</h5>
                        <p class="small text-muted">Consulta tu rendimiento académico.</p>
                        <a href="@Url.Action("MisNotas", "Estudiante")" class="btn btn-estudiante-solido btn-sm mt-auto w-100 text-white" style="background-color: #6f42c1;">
                            Ver Notas
                        </a>
                    </div>
                </div>

                <!-- 3. Actividades -->
                <div class="col-md-4 mb-4">
                    <div class="card p-4 text-center border-0 shadow-sm h-100 card-estudiante-limpia"
                         style="border-top: 4px solid #6f42c1 !important; cursor: pointer;"
                         onclick="verActividadesEstudiante()">
                        <i class="bi bi-list-task fs-2 mb-2" style="color: #6f42c1;"></i>
                        <h5 style="color: #6f42c1; font-weight: bold;">Actividades</h5>
                        <p class="small text-muted">Tareas y trabajos pendientes.</p>
                        <button class="btn btn-estudiante-solido btn-sm mt-auto w-100">Ver Tareas</button>
                    </div>
                </div>

                <!-- 4. Cursos Extracurriculares -->
                <div class="col-md-4 mb-4">
                    <div class="card p-4 text-center border-0 shadow-sm h-100 card-estudiante-limpia"
                         style="border-top: 4px solid #6f42c1 !important; cursor: pointer;"
                         onclick="verCursosExtra()">
                        <i class="bi bi-stars fs-2 mb-2" style="color: #6f42c1;"></i>
                        <h5 style="color: #6f42c1; font-weight: bold;">Cursos Extracurriculares</h5>
                        <p class="small text-muted">Actividades y talleres adicionales.</p>
                        <button class="btn btn-estudiante-solido btn-sm mt-auto w-100">Ver Cursos</button>
                    </div>
                </div>

                <!-- 5. Acciones de Mejora -->
                <div class="col-md-4 mb-4 element-modulo-estudiante">
                    <div class="card p-4 text-center border-0 shadow-sm h-100 card-estudiante-limpia"
                         style="border-top: 4px solid #6f42c1 !important; cursor: pointer;"
                         onclick="verModuloMejoras()">
                        <i class="bi bi-arrow-up-right-circle fs-2 mb-2" style="color: #6f42c1;"></i>
                        <h5 style="color: #6f42c1; font-weight: bold;">Mis Mejoras</h5>
                        <p class="small text-muted">Seguimiento y cumplimiento de tus acciones de mejora.</p>
                        <button class="btn btn-estudiante-solido btn-sm mt-auto w-100">Ver Mejoras</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Módulos Ocultos (Se mantienen sin cambios) -->
        <div id="estudiante-calificaciones" class="d-none">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h3 style="color: #6f42c1;"><i class="bi bi-journal-check me-2"></i>Mis Calificaciones</h3>
                <button class="btn btn-outline-secondary btn-sm" onclick="volverEstudiante()">Volver</button>
            </div>
            <div class="card border-0 shadow-sm p-4">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Asignatura</th>
                            <th>Tarea 1</th>
                            <th>Examen</th>
                            <th>Definitiva</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Matemáticas</td>
                            <td>4.5</td>
                            <td>3.8</td>
                            <td><span class="badge bg-success">4.2</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div id="estudiante-actividades" class="d-none">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h3 style="color: #6f42c1;"><i class="bi bi-list-task me-2"></i>Tareas y Trabajos</h3>
                <button class="btn btn-outline-secondary btn-sm" onclick="volverEstudiante()">Volver</button>
            </div>
            <div class="card border-0 shadow-sm p-4">
                <div class="list-group">
                    <div class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-1">Taller de Álgebra</h6>
                            <small class="text-muted">Fecha límite: 20 de Julio</small>
                        </div>
                        <span class="badge bg-warning text-dark">Pendiente</span>
                    </div>
                </div>
            </div>
        </div>

        <div id="estudiante-cursosextra" class="d-none">
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
                <div>
                    <h3 class="fw-bold mb-0" style="color: #6f42c1;">
                        <i class="bi bi-stars me-2"></i>Cursos Extracurriculares
                    </h3>
                    <p class="text-muted small mb-0">Explora talleres y actividades complementarias, consulta temarios y asegura tu cupo en tiempo real.</p>
                </div>
                <button class="btn btn-outline-secondary btn-sm" onclick="volverEstudiante()" style="border-radius: 8px;">
                    <i class="bi bi-arrow-left me-1"></i> Volver
                </button>
            </div>

            <!-- Navegación por pestañas: Catálogo vs Mis Inscripciones -->
            <ul class="nav nav-pills mb-4" id="pills-tab-extra" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active rounded-pill px-4 fw-bold" id="pills-catalogo-tab" data-bs-toggle="pill" data-bs-target="#pills-catalogo" type="button" role="tab" aria-controls="pills-catalogo" aria-selected="true" style="border: 1px solid #6f42c1;">
                        <i class="bi bi-grid-fill me-2"></i>Catálogo Disponible (@cursosExtraEstudiante.Count(c => c.Activo))
                    </button>
                </li>
                <li class="nav-item ms-2" role="presentation">
                    <button class="nav-link rounded-pill px-4 fw-bold text-dark" id="pills-miscursos-tab" data-bs-toggle="pill" data-bs-target="#pills-miscursos" type="button" role="tab" aria-controls="pills-miscursos" aria-selected="false" style="border: 1px solid #dee2e6;">
                        <i class="bi bi-check2-circle me-2"></i>Mis Cursos Inscritos (@misCursosExtraInscritos.Count)
                    </button>
                </li>
            </ul>

            <div class="tab-content" id="pills-tabContent-extra">
                <!-- PESTAÑA 1: CATÁLOGO DISPONIBLE -->
                <div class="tab-pane fade show active" id="pills-catalogo" role="tabpanel" aria-labelledby="pills-catalogo-tab">
                    @if (!cursosExtraEstudiante.Any(c => c.Activo))
                    {
                        <div class="card border-0 shadow-sm p-5 text-center rounded-4 bg-white">
                            <i class="bi bi-stars text-muted display-4 mb-3"></i>
                            <h5 class="fw-bold text-secondary">No hay cursos extracurriculares abiertos en este momento</h5>
                            <p class="text-muted small mb-0">Los docentes publicarán nuevas actividades y talleres complementarios próximamente. ¡Mantente atento!</p>
                        </div>
                    }
                    else
                    {
                        <div class="row g-3">
                            @foreach (var curso in cursosExtraEstudiante.Where(c => c.Activo))
                            {
                                var pctOcupacion = curso.CuposTotales > 0 ? (int)(((double)(curso.CuposTotales - curso.CuposDisponibles) / curso.CuposTotales) * 100) : 0;
                                var esGradoValido = curso.EsGradoValido(gradoEstudianteSesion);

                                <div class="col-lg-6 mb-3">
                                    <div class="card border-0 shadow-sm rounded-4 h-100 p-3 bg-white card-hover position-relative" style="border-top: 4px solid #6f42c1 !important;">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <h5 class="fw-bold text-dark mb-0" style="color: #4a154b;">@curso.Nombre</h5>
                                            @if (curso.EstaInscrito)
                                            {
                                                <span class="badge bg-success rounded-pill px-3 py-1"><i class="bi bi-check-circle-fill me-1"></i>Inscrito</span>
                                            }
                                            else if (curso.CuposDisponibles <= 0)
                                            {
                                                <span class="badge bg-danger rounded-pill px-3 py-1">Cupos Agotados</span>
                                            }
                                            else if (!curso.PeriodoInscripcionAbierto)
                                            {
                                                <span class="badge bg-secondary rounded-pill px-3 py-1">Inscripciones Cerradas</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-primary rounded-pill px-3 py-1" style="background-color: #6f42c1 !important;">Inscripción Abierta</span>
                                            }
                                        </div>

                                        <p class="text-muted small mb-2">
                                            <i class="bi bi-person-badge text-purple me-1" style="color: #6f42c1;"></i><strong>Docente:</strong> @curso.Instructor
                                            @if (!string.IsNullOrEmpty(curso.Horario))
                                            {
                                                <span class="ms-2"><i class="bi bi-clock-fill text-muted me-1"></i>@curso.Horario</span>
                                            }
                                        </p>

                                        <div class="p-3 rounded-3 mb-3" style="background-color: #f8f5fc; border-left: 3px solid #6f42c1;">
                                            <h6 class="fw-bold small mb-1" style="color: #6f42c1;">
                                                <i class="bi bi-mortarboard-fill me-1"></i>¿Qué vas a aprender?
                                            </h6>
                                            <p class="small text-muted mb-0" style="white-space: pre-line;">@(string.IsNullOrWhiteSpace(curso.Descripcion) ? "Sin descripción detallada." : curso.Descripcion)</p>
                                        </div>

                                        <div class="row g-2 small text-muted mb-3">
                                            <div class="col-6">
                                                <div class="border p-2 rounded-2 bg-light">
                                                    <span class="d-block text-secondary fw-semibold"><i class="bi bi-calendar-event me-1"></i>Inscripciones hasta:</span>
                                                    <span class="fw-bold text-dark">@curso.FechaFinInscripcion.ToString("dd/MM/yyyy")</span>
                                                </div>
                                            </div>
                                            <div class="col-6">
                                                <div class="border p-2 rounded-2 bg-light">
                                                    <span class="d-block text-secondary fw-semibold"><i class="bi bi-calendar-check me-1"></i>Inicio de clases:</span>
                                                    <span class="fw-bold text-dark">@curso.FechaInicio.ToString("dd/MM/yyyy")</span>
                                                </div>
                                            </div>
                                            <div class="col-12">
                                                <div class="border p-2 rounded-2 bg-light d-flex justify-content-between align-items-center">
                                                    <span><i class="bi bi-people me-1" style="color: #6f42c1;"></i>Rango de grados permitidos:</span>
                                                    <span class="badge text-white" style="background-color: #6f42c1;">Grados @(curso.GradoMin ?? 6)° a @(curso.GradoMax ?? 11)°</span>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Barra de cupos disponibles -->
                                        <div class="mb-3">
                                            <div class="d-flex justify-content-between align-items-center small mb-1">
                                                <span class="text-muted fw-semibold">Disponibilidad de cupos:</span>
                                                <span class="fw-bold @(curso.CuposDisponibles > 0 ? "text-success" : "text-danger")">
                                                    @curso.CuposDisponibles de @curso.CuposTotales cupos libres
                                                </span>
                                            </div>
                                            <div class="progress" style="height: 8px;">
                                                <div class="progress-bar @(pctOcupacion >= 100 ? "bg-danger" : (pctOcupacion >= 80 ? "bg-warning" : "bg-success"))" role="progressbar" style="width: @pctOcupacion%;" aria-valuenow="@pctOcupacion" aria-valuemin="0" aria-valuemax="100"></div>
                                            </div>
                                        </div>

                                        <!-- Botones de Acción -->
                                        <div class="d-flex justify-content-between align-items-center pt-2 border-top mt-auto">
                                            @if (curso.EstaInscrito)
                                            {
                                                <div class="d-flex align-items-center gap-2 w-100 justify-content-between">
                                                    <span class="text-success small fw-bold"><i class="bi bi-check-circle me-1"></i>Inscrito el @curso.FechaInscripcionEstudiante?.ToString("dd/MM/yyyy")</span>
                                                    @if (curso.IdInscripcion.HasValue)
                                                    {
                                                        <button class="btn btn-outline-danger btn-sm rounded-pill px-3" onclick="cancelarInscripcionEstudiante(@curso.IdInscripcion.Value, '@curso.Nombre')">
                                                            <i class="bi bi-x-circle me-1"></i> Cancelar Cupo
                                                        </button>
                                                    }
                                                </div>
                                            }
                                            else if (curso.CuposDisponibles <= 0)
                                            {
                                                <button class="btn btn-secondary btn-sm rounded-pill w-100 py-2" disabled>
                                                    <i class="bi bi-slash-circle me-1"></i> Cupos Agotados
                                                </button>
                                            }
                                            else if (!curso.PeriodoInscripcionAbierto)
                                            {
                                                <button class="btn btn-outline-secondary btn-sm rounded-pill w-100 py-2" disabled>
                                                    <i class="bi bi-clock-history me-1"></i> Fuera de periodo de inscripción
                                                </button>
                                            }
                                            else if (!esGradoValido)
                                            {
                                                <button class="btn btn-outline-warning text-dark btn-sm rounded-pill w-100 py-2" disabled>
                                                    <i class="bi bi-exclamation-triangle me-1"></i> No admitido para tu grado actual (@(gradoEstudianteSesion.HasValue ? $"{gradoEstudianteSesion}°" : "-"))
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn text-white btn-sm rounded-pill w-100 py-2 shadow-sm" style="background-color: #6f42c1;" onclick="inscribirseEstudiante(@curso.IdExtraCurso, '@curso.Nombre')">
                                                    <i class="bi bi-pencil-square me-1"></i> Inscribirme a este Curso
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- PESTAÑA 2: MIS CURSOS INSCRITOS -->
                <div class="tab-pane fade" id="pills-miscursos" role="tabpanel" aria-labelledby="pills-miscursos-tab">
                    @if (!misCursosExtraInscritos.Any())
                    {
                        <div class="card border-0 shadow-sm p-5 text-center rounded-4 bg-white">
                            <i class="bi bi-journal-x text-muted display-4 mb-3"></i>
                            <h5 class="fw-bold text-secondary">Aún no estás inscrito en ningún curso extracurricular</h5>
                            <p class="text-muted small mb-4">Revisa el catálogo disponible e inscríbete para aprovechar las actividades extracurriculares de la institución.</p>
                            <div>
                                <button class="btn text-white rounded-pill px-4 py-2 shadow-sm" style="background-color: #6f42c1;" onclick="document.getElementById('pills-catalogo-tab').click();">
                                    <i class="bi bi-search me-1"></i> Ver Catálogo Disponible
                                </button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="row g-3">
                            @foreach (var miCurso in misCursosExtraInscritos)
                            {
                                <div class="col-lg-6 mb-3">
                                    <div class="card border-0 shadow-sm rounded-4 h-100 p-3 bg-white" style="border-left: 5px solid #27ae60 !important;">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <h5 class="fw-bold text-dark mb-0">@miCurso.Nombre</h5>
                                            <span class="badge bg-success rounded-pill px-3 py-1"><i class="bi bi-check-circle me-1"></i>Activo</span>
                                        </div>

                                        <p class="text-muted small mb-2">
                                            <i class="bi bi-person-badge me-1 text-success"></i><strong>Docente:</strong> @miCurso.Instructor
                                            @if (!string.IsNullOrEmpty(miCurso.Horario))
                                            {
                                                <span class="ms-2"><i class="bi bi-clock-fill text-muted me-1"></i>@miCurso.Horario</span>
                                            }
                                        </p>

                                        <div class="p-3 bg-light rounded-3 mb-3">
                                            <h6 class="fw-bold text-secondary small mb-1"><i class="bi bi-info-circle me-1"></i>Temario:</h6>
                                            <p class="small text-muted mb-0">@(string.IsNullOrWhiteSpace(miCurso.Descripcion) ? "Sin descripción." : miCurso.Descripcion)</p>
                                        </div>

                                        <div class="row g-2 small text-muted mb-3">
                                            <div class="col-6">
                                                <div class="border p-2 rounded-2 bg-white">
                                                    <span class="d-block text-secondary fw-semibold">Fecha de Inscripción:</span>
                                                    <span class="fw-bold text-dark">@miCurso.FechaInscripcionEstudiante?.ToString("dd/MM/yyyy")</span>
                                                </div>
                                            </div>
                                            <div class="col-6">
                                                <div class="border p-2 rounded-2 bg-white">
                                                    <span class="d-block text-secondary fw-semibold">Periodo de Clases:</span>
                                                    <span class="fw-bold text-dark">@miCurso.FechaInicio.ToString("dd/MM/yyyy") - @miCurso.FechaFin.ToString("dd/MM/yyyy")</span>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="d-flex justify-content-between align-items-center pt-2 border-top mt-auto">
                                            <span class="text-success small fw-semibold"><i class="bi bi-shield-check me-1"></i>Cupo asegurado</span>
                                            @if (miCurso.IdInscripcion.HasValue)
                                            {
                                                <button class="btn btn-outline-danger btn-sm rounded-pill px-3" onclick="cancelarInscripcionEstudiante(@miCurso.IdInscripcion.Value, '@miCurso.Nombre')">
                                                    <i class="bi bi-x-circle me-1"></i> Cancelar Inscripción
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <div id="estudiante-mejoras" class="d-none">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h3 style="color: #6f42c1; font-weight: bold;">
                    <i class="bi bi-arrow-up-right-circle me-2"></i> Mis Acciones de Mejora
                </h3>
                <a href="@Url.Action("Dashboard", "Home")" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                    <i class="bi bi-arrow-left me-1"></i> Volver
                </a>
            </div>

            <div class="card border-0 shadow-sm p-4" style="border-radius: 15px;">
                <h5 class="fw-bold mb-3 text-muted">Historial de Compromisos Académicos</h5>
                <p class="small text-muted">Aquí aparecerán tus actividades de refuerzo asignadas por los docentes.</p>

                <div class="mt-3">
                    <button class="btn btn-sm text-white" style="background-color: #6f42c1; border-radius: 8px;"
                            onclick="abrirCuadroTexto(1, 'Estudiante', 'Reforzamiento de Álgebra')">
                        <i class="bi bi-chat-left-text me-2"></i> Registrar Avance
                    </button>
                </div>
            </div>
        </div>
    </div>


    <div class="modal fade" id="modalCalificaciones" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title"><i class="bi bi-journal-text me-2"></i>Boletín de Calificaciones</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Materia</th>
                                    <th>Tipo</th>
                                    <th>Fecha</th>
                                    <th class="text-center">Nota</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (ViewBag.DetalleNotas != null)
                                {
                                    foreach (var nota in (List<ProyectoPAE.Models.Evaluacion>)ViewBag.DetalleNotas)
                                    {
                                        <tr>
                                            <td>@(nota.id_materia == 1 ? "Matemáticas" : nota.id_materia == 2 ? "Español" : "Otras")</td>
                                            <td>@nota.tipo_evaluacion</td>
                                            <td>@nota.fecha_evaluacion.ToShortDateString()</td>
                                            <td class="text-center fw-bold @(nota.nota < 3 ? "text-danger" : "text-success")">@nota.nota</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr><td colspan="4" class="text-center text-muted">No hay notas registradas.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modalAsistencia" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title"><i class="bi bi-calendar-check me-2"></i>Detalle de Asistencia</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-center">
                    <h3 class="display-4 text-danger">@ViewBag.FallasRapidas</h3>
                    <p class="text-muted">Fallas totales en el periodo actual</p>
                    <hr>
                    <p class="small text-start text-muted italic">Próximamente: Listado detallado de fechas e inasistencias.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modalCitaciones" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title"><i class="bi bi-envelope-paper me-2"></i>Buzón de Citaciones</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="listaCitaciones">
                        @if (ViewBag.ListaCitaciones != null && ((List<ProyectoPAE.Models.Citacion>)ViewBag.ListaCitaciones).Any())
                        {
                            foreach (var cita in (List<ProyectoPAE.Models.Citacion>)ViewBag.ListaCitaciones)
                            {
                                <div class="alert alert-light border shadow-sm mb-3">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <h6 class="fw-bold text-success mb-1">@cita.asunto</h6>
                                        <span class="badge bg-secondary">@cita.fecha.ToShortDateString()</span>
                                    </div>
                                    <p class="mb-2 text-dark" style="font-size: 0.9rem;">@cita.mensaje</p>
                                    <div class="border-top pt-2 mt-1">
                                        <small class="text-muted"><strong>Remitente:</strong> @cita.remitente</small>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center py-4">
                                <i class="bi bi-chat-left-x fs-1 text-muted"></i>
                                <p class="text-muted mt-2">No tienes citaciones o mensajes pendientes.</p>
                            </div>
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    /**
     * Oculta todos los paneles y subsecciones de la interfaz SPA.
     */
    function ocultarTodo() {
        const subs = [
            'admin-main', 'admin-matricula', 'admin-usuarios', 'admin-certificados', 'admin-notificaciones', 'admin-asignacion', 'admin-reportes',
            'docente-main', 'docente-planilla', 'docente-asistencia', 'docente-observaciones', 'docente-mejoras', 'docente-cursosextra',
            'estudiante-main', 'estudiante-calificaciones', 'estudiante-actividades', 'estudiante-cursosextra', 'estudiante-mejoras'
        ];

        const panelesPrincipales = [
            'panel-admin', 'panel-docente', 'panel-estudiante', 'panel-acudiente'
        ];

        subs.forEach(id => {
            const el = document.getElementById(id);
            if (el) el.classList.add('d-none');
        });

        panelesPrincipales.forEach(id => {
            const p = document.getElementById(id);
            if (p) p.classList.add('d-none');
        });
    }

    /**
     * Cambia la vista activa según el selector o el rol enviado.
     */
    function switchRole() {
        const selector = document.getElementById('roleSelector');
        const inputRol = document.getElementById('rolOculto');

        let role = '';

        if (selector && selector.value) {
            role = selector.value.toLowerCase().trim();
        } else if (inputRol && inputRol.value) {
            role = inputRol.value.toLowerCase().trim();
        }

        if (!role) return;

        if (role === 'administrador') {
            role = 'admin';
        } else if (role === 'padre') {
            role = 'acudiente';
        } else if (role === 'profesor') {
            role = 'docente';
        }

        ocultarTodo();

        const panel = document.getElementById('panel-' + role);
        if (panel) {
            panel.classList.remove('d-none');

            const subMain = document.getElementById(role + '-main');
            if (subMain) subMain.classList.remove('d-none');
        }
    }

    // --- FUNCIONES DE NAVEGACIÓN ADMINISTRADOR ---
    function verMatricula() { ocultarTodo(); mostrarSubpanel('panel-admin', 'admin-matricula'); }
    function verCertificados() { ocultarTodo(); mostrarSubpanel('panel-admin', 'admin-certificados'); }
    function verNotificaciones() { ocultarTodo(); mostrarSubpanel('panel-admin', 'admin-notificaciones'); }
    function verAsignacion() { ocultarTodo(); mostrarSubpanel('panel-admin', 'admin-asignacion'); }
    function verReportes() { ocultarTodo(); mostrarSubpanel('panel-admin', 'admin-reportes'); }
    function volverAdmin() { ocultarTodo(); mostrarSubpanel('panel-admin', 'admin-main'); }

    // --- FUNCIONES DE NAVEGACIÓN DOCENTE ---
    function verPlanilla() { ocultarTodo(); mostrarSubpanel('panel-docente', 'docente-planilla'); }
    function verAsistencia() { ocultarTodo(); mostrarSubpanel('panel-docente', 'docente-asistencia'); }
