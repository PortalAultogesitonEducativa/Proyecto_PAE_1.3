                        <i class="bi bi-list-task me-2"></i>Mis Tareas y Actividades Académicas
                    </h3>
                    <p class="text-muted small mb-0">Consulta tus tareas pendientes, descarga guías docentes, sube tus trabajos y revisa tus calificaciones y comentarios.</p>
                </div>
                <div class="d-flex gap-2 align-items-center">
                    <button class="btn btn-outline-secondary btn-sm" onclick="volverEstudiante()" style="border-radius: 8px;">
                        <i class="bi bi-arrow-left me-1"></i> Volver al Menú
                    </button>
                </div>
            </div>

            <!-- 1. Filtro por Materia / Asignatura (Organización por Materias - Moodle LMS Style) -->
            <div class="card border-0 shadow-sm p-3 mb-4 rounded-3 bg-white" style="border-left: 4px solid #6f42c1 !important;">
                <label class="form-label small fw-bold text-dark mb-2"><i class="bi bi-book-half text-purple me-1" style="color: #6f42c1;"></i>Filtrar por Asignatura / Materia:</label>
                <div class="d-flex flex-wrap gap-2" id="contenedorFiltrosMaterias">
                    <button class="btn btn-sm btn-outline-purple active rounded-pill px-3 filtro-materia-btn" onclick="filtrarActividadesPorMateria('todas', this)" style="border-color: #6f42c1; color: #6f42c1;">
                        <i class="bi bi-grid-fill me-1"></i> Todas las Materias
                    </button>
                    @if (ViewBag.MateriasEstudiante != null)
                    {
                        foreach (var mat in (IEnumerable<string>)ViewBag.MateriasEstudiante)
                        {
                            <button class="btn btn-sm btn-outline-secondary rounded-pill px-3 filtro-materia-btn" onclick="filtrarActividadesPorMateria('@mat', this)">
                                @mat
                            </button>
                        }
                    }
                </div>
            </div>

            <!-- 2. Filtros Rápidos por Estado -->
            <div class="d-flex flex-wrap gap-2 mb-4">
                <button class="btn btn-sm btn-outline-primary active rounded-pill px-3 filtro-act-btn" onclick="filtrarActividadesEstudiante('todas', this)">
                    Todas las Actividades
                </button>
                <button class="btn btn-sm btn-outline-warning rounded-pill px-3 filtro-act-btn" onclick="filtrarActividadesEstudiante('Pendiente', this)">
                    <i class="bi bi-clock me-1"></i> Pendientes
                </button>
                <button class="btn btn-sm btn-outline-info rounded-pill px-3 filtro-act-btn" onclick="filtrarActividadesEstudiante('Entregado', this)">
                    <i class="bi bi-send-check me-1"></i> Entregadas
                </button>
                <button class="btn btn-sm btn-outline-success rounded-pill px-3 filtro-act-btn" onclick="filtrarActividadesEstudiante('Calificado', this)">
                    <i class="bi bi-check-circle me-1"></i> Calificadas
                </button>
            </div>

            <!-- Contenedor dinámico de actividades -->
            <div id="contenedorActividadesEstudiante" class="row g-3">
                <div class="col-12 text-center py-5">
                    <div class="spinner-border" style="color: #6f42c1;" role="status"></div>
                    <p class="text-muted small mt-2">Cargando tus actividades académicas...</p>
                </div>
            </div>
        </div>

        <!-- MODAL: SUBIR ENTREGA DE ACTIVIDAD (ESTUDIANTE - ESTILO LMS / MOODLE) -->
        <div class="modal fade" id="modalSubirEntregaActividad" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
                    <div class="modal-header text-white" style="background: linear-gradient(135deg, #3b0764 0%, #6f42c1 100%); border-radius: 16px 16px 0 0;">
                        <div>
                            <h5 class="modal-title fw-bold"><i class="bi bi-cloud-arrow-up me-2"></i>Entregar Actividad Académica</h5>
                            <small class="opacity-75" id="subtituloModalSubirEntrega">Envío institucional - Respuesta en línea y archivos adjuntos</small>
                        </div>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <form id="formSubirEntregaActividad" onsubmit="guardarEntregaEstudiante(event)">
                        <input type="hidden" id="idActividadEntrega" name="idActividad" />
                        <div class="modal-body p-4">
                            <!-- Datos de la Actividad -->
                            <div class="p-3 rounded-3 mb-4 bg-light border">
                                <h6 class="fw-bold mb-1" id="entregaTituloActividad" style="color: #6f42c1;">Título de la Actividad</h6>
                                <div class="d-flex flex-wrap gap-3 small text-muted">
                                    <span><i class="bi bi-book me-1 text-primary"></i>Materia: <strong id="entregaMateriaActividad">Materia</strong></span>
                                    <span><i class="bi bi-calendar-event me-1 text-danger"></i>Fecha Límite: <strong id="entregaFechaLimiteActividad">--</strong></span>
                                </div>
                            </div>

                            <!-- SECCIÓN 1: TEXTO EN LÍNEA / RESPUESTA (LMS STYLE) -->
                            <div class="mb-4">
                                <label class="form-label fw-bold small text-dark"><i class="bi bi-chat-left-text-fill text-purple me-1" style="color: #6f42c1;"></i>1. Texto en Línea / Respuesta Escrita (Opcional)</label>
                                <textarea id="inputComentarioEntrega" name="comentario" class="form-control" rows="4" placeholder="Escribe aquí tu respuesta directa, enlaces web (Google Drive, Canva, GitHub) o comentarios para el docente..."></textarea>
                                <small class="text-muted" style="font-size: 0.75rem;">Puedes redactar tu síntesis o pegar enlaces complementarios directamente.</small>
                            </div>

                            <!-- SECCIÓN 2: ARCHIVO ADJUNTO (LMS DROPZONE STYLE - MÁX 5 MB) -->
                            <div class="mb-3">
                                <label class="form-label fw-bold small text-dark"><i class="bi bi-paperclip me-1 text-primary"></i>2. Archivo Adjunto de Trabajo (Máx. 5 MB)</label>
                                <div class="p-3 border rounded-3 bg-light text-center" style="border: 2px dashed #6f42c1 !important;">
                                    <i class="bi bi-cloud-arrow-up display-6 text-muted mb-2 d-block"></i>
                                    <input type="file" id="inputArchivoEntrega" name="archivo" class="form-control" accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.zip,.rar,.png,.jpg,.jpeg" onchange="validarTamanoArchivoEntrega(this)" />
                                    <div class="d-flex justify-content-between align-items-center mt-2 px-1">
                                        <small class="text-muted" style="font-size: 0.75rem;">Formatos: PDF, Word, Excel, PowerPoint, ZIP, JPG, PNG</small>
                                        <span class="badge bg-warning text-dark"><i class="bi bi-exclamation-triangle-fill me-1"></i>Límite: 5 MB</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer bg-light" style="border-radius: 0 0 16px 16px;">
                            <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancelar</button>
                            <button type="submit" class="btn text-white rounded-pill px-4 shadow-sm" style="background-color: #6f42c1;" id="btnEnviarEntrega">
                                <i class="bi bi-send me-1"></i> Guardar y Enviar Entrega
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div id="estudiante-cursosextra" class="d-none">
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
                <div>
                    <h3 class="fw-bold mb-0" style="color: #6f42c1;">
                        <i class="bi bi-stars me-2"></i>Cursos Extracurriculares
                    </h3>
                    <p class="text-muted small mb-0">Explora talleres y actividades complementarias, consulta temarios y asegura tu cupo en tiempo real.</p>
                </div>
                <button class="btn btn-outline-secondary btn-sm" onclick="volverEstudiante()" style="border-radius: 8px;">
                    <i class="bi bi-arrow-left me-1"></i> Volver
                </button>
            </div>

            <!-- Navegación por pestañas: Catálogo vs Mis Inscripciones -->
            <ul class="nav nav-pills mb-4" id="pills-tab-extra" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active rounded-pill px-4 fw-bold" id="pills-catalogo-tab" data-bs-toggle="pill" data-bs-target="#pills-catalogo" type="button" role="tab" aria-controls="pills-catalogo" aria-selected="true" style="border: 1px solid #6f42c1;">
                        <i class="bi bi-grid-fill me-2"></i>Catálogo Disponible (@cursosExtraEstudiante.Count(c => c.Activo))
                    </button>
                </li>
                <li class="nav-item ms-2" role="presentation">
                    <button class="nav-link rounded-pill px-4 fw-bold text-dark" id="pills-miscursos-tab" data-bs-toggle="pill" data-bs-target="#pills-miscursos" type="button" role="tab" aria-controls="pills-miscursos" aria-selected="false" style="border: 1px solid #dee2e6;">
                        <i class="bi bi-check2-circle me-2"></i>Mis Cursos Inscritos (@misCursosExtraInscritos.Count)
                    </button>
                </li>
            </ul>

            <div class="tab-content" id="pills-tabContent-extra">
                <!-- PESTAÑA 1: CATÁLOGO DISPONIBLE -->
                <div class="tab-pane fade show active" id="pills-catalogo" role="tabpanel" aria-labelledby="pills-catalogo-tab">
                    @if (!cursosExtraEstudiante.Any(c => c.Activo))
                    {
                        <div class="card border-0 shadow-sm p-5 text-center rounded-4 bg-white">
                            <i class="bi bi-stars text-muted display-4 mb-3"></i>
                            <h5 class="fw-bold text-secondary">No hay cursos extracurriculares abiertos en este momento</h5>
                            <p class="text-muted small mb-0">Los docentes publicarán nuevas actividades y talleres complementarios próximamente. ¡Mantente atento!</p>
                        </div>
                    }
                    else
                    {
                        <div class="row g-3">
                            @foreach (var curso in cursosExtraEstudiante.Where(c => c.Activo))
                            {
                                var pctOcupacion = curso.CuposTotales > 0 ? (int)(((double)(curso.CuposTotales - curso.CuposDisponibles) / curso.CuposTotales) * 100) : 0;
                                var esGradoValido = curso.EsGradoValido(gradoEstudianteSesion);

                                <div class="col-lg-6 mb-3">
                                    <div class="card border-0 shadow-sm rounded-4 h-100 p-3 bg-white card-hover position-relative" style="border-top: 4px solid #6f42c1 !important;">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <h5 class="fw-bold text-dark mb-0" style="color: #4a154b;">@curso.Nombre</h5>
                                            @if (curso.EstaInscrito)
                                            {
                                                <span class="badge bg-success rounded-pill px-3 py-1"><i class="bi bi-check-circle-fill me-1"></i>Inscrito</span>
                                            }
                                            else if (curso.CuposDisponibles <= 0)
                                            {
                                                <span class="badge bg-danger rounded-pill px-3 py-1">Cupos Agotados</span>
                                            }
                                            else if (!curso.PeriodoInscripcionAbierto)
                                            {
                                                <span class="badge bg-secondary rounded-pill px-3 py-1">Inscripciones Cerradas</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-primary rounded-pill px-3 py-1" style="background-color: #6f42c1 !important;">Inscripción Abierta</span>
                                            }
                                        </div>

                                        <p class="text-muted small mb-2">
                                            <i class="bi bi-person-badge text-purple me-1" style="color: #6f42c1;"></i><strong>Docente:</strong> @curso.Instructor
                                            @if (!string.IsNullOrEmpty(curso.Horario))
                                            {
                                                <span class="ms-2"><i class="bi bi-clock-fill text-muted me-1"></i>@curso.Horario</span>
                                            }
                                        </p>

                                        <div class="p-3 rounded-3 mb-3" style="background-color: #f8f5fc; border-left: 3px solid #6f42c1;">
                                            <h6 class="fw-bold small mb-1" style="color: #6f42c1;">
                                                <i class="bi bi-mortarboard-fill me-1"></i>¿Qué vas a aprender?
                                            </h6>
                                            <p class="small text-muted mb-0" style="white-space: pre-line;">@(string.IsNullOrWhiteSpace(curso.Descripcion) ? "Sin descripción detallada." : curso.Descripcion)</p>
                                        </div>

                                        <div class="row g-2 small text-muted mb-3">
                                            <div class="col-6">
                                                <div class="border p-2 rounded-2 bg-light">
                                                    <span class="d-block text-secondary fw-semibold"><i class="bi bi-calendar-event me-1"></i>Inscripciones hasta:</span>
                                                    <span class="fw-bold text-dark">@curso.FechaFinInscripcion.ToString("dd/MM/yyyy")</span>
                                                </div>
                                            </div>
                                            <div class="col-6">
                                                <div class="border p-2 rounded-2 bg-light">
                                                    <span class="d-block text-secondary fw-semibold"><i class="bi bi-calendar-check me-1"></i>Inicio de clases:</span>
                                                    <span class="fw-bold text-dark">@curso.FechaInicio.ToString("dd/MM/yyyy")</span>
                                                </div>
                                            </div>
                                            <div class="col-12">
                                                <div class="border p-2 rounded-2 bg-light d-flex justify-content-between align-items-center">
                                                    <span><i class="bi bi-people me-1" style="color: #6f42c1;"></i>Rango de grados permitidos:</span>
                                                    <span class="badge text-white" style="background-color: #6f42c1;">Grados @(curso.GradoMin ?? 6)° a @(curso.GradoMax ?? 11)°</span>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Barra de cupos disponibles -->
                                        <div class="mb-3">
                                            <div class="d-flex justify-content-between align-items-center small mb-1">
                                                <span class="text-muted fw-semibold">Disponibilidad de cupos:</span>
                                                <span class="fw-bold @(curso.CuposDisponibles > 0 ? "text-success" : "text-danger")">
                                                    @curso.CuposDisponibles de @curso.CuposTotales cupos libres
                                                </span>
                                            </div>
                                            <div class="progress" style="height: 8px;">
                                                <div class="progress-bar @(pctOcupacion >= 100 ? "bg-danger" : (pctOcupacion >= 80 ? "bg-warning" : "bg-success"))" role="progressbar" style="width: @pctOcupacion%;" aria-valuenow="@pctOcupacion" aria-valuemin="0" aria-valuemax="100"></div>
                                            </div>
                                        </div>

                                        <!-- Botones de Acción -->
                                        <div class="d-flex justify-content-between align-items-center pt-2 border-top mt-auto">
                                            @if (curso.EstaInscrito)
                                            {
                                                <div class="d-flex align-items-center gap-2 w-100 justify-content-between">
                                                    <span class="text-success small fw-bold"><i class="bi bi-check-circle me-1"></i>Inscrito el @curso.FechaInscripcionEstudiante?.ToString("dd/MM/yyyy")</span>
                                                    @if (curso.IdInscripcion.HasValue)
                                                    {
                                                        <button class="btn btn-outline-danger btn-sm rounded-pill px-3" onclick="cancelarInscripcionEstudiante(@curso.IdInscripcion.Value, '@curso.Nombre')">
                                                            <i class="bi bi-x-circle me-1"></i> Cancelar Cupo
                                                        </button>
                                                    }
                                                </div>
                                            }
                                            else if (curso.CuposDisponibles <= 0)
                                            {
                                                <button class="btn btn-secondary btn-sm rounded-pill w-100 py-2" disabled>
                                                    <i class="bi bi-slash-circle me-1"></i> Cupos Agotados
                                                </button>
                                            }
                                            else if (!curso.PeriodoInscripcionAbierto)
                                            {
                                                <button class="btn btn-outline-secondary btn-sm rounded-pill w-100 py-2" disabled>
                                                    <i class="bi bi-clock-history me-1"></i> Fuera de periodo de inscripción
                                                </button>
                                            }
                                            else if (!esGradoValido)
                                            {
                                                <button class="btn btn-outline-warning text-dark btn-sm rounded-pill w-100 py-2" disabled>
                                                    <i class="bi bi-exclamation-triangle me-1"></i> No admitido para tu grado actual (@(gradoEstudianteSesion.HasValue ? $"{gradoEstudianteSesion}°" : "-"))
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn text-white btn-sm rounded-pill w-100 py-2 shadow-sm" style="background-color: #6f42c1;" onclick="inscribirseEstudiante(@curso.IdExtraCurso, '@curso.Nombre')">
                                                    <i class="bi bi-pencil-square me-1"></i> Inscribirme a este Curso
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- PESTAÑA 2: MIS CURSOS INSCRITOS -->
                <div class="tab-pane fade" id="pills-miscursos" role="tabpanel" aria-labelledby="pills-miscursos-tab">
                    @if (!misCursosExtraInscritos.Any())
                    {
                        <div class="card border-0 shadow-sm p-5 text-center rounded-4 bg-white">
                            <i class="bi bi-journal-x text-muted display-4 mb-3"></i>
                            <h5 class="fw-bold text-secondary">Aún no estás inscrito en ningún curso extracurricular</h5>
                            <p class="text-muted small mb-4">Revisa el catálogo disponible e inscríbete para aprovechar las actividades extracurriculares de la institución.</p>
                            <div>
                                <button class="btn text-white rounded-pill px-4 py-2 shadow-sm" style="background-color: #6f42c1;" onclick="document.getElementById('pills-catalogo-tab').click();">
                                    <i class="bi bi-search me-1"></i> Ver Catálogo Disponible
                                </button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="row g-3">
                            @foreach (var miCurso in misCursosExtraInscritos)
                            {
                                <div class="col-lg-6 mb-3">
                                    <div class="card border-0 shadow-sm rounded-4 h-100 p-3 bg-white" style="border-left: 5px solid #27ae60 !important;">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <h5 class="fw-bold text-dark mb-0">@miCurso.Nombre</h5>
                                            <span class="badge bg-success rounded-pill px-3 py-1"><i class="bi bi-check-circle me-1"></i>Activo</span>
                                        </div>

                                        <p class="text-muted small mb-2">
                                            <i class="bi bi-person-badge me-1 text-success"></i><strong>Docente:</strong> @miCurso.Instructor
                                            @if (!string.IsNullOrEmpty(miCurso.Horario))
                                            {
                                                <span class="ms-2"><i class="bi bi-clock-fill text-muted me-1"></i>@miCurso.Horario</span>
                                            }
                                        </p>

                                        <div class="p-3 bg-light rounded-3 mb-3">
                                            <h6 class="fw-bold text-secondary small mb-1"><i class="bi bi-info-circle me-1"></i>Temario:</h6>
                                            <p class="small text-muted mb-0">@(string.IsNullOrWhiteSpace(miCurso.Descripcion) ? "Sin descripción." : miCurso.Descripcion)</p>
                                        </div>

                                        <div class="row g-2 small text-muted mb-3">
                                            <div class="col-6">
                                                <div class="border p-2 rounded-2 bg-white">
                                                    <span class="d-block text-secondary fw-semibold">Fecha de Inscripción:</span>
                                                    <span class="fw-bold text-dark">@miCurso.FechaInscripcionEstudiante?.ToString("dd/MM/yyyy")</span>
                                                </div>
                                            </div>
                                            <div class="col-6">
                                                <div class="border p-2 rounded-2 bg-white">
                                                    <span class="d-block text-secondary fw-semibold">Periodo de Clases:</span>
                                                    <span class="fw-bold text-dark">@miCurso.FechaInicio.ToString("dd/MM/yyyy") - @miCurso.FechaFin.ToString("dd/MM/yyyy")</span>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- SECCIÓN: COLA DE DOCUMENTOS REQUERIDOS PARA EL ESTUDIANTE -->
                                        <div class="p-3 rounded-3 mb-3 border bg-light">
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <h6 class="fw-bold text-dark mb-0 small"><i class="bi bi-folder-symlink-fill text-primary me-1"></i>Documentos de Inscripción (Máx 5 MB)</h6>
                                                <span class="badge bg-secondary" style="font-size: 0.72rem;">Requisitos Obligatorios</span>
                                            </div>

                                            @if (miCurso.DocumentosRequeridosLista != null && miCurso.DocumentosRequeridosLista.Any())
                                            {
                                                <div class="d-flex flex-column gap-2">
                                                    @foreach (var docNombre in miCurso.DocumentosRequeridosLista)
                                                    {
                                                        var subido = miCurso.DocumentosSubidos != null ? miCurso.DocumentosSubidos.FirstOrDefault(d => d.TipoDocumento == docNombre) : null;
                                                        var estaCargado = subido != null && !string.IsNullOrEmpty(subido.RutaArchivo);

                                                        <div class="p-2 bg-white rounded-2 border d-flex flex-wrap justify-content-between align-items-center gap-2">
                                                            <div class="d-flex align-items-center gap-2">
                                                                <i class="bi @(estaCargado ? "bi-check-circle-fill text-success" : "bi-file-earmark-arrow-up text-warning") fs-6"></i>
                                                                <div>
                                                                    <span class="d-block small fw-bold text-dark" style="font-size: 0.8rem;">@docNombre</span>
                                                                    @if (estaCargado)
                                                                    {
                                                                        <small class="text-muted" style="font-size: 0.72rem;">Cargado el @subido!.FechaSubida.ToString("dd/MM/yyyy HH:mm")</small>
                                                                    }
                                                                    else
                                                                    {
                                                                        <small class="text-danger" style="font-size: 0.72rem;">Pendiente por adjuntar</small>
                                                                    }
                                                                </div>
                                                            </div>

                                                            <div class="d-flex align-items-center gap-1">
                                                                @if (estaCargado)
                                                                {
                                                                    <a href="@subido!.RutaArchivo" target="_blank" class="btn btn-sm btn-outline-success rounded-pill px-2 py-0" style="font-size: 0.75rem;" title="Ver archivo cargado">
                                                                        <i class="bi bi-eye"></i> Ver
                                                                    </a>
                                                                    <label class="btn btn-sm btn-outline-secondary rounded-pill px-2 py-0 mb-0" style="font-size: 0.75rem; cursor: pointer;" title="Reemplazar archivo">
                                                                        <i class="bi bi-arrow-repeat"></i>
                                                                        <input type="file" class="d-none" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png" onchange="subirDocumentoEstudianteExtra(@miCurso.IdInscripcion, '@docNombre', this)" />
                                                                    </label>
                                                                }
                                                                else
                                                                {
                                                                    <label class="btn btn-sm btn-primary rounded-pill px-3 py-1 mb-0 shadow-sm" style="font-size: 0.75rem; cursor: pointer; background-color: #6f42c1; border-color: #6f42c1;">
                                                                        <i class="bi bi-upload me-1"></i> Adjuntar
                                                                        <input type="file" class="d-none" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png" onchange="subirDocumentoEstudianteExtra(@miCurso.IdInscripcion, '@docNombre', this)" />
                                                                    </label>
                                                                }
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <small class="text-muted fst-italic">Este curso no requiere entrega de documentos adicionales.</small>
                                            }
                                        </div>

                                        <div class="d-flex justify-content-between align-items-center pt-2 border-top mt-auto">
                                            <span class="text-success small fw-semibold"><i class="bi bi-shield-check me-1"></i>Cupo asegurado</span>
                                            @if (miCurso.IdInscripcion.HasValue)
                                            {
                                                <button class="btn btn-outline-danger btn-sm rounded-pill px-3" onclick="cancelarInscripcionEstudiante(@miCurso.IdInscripcion.Value, '@miCurso.Nombre')">
                                                    <i class="bi bi-x-circle me-1"></i> Cancelar Inscripción
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <div id="estudiante-mejoras" class="d-none">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h3 style="color: #6f42c1; font-weight: bold;">
                    <i class="bi bi-arrow-up-right-circle me-2"></i> Mis Acciones de Mejora
                </h3>
                <a href="@Url.Action("Dashboard", "Home")" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                    <i class="bi bi-arrow-left me-1"></i> Volver
                </a>
            </div>

            <div class="card border-0 shadow-sm p-4" style="border-radius: 15px;">
                <h5 class="fw-bold mb-3 text-muted">Historial de Compromisos Académicos</h5>
                <p class="small text-muted">Aquí aparecerán tus actividades de refuerzo asignadas por los docentes.</p>

                <div class="mt-3">
                    <button class="btn btn-sm text-white" style="background-color: #6f42c1; border-radius: 8px;"
                            onclick="abrirCuadroTexto(1, 'Estudiante', 'Reforzamiento de Álgebra')">
                        <i class="bi bi-chat-left-text me-2"></i> Registrar Avance
                    </button>
                </div>
            </div>
        </div>
    </div>


    <div class="modal fade" id="modalCalificaciones" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title"><i class="bi bi-journal-text me-2"></i>Boletín de Calificaciones</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Materia</th>
                                    <th>Tipo</th>
                                    <th>Fecha</th>
                                    <th class="text-center">Nota</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (ViewBag.DetalleNotas != null)
                                {
                                    foreach (var nota in (List<ProyectoPAE.Models.Evaluacion>)ViewBag.DetalleNotas)
                                    {
                                        <tr>
                                            <td>@(nota.id_materia == 1 ? "Matemáticas" : nota.id_materia == 2 ? "Español" : "Otras")</td>
                                            <td>@nota.tipo_evaluacion</td>
                                            <td>@nota.fecha_evaluacion.ToShortDateString()</td>
                                            <td class="text-center fw-bold @(nota.nota < 3 ? "text-danger" : "text-success")">@nota.nota</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr><td colspan="4" class="text-center text-muted">No hay notas registradas.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modalAsistencia" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title"><i class="bi bi-calendar-check me-2"></i>Historial de Asistencia del Estudiante</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <!-- Resumen KPIs -->
                    <div class="row g-3 mb-4 text-center">
                        <div class="col-4">
                            <div class="p-3 bg-success-subtle rounded border border-success-subtle">
                                <span class="d-block small text-success fw-bold">PRESENTES</span>
                                <h4 class="fw-bold mb-0 text-success" id="kpiPresentesModal">@(ViewBag.PresentesRapidos ?? 0)</h4>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-3 bg-danger-subtle rounded border border-danger-subtle">
                                <span class="d-block small text-danger fw-bold">FALLAS</span>
                                <h4 class="fw-bold mb-0 text-danger" id="kpiFallasModal">@(ViewBag.FallasRapidas ?? 0)</h4>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-3 bg-warning-subtle rounded border border-warning-subtle">
                                <span class="d-block small text-warning-emphasis fw-bold">RETARDOS</span>
                                <h4 class="fw-bold mb-0 text-warning-emphasis" id="kpiRetardosModal">@(ViewBag.RetardosRapidos ?? 0)</h4>
                            </div>
                        </div>
                    </div>

                    <h6 class="fw-bold text-dark mb-3"><i class="bi bi-list-check me-1 text-success"></i>Registro detallado de asistencias</h6>
                    <div class="table-responsive border rounded" style="max-height: 320px; overflow-y: auto;">
                        <table class="table table-hover align-middle mb-0" id="tablaAsistenciaModal">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th>Fecha</th>
                                    <th>Estado</th>
                                    <th>Observación / Justificación</th>
                                </tr>
                            </thead>
                            <tbody id="tbodyAsistenciasModal">
                                @if (ViewBag.ListaAsistencias != null && ((List<ProyectoPAE.Models.Asistencia>)ViewBag.ListaAsistencias).Any())
                                {
                                    foreach (var a in (List<ProyectoPAE.Models.Asistencia>)ViewBag.ListaAsistencias)
                                    {
                                        string est = a.estado?.ToLower() ?? "";
                                        string badgeClass = est.Contains("falla") || est == "f" ? "bg-danger text-white" : (est.Contains("retardo") || est == "r" ? "bg-warning text-dark" : "bg-success text-white");
                                        string textoEstado = est.Contains("falla") || est == "f" ? "Falla" : (est.Contains("retardo") || est == "r" ? "Retardo" : "Presente");
                                        <tr>
                                            <td>@a.fecha.ToString("dd/MM/yyyy")</td>
                                            <td><span class="badge @badgeClass">@textoEstado</span></td>
                                            <td>@(string.IsNullOrWhiteSpace(a.justificacion) ? "-" : a.justificacion)</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr id="sinAsistenciasRow">
                                        <td colspan="3" class="text-center text-muted py-4">No hay registros de asistencia para este estudiante.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modalCitaciones" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title"><i class="bi bi-envelope-paper me-2"></i>Buzón de Citaciones</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div id="listaCitaciones" style="max-height: 400px; overflow-y: auto;">
                        @if (ViewBag.ListaCitaciones != null && ((List<ProyectoPAE.Models.Citacion>)ViewBag.ListaCitaciones).Any())
                        {
                            foreach (var cita in (List<ProyectoPAE.Models.Citacion>)ViewBag.ListaCitaciones)
                            {
                                <div class="card border-0 shadow-sm mb-3 bg-light" style="border-left: 4px solid #27ae60 !important;">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <h6 class="fw-bold text-success mb-0">@cita.asunto</h6>
                                            <span class="badge bg-secondary">@cita.fecha.ToString("dd/MM/yyyy")</span>
                                        </div>
                                        <p class="mb-2 text-dark" style="font-size: 0.95rem;">@cita.mensaje</p>
                                        <div class="border-top pt-2 mt-2">
                                            <small class="text-muted"><i class="bi bi-person-circle me-1"></i><strong>Remitente:</strong> @cita.remitente</small>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center py-4" id="sinCitacionesMsg">
                                <i class="bi bi-chat-left-x fs-1 text-muted"></i>
                                <p class="text-muted mt-2">No tienes citaciones o mensajes pendientes para este estudiante.</p>
                            </div>
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modalObservadorAcudiente" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title"><i class="bi bi-eye-fill me-2"></i>Observador del Alumno (Convivencia y Disciplina)</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div id="listaObservacionesHijo" style="max-height: 400px; overflow-y: auto;">
                        @if (ViewBag.ListaObservaciones != null && ((List<ProyectoPAE.Models.ObservacionEstudiante>)ViewBag.ListaObservaciones).Any())
                        {
                            foreach (var obs in (List<ProyectoPAE.Models.ObservacionEstudiante>)ViewBag.ListaObservaciones)
                            {
                                string tipo = obs.tipo_nota?.ToLower() ?? "";
                                string borderCol = tipo.Contains("positiva") || tipo.Contains("merito") ? "#27ae60" : (tipo.Contains("llamado") || tipo.Contains("atencion") ? "#e74c3c" : "#f39c12");
                                string badgeCol = tipo.Contains("positiva") || tipo.Contains("merito") ? "bg-success" : (tipo.Contains("llamado") || tipo.Contains("atencion") ? "bg-danger" : "bg-warning text-dark");
                                <div class="card border-0 shadow-sm mb-3 bg-light" style="border-left: 4px solid @borderCol !important;">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <span class="badge @badgeCol px-2 py-1">@obs.tipo_nota</span>
                                            <span class="badge bg-secondary">@obs.fecha.ToString("dd/MM/yyyy")</span>
                                        </div>
                                        <p class="mb-2 text-dark" style="font-size: 0.95rem;">@obs.descripcion</p>
                                        <div class="border-top pt-2 mt-2">
                                            <small class="text-muted"><i class="bi bi-person-badge me-1"></i><strong>Docente:</strong> @obs.docente</small>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center py-4" id="sinObservacionesMsg">
                                <i class="bi bi-journal-check fs-1 text-muted"></i>
                                <p class="text-muted mt-2">El estudiante no registra llamados de atención ni anotaciones en el observador.</p>
                            </div>
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    /**
     * Oculta todos los paneles y subsecciones de la interfaz SPA.
     */
    function ocultarTodo() {
        const subs = [
            'admin-main', 'admin-matricula', 'admin-usuarios', 'admin-certificados', 'admin-notificaciones', 'admin-asignacion', 'admin-reportes',
            'docente-main', 'docente-planilla', 'docente-asistencia', 'docente-observaciones', 'docente-mejoras', 'docente-cursosextra', 'docente-actividades',
            'estudiante-main', 'estudiante-calificaciones', 'estudiante-actividades', 'estudiante-cursosextra', 'estudiante-mejoras'
        ];

        const panelesPrincipales = [
            'panel-admin', 'panel-docente', 'panel-estudiante', 'panel-acudiente'
        ];

        subs.forEach(id => {
            const el = document.getElementById(id);
            if (el) el.classList.add('d-none');
        });

        panelesPrincipales.forEach(id => {
            const p = document.getElementById(id);
            if (p) p.classList.add('d-none');
        });
    }

    /**
     * Cambia la vista activa según el selector o el rol enviado.
     */
    function switchRole() {
        const selector = document.getElementById('roleSelector');
        const inputRol = document.getElementById('rolOculto');

        let role = '';

        if (selector && selector.value) {
            role = selector.value.toLowerCase().trim();
        } else if (inputRol && inputRol.value) {
            role = inputRol.value.toLowerCase().trim();
        }

        if (!role) return;

        if (role === 'administrador') {
            role = 'admin';
        } else if (role === 'padre') {
            role = 'acudiente';
        } else if (role === 'profesor') {
            role = 'docente';
        }

        ocultarTodo();

        const panel = document.getElementById('panel-' + role);
        if (panel) {
            panel.classList.remove('d-none');

            const subMain = document.getElementById(role + '-main');
            if (subMain) subMain.classList.remove('d-none');
        }
    }

    // --- FUNCIONES DE NAVEGACIÓN ADMINISTRADOR ---
    function verMatricula() { ocultarTodo(); mostrarSubpanel('panel-admin', 'admin-matricula'); }
    function verCertificados() { ocultarTodo(); mostrarSubpanel('panel-admin', 'admin-certificados'); }
    function verNotificaciones() { ocultarTodo(); mostrarSubpanel('panel-admin', 'admin-notificaciones'); }
    function verAsignacion() { ocultarTodo(); mostrarSubpanel('panel-admin', 'admin-asignacion'); }
    function verReportes() { ocultarTodo(); mostrarSubpanel('panel-admin', 'admin-reportes'); }
    function volverAdmin() { ocultarTodo(); mostrarSubpanel('panel-admin', 'admin-main'); }

    // --- FUNCIONES DE NAVEGACIÓN DOCENTE ---
    function verPlanilla() { ocultarTodo(); mostrarSubpanel('panel-docente', 'docente-planilla'); }
    function verAsistencia() { ocultarTodo(); mostrarSubpanel('panel-docente', 'docente-asistencia'); }
    function verObservaciones() { ocultarTodo(); mostrarSubpanel('panel-docente', 'docente-observaciones'); }
    function verModuloMejorasDocente() { ocultarTodo(); mostrarSubpanel('panel-docente', 'docente-mejoras'); }
    function verCursosExtraDocente() { ocultarTodo(); mostrarSubpanel('panel-docente', 'docente-cursosextra'); }
    function verActividadesDocente() { ocultarTodo(); mostrarSubpanel('panel-docente', 'docente-actividades'); cargarActividadesDocente(); }
    function volverDocenteActividades() { ocultarTodo(); mostrarSubpanel('panel-docente', 'docente-main'); }
    function volverDocente() { ocultarTodo(); mostrarSubpanel('panel-docente', 'docente-main'); }

    // --- FUNCIONES DE NAVEGACIÓN ESTUDIANTE ---
    function verCalificacionesEstudiante() { ocultarTodo(); mostrarSubpanel('panel-estudiante', 'estudiante-calificaciones'); }
    function verActividadesEstudiante() { ocultarTodo(); mostrarSubpanel('panel-estudiante', 'estudiante-actividades'); cargarActividadesEstudiante(); }
    function verCursosExtra() { ocultarTodo(); mostrarSubpanel('panel-estudiante', 'estudiante-cursosextra'); }
    function verModuloMejoras() { ocultarTodo(); mostrarSubpanel('panel-estudiante', 'estudiante-mejoras'); }
    function volverEstudiante() { ocultarTodo(); mostrarSubpanel('panel-estudiante', 'estudiante-main'); }

    function mostrarSubpanel(panelId, subId) {
        const panel = document.getElementById(panelId);
        const sub = document.getElementById(subId);
        if (panel) panel.classList.remove('d-none');
        if (sub) sub.classList.remove('d-none');
    }

    // ===============================================
    // AJAX: GESTIÓN DE ACTIVIDADES Y TAREAS (DOCENTE)
    // ===============================================

    function cargarActividadesDocente() {
        const contenedor = document.getElementById('contenedorActividadesDocente');
        if (!contenedor) return;

        contenedor.innerHTML = `
            <div class="col-12 text-center py-5">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="text-muted small mt-2">Cargando actividades académicas...</p>
            </div>
        `;

        fetch('@Url.Action("ObtenerActividadesDocente", "Docente")')
            .then(res => res.json())
            .then(data => {
                if (!data.success || !data.actividades || data.actividades.length === 0) {
                    contenedor.innerHTML = `
                        <div class="col-12">
                            <div class="card border-0 shadow-sm p-5 text-center rounded-4 bg-white">
                                <i class="bi bi-journal-x text-muted display-4 mb-3"></i>
                                <h5 class="fw-bold text-secondary">No hay actividades creadas</h5>
                                <p class="text-muted small mb-4">Comienza publicando una nueva tarea o taller para tus grupos de clase.</p>
                                <div>
                                    <button class="btn text-white px-4 py-2 shadow-sm" style="background-color: #2980b9; border-radius: 8px;" data-bs-toggle="modal" data-bs-target="#modalCrearActividad">
                                        <i class="bi bi-plus-circle me-1"></i> Publicar Primera Actividad
                                    </button>
                                </div>
                            </div>
                        </div>
                    `;
                    return;
                }

                let html = '';
                data.actividades.forEach(act => {
                    const badgeVencida = act.estaVencida 
                        ? `<span class="badge bg-danger rounded-pill px-2 py-1"><i class="bi bi-exclamation-triangle-fill me-1"></i>Vencida</span>` 
                        : `<span class="badge bg-success rounded-pill px-2 py-1"><i class="bi bi-check-circle-fill me-1"></i>Vigente</span>`;

                    const linkAdjunto = act.archivoAdjunto 
                        ? `<a href="${act.archivoAdjunto}" target="_blank" class="btn btn-sm btn-outline-secondary rounded-pill px-2 py-0" style="font-size: 0.78rem;">
                               <i class="bi bi-file-earmark-arrow-down me-1"></i>Guía / Adjunto
                           </a>` 
                        : '';

                    html += `
                        <div class="col-lg-6 mb-3">
                            <div class="card border-0 shadow-sm rounded-4 h-100 p-3 bg-white" style="border-top: 4px solid #2980b9 !important;">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div class="d-flex gap-2 align-items-center flex-wrap">
                                        <span class="badge bg-primary rounded-pill px-3 py-1">${act.materia}</span>
                                        <span class="badge bg-light text-dark border rounded-pill px-2 py-1">Grado: ${act.grado || 'Todos'}</span>
                                    </div>
                                    ${badgeVencida}
                                </div>

                                <h5 class="fw-bold text-dark mb-1">${act.titulo}</h5>
                                
                                <p class="small text-muted mb-2" style="white-space: pre-line; max-height: 80px; overflow: hidden; text-overflow: ellipsis;">
                                    ${act.descripcion || 'Sin descripción adicional.'}
                                </p>

                                <div class="d-flex justify-content-between align-items-center small text-muted p-2 bg-light rounded-3 mb-3">
                                    <span><i class="bi bi-clock-history me-1 text-danger"></i>Fecha Límite: <strong>${act.fechaLimite}</strong></span>
                                    ${linkAdjunto}
                                </div>

                                <!-- Métricas de entregas -->
                                <div class="row g-2 mb-3 text-center">
                                    <div class="col-4">
                                        <div class="p-2 border rounded-3 bg-white">
                                            <span class="d-block text-muted small" style="font-size: 0.75rem;">Total Entregas</span>
                                            <span class="fs-5 fw-bold text-dark">${act.totalEntregas}</span>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div class="p-2 border rounded-3 bg-white">
                                            <span class="d-block text-muted small" style="font-size: 0.75rem;">Calificadas</span>
                                            <span class="fs-5 fw-bold text-success">${act.calificadas}</span>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div class="p-2 border rounded-3 bg-white">
                                            <span class="d-block text-muted small" style="font-size: 0.75rem;">Por Calificar</span>
                                            <span class="fs-5 fw-bold text-warning">${act.pendientes}</span>
                                        </div>
                                    </div>
                                </div>

                                <div class="d-flex justify-content-between align-items-center pt-2 border-top mt-auto">
                                    <button class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-bold" onclick="abrirModalRevisarEntregas(${act.idActividad})">
                                        <i class="bi bi-file-earmark-check me-1"></i> Revisar y Calificar (${act.totalEntregas})
                                    </button>
                                    <button class="btn btn-outline-danger btn-sm rounded-pill px-2" title="Eliminar actividad" onclick="eliminarActividadDocente(${act.idActividad})">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    `;
                });

                contenedor.innerHTML = html;
            })
            .catch(err => {
                console.error(err);
                contenedor.innerHTML = `<div class="col-12 text-center text-danger py-4">Error al cargar las actividades.</div>`;
            });
    }

    function guardarNuevaActividad(event) {
        event.preventDefault();
        const form = document.getElementById('formCrearActividad');
        const formData = new FormData(form);

        fetch('@Url.Action("CrearActividad", "Docente")', {
            method: 'POST',
            body: formData
        })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    if (typeof Swal !== 'undefined') {
                        Swal.fire({ icon: 'success', title: '¡Éxito!', text: data.message, timer: 2000, showConfirmButton: false });
                    } else {
                        alert(data.message);
                    }
                    const modalEl = document.getElementById('modalCrearActividad');
                    const modal = bootstrap.Modal.getInstance(modalEl);
                    if (modal) modal.hide();
                    form.reset();
                    cargarActividadesDocente();
                } else {
                    if (typeof Swal !== 'undefined') {
                        Swal.fire({ icon: 'error', title: 'Atención', text: data.message });
                    } else {
                        alert('Error: ' + data.message);
                    }
                }
            })
            .catch(err => {
                console.error(err);
                alert('Ocurrió un error al publicar la actividad.');
            });
    }

    function abrirModalRevisarEntregas(idActividad) {
        const tbody = document.getElementById('tablaCuerpoEntregas');
        if (!tbody) return;

        tbody.innerHTML = `<tr><td colspan="7" class="text-center py-4 text-muted"><div class="spinner-border spinner-border-sm text-primary"></div> Cargando entregas...</td></tr>`;

        const modalEl = document.getElementById('modalRevisarEntregas');
        const modal = new bootstrap.Modal(modalEl);
        modal.show();

        fetch(`@Url.Action("ObtenerEntregasActividad", "Docente")?idActividad=${idActividad}`)
            .then(res => res.json())
            .then(data => {
                if (!data.success) {
                    tbody.innerHTML = `<tr><td colspan="7" class="text-center py-4 text-danger">${data.message}</td></tr>`;
                    return;
                }

                document.getElementById('tituloModalRevisarEntregas').innerHTML = `<i class="bi bi-file-earmark-check me-2"></i>Entregas: ${data.tituloActividad}`;
                document.getElementById('subtituloModalRevisarEntregas').textContent = `Materia: ${data.materia} | Grado: ${data.grado || 'Todos'} | Total entregas: ${data.totalEntregas}`;

                if (!data.entregas || data.entregas.length === 0) {
                    tbody.innerHTML = `<tr><td colspan="7" class="text-center py-4 text-muted">Ningún estudiante ha subido su entrega todavía.</td></tr>`;
                    return;
                }

                let html = '';
                data.entregas.forEach(ent => {
                    const badgeEstado = ent.estado === 'Calificado' 
                        ? `<span class="badge bg-success" id="badge-estado-${ent.idEntrega}">Calificado</span>` 
                        : `<span class="badge bg-warning text-dark" id="badge-estado-${ent.idEntrega}">Pendiente</span>`;

                    const linkArchivo = ent.archivoRuta 
                        ? `<a href="${ent.archivoRuta}" target="_blank" class="btn btn-sm btn-outline-primary py-0 px-2 rounded-pill" style="font-size: 0.8rem;">
                               <i class="bi bi-file-earmark-arrow-down me-1"></i>${ent.archivoNombre || 'Descargar Trabajo'}
                           </a>` 
                        : `<span class="text-muted small">Sin archivo adjunto</span>`;

                    const comentarioEstudiante = ent.comentario 
                        ? `<div class="p-2 bg-light rounded mt-1 small text-dark border" style="font-size: 0.78rem;">
                               <i class="bi bi-chat-left-quote me-1 text-primary"></i>${ent.comentario}
                           </div>` 
                        : '';

                    const valorNota = ent.calificacion !== null && ent.calificacion !== undefined 
                        ? Number(ent.calificacion).toFixed(1) 
                        : '';

                    html += `
                        <tr id="fila-entrega-${ent.idEntrega}">
                            <td>
                                <strong class="d-block text-dark">${ent.nombreEstudiante}</strong>
                                <small class="text-muted">${ent.correo} | Doc: ${ent.documento}</small>
                            </td>
                            <td>
                                <small class="text-muted">${ent.fechaEntrega}</small>
                                <div class="mt-1">${badgeEstado}</div>
                            </td>
                            <td>
                                ${linkArchivo}
                                ${comentarioEstudiante}
                            </td>
                            <td>
                                <select class="form-select form-select-sm" id="periodo-entrega-${ent.idEntrega}">
                                    <option value="1" selected>Periodo 1</option>
                                    <option value="2">Periodo 2</option>
                                    <option value="3">Periodo 3</option>
                                    <option value="4">Periodo 4</option>
                                </select>
                            </td>
                            <td>
                                <div class="input-group input-group-sm">
                                    <input type="number" step="0.1" min="0" max="5" class="form-control form-control-sm text-center fw-bold text-primary" 
                                           id="nota-entrega-${ent.idEntrega}" value="${valorNota}" placeholder="0.0 - 5.0" />
                                </div>
                            </td>
                            <td>
                                <textarea class="form-control form-control-sm" id="retro-entrega-${ent.idEntrega}" rows="2" placeholder="Observaciones o retroalimentación...">${ent.retroalimentacion || ''}</textarea>
                            </td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm btn-success rounded-pill px-3 shadow-sm" onclick="guardarCalificacionEntrega(${ent.idEntrega})">
                                    <i class="bi bi-check-lg me-1"></i>Guardar
                                </button>
                            </td>
                        </tr>
                    `;
                });

                tbody.innerHTML = html;
            })
            .catch(err => {
                console.error(err);
                tbody.innerHTML = `<tr><td colspan="7" class="text-center py-4 text-danger">Error al cargar entregas.</td></tr>`;
            });
    }

    function guardarCalificacionEntrega(idEntrega) {
        const inputNota = document.getElementById(`nota-entrega-${idEntrega}`);
        const inputRetro = document.getElementById(`retro-entrega-${idEntrega}`);
        const selectPeriodo = document.getElementById(`periodo-entrega-${idEntrega}`);

        const notaVal = inputNota ? inputNota.value.trim() : '';
        const retroVal = inputRetro ? inputRetro.value.trim() : '';
        const periodoVal = selectPeriodo ? selectPeriodo.value : '1';

        if (!notaVal) {
            alert('Por favor ingresa una nota válida entre 0.0 y 5.0');
            return;
        }

        const notaNum = parseFloat(notaVal.replace(',', '.'));
        if (isNaN(notaNum) || notaNum < 0 || notaNum > 5.0) {
            alert('La calificación debe ser un valor numérico entre 0.0 y 5.0');
            return;
        }

        const formData = new FormData();
        formData.append('idEntrega', idEntrega);
        formData.append('nota', notaVal);
        formData.append('retroalimentacion', retroVal);
        formData.append('periodo', periodoVal);

        fetch('@Url.Action("CalificarEntrega", "Docente")', {
            method: 'POST',
            body: formData
        })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    if (typeof Swal !== 'undefined') {
                        Swal.fire({
                            toast: true,
                            position: 'top-end',
                            icon: 'success',
                            title: '¡Calificación registrada y sincronizada en planilla!',
                            showConfirmButton: false,
                            timer: 3000
                        });
                    } else {
                        alert(data.message);
                    }

                    const badge = document.getElementById(`badge-estado-${idEntrega}`);
                    if (badge) {
                        badge.className = 'badge bg-success';
                        badge.textContent = 'Calificado';
                    }

                    cargarActividadesDocente();
                } else {
                    alert('Error: ' + data.message);
                }
            })
            .catch(err => {
                console.error(err);
                alert('Ocurrió un error al guardar la calificación.');
            });
    }

    function eliminarActividadDocente(idActividad) {
        if (!confirm('¿Estás seguro de eliminar esta actividad?')) return;

        const formData = new FormData();
        formData.append('idActividad', idActividad);

        fetch('@Url.Action("EliminarActividad", "Docente")', {
            method: 'POST',
            body: formData
        })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    cargarActividadesDocente();
                } else {
                    alert(data.message);
                }
            })
            .catch(err => {
                console.error(err);
                alert('Error al eliminar actividad.');
            });
    }

