@{
    ViewData["Title"] = "Panel de Control Educativo";
    @using Microsoft.AspNetCore.Http
}

@{
    var nombre = Context.Session.GetString("NombreUsuario");
    var rolReal = Context.Session.GetString("UserRol"); // Rol original de la sesión
    var rep = ViewBag.ReportesPro as ProyectoPAE.Models.ReportesProViewModel ?? new ProyectoPAE.Models.ReportesProViewModel();
    var cursosExtraDocente = ViewBag.CursosExtraDocente as List<ProyectoPAE.Models.ExtraCursoItemViewModel> ?? new List<ProyectoPAE.Models.ExtraCursoItemViewModel>();
    var cursosExtraEstudiante = ViewBag.CursosExtraEstudiante as List<ProyectoPAE.Models.ExtraCursoItemViewModel> ?? new List<ProyectoPAE.Models.ExtraCursoItemViewModel>();
    var misCursosExtraInscritos = ViewBag.MisCursosExtraInscritos as List<ProyectoPAE.Models.ExtraCursoItemViewModel> ?? new List<ProyectoPAE.Models.ExtraCursoItemViewModel>();
    int? gradoEstudianteSesion = ViewBag.GradoEstudiante as int?;
}

<input type="hidden" id="rolOculto" value="@ViewBag.Rol" />

<input type="hidden" id="rolRealSesion" value="@rolReal" />

<center><h2>Bienvenido/a, @nombre</h2></center>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const inputRol = document.getElementById('rolOculto');
        const selector = document.getElementById('roleSelector');

        // Rol activo que se quiere visualizar en la vista
        const rolActivo = inputRol ? inputRol.value.toLowerCase().trim() : '';

        if (selector && rolActivo) {
            // Asigna la opción seleccionada según el rol activo
            selector.value = rolActivo;

            // Cambia el panel visible
            if (typeof switchRole === "function") {
                switchRole();
            }
        }
    });
</script>

<!-- BARRA SUPERIOR AZUL -->
<div class="container-fluid fw-bold py-3 mb-4" style="background-color: #0d2a4a; color: white;">
    <div class="container d-flex justify-content-between align-items-center">
        <!-- Título a la izquierda con logo de PAE -->
        <span class="d-flex align-items-center gap-2">
            <img src="~/images/logo.png" alt="Logo PAE" style="height: 32px; width: auto; object-fit: contain; background: white; border-radius: 6px; padding: 2px;" class="shadow-sm" />
            <span style="letter-spacing: 0.5px;"><i class="bi bi-mortarboard-fill me-2"></i>SISTEMA DE GESTIÓN PAE</span>
        </span>

        <!-- Selector de Rol a la derecha (solo visible para Administrador) -->
        @if (rolReal != null && (rolReal.ToLower() == "admin" || rolReal.ToLower() == "administrador"))
        {
            <div id="contenedorSelectorRol" class="d-flex align-items-center gap-2">
                <small class="opacity-75">Rol actual:</small>
                <select id="roleSelector" class="form-select form-select-sm" onchange="switchRole()" style="width: auto;">
                    <option value="admin">Administrador</option>
                    <option value="docente">Docente</option>
                    <option value="estudiante">Estudiante</option>
                    <option value="acudiente">Acudiente</option>
                </select>
            </div>
        }
    </div>
</div>

<div class="container pb-5">



    <div id="panel-admin" class="role-panel d-none">

        <div id="admin-main">
            <h2 class="mb-4" style="color: #e67e22;"><i class="bi bi-gear-fill me-2"></i>Gestión Administrativa</h2>

            <div class="row">
                <!-- 1. Matrículas -->
                <div class="col-md-4 mb-4">
                    <div class="card p-4 text-center border-0 shadow-sm h-100 card-hover card-admin-limpia" 
                         style="border-top: 4px solid #e67e22 !important; cursor: pointer;" 
                         onclick="verMatricula()">
                        <i class="bi bi-clipboard-check fs-2 mb-2" style="color: #e67e22;"></i>
                        <h5 style="color: #e67e22; font-weight: bold;">Matrículas</h5>
                        <p class="small text-muted mb-3" style="min-height: 44px; display: flex; align-items: center; justify-content: center;">Consulta y gestiona las matrículas registradas.</p>
                        <button class="btn btn-admin-solido btn-sm mt-auto w-100 text-white">Ver Matrículas</button>
                    </div>
                </div>

                <!-- 2. Gestión de Usuarios -->
                <div class="col-md-4 mb-4">
                    <div class="card p-4 text-center border-0 shadow-sm h-100 card-hover card-admin-limpia" 
                         style="border-top: 4px solid #e67e22 !important; cursor: pointer;" 
                         onclick="location.href='@Url.Action("Usuarios", "Admin")'">
                        <i class="bi bi-people-fill fs-2 mb-2" style="color: #e67e22;"></i>
                        <h5 style="color: #e67e22; font-weight: bold;">Gestión de Usuarios</h5>
                        <p class="small text-muted mb-3" style="min-height: 44px; display: flex; align-items: center; justify-content: center;">Administra estudiantes, docentes y acudientes.</p>
                        <a href="@Url.Action("Usuarios", "Admin")" class="btn btn-admin-solido btn-sm mt-auto w-100 text-white">Ver Usuarios</a>
                    </div>
                </div>

                <!-- 3. Certificados -->
                <div class="col-md-4 mb-4">
                    <div class="card p-4 text-center border-0 shadow-sm h-100 card-hover card-admin-limpia" 
                         style="border-top: 4px solid #e67e22 !important; cursor: pointer;" 
                         onclick="verCertificados()">
                        <i class="bi bi-file-earmark-pdf-fill fs-2 mb-2" style="color: #e67e22;"></i>
                        <h5 style="color: #e67e22; font-weight: bold;">Certificados</h5>
                        <p class="small text-muted mb-3" style="min-height: 44px; display: flex; align-items: center; justify-content: center;">Genera y descarga certificados oficiales.</p>
                        <button class="btn btn-admin-solido btn-sm mt-auto w-100 text-white">Ver Certificados</button>
                    </div>
                </div>

                <!-- 4. Notificaciones -->
                <div class="col-md-4 mb-4">
                    <div class="card p-4 text-center border-0 shadow-sm h-100 card-hover card-admin-limpia" 
                         style="border-top: 4px solid #e67e22 !important; cursor: pointer;" 
                         onclick="location.href='@Url.Action("Notificaciones", "Admin")'">
                        <i class="bi bi-megaphone-fill fs-2 mb-2" style="color: #e67e22;"></i>
                        <h5 style="color: #e67e22; font-weight: bold;">Notificaciones</h5>
                        <p class="small text-muted mb-3" style="min-height: 44px; display: flex; align-items: center; justify-content: center;">Envía comunicados a toda la institución.</p>
                        <a href="@Url.Action("Notificaciones", "Admin")" class="btn btn-admin-solido btn-sm mt-auto w-100 text-white">Ver Notificaciones</a>
                    </div>
                </div>

                <!-- 5. Asignación Académica -->
                <div class="col-md-4 mb-4">
                    <div class="card p-4 text-center border-0 shadow-sm h-100 card-hover card-admin-limpia" 
                         style="border-top: 4px solid #e67e22 !important; cursor: pointer;" 
                         onclick="verAsignacion()">
                        <i class="bi bi-diagram-3-fill fs-2 mb-2" style="color: #e67e22;"></i>
                        <h5 style="color: #e67e22; font-weight: bold;">Asignación Académica</h5>
                        <p class="small text-muted mb-3" style="min-height: 44px; display: flex; align-items: center; justify-content: center;">Asigna materias y grupos a los docentes.</p>
                        <button class="btn btn-admin-solido btn-sm mt-auto w-100 text-white">Ver Asignación</button>
                    </div>
                </div>

                <!-- 6. Reportes Pro -->
                <div class="col-md-4 mb-4">
                    <div class="card p-4 text-center border-0 shadow-sm h-100 card-hover card-admin-limpia" 
                         style="border-top: 4px solid #e67e22 !important; cursor: pointer;" 
                         onclick="verReportes()">
                        <i class="bi bi-graph-up-arrow fs-2 mb-2" style="color: #e67e22;"></i>
                        <h5 style="color: #e67e22; font-weight: bold;">Reportes Pro</h5>
                        <p class="small text-muted mb-3" style="min-height: 44px; display: flex; align-items: center; justify-content: center;">Estadísticas generales de la institución.</p>
                        <button class="btn btn-admin-solido btn-sm mt-auto w-100 text-white">Ver Reportes</button>
                    </div>
                </div>
            </div>
        </div>

        <div id="admin-matricula" class="d-none">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h3 style="color: #e67e22;"><i class="bi bi-clipboard-check me-2"></i>Matrículas</h3>
                <button class="btn btn-outline-secondary btn-sm" onclick="volverAdmin()">Volver</button>
            </div>

            <!-- Resumen (datos reales de MATRICULA) -->
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm p-4 h-100" style="border-left: 4px solid #0d2a4a !important;">
                        <p class="text-muted text-uppercase small mb-2">Matrículas Activas</p>
                        <div class="d-flex justify-content-between align-items-end">
                            <span class="fs-3 fw-bold" style="color: #0d2a4a;">@ViewBag.TotalMatriculadosActivos</span>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm p-4 h-100" style="border-left: 4px solid #e67e22 !important;">
                        <p class="text-muted text-uppercase small mb-2">Matrículas @DateTime.Now.Year</p>
                        <div class="d-flex justify-content-between align-items-end">
                            <span class="fs-3 fw-bold" style="color: #e67e22;">@ViewBag.MatriculasEsteAnio</span>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm p-4 h-100" style="border-left: 4px solid #0d2a4a99 !important;">
                        <p class="text-muted text-uppercase small mb-2">Matrículas Finalizadas</p>
                        <div class="d-flex justify-content-between align-items-end">
                            <span class="fs-3 fw-bold" style="color: #0d2a4a;">@ViewBag.MatriculasFinalizadas</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tabla -->
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white d-flex flex-wrap align-items-center justify-content-between gap-3 p-3">
                    <div class="d-flex gap-3">
                        <div>
                            <label class="form-label small mb-1">Filtrar por Grado</label>
                            <select id="filtroGrado" class="form-select form-select-sm" onchange="filtrarMatriculas()">
                                <option value="todos">Todos los Grados</option>
                                <option value="6">Grado 6</option>
                                <option value="7">Grado 7</option>
                                <option value="8">Grado 8</option>
                                <option value="9">Grado 9</option>
                                <option value="10">Grado 10</option>
                                <option value="11">Grado 11</option>
                            </select>
                        </div>
                        <div>
                            <label class="form-label small mb-1">Estado</label>
                            <select id="filtroEstado" class="form-select form-select-sm" onchange="filtrarMatriculas()">
                                <option value="todos">Cualquier Estado</option>
                                <option value="activa">Activa</option>
                                <option value="finalizada">Finalizada</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr class="small text-uppercase text-muted">
                                <th class="px-3 py-3">Estudiante</th>
                                <th class="px-3 py-3">Grado</th>
                                <th class="px-3 py-3">Periodo Académico</th>
                                <th class="px-3 py-3">Fecha Matrícula</th>
                                <th class="px-3 py-3">Estado</th>
                                <th class="px-3 py-3 text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="tbodyMatriculas">
                            @{
                                var listaMatriculas = ViewBag.ListaMatriculas as List<ProyectoPAE.Models.MatriculaAdminItemViewModel>;
                            }
                            @if (listaMatriculas != null && listaMatriculas.Any())
                            {
                                foreach (var mat in listaMatriculas)
                                {
                                    bool esActiva = mat.Estado != null && (mat.Estado.Equals("Activa", StringComparison.OrdinalIgnoreCase) || mat.Estado.Equals("Activo", StringComparison.OrdinalIgnoreCase));
                                    string colorFondo = esActiva ? "#0d2a4a1a" : "#6c757d1a";
                                    string colorTexto = esActiva ? "#0d2a4a" : "#6c757d";
                                    var iniciales = string.Join("", mat.NombreEstudiante.Split(' ').Take(2).Select(p => p.Length > 0 ? p[0].ToString().ToUpper() : ""));

                                    <tr class="fila-mat" data-grado="@mat.Grado" data-estado="@mat.Estado?.ToLower()">
                                        <td class="px-3 py-3">
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width:40px;height:40px;background:@colorFondo;color:@colorTexto;">@iniciales</div>
                                                <div>
                                                    <p class="fw-bold mb-0">@mat.NombreEstudiante</p>
                                                    <p class="text-muted small mb-0">ID: @mat.CodigoEstudiante</p>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="px-3 py-3">Grado @mat.Grado°</td>
                                        <td class="px-3 py-3">@mat.PeriodoAcademico</td>
                                        <td class="px-3 py-3">@mat.FechaMatricula.ToString("dd MMM, yyyy")</td>
                                        <td class="px-3 py-3">
                                            <span class="badge rounded-pill" style="background:@colorFondo;color:@colorTexto;">@mat.Estado.ToUpper()</span>
                                        </td>
                                        <td class="px-3 py-3 text-end">
                                            <div class="dropdown">
                                                <button class="btn btn-sm btn-light border" type="button"
                                                        id="accion-@mat.IdMatricula"
                                                        data-bs-toggle="dropdown" aria-expanded="false">
                                                    <i class="bi bi-three-dots-vertical"></i>
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-end shadow-sm"
                                                    aria-labelledby="accion-@mat.IdMatricula">
                                                    <li>
                                                        <button type="button" class="dropdown-item"
                                                                onclick="abrirModalEditarMatricula(@mat.IdMatricula, @mat.Grado, '@mat.Estado', '@mat.NombreEstudiante')">
                                                            <i class="bi bi-pencil-square text-primary me-2"></i>Editar
                                                        </button>
                                                    </li>
                                                    @if (!esActiva)
                                                    {
                                                        <li>
                                                            <form method="post" action="/Admin/CambiarEstadoMatricula" style="display:inline">
                                                                <input type="hidden" name="idMatricula" value="@mat.IdMatricula" />
                                                                <input type="hidden" name="nuevoEstado" value="Activa" />
                                                                @Html.AntiForgeryToken()
                                                                <button type="submit" class="dropdown-item"><i class="bi bi-check-circle text-success me-2"></i>Marcar Activa</button>
                                                            </form>
                                                        </li>
                                                    }
                                                    @if (esActiva)
                                                    {
                                                        <li>
                                                            <form method="post" action="/Admin/CambiarEstadoMatricula" style="display:inline">
                                                                <input type="hidden" name="idMatricula" value="@mat.IdMatricula" />
                                                                <input type="hidden" name="nuevoEstado" value="Finalizada" />
                                                                @Html.AntiForgeryToken()
                                                                <button type="submit" class="dropdown-item"><i class="bi bi-x-circle text-warning me-2"></i>Dar de Baja</button>
                                                            </form>
                                                        </li>
                                                    }
                                                    <li><hr class="dropdown-divider" /></li>
                                                    <li>
                                                        <form method="post" action="/Admin/EliminarMatricula" style="display:inline"
                                                              onsubmit="return confirm('¿Eliminar la matrícula de @mat.NombreEstudiante? Esta acción no se puede deshacer.')">
                                                            <input type="hidden" name="idMatricula" value="@mat.IdMatricula" />
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="dropdown-item text-danger"><i class="bi bi-trash me-2"></i>Eliminar</button>
                                                        </form>
                                                    </li>
                                                </ul>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr id="sinMatriculas">
                                    <td colspan="6" class="text-center text-muted py-4">No hay matrículas registradas.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- PAGINACIÓN MATRÍCULAS -->
                <div class="card-footer bg-white d-flex flex-wrap align-items-center justify-content-between gap-2 px-3 py-2">
                    <p class="text-muted small mb-0" id="infoMatPagina">Cargando...</p>
                    <nav aria-label="Paginación matrículas">
                        <ul class="pagination pagination-sm mb-0" id="paginacionMat"></ul>
                    </nav>
                </div>
            </div>

            @* Alertas de feedback para el CRUD de matrículas *@
            @if (TempData["MensajeMatriculas"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>@TempData["MensajeMatriculas"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["ErrorMatriculas"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMatriculas"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @* Modal de edición de matrícula *@
            <div class="modal fade" id="modalEditarMatricula" tabindex="-1" aria-labelledby="modalEditarMatriculaLabel" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <form method="post" action="/Admin/EditarMatricula">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="idMatricula" id="edit_idMatricula" />
                            <div class="modal-header" style="background:#0d2a4a;color:white;">
                                <h5 class="modal-title" id="modalEditarMatriculaLabel">
                                    <i class="bi bi-pencil-square me-2"></i>Editar Matrícula
                                </h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <p class="text-muted small mb-3" id="edit_nombreEstudiante"></p>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Grado (curso)</label>
                                    <select name="idCurso" id="edit_idCurso" class="form-select" required>
                                        @for (int g = 1; g <= 11; g++)
                                        {
                                            <option value="@g">Grado @g°</option>
                                        }
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Estado</label>
                                    <select name="estado" id="edit_estado" class="form-select" required>
                                        <option value="Activa">Activa</option>
                                        <option value="Finalizada">Finalizada</option>
                                        <option value="Retirada">Retirada</option>
                                    </select>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-save me-1"></i>Guardar Cambios
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <script>
                            function abrirModalEditarMatricula(idMatricula, grado, estado, nombre) {
                                document.getElementById('edit_idMatricula').value = idMatricula;
                                document.getElementById('edit_nombreEstudiante').textContent = 'Estudiante: ' + nombre;
                                var selectGrado = document.getElementById('edit_idCurso');
                                for (var i = 0; i < selectGrado.options.length; i++) {
                                    selectGrado.options[i].selected = (parseInt(selectGrado.options[i].value) === grado);
                                }
                                var selectEstado = document.getElementById('edit_estado');
                                for (var j = 0; j < selectEstado.options.length; j++) {
                                    selectEstado.options[j].selected = (selectEstado.options[j].value === estado);
                                }
                                var modal = new bootstrap.Modal(document.getElementById('modalEditarMatricula'));
                                modal.show();
                            }
            </script>
        </div>

        <div id="admin-certificados" class="d-none">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h3 style="color: #e67e22;"><i class="bi bi-file-earmark-pdf-fill me-2"></i>Certificados</h3>
                <button class="btn btn-outline-secondary btn-sm" onclick="volverAdmin()">Volver</button>
            </div>

            @if (TempData["ErrorMatricula"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["ErrorMatricula"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="card border-0 shadow-sm p-4">
                <h5 class="mb-3">Constancia de Matrícula</h5>
                <form action="@Url.Action("GenerarMatricula", "Certificado")" method="get" class="row g-3 align-items-end">
                    <div class="col-md-6">
                        <label class="form-label small">Número de documento del estudiante (TI / CC)</label>
                        <input type="text" name="numeroDocumento" class="form-control" placeholder="Ej: 1122334455" required />
                    </div>
                    <div class="col-md-6">
                        <button type="submit" class="btn btn-warning text-white w-100">
                            <i class="bi bi-file-earmark-pdf me-2"></i>Generar Constancia
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div id="admin-notificaciones" class="d-none">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h3 style="color: #e67e22;"><i class="bi bi-megaphone-fill me-2"></i>Notificaciones</h3>
                <button class="btn btn-outline-secondary btn-sm" onclick="volverAdmin()">Volver</button>
            </div>
            <div class="card border-0 shadow-sm p-4">
                <textarea class="form-control mb-3" rows="3" placeholder="Escriba el comunicado general..."></textarea>
                <button class="btn btn-warning text-white">Enviar a toda la institución</button>
            </div>
        </div>

        <div id="admin-asignacion" class="d-none">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h3 style="color: #e67e22;"><i class="bi bi-diagram-3-fill me-2"></i>Asignación Académica</h3>
                <button class="btn btn-outline-secondary btn-sm" onclick="volverAdmin()">Volver</button>
            </div>
            <div class="alert alert-info">Seleccione un docente para asignar sus materias y grupos correspondientes.</div>
        </div>

        <!-- ─── SECCIÓN: REPORTES PRO ANUAL CONSOLIDADO ────────────────── -->
        <div id="admin-reportes" class="d-none">
            <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
                <div>
                    <h3 class="fw-bold mb-1" style="color: #1b2a47;">
                        <i class="bi bi-graph-up-arrow me-2" style="color: #e67e22;"></i>Reportes Pro - Anual Consolidado
                    </h3>
                    <p class="text-muted small mb-0">Indicadores institucionales de rendimiento académico, convivencia, permanencia y matrículas.</p>
                </div>
                <button class="btn btn-outline-secondary rounded-pill px-4" onclick="volverAdmin()">
                    <i class="bi bi-arrow-left me-1"></i> Volver al Dashboard
                </button>
            </div>

            <!-- TARJETAS PRINCIPALES KPI -->
            <div class="row g-3 mb-4">
                <div class="col-md-3">
                    <div class="card border-0 shadow-sm p-3 h-100 rounded-4" style="border-left: 5px solid #1b2a47 !important;">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <p class="text-muted text-uppercase small fw-semibold mb-1">Estudiantes Registrados</p>
                                <h2 class="fw-bold mb-0" style="color: #1b2a47;">@rep.TotalEstudiantes</h2>
                            </div>
                            <div class="rounded-circle p-3 bg-light text-primary">
                                <i class="bi bi-people-fill fs-3" style="color: #1b2a47 !important;"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="card border-0 shadow-sm p-3 h-100 rounded-4" style="border-left: 5px solid #e67e22 !important;">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <p class="text-muted text-uppercase small fw-semibold mb-1">Promedio Institucional</p>
                                <h2 class="fw-bold mb-0" style="color: #e67e22;">@rep.PromedioInstitucional.ToString("0.0") / 5.0</h2>
                            </div>
                            <div class="rounded-circle p-3 bg-light">
                                <i class="bi bi-journal-bookmark-fill fs-3" style="color: #e67e22 !important;"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="card border-0 shadow-sm p-3 h-100 rounded-4" style="border-left: 5px solid #27ae60 !important;">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <p class="text-muted text-uppercase small fw-semibold mb-1">Asistencia Consolidada</p>
                                <h2 class="fw-bold mb-0 text-success">@rep.PorcentajeAsistencia%</h2>
                            </div>
                            <div class="rounded-circle p-3 bg-light text-success">
                                <i class="bi bi-calendar-check-fill fs-3"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="card border-0 shadow-sm p-3 h-100 rounded-4" style="border-left: 5px solid #e74c3c !important;">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <p class="text-muted text-uppercase small fw-semibold mb-1">Tasa de Deserción</p>
                                <h2 class="fw-bold mb-0 text-danger">@rep.PorcentajeDesercion%</h2>
                            </div>
                            <div class="rounded-circle p-3 bg-light text-danger">
                                <i class="bi bi-person-x-fill fs-3"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SECCIÓN 1: RENDIMIENTO ACADÉMICO ANUAL -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
                    <h5 class="fw-bold mb-0" style="color: #1b2a47;">
                        <i class="bi bi-award-fill me-2" style="color: #e67e22;"></i>1. Rendimiento Académico Anual
                    </h5>
                    <span class="badge bg-light text-dark border">Cierre de Período</span>
                </div>
                <div class="card-body p-4">
                    <div class="row g-4 mb-4">
                        <div class="col-lg-8">
                            <div class="card border-0 bg-light p-3 rounded-3 h-100">
                                <h6 class="fw-bold text-secondary mb-3">Notas Promedio Finales por Área / Materia</h6>
                                <div style="position: relative; height:260px;">
                                    <canvas id="chartPromediosMateria"></canvas>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-4">
                            <div class="card border-0 bg-light p-3 rounded-3 h-100">
                                <h6 class="fw-bold text-secondary mb-3">Tasa de Aprobación vs Reprobación</h6>
                                <div style="position: relative; height:200px;" class="d-flex justify-content-center">
                                    <canvas id="chartAprobacion"></canvas>
                                </div>
                                <div class="d-flex justify-content-around text-center mt-3 pt-2 border-top">
                                    <div>
                                        <span class="badge bg-success px-2 py-1">Aprobados</span>
                                        <p class="fw-bold mb-0 mt-1">@rep.Aprobados (@rep.PorcentajeAprobacion%)</p>
                                    </div>
                                    <div>
                                        <span class="badge bg-danger px-2 py-1">Reprobados</span>
                                        <p class="fw-bold mb-0 mt-1">@rep.Reprobados (@rep.PorcentajeReprobacion%)</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ALERTA DE DATO NO DISPONIBLE EN BD (PRUEBAS SABER) -->
                    <div class="alert alert-warning border-warning d-flex align-items-center rounded-3 mb-0" role="alert">
                        <i class="bi bi-exclamation-triangle-fill fs-3 me-3 flex-shrink-0 text-warning"></i>
                        <div>
                            <h6 class="fw-bold mb-1">Resultados de Pruebas de Estado (Pruebas Saber)</h6>
                            <p class="mb-0 small">
                                <strong>Estado de Base de Datos:</strong> Los datos históricos y puntajes de exámenes nacionales (Pruebas Saber ICFES) no se encuentran registrados en la base de datos actual.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SECCIÓN 2: REGISTROS DE CONVIVENCIA Y PERMANENCIA -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
                    <h5 class="fw-bold mb-0" style="color: #1b2a47;">
                        <i class="bi bi-shield-check me-2" style="color: #e67e22;"></i>2. Registros de Convivencia y Permanencia
                    </h5>
                    <span class="badge bg-light text-dark border">Asistencia & Retención</span>
                </div>
                <div class="card-body p-4">
                    <div class="row g-4 mb-3">
                        <div class="col-md-6">
                            <div class="p-3 border rounded-3 bg-light">
                                <div class="d-flex align-items-center mb-2">
                                    <i class="bi bi-calendar-range-fill text-success fs-4 me-2"></i>
                                    <h6 class="fw-bold mb-0 text-dark">Asistencia Escolar Consolidada</h6>
                                </div>
                                <h3 class="fw-bold text-success mb-1">@rep.PorcentajeAsistencia%</h3>
                                <p class="text-muted small mb-0">Total asistencias registradas: @rep.TotalAsistencias (@rep.AsistenciasPresentes registros de presencia).</p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 border rounded-3 bg-light">
                                <div class="d-flex align-items-center mb-2">
                                    <i class="bi bi-person-dash-fill text-danger fs-4 me-2"></i>
                                    <h6 class="fw-bold mb-0 text-dark">Tasa de Deserción Escolar</h6>
                                </div>
                                <h3 class="fw-bold text-danger mb-1">@rep.PorcentajeDesercion%</h3>
                                <p class="text-muted small mb-0">Matrículas retiradas o inactivas: @rep.Desertores de @rep.TotalMatriculas matrículas procesadas.</p>
                            </div>
                        </div>
                    </div>

                    <!-- ALERTA DE DATO NO DISPONIBLE EN BD (REPITENCIA) -->
                    <div class="alert alert-warning border-warning d-flex align-items-center rounded-3 mb-0" role="alert">
                        <i class="bi bi-exclamation-triangle-fill fs-3 me-3 flex-shrink-0 text-warning"></i>
                        <div>
                            <h6 class="fw-bold mb-1">Índices de Repitencia Escolar Consecutiva</h6>
                            <p class="mb-0 small">
                                <strong>Estado de Base de Datos:</strong> El historial consecutivo de repitencia de curso por estudiante no se encuentra registrado en el esquema de base de datos actual.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SECCIÓN 3: INFORMACIÓN DE MATRÍCULA Y EGRESO -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
                    <h5 class="fw-bold mb-0" style="color: #1b2a47;">
                        <i class="bi bi-mortarboard-fill me-2" style="color: #e67e22;"></i>3. Información de Matrícula por Grado y Género
                    </h5>
                    <span class="badge bg-light text-dark border">Consolidado por Nivel</span>
                </div>
                <div class="card-body p-4">
                    <div class="row g-4">
                        <div class="col-lg-7">
                            <div class="card border-0 bg-light p-3 rounded-3 h-100">
                                <h6 class="fw-bold text-secondary mb-3">Historial de Matrícula Registrada por Grado</h6>
                                <div style="position: relative; height:240px;">
                                    <canvas id="chartMatriculasGrado"></canvas>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-5">
                            <div class="card border-0 bg-light p-3 rounded-3 h-100">
                                <h6 class="fw-bold text-secondary mb-3">Distribución por Género</h6>
                                <div style="position: relative; height:200px;" class="d-flex justify-content-center">
                                    <canvas id="chartGenero"></canvas>
                                </div>
                                <div class="d-flex justify-content-around text-center mt-3 pt-2 border-top">
                                    <div>
                                        <span class="badge bg-primary px-2 py-1">Hombres</span>
                                        <p class="fw-bold mb-0 mt-1">@rep.TotalHombres</p>
                                    </div>
                                    <div>
                                        <span class="badge px-2 py-1" style="background-color: #e84393; color: white;">Mujeres</span>
                                        <p class="fw-bold mb-0 mt-1">@rep.TotalMujeres</p>
                                    </div>
                                    @if (rep.TotalSinGenero > 0)
                                    {
                                        <div>
                                            <span class="badge bg-secondary px-2 py-1">No Esp.</span>
                                            <p class="fw-bold mb-0 mt-1">@rep.TotalSinGenero</p>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    @if (TempData.Peek("ErrorMatricula") != null)
    {
        <script>
                document.addEventListener("DOMContentLoaded", function() {
                    mostrarAdminSub('admin-certificados');
                });
        </script>
