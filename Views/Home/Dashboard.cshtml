        <!-- MÓDULO: OBSERVADOR DEL ALUMNO & CITACIONES (DOCENTE) -->
        <div id="docente-observaciones" class="d-none">
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
                <div>
                    <h3 style="color: #2980b9;" class="fw-bold mb-0"><i class="bi bi-eye-fill me-2"></i>Observador del Alumno</h3>
                    <p class="text-muted small mb-0">Seguimiento convivencial, reconocimientos de mérito, compromisos y generación de informe institucional.</p>
                </div>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-sm btn-danger text-white shadow-sm" style="border-radius: 8px;" onclick="descargarObservadorDocentePdf()">
                        <i class="bi bi-file-earmark-pdf me-1"></i> Descargar Reporte PDF
                    </button>
                    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="volverDocente()" style="border-radius: 8px;">
                        <i class="bi bi-arrow-left me-1"></i> Volver
                    </button>
                </div>
            </div>

            <!-- 1. Filtros Previos: Buscador, Grado, Curso, Jornada y Tipo de Nota -->
            <div class="card border-0 shadow-sm p-4 mb-4 rounded-3">
                <h5 class="fw-bold text-dark mb-3"><i class="bi bi-funnel-fill text-primary me-2"></i>Filtros de Búsqueda y Selección</h5>
                <div class="row g-3">
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label small fw-bold">Buscar Estudiante</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white text-muted border-end-0"><i class="bi bi-person-search"></i></span>
                            <input type="text" class="form-control border-start-0 ps-0" id="inputBuscarEstudianteObservador" placeholder="Nombre o apellido..." oninput="filtrarEstudiantesObservador()">
                        </div>
                    </div>
                    <div class="col-lg-2 col-md-3 col-sm-6">
                        <label class="form-label small fw-bold">Grado</label>
                        <select class="form-select" id="selectGradoNivelObservador" onchange="filtrarOpcionesCursosObservador(); filtrarEstudiantesObservador();">
                            <option value="todos">Todos los Grados</option>
                            <option value="6">Grado 6°</option>
                            <option value="7">Grado 7°</option>
                            <option value="8">Grado 8°</option>
                            <option value="9">Grado 9°</option>
                            <option value="10">Grado 10°</option>
                            <option value="11">Grado 11°</option>
                        </select>
                    </div>
                    <div class="col-lg-2 col-md-3 col-sm-6">
                        <label class="form-label small fw-bold">Curso / Grupo</label>
                        <select class="form-select" id="selectCursoObservador" onchange="filtrarEstudiantesObservador()">
                            <option value="todos">Todos los Cursos</option>
                            @if (ViewBag.CursosAsistencia != null)
                            {
                                foreach (var c in (IEnumerable<string>)ViewBag.CursosAsistencia)
                                {
                                    <option value="@c">@c</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-lg-2 col-md-4 col-sm-6">
                        <label class="form-label small fw-bold">Jornada</label>
                        <select class="form-select" id="selectJornadaObservador" onchange="filtrarOpcionesCursosObservador(); filtrarEstudiantesObservador();">
                            <option value="todos">Todas las Jornadas</option>
                            <option value="Mañana" selected>Mañana (M)</option>
                            <option value="Tarde">Tarde (T)</option>
                        </select>
                    </div>
                    <div class="col-lg-3 col-md-8 col-sm-6">
                        <label class="form-label small fw-bold">Tipo de Nota <span class="text-danger">*</span></label>
                        <select class="form-select" id="selectTipoNotaObservacion" onchange="cambiarCamposObservadorPorTipo()">
                            <option value="Positiva / Mérito" class="text-success fw-bold">Positiva / Mérito</option>
                            <option value="Seguimiento Académico" class="text-warning fw-bold">Seguimiento Académico (Compromiso)</option>
                            <option value="Llamado de Atención" class="text-danger fw-bold">Llamado de Atención (Disciplinario)</option>
                            <option value="Falta al Manual de Convivencia" class="text-danger">Falta al Manual de Convivencia</option>
                        </select>
                    </div>
                    <div class="col-12 mt-2">
                        <label class="form-label small fw-bold">Estudiante Seleccionado <span class="text-danger">*</span></label>
                        <select class="form-select" id="selectEstudianteObservacion" required onchange="cargarObservacionesEstudianteSeleccionado()">
                            <option value="">-- Seleccionar Estudiante --</option>
                            @if (ViewBag.EstudiantesAsistencia != null)
                            {
                                var gradosMap = ViewBag.EstudianteGradosMap as Dictionary<int, string>;
                                foreach (var est in (List<ProyectoPAE.Models.Usuario>)ViewBag.EstudiantesAsistencia)
                                {
                                    string cursoEst = (gradosMap != null && gradosMap.ContainsKey(est.ID_Usuario)) ? gradosMap[est.ID_Usuario] : "";
                                    <option value="@est.ID_Usuario" data-curso="@cursoEst">@(!string.IsNullOrEmpty(est.NOMBRES) ? $"{est.NOMBRES} {est.APELLIDOS}".Trim() : est.NOMBRE_USUARIO) @(!string.IsNullOrEmpty(cursoEst) ? $"({cursoEst})" : "")</option>
                                }
                            }
                        </select>
                    </div>
                </div>
            </div>

            <!-- 2. Formulario Dinámico de Registro según Tipo de Nota -->
            <div class="row g-4 mb-4">
                <div class="col-lg-7">
                    <div class="card border-0 shadow-sm p-4 h-100 rounded-3" style="border-top: 4px solid #2980b9 !important;">
                        <h5 class="fw-bold mb-3 text-dark"><i class="bi bi-journal-plus text-primary me-2"></i>Registrar Anotación en Observador</h5>

                        <!-- Periodo Lectivo -->
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Periodo Lectivo</label>
                            <select class="form-select form-select-sm" id="selectPeriodoObservacion">
                                <option value="1">Primer Periodo</option>
                                <option value="2">Segundo Periodo</option>
                                <option value="3">Tercer Periodo</option>
                                <option value="4">Cuarto Periodo</option>
                            </select>
                        </div>

                        <!-- BLOQUE 1: Para notas Positivas / Mérito (1 Campo) -->
                        <div id="bloqueNotaPositiva">
                            <div class="mb-3">
                                <label class="form-label small fw-semibold text-success"><i class="bi bi-star-fill me-1"></i>Descripción del Mérito <span class="text-danger">*</span></label>
                                <textarea class="form-control" id="txtDescripcionMerito" rows="4" placeholder="Detalla el logro, felicitación, mérito académico o actitudinal destacado del estudiante..."></textarea>
                            </div>
                        </div>

                        <!-- BLOQUE 2: Para notas Negativas / Seguimiento Académico / Llamado de Atención (3 Campos) -->
                        <div id="bloqueNotaNegativa" class="d-none">
                            <div class="mb-3">
                                <label class="form-label small fw-semibold text-danger"><i class="bi bi-exclamation-circle-fill me-1"></i>1. Descripción del Suceso <span class="text-danger">*</span></label>
                                <textarea class="form-control" id="txtDescripcionSuceso" rows="3" placeholder="Detalle lo sucedido, fecha/hora y hechos ocurridos en el aula o institución..."></textarea>
                            </div>

                            <div class="mb-3">
                                <label class="form-label small fw-semibold text-warning text-dark"><i class="bi bi-arrow-up-right-circle-fill me-1 text-warning"></i>2. Aspectos a Mejorar del Estudiante <span class="text-danger">*</span></label>
                                <textarea class="form-control" id="txtAspectosMejorar" rows="3" placeholder="Especifique los compromisos pedagógicos, pautas de comportamiento y acciones de mejora a adoptar..."></textarea>
                            </div>

                            <div class="mb-3">
                                <label class="form-label small fw-semibold text-primary"><i class="bi bi-person-badge-fill me-1"></i>3. Quién le Pone la Nota / Docente que Registra <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="txtQuienRegistra" value="@nombre" placeholder="Nombre completo o cargo del docente/directivo" />
                            </div>
                        </div>

                        <div class="text-end mt-3">
                            <button type="button" class="btn text-white fw-bold px-4 shadow-sm" style="background-color: #2980b9;" onclick="guardarObservacionDocente()">
                                <i class="bi bi-save me-1"></i> Registrar en Observador
                            </button>
                        </div>
                    </div>
                </div>

                <!-- 3. Formulario de Citación a Padres -->
                <div class="col-lg-5">
                    <div class="card border-0 shadow-sm p-4 h-100 rounded-3" style="border-top: 4px solid #27ae60 !important;">
                        <h5 class="fw-bold mb-3 text-dark"><i class="bi bi-envelope-paper-fill text-success me-2"></i>Enviar Citación Oficial a Acudiente</h5>
                        <p class="text-muted small">Notifica formalmente al padre de familia o tutor legal sobre novedades académicas o citaciones presenciales.</p>

                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Asunto de la Citación <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="txtAsuntoCitacion" placeholder="Ej: Citación sobre rendimiento académico - Periodo 1" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Mensaje y Fecha/Hora de Citación <span class="text-danger">*</span></label>
                            <textarea class="form-control" id="txtMensajeCitacion" rows="4" placeholder="Estimado acudiente, se solicita su presencia el día..."></textarea>
                        </div>

                        <button type="button" class="btn btn-success fw-bold w-100 mt-auto text-white" onclick="guardarCitacionDocente()">
                            <i class="bi bi-send-fill me-1"></i> Enviar Citación al Acudiente
                        </button>
                    </div>
                </div>
            </div>

            <!-- 4. Historial de Observaciones del Estudiante Seleccionado -->
            <div class="card border-0 shadow-sm p-4 rounded-3">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold text-dark mb-0"><i class="bi bi-clock-history text-secondary me-2"></i>Historial de Anotaciones en el Observador</h5>
                    <span class="badge bg-secondary" id="conteoObservacionesEstudiante">Selecciona un estudiante</span>
                </div>
                <div id="contenedorHistorialObservaciones" class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 130px;">Fecha</th>
                                <th style="width: 110px;">Periodo</th>
                                <th style="width: 170px;">Tipo de Nota</th>
                                <th>Descripción / Hechos</th>
                                <th>Aspectos a Mejorar</th>
                                <th style="width: 150px;">Docente / Autor</th>
                            </tr>
                        </thead>
                        <tbody id="cuerpoHistorialObservaciones">
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">Seleccione un estudiante para consultar su historial de observador.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- MÓDULO: CONTROL DE ASISTENCIA (DOCENTE) -->
        <div id="docente-asistencia" class="d-none">
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
                <div>
                    <h3 style="color: #2980b9;" class="fw-bold mb-0"><i class="bi bi-calendar-check me-2"></i>Control de Asistencia</h3>
                    <p class="text-muted small mb-0">Selecciona el curso y la jornada para cargar la lista de estudiantes y registrar la asistencia diaria.</p>
                </div>
                <button type="button" class="btn btn-outline-secondary btn-sm" onclick="volverDocente()" style="border-radius: 8px;">
                    <i class="bi bi-arrow-left me-1"></i> Volver
                </button>
            </div>

            <!-- Filtros: Fecha, Buscador, Grado, Curso, Jornada y Botón Rápido -->
            <div class="card border-0 shadow-sm p-4 mb-4 rounded-3">
                <div class="row g-3 align-items-end">
                    <!-- 1. Campo Fecha -->
                    <div class="col-lg-2 col-md-4 col-sm-6">
                        <label class="form-label fw-bold small text-dark"><i class="bi bi-calendar3 me-1 text-primary"></i>Fecha</label>
                        <input type="date" class="form-control" id="inputFechaAsistencia" value="@DateTime.Now.ToString("yyyy-MM-dd")">
                    </div>

                    <!-- 2. Buscador de Estudiante -->
                    <div class="col-lg-3 col-md-4 col-sm-6">
                        <label class="form-label fw-bold small text-dark"><i class="bi bi-search me-1 text-primary"></i>Buscar Estudiante</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white text-muted border-end-0"><i class="bi bi-person"></i></span>
                            <input type="text" class="form-control border-start-0 ps-0" id="inputBuscarEstudianteAsistencia" placeholder="Nombre o apellido..." oninput="filtrarAsistenciaPorCursoYJornada()">
                        </div>
                    </div>

                    <!-- 3. Grado Nivel -->
                    <div class="col-lg-2 col-md-4 col-sm-6">
                        <label class="form-label fw-bold small text-dark"><i class="bi bi-mortarboard me-1 text-primary"></i>Grado</label>
                        <select class="form-select" id="selectGradoNivelAsistencia" onchange="filtrarOpcionesCursosAsistencia(); filtrarAsistenciaPorCursoYJornada();">
                            <option value="todos">Todos los Grados</option>
                            <option value="6">Grado 6°</option>
                            <option value="7">Grado 7°</option>
                            <option value="8">Grado 8°</option>
                            <option value="9">Grado 9°</option>
                            <option value="10">Grado 10°</option>
                            <option value="11">Grado 11°</option>
                        </select>
                    </div>

                    <!-- 4. Seleccionar Grupo / Curso -->
                    <div class="col-lg-2 col-md-4 col-sm-6">
                        <label class="form-label fw-bold small text-dark"><i class="bi bi-people me-1 text-primary"></i>Curso</label>
                        <select class="form-select" id="selectGrupoAsistencia" onchange="filtrarAsistenciaPorCursoYJornada()">
                            <option value="todos">Todos los Cursos</option>
                            @if (ViewBag.CursosAsistencia != null && ((IEnumerable<string>)ViewBag.CursosAsistencia).Any())
                            {
                                foreach (var c in (IEnumerable<string>)ViewBag.CursosAsistencia)
                                {
                                    <option value="@c">@c</option>
                                }
                            }
                            else
                            {
                                <option value="601 M">601 M</option>
                                <option value="602 M">602 M</option>
                                <option value="701 M">701 M</option>
                                <option value="801 M">801 M</option>
                                <option value="901 M">901 M</option>
                                <option value="1001 M">1001 M</option>
                                <option value="1101 M">1101 M</option>
                            }
                        </select>
                    </div>

                    <!-- 5. Seleccionar Jornada (Mañana / Tarde) -->
                    <div class="col-lg-3 col-md-4 col-sm-6">
                        <label class="form-label fw-bold small text-dark"><i class="bi bi-clock-history me-1 text-primary"></i>Jornada</label>
                        <select class="form-select" id="selectJornadaAsistencia" onchange="filtrarOpcionesCursosAsistencia(); filtrarAsistenciaPorCursoYJornada();">
                            <option value="todos">Todas las Jornadas</option>
                            <option value="Mañana" selected>Mañana (M)</option>
                            <option value="Tarde">Tarde (T)</option>
                        </select>
                    </div>
                </div>

                <div class="d-flex justify-content-end mt-3">
                    <button type="button" class="btn btn-success fw-bold shadow-sm rounded-pill px-4" onclick="marcarTodosPresentes()">
                        <i class="bi bi-check-all me-1"></i> Marcar todos los visibles como Presente
                    </button>
                </div>
            </div>

            <!-- Tabla Dinámica cargada desde la Base de Datos con Paginación Client-Side -->
            <div class="card border-0 shadow-sm overflow-hidden mb-4 rounded-3">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" id="tablaAsistencia">
                        <thead class="table-dark">
                            <tr>
                                <th class="ps-3">Estudiante</th>
                                <th class="text-center" style="width: 140px;">Curso</th>
                                <th class="text-center" style="width: 220px;">Estado (P / F / R)</th>
                                <th>Observación / Justificación</th>
                            </tr>
                        </thead>
                        <tbody id="tbodyAsistencia">
                            @if (ViewBag.EstudiantesAsistencia != null && ((List<ProyectoPAE.Models.Usuario>)ViewBag.EstudiantesAsistencia).Any())
                            {
                                var listaEst = (List<ProyectoPAE.Models.Usuario>)ViewBag.EstudiantesAsistencia;
                                var gradosMap = ViewBag.EstudianteGradosMap as Dictionary<int, string>;
                                for (int i = 0; i < listaEst.Count; i++)
                                {
                                    var est = listaEst[i];
                                    var radId = i + 1;
                                    string cursoEst = (gradosMap != null && gradosMap.ContainsKey(est.ID_Usuario)) ? gradosMap[est.ID_Usuario] : "";
                                    <tr class="fila-asistencia-estudiante" data-curso="@cursoEst">
                                        <td class="ps-3 fw-bold estudiante-nombre">
                                            <input type="hidden" name="estudiante_id_asistencia" value="@est.ID_Usuario" />
                                            @(!string.IsNullOrEmpty(est.NOMBRES) ? $"{est.NOMBRES} {est.APELLIDOS}".Trim() : est.NOMBRE_USUARIO)
                                        </td>
                                        <td class="text-center">
                                            @if (!string.IsNullOrEmpty(cursoEst))
                                            {
                                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle">@cursoEst</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-muted border">-</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            <div class="btn-group btn-group-sm" role="group">
                                                <input type="radio" class="btn-check radio-estado-p" name="ast_@est.ID_Usuario" id="p_@radId" value="P" checked>
                                                <label class="btn btn-outline-success fw-bold px-3" for="p_@radId" title="Presente">P</label>

                                                <input type="radio" class="btn-check" name="ast_@est.ID_Usuario" id="f_@radId" value="F">
                                                <label class="btn btn-outline-danger fw-bold px-3" for="f_@radId" title="Falla / Ausente">F</label>

                                                <input type="radio" class="btn-check" name="ast_@est.ID_Usuario" id="r_@radId" value="R">
                                                <label class="btn btn-outline-warning fw-bold px-3" for="r_@radId" title="Retardo / Llegada Tardía">R</label>
                                            </div>
                                        </td>
                                        <td>
                                            <input type="text" class="form-control form-control-sm" name="obs_@est.ID_Usuario" placeholder="Observación opcional...">
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-4">No hay estudiantes registrados en la base de datos.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Paginación Client-Side Asistencia -->
                <div class="card-footer bg-white d-flex flex-wrap align-items-center justify-content-between gap-2 px-3 py-2 border-top">
                    <p class="text-muted small mb-0" id="infoAsistenciaPagina">Cargando...</p>
                    <nav aria-label="Paginación asistencia">
                        <ul class="pagination pagination-sm mb-0" id="paginacionAsistencia"></ul>
                    </nav>
                </div>

                <!-- Botones de Acción: Reiniciar y Guardar Asistencia -->
                <div class="p-3 bg-light d-flex justify-content-between align-items-center border-top">
                    <button type="button" class="btn btn-outline-secondary fw-bold" onclick="reiniciarAsistencias()">
                        <i class="bi bi-arrow-counterclockwise me-2"></i>Reiniciar Calificación de Asistencias
                    </button>
                    <button type="button" class="btn text-white fw-bold px-4 shadow-sm" style="background-color: #2980b9;" onclick="guardarAsistenciaYObservaciones()">
                        <i class="bi bi-save me-2"></i>Guardar Asistencia y Observaciones
                    </button>
                </div>
            </div>
        </div>

        <!-- Módulo Oculto de Gestión de Cursos Extracurriculares (Docente) -->
        <div id="docente-cursosextra" class="d-none">
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
                <div>
                    <h3 class="fw-bold mb-0" style="color: #2980b9;">
                        <i class="bi bi-stars me-2"></i>Gestión de Cursos Extracurriculares
                    </h3>
                    <p class="text-muted small mb-0">Crea talleres institucionales, define temarios de aprendizaje, límites de cupos y consulta inscripciones en tiempo real.</p>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn text-white shadow-sm" style="background-color: #2980b9; border-radius: 8px;" data-bs-toggle="modal" data-bs-target="#modalCrearCursoExtra">
                        <i class="bi bi-plus-circle me-1"></i> Publicar Nuevo Curso
                    </button>
                    <button class="btn btn-outline-secondary btn-sm" onclick="volverDocente()" style="border-radius: 8px;">
                        <i class="bi bi-arrow-left me-1"></i> Volver
                    </button>
                </div>
            </div>

            <!-- KPIs de Cursos Extracurriculares -->
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm p-3 h-100 rounded-3" style="border-left: 4px solid #2980b9 !important;">
                        <span class="text-muted text-uppercase small fw-semibold">Cursos Registrados</span>
                        <h3 class="fw-bold mb-0 text-dark">@cursosExtraDocente.Count</h3>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm p-3 h-100 rounded-3" style="border-left: 4px solid #27ae60 !important;">
                        <span class="text-muted text-uppercase small fw-semibold">Cupos Totales Ofertados</span>
                        <h3 class="fw-bold mb-0 text-success">@cursosExtraDocente.Sum(c => c.CuposTotales)</h3>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm p-3 h-100 rounded-3" style="border-left: 4px solid #f39c12 !important;">
                        <span class="text-muted text-uppercase small fw-semibold">Cupos Disponibles Libres</span>
                        <h3 class="fw-bold mb-0 text-warning">@cursosExtraDocente.Sum(c => c.CuposDisponibles)</h3>
                    </div>
                </div>
            </div>

            @if (!cursosExtraDocente.Any())
            {
                <div class="card border-0 shadow-sm p-5 text-center rounded-4 bg-white">
                    <i class="bi bi-stars text-muted display-4 mb-3"></i>
                    <h5 class="fw-bold text-secondary">Aún no has publicado ningún curso extracurricular</h5>
                    <p class="text-muted small mb-4">Haz clic en el botón inferior para abrir las inscripciones a un nuevo taller o actividad extracurricular.</p>
                    <div>
                        <button class="btn text-white px-4 py-2 shadow-sm" style="background-color: #2980b9; border-radius: 8px;" data-bs-toggle="modal" data-bs-target="#modalCrearCursoExtra">
                            <i class="bi bi-plus-circle me-2"></i> Crear Primer Curso Extracurricular
                        </button>
                    </div>
                </div>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var curso in cursosExtraDocente)
                    {
                        var pctOcupacion = curso.CuposTotales > 0 ? (int)(((double)(curso.CuposTotales - curso.CuposDisponibles) / curso.CuposTotales) * 100) : 0;
                        var estadoClase = !curso.Activo ? "bg-secondary" : (curso.CuposDisponibles == 0 ? "bg-danger" : (curso.PeriodoInscripcionAbierto ? "bg-success" : "bg-warning text-dark"));
                        var estadoTexto = !curso.Activo ? "Inactivo / Pausado" : (curso.CuposDisponibles == 0 ? "Cupos Agotados" : (curso.PeriodoInscripcionAbierto ? "Inscripciones Abiertas" : "Fuera de Periodo"));

                        <div class="col-lg-6 mb-3">
                            <div class="card border-0 shadow-sm rounded-4 h-100 p-3 bg-white" style="border-top: 4px solid #2980b9 !important;">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h5 class="fw-bold text-dark mb-0">@curso.Nombre</h5>
                                    <span class="badge @estadoClase rounded-pill px-3 py-1">@estadoTexto</span>
                                </div>

                                <p class="text-muted small mb-2">
                                    <i class="bi bi-person-fill text-primary me-1"></i><strong>Instructor:</strong> @curso.Instructor
                                    @if (!string.IsNullOrEmpty(curso.Horario))
                                    {
                                        <span class="ms-2"><i class="bi bi-clock-fill text-secondary me-1"></i>@curso.Horario</span>
                                    }
                                </p>

                                <div class="p-3 bg-light rounded-3 mb-3">
                                    <h6 class="fw-bold text-secondary small mb-1"><i class="bi bi-journal-text me-1 text-primary"></i>¿Qué se va a aprender? / Temario:</h6>
                                    <p class="small text-muted mb-0" style="white-space: pre-line;">@(string.IsNullOrWhiteSpace(curso.Descripcion) ? "Sin descripción detallada." : curso.Descripcion)</p>
                                </div>

                                <div class="row g-2 small text-muted mb-3">
                                    <div class="col-6">
                                        <div class="border p-2 rounded-2 bg-white">
                                            <span class="d-block text-secondary fw-semibold"><i class="bi bi-calendar-event me-1"></i>Inscripciones:</span>
                                            <span class="fw-bold text-dark">@curso.FechaInicioInscripcion.ToString("dd/MM/yyyy") - @curso.FechaFinInscripcion.ToString("dd/MM/yyyy")</span>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="border p-2 rounded-2 bg-white">
                                            <span class="d-block text-secondary fw-semibold"><i class="bi bi-calendar-check me-1"></i>Clases del Curso:</span>
                                            <span class="fw-bold text-dark">@curso.FechaInicio.ToString("dd/MM/yyyy") - @curso.FechaFin.ToString("dd/MM/yyyy")</span>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <div class="border p-2 rounded-2 bg-white d-flex justify-content-between align-items-center">
                                            <span><i class="bi bi-mortarboard me-1 text-primary"></i>Grados admitidos:</span>
                                            <span class="badge bg-primary text-white">Grados @(curso.GradoMin ?? 6)° a @(curso.GradoMax ?? 11)°</span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Barra de cupos -->
                                <div class="mb-3">
                                    <div class="d-flex justify-content-between align-items-center small mb-1">
                                        <span class="text-muted fw-semibold">Disponibilidad de cupos:</span>
                                        <span class="fw-bold @(curso.CuposDisponibles > 0 ? "text-success" : "text-danger")">
                                            @curso.CuposDisponibles de @curso.CuposTotales disponibles (@(curso.CuposTotales - curso.CuposDisponibles) inscritos)
                                        </span>
                                    </div>
                                    <div class="progress" style="height: 8px;">
                                        <div class="progress-bar @(pctOcupacion >= 100 ? "bg-danger" : (pctOcupacion >= 80 ? "bg-warning" : "bg-primary"))" role="progressbar" style="width: @pctOcupacion%;" aria-valuenow="@pctOcupacion" aria-valuemin="0" aria-valuemax="100"></div>
                                    </div>
                                </div>

                                <div class="d-flex justify-content-between align-items-center pt-2 border-top mt-auto">
                                    <button class="btn btn-outline-primary btn-sm rounded-pill px-3" onclick="verInscritosCursoExtra(@curso.IdExtraCurso)">
                                        <i class="bi bi-people-fill me-1"></i> Ver Inscritos (@(curso.CuposTotales - curso.CuposDisponibles))
                                    </button>
                                    <div class="d-flex gap-1">
                                        <button class="btn btn-sm @(curso.Activo ? "btn-outline-warning" : "btn-outline-success") rounded-pill px-3" onclick="cambiarEstadoCursoExtra(@curso.IdExtraCurso, @(curso.Activo ? "false" : "true"))">
                                            @(curso.Activo ? "Pausar" : "Activar")
                                        </button>
                                        <button class="btn btn-outline-danger btn-sm rounded-pill px-2" title="Eliminar curso" onclick="eliminarCursoExtra(@curso.IdExtraCurso)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- MODAL: CREAR CURSO EXTRACURRICULAR -->
        <div class="modal fade" id="modalCrearCursoExtra" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
                    <div class="modal-header text-white" style="background-color: #2980b9; border-radius: 16px 16px 0 0;">
                        <h5 class="modal-title fw-bold"><i class="bi bi-stars me-2"></i>Publicar Nuevo Curso Extracurricular</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <form id="formCrearCursoExtra" onsubmit="guardarCursoExtra(event)">
                        <div class="modal-body p-4">
                            <div class="row g-3">
                                <div class="col-md-8">
                                    <label class="form-label fw-bold small">Nombre del Curso / Taller <span class="text-danger">*</span></label>
                                    <input type="text" name="Nombre" class="form-control" placeholder="Ej: Club de Robótica y Programación, Taller de Arte y Óleo..." required />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-bold small">Docente / Instructor</label>
                                    <input type="text" name="Instructor" class="form-control" value="@nombre" placeholder="Nombre del instructor" />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold small">Categoría / Tipo de Curso <span class="text-danger">*</span></label>
                                    <select name="TipoCurso" class="form-select" required>
                                        <option value="Deportivo">⚽ Deportivo (Fútbol, Baloncesto, Voleibol, Atletismo)</option>
                                        <option value="Matemático / Académico">📐 Matemático / Académico (Olimpiadas, Robótica, Ciencias)</option>
                                        <option value="Artístico y Cultural">🎨 Artístico y Cultural (Música, Teatro, Pintura, Danza)</option>
                                        <option value="Servicio Social y Comunitario">🤝 Servicio Social y Comunitario</option>
                                    </select>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold small">Cupos Totales <span class="text-danger">*</span></label>
                                    <input type="number" name="CuposTotales" class="form-control" min="1" max="500" value="20" required />
                                </div>

                                <div class="col-12">
                                    <label class="form-label fw-bold small">¿Qué se va a aprender? / Temario y Objetivos <span class="text-danger">*</span></label>
                                    <textarea name="Descripcion" class="form-control" rows="3" placeholder="Describe los contenidos del curso, competencias a desarrollar, materiales necesarios y dinámica de las sesiones..." required></textarea>
                                </div>

                                <!-- SECCIÓN: DOCUMENTOS REQUERIDOS ORGANIZADOS POR CATEGORÍAS -->
                                <div class="col-12">
                                    <div class="card p-3 border-0 rounded-3" style="background-color: #f0f7ff; border-left: 4px solid #2980b9 !important;">
                                        <h6 class="fw-bold text-dark mb-2"><i class="bi bi-file-earmark-check-fill text-primary me-2"></i>Documentos Requeridos para la Inscripción</h6>
                                        <p class="text-muted small mb-3">Selecciona los documentos que los estudiantes deberán adjuntar obligatoriamente (formato PDF/Imagen, máx. 5 MB c/u):</p>
                                        
                                        <div class="row g-3">
                                            <!-- Categoría 1: Obligatorios -->
                                            <div class="col-md-4">
                                                <div class="p-2 bg-white rounded-3 border h-100">
                                                    <span class="d-block fw-bold text-primary small mb-2"><i class="bi bi-person-vcard me-1"></i>1. Obligatorios</span>
                                                    <div class="form-check mb-1">
                                                        <input class="form-check-input check-doc-req" type="checkbox" value="Documento de Identidad (TI / RC)" id="docReqTI" checked>
                                                        <label class="form-check-label small" for="docReqTI">Doc. de Identidad (TI / RC)</label>
                                                    </div>
                                                    <div class="form-check">
                                                        <input class="form-check-input check-doc-req" type="checkbox" value="Formato de Autorización de Padres / Acudientes" id="docReqAut" checked>
                                                        <label class="form-check-label small" for="docReqAut">Autorización de Padres</label>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Categoría 2: Salud y Emergencias -->
                                            <div class="col-md-4">
                                                <div class="p-2 bg-white rounded-3 border h-100">
                                                    <span class="d-block fw-bold text-success small mb-2"><i class="bi bi-heart-pulse me-1"></i>2. Salud y Emergencias</span>
                                                    <div class="form-check mb-1">
                                                        <input class="form-check-input check-doc-req" type="checkbox" value="Certificado Médico de Aptitud Física" id="docReqMed">
                                                        <label class="form-check-label small" for="docReqMed">Certificado Médico Aptitud</label>
                                                    </div>
                                                    <div class="form-check">
                                                        <input class="form-check-input check-doc-req" type="checkbox" value="Copia de EPS o Seguro Estudiantil" id="docReqEPS" checked>
                                                        <label class="form-check-label small" for="docReqEPS">Copia de EPS / Seguro</label>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Categoría 3: Administrativos -->
                                            <div class="col-md-4">
                                                <div class="p-2 bg-white rounded-3 border h-100">
                                                    <span class="d-block fw-bold text-warning text-dark small mb-2"><i class="bi bi-folder-check me-1 text-warning"></i>3. Administrativos</span>
                                                    <div class="form-check mb-1">
                                                        <input class="form-check-input check-doc-req" type="checkbox" value="Foto Tipo Documento 3x4 Fondo Blanco" id="docReqFoto">
                                                        <label class="form-check-label small" for="docReqFoto">Foto tipo carné 3x4</label>
                                                    </div>
                                                    <div class="form-check">
                                                        <input class="form-check-input check-doc-req" type="checkbox" value="Paz y Salvo Institucional" id="docReqPaz">
                                                        <label class="form-check-label small" for="docReqPaz">Paz y Salvo</label>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold small">Grado Mínimo Permitido</label>
                                    <select name="GradoMin" class="form-select">
                                        <option value="6" selected>6° Grado</option>
                                        <option value="7">7° Grado</option>
                                        <option value="8">8° Grado</option>
                                        <option value="9">9° Grado</option>
                                        <option value="10">10° Grado</option>
                                        <option value="11">11° Grado</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold small">Grado Máximo Permitido</label>
                                    <select name="GradoMax" class="form-select">
                                        <option value="6">6° Grado</option>
                                        <option value="7">7° Grado</option>
                                        <option value="8">8° Grado</option>
                                        <option value="9">9° Grado</option>
                                        <option value="10">10° Grado</option>
                                        <option value="11" selected>11° Grado</option>
                                    </select>
                                </div>

                                <div class="col-md-12">
                                    <label class="form-label fw-bold small">Horario / Días de Clase</label>
                                    <input type="text" name="Horario" class="form-control" placeholder="Ej: Martes y Jueves de 3:30 PM a 5:00 PM (Aula de Informática)" />
                                </div>

                                <div class="col-md-6">
                                    <div class="card p-3 bg-light border-0 rounded-3">
                                        <h6 class="fw-bold small text-primary mb-2"><i class="bi bi-calendar-event me-1"></i>Periodo de Inscripción</h6>
                                        <div class="mb-2">
                                            <label class="form-label small mb-1">Fecha Inicio Inscripción:</label>
                                            <input type="date" name="FechaInicioInscripcion" class="form-control form-control-sm" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                                        </div>
                                        <div>
                                            <label class="form-label small mb-1">Fecha Cierre Inscripción:</label>
                                            <input type="date" name="FechaFinInscripcion" class="form-control form-control-sm" value="@DateTime.Now.AddDays(15).ToString("yyyy-MM-dd")" required />
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="card p-3 bg-light border-0 rounded-3">
                                        <h6 class="fw-bold small text-success mb-2"><i class="bi bi-calendar-check me-1"></i>Periodo de Clases</h6>
                                        <div class="mb-2">
                                            <label class="form-label small mb-1">Fecha Inicio del Curso:</label>
                                            <input type="date" name="FechaInicio" class="form-control form-control-sm" value="@DateTime.Now.AddDays(16).ToString("yyyy-MM-dd")" required />
                                        </div>
                                        <div>
                                            <label class="form-label small mb-1">Fecha Fin del Curso:</label>
                                            <input type="date" name="FechaFin" class="form-control form-control-sm" value="@DateTime.Now.AddMonths(3).ToString("yyyy-MM-dd")" required />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer bg-light" style="border-radius: 0 0 16px 16px;">
                            <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancelar</button>
                            <button type="submit" class="btn text-white rounded-pill px-4 shadow-sm" style="background-color: #2980b9;">
                                <i class="bi bi-check-circle me-1"></i> Publicar Curso
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- MODAL: VER ESTUDIANTES INSCRITOS -->
        <div class="modal fade" id="modalVerInscritosExtra" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
                    <div class="modal-header text-white" style="background-color: #2980b9; border-radius: 16px 16px 0 0;">
                        <h5 class="modal-title fw-bold" id="tituloModalInscritos"><i class="bi bi-people-fill me-2"></i>Estudiantes Inscritos</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-4">
                        <div id="resumenInscritos" class="d-flex justify-content-between align-items-center mb-3 p-3 bg-light rounded-3">
                            <span class="text-muted fw-semibold" id="conteoInscritos">Cargando inscritos...</span>
                            <span class="badge bg-primary px-3 py-1" id="badgeCuposModal">--</span>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>#</th>
                                        <th>Estudiante</th>
                                        <th>Documento / Código</th>
                                        <th>Correo Electrónico</th>
                                        <th>Fecha Inscripción</th>
                                        <th>Documentos Requeridos</th>
                                        <th>Estado</th>
                                    </tr>
                                </thead>
                                <tbody id="tablaCuerpoInscritos">
                                    <tr>
                                        <td colspan="7" class="text-center py-4 text-muted">Cargando lista de inscritos...</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="modal-footer bg-light" style="border-radius: 0 0 16px 16px;">
                        <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Cerrar</button>
                    </div>
                </div>
            </div>
        </div>

        <!--  -->
        <!-- SUBPANEL: GESTIÓN DE ACTIVIDADES Y TAREAS ACADÉMICAS POR CURSO (DOCENTE) -->
        <!--  -->
        <div id="docente-actividades" class="d-none">

            <!-- VISTA 1: LISTADO DE CURSOS ASOCIADOS AL DOCENTE -->
            <div id="vistaCursosDocente">
                <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
                    <div>
                        <h3 class="fw-bold mb-1" style="color: #2980b9;">
                            <i class="bi bi-journal-check me-2"></i>Mis Cursos y Grupos Académicos
                        </h3>
                        <p class="text-muted small mb-0">Selecciona un curso para entrar a su aula virtual estilo Google Classroom, publicar tareas, revisar entregas y calificar.</p>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn text-white btn-sm shadow-sm px-3 rounded-pill" style="background-color: #2980b9;" data-bs-toggle="modal" data-bs-target="#modalCrearActividad">
                            <i class="bi bi-plus-circle me-1"></i> Nueva Actividad
                        </button>
                        <button class="btn btn-outline-secondary btn-sm rounded-pill px-4 shadow-sm" onclick="volverDocenteActividades()">
                            <i class="bi bi-arrow-left me-1"></i> Volver al Menú Principal
                        </button>
                    </div>
                </div>

                <!-- Filtros para los Cursos de Actividades -->
                <div class="card border-0 shadow-sm p-3 mb-4 rounded-3">
                    <div class="row g-2 align-items-center">
                        <div class="col-md-4">
                            <label class="form-label small fw-bold mb-1"><i class="bi bi-search me-1 text-primary"></i>Buscar Curso</label>
                            <input type="text" class="form-control form-control-sm" id="inputBuscarCursoActividades" placeholder="Escribir curso (ej: 601, 702)..." oninput="filtrarGridCursosActividades()">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold mb-1"><i class="bi bi-mortarboard me-1 text-primary"></i>Filtrar por Grado</label>
                            <select class="form-select form-select-sm" id="selectGradoNivelCursosActividades" onchange="filtrarGridCursosActividades()">
                                <option value="todos">Todos los Grados</option>
                                <option value="6">Grado 6°</option>
                                <option value="7">Grado 7°</option>
                                <option value="8">Grado 8°</option>
                                <option value="9">Grado 9°</option>
                                <option value="10">Grado 10°</option>
                                <option value="11">Grado 11°</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold mb-1"><i class="bi bi-clock-history me-1 text-primary"></i>Filtrar por Jornada</label>
                            <select class="form-select form-select-sm" id="selectJornadaCursosActividades" onchange="filtrarGridCursosActividades()">
                                <option value="todos">Todas las Jornadas</option>
                                <option value="Mañana">Mañana (M)</option>
                                <option value="Tarde">Tarde (T)</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Grid de Cursos del Docente -->
                <div class="row" id="gridCursosDocente">
                    @{
                        var cursosDocenteList = ViewBag.CursosDocente as IEnumerable<string>;
                        if (cursosDocenteList == null || !cursosDocenteList.Any())
                        {
                            cursosDocenteList = new List<string> { "601", "602", "701", "702", "801", "802", "901", "902", "1001", "1002", "1101", "1102" };
                        }
                    }
                    @foreach (var curso in cursosDocenteList)
                    {
                        var slugCurso = curso.Replace(" ", "_");
                        <div class="col-md-4 mb-4 card-curso-actividad-item" data-curso="@curso.ToLower()">
                            <div class="card p-4 text-center border-0 shadow-sm h-100 card-hover card-docente-limpia" 
                                 style="border-top: 4px solid #2980b9 !important; cursor: pointer;"
                                 onclick="entrarAClassroomDocenteCurso('@curso')">
                                <i class="bi bi-people-fill fs-2 mb-2" style="color: #2980b9;"></i>
                                <h5 style="color: #2980b9; font-weight: bold;">Curso @curso</h5>
                                <p class="small text-muted mb-2">Aula virtual y gestión académica del grupo @curso.</p>
                                
                                <div class="mb-3" id="badge-novedades-docente-@slugCurso">
                                    <span class="badge bg-light text-muted border rounded-pill px-3 py-1">
                                        <i class="bi bi-clock me-1"></i>Consultando actividades...
                                    </span>
                                </div>

                                <button class="btn btn-docente-solido btn-sm mt-auto w-100 text-white">
                                    <i class="bi bi-door-open me-1"></i> Entrar al Curso
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- VISTA 2: AULA VIRTUAL ESTILO GOOGLE CLASSROOM PARA DOCENTE -->
            <div id="vistaClassroomDocenteCurso" class="d-none">
                <!-- Barra superior Classroom Docente -->
                <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 pb-2 border-bottom gap-2">
                    <div class="d-flex align-items-center gap-3">
                        <button class="btn btn-outline-secondary btn-sm rounded-pill px-3 shadow-sm" onclick="volverAListaCursosDocente()">
                            <i class="bi bi-arrow-left me-1"></i> Mis Cursos
                        </button>
                        <h4 class="fw-bold mb-0 text-dark" id="classroomDocenteTituloTop">Curso</h4>
                    </div>

                    <!-- Pestañas estilo Google Classroom -->
                    <div class="d-flex classroom-tabs-wrapper">
                        <button class="classroom-docente-nav-tab active" id="tabClassroomDocenteTablon" onclick="cambiarTabClassroomDocente('tablon', this)">
                            <i class="bi bi-chat-square-text me-1"></i> Tablón
                        </button>
                        <button class="classroom-docente-nav-tab" id="tabClassroomDocenteTrabajo" onclick="cambiarTabClassroomDocente('trabajo', this)">
                            <i class="bi bi-card-checklist me-1"></i> Trabajo de clase
                        </button>
                        <button class="classroom-docente-nav-tab" id="tabClassroomDocentePersonas" onclick="cambiarTabClassroomDocente('personas', this)">
                            <i class="bi bi-people me-1"></i> Personas / Alumnos
                        </button>
                    </div>

                    <!-- Botón de acción rápida: Asignar Tarea -->
                    <div>
                        <button class="btn text-white btn-sm rounded-pill px-3 shadow-sm" style="background-color: #2980b9;" onclick="abrirModalCrearActividadParaCurso()">
                            <i class="bi bi-plus-circle me-1"></i> Asignar Tarea
                        </button>
                    </div>
                </div>

                <!-- Banner estilo Google Classroom Docente -->
                <div class="card border-0 rounded-4 shadow-sm text-white mb-4 position-relative overflow-hidden classroom-banner" id="classroomDocenteBannerPrincipal" style="background: linear-gradient(135deg, #0d2a4a 0%, #1565c0 50%, #2980b9 100%); min-height: 190px; padding: 2.2rem 2.5rem;">
                    <div class="position-relative" style="z-index: 2;">
                        <span class="badge bg-white text-dark px-3 py-1 rounded-pill mb-2 fw-bold shadow-sm" id="classroomDocenteBadgeGrado">AULA VIRTUAL PAE • GESTIÓN DOCENTE</span>
                        <h1 class="display-6 fw-bold mb-1" id="classroomDocenteBannerTitulo">Curso</h1>
                        <p class="fs-6 opacity-75 mb-0" id="classroomDocenteBannerDetalle">Asignación de talleres, recepción de trabajos y evaluación continua</p>
                    </div>
                    <div class="position-absolute end-0 bottom-0 opacity-25 me-4 mb-2 d-none d-md-block" style="z-index: 1;">
                        <i class="bi bi-easel2-fill" style="font-size: 8rem; color: rgba(255,255,255,0.4);"></i>
                    </div>
                </div>

                <!-- CONTENIDO: TABLÓN / TRABAJO DE CLASE (DOCENTE) -->
                <div id="seccionClassroomDocenteTablon">
                    <div class="row g-4">
                        <!-- Columna Izquierda: Resumen de Asignaciones y Pendientes -->
                        <div class="col-lg-3 col-md-4">
                            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white mb-3">
                                <h6 class="fw-bold text-dark mb-3"><i class="bi bi-bar-chart-fill me-2 text-primary"></i>Resumen del Aula</h6>
                                <div id="classroomDocenteResumenContainer">
                                    <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                                        <span class="small text-muted">Tareas Publicadas:</span>
                                        <span class="fw-bold text-dark" id="docenteMetricTotalTareas">0</span>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                                        <span class="small text-muted">Total Entregas:</span>
                                        <span class="fw-bold text-primary" id="docenteMetricTotalEntregas">0</span>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="small text-muted">Por Calificar:</span>
                                        <span class="fw-bold text-warning" id="docenteMetricPorCalificar">0</span>
                                    </div>
                                </div>
                                <div class="border-top pt-3 mt-2 text-center">
                                    <button class="btn btn-outline-primary btn-sm rounded-pill w-100" onclick="abrirModalCrearActividadParaCurso()">
                                        <i class="bi bi-plus-circle me-1"></i> Nueva Tarea
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Columna Derecha: Tablón y Lista de Actividades Publicadas -->
                        <div class="col-lg-9 col-md-8">
                            <!-- Aviso / Caja para Publicar Tarea Rápida -->
                            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white mb-3 card-hover" style="cursor: pointer;" onclick="abrirModalCrearActividadParaCurso()">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center text-white flex-shrink-0" style="width: 44px; height: 44px; background: linear-gradient(135deg, #0d2a4a, #2980b9);">
                                        <i class="bi bi-plus-lg fs-5"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <span class="text-muted small fw-bold">Publicar una nueva tarea, taller o guía pedagógica para este curso...</span>
                                    </div>
                                    <button class="btn btn-sm btn-light border rounded-pill px-3 text-secondary">
                                        <i class="bi bi-send me-1"></i> Asignar
                                    </button>
                                </div>
                            </div>

                            <!-- Stream de Actividades del Curso para Docente -->
                            <div id="classroomDocenteStreamActividades">
                                <div class="text-center py-5">
                                    <div class="spinner-border text-primary" role="status"></div>
                                    <p class="text-muted small mt-2">Cargando actividades del curso...</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- PESTAÑA: PERSONAS / ALUMNOS MATRICULADOS EN EL CURSO -->
                <div id="seccionClassroomDocentePersonas" class="d-none">
                    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
                        <h5 class="fw-bold text-dark border-bottom pb-3 mb-3" style="color: #2980b9 !important;">
                            <i class="bi bi-person-workspace me-2"></i>Profesor Titular
                        </h5>
                        <div class="d-flex align-items-center gap-3 py-2">
                            <div class="rounded-circle bg-light border d-flex align-items-center justify-content-center fw-bold" style="width: 44px; height: 44px; color: #2980b9;">
                                <i class="bi bi-person-fill fs-4"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-0 text-dark">@nombre</h6>
                                <small class="text-muted">Docente Encargado(a)</small>
                            </div>
                        </div>
                    </div>

                    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                        <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-3">
                            <h5 class="fw-bold text-dark mb-0" style="color: #2980b9 !important;">
                                <i class="bi bi-people-fill me-2"></i>Alumnos Matriculados en el Curso
                            </h5>
                            <span class="badge bg-light text-dark border rounded-pill px-3 py-1" id="badgeTotalAlumnosCurso">0 Estudiantes</span>
                        </div>
                        <div id="listaAlumnosClassroomDocente" class="row g-2">
                            <!-- Se llena dinámicamente según el curso seleccionado -->
                        </div>
                    </div>
                </div>

            </div>

        </div>

        <!-- MODAL: CREAR NUEVA ACTIVIDAD ACADÉMICA (DOCENTE) -->
        <div class="modal fade" id="modalCrearActividad" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
                    <div class="modal-header text-white" style="background: linear-gradient(135deg, #0d2a4a 0%, #2980b9 100%); border-radius: 16px 16px 0 0;">
                        <h5 class="modal-title fw-bold"><i class="bi bi-journal-plus me-2"></i>Crear Nueva Actividad / Tarea</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <form id="formCrearActividad" onsubmit="guardarNuevaActividad(event)">
                        <div class="modal-body p-4">
                            <div class="row g-3">
                                <div class="col-md-12">
                                    <label class="form-label fw-bold small">Título de la Actividad / Tarea <span class="text-danger">*</span></label>
                                    <input type="text" name="Titulo" class="form-control" placeholder="Ej: Taller 1 - Ecuaciones Cuadráticas, Ensayo Histórico..." required />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold small">Asignatura / Materia <span class="text-danger">*</span></label>
                                    <input type="text" name="Materia" list="listaMateriasSugeridas" class="form-control" placeholder="Selecciona o escribe la materia" required />
                                    <datalist id="listaMateriasSugeridas">
                                        @if (ViewBag.Asignaturas != null)
                                        {
                                            foreach (var asig in (IEnumerable<string>)ViewBag.Asignaturas)
                                            {
                                                <option value="@asig">@asig</option>
                                            }
                                        }
                                        <option value="Matemáticas">Matemáticas</option>
                                        <option value="Español y Literatura">Español y Literatura</option>
                                        <option value="Ciencias Naturales">Ciencias Naturales</option>
                                        <option value="Ciencias Sociales">Ciencias Sociales</option>
                                        <option value="Inglés">Inglés</option>
                                        <option value="Informática y Tecnología">Informática y Tecnología</option>
                                        <option value="Educación Física">Educación Física</option>
                                        <option value="Educación Artística">Educación Artística</option>
                                        <option value="Ética y Valores">Ética y Valores</option>
                                        <option value="Filosofía">Filosofía</option>
                                    </datalist>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold small">Grado / Grupo Destino</label>
                                    <select name="Grado" class="form-select">
                                        <option value="Todos">Todos los Grados</option>
                                        <option value="601">601</option>
                                        <option value="602">602</option>
                                        <option value="701">701</option>
                                        <option value="702">702</option>
                                        <option value="801">801</option>
                                        <option value="802">802</option>
                                        <option value="901">901</option>
                                        <option value="902">902</option>
                                        <option value="1001">1001</option>
                                        <option value="1002">1002</option>
                                        <option value="1101">1101</option>
                                        <option value="1102">1102</option>
                                    </select>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold small">Fecha y Hora Límite de Entrega <span class="text-danger">*</span></label>
                                    <input type="datetime-local" name="FechaLimite" class="form-control" value="@DateTime.Now.AddDays(7).ToString("yyyy-MM-ddTHH:mm")" required />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold small">Archivo Adjunto / Guía Docente (Opcional)</label>
                                    <input type="file" name="archivo" class="form-control" accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.zip,.rar,.png,.jpg,.jpeg" />
                                    <small class="text-muted" style="font-size: 0.75rem;">PDF, Word, Excel, PowerPoint, ZIP (Máx 25 MB)</small>
                                </div>

                                <div class="col-12">
                                    <label class="form-label fw-bold small">Descripción, Instrucciones y Criterios de Evaluación</label>
                                    <textarea name="Descripcion" class="form-control" rows="4" placeholder="Indica detalladamente los puntos a desarrollar, formato de entrega y rúbrica de calificación..."></textarea>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer bg-light" style="border-radius: 0 0 16px 16px;">
                            <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancelar</button>
                            <button type="submit" class="btn text-white rounded-pill px-4 shadow-sm" style="background-color: #2980b9;">
                                <i class="bi bi-cloud-arrow-up me-1"></i> Publicar Actividad
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- MODAL: REVISAR ENTREGAS Y CALIFICAR (DOCENTE) -->
        <div class="modal fade" id="modalRevisarEntregas" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
                    <div class="modal-header text-white" style="background: linear-gradient(135deg, #0d2a4a 0%, #2980b9 100%); border-radius: 16px 16px 0 0;">
                        <div>
                            <h5 class="modal-title fw-bold" id="tituloModalRevisarEntregas"><i class="bi bi-file-earmark-check me-2"></i>Entregas de Estudiantes</h5>
                            <small class="opacity-75" id="subtituloModalRevisarEntregas">Revisión, calificación y sincronización con planilla de notas</small>
                        </div>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-4">
                        <div class="alert alert-info border-0 rounded-3 d-flex align-items-center mb-3 py-2 px-3 small">
                            <i class="bi bi-info-circle-fill fs-5 me-2 text-primary"></i>
                            <span>Las calificaciones asignadas aquí (0.0 a 5.0) se <strong>guardan y sincronizan automáticamente en la Planilla Oficial de Notas</strong> del estudiante en la materia correspondiente.</span>
                        </div>

                        <!-- Buscador de Estudiante en Entregas -->
                        <div class="card border-0 shadow-sm p-3 mb-3 bg-light rounded-3">
                            <div class="row g-2 align-items-center">
                                <div class="col-md-8">
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-primary"></i></span>
                                        <input type="text" class="form-control border-start-0 ps-0 bg-white" id="inputBuscarEstudianteEntregas" placeholder="Buscar por nombre, documento o correo..." oninput="filtrarEntregasEstudiante()">
                                    </div>
                                </div>
                                <div class="col-md-4 text-md-end">
                                    <span class="badge bg-primary rounded-pill px-3 py-2" id="conteoEntregasBadge">Entregas</span>
                                </div>
                            </div>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr class="small text-uppercase text-muted">
                                        <th>Estudiante</th>
                                        <th>Fecha Entrega</th>
                                        <th>Archivo / Comentario</th>
                                        <th style="width: 130px;">Periodo</th>
                                        <th style="width: 140px;">Calificación (0-5)</th>
                                        <th style="width: 220px;">Retroalimentación</th>
                                        <th class="text-end" style="width: 120px;">Acción</th>
                                    </tr>
                                </thead>
                                <tbody id="tablaCuerpoEntregas">
                                    <tr>
                                        <td colspan="7" class="text-center py-4 text-muted">Cargando entregas...</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="modal-footer bg-light" style="border-radius: 0 0 16px 16px;">
                        <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Cerrar</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- MÓDULO: GESTIÓN DE ACCIONES DE MEJORA Y SEGUIMIENTO (DOCENTE) -->
        <div id="docente-mejoras" class="d-none">

            <!-- VISTA 1: LISTADO DE CURSOS DOCENTE PARA MEJORAS -->
            <div id="vistaCursosMejorasDocente">
                <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
                    <div>
                        <h3 class="fw-bold mb-1" style="color: #2980b9;">
                            <i class="bi bi-arrow-up-right-circle-fill me-2"></i>Seguimiento de Acciones de Mejora • Por Cursos
                        </h3>
                        <p class="text-muted small mb-0">Selecciona un curso para gestionar los compromisos de mejora pedagógica y registrar el seguimiento de cumplimiento de los estudiantes.</p>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-outline-secondary btn-sm rounded-pill px-4 shadow-sm" onclick="volverDocente()">
                            <i class="bi bi-arrow-left me-1"></i> Volver al Menú Principal
                        </button>
                    </div>
                </div>

                <!-- Filtros para los Cursos de Mejoras -->
                <div class="card border-0 shadow-sm p-3 mb-4 rounded-3">
                    <div class="row g-2 align-items-center">
                        <div class="col-md-4">
                            <label class="form-label small fw-bold mb-1"><i class="bi bi-search me-1 text-primary"></i>Buscar Curso</label>
                            <input type="text" class="form-control form-control-sm" id="inputBuscarCursoMejoras" placeholder="Escribir curso (ej: 601, 702)..." oninput="filtrarGridCursosMejoras()">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold mb-1"><i class="bi bi-mortarboard me-1 text-primary"></i>Filtrar por Grado</label>
                            <select class="form-select form-select-sm" id="selectGradoNivelCursosMejoras" onchange="filtrarGridCursosMejoras()">
                                <option value="todos">Todos los Grados</option>
                                <option value="6">Grado 6°</option>
                                <option value="7">Grado 7°</option>
                                <option value="8">Grado 8°</option>
                                <option value="9">Grado 9°</option>
                                <option value="10">Grado 10°</option>
                                <option value="11">Grado 11°</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold mb-1"><i class="bi bi-clock-history me-1 text-primary"></i>Filtrar por Jornada</label>
                            <select class="form-select form-select-sm" id="selectJornadaCursosMejoras" onchange="filtrarGridCursosMejoras()">
                                <option value="todos">Todas las Jornadas</option>
                                <option value="Mañana">Mañana (M)</option>
                                <option value="Tarde">Tarde (T)</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Grid de Cursos del Docente para Mejoras -->
                <div class="row" id="gridCursosMejorasDocente">
                    @foreach (var curso in cursosDocenteList)
                    {
                        var slugCurso = curso.Replace(" ", "_");
                        <div class="col-md-4 mb-4 card-curso-mejora-item" data-curso="@curso.ToLower()">
                            <div class="card p-4 text-center border-0 shadow-sm h-100 card-hover card-docente-limpia" 
                                 style="border-top: 4px solid #2980b9 !important; cursor: pointer;"
                                 onclick="entrarAMejorasCursoDocente('@curso')">
                                <i class="bi bi-people-fill fs-2 mb-2" style="color: #2980b9;"></i>
                                <h5 style="color: #2980b9; font-weight: bold;">Curso @curso</h5>
                                <p class="small text-muted mb-2">Acciones de mejora y compromisos para el grupo @curso.</p>
                                
                                <div class="mb-3" id="badge-mejoras-curso-@slugCurso">
                                    <span class="badge bg-light text-muted border rounded-pill px-3 py-1">
                                        <i class="bi bi-arrow-repeat me-1"></i>Consultando mejoras...
                                    </span>
                                </div>

                                <button class="btn btn-docente-solido btn-sm mt-auto w-100 text-white">
                                    <i class="bi bi-folder-check me-1"></i> Ver Estudiantes y Mejoras
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- VISTA 2: TABLERO DE ACCIONES DE MEJORA DEL CURSO SELECCIONADO -->
            <div id="vistaTableroMejorasDocenteCurso" class="d-none">
                <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2 border-bottom pb-3">
                    <div class="d-flex align-items-center gap-3">
                        <button class="btn btn-outline-secondary btn-sm rounded-pill px-3 shadow-sm" onclick="volverAListaCursosMejorasDocente()">
                            <i class="bi bi-arrow-left me-1"></i> Mis Cursos
                        </button>
                        <div>
                            <h4 class="fw-bold mb-0 text-dark" id="tituloCursoMejorasDocente">Curso</h4>
                            <small class="text-muted">Registro pedagógico: Acción de Mejora ➔ Seguimiento Posterior</small>
                        </div>
                    </div>
                    <div>
                        <button class="btn text-white btn-sm rounded-pill px-3 shadow-sm" style="background-color: #2980b9;" onclick="abrirModalCrearMejoraParaCurso()">
                            <i class="bi bi-plus-circle me-1"></i> Nueva Acción de Mejora
                        </button>
                    </div>
                </div>

                <!-- Banner Informativo del Flujo -->
                <div class="card border-0 shadow-sm rounded-4 p-4 text-white mb-4" style="background: linear-gradient(135deg, #0d2a4a 0%, #2980b9 100%);">
                    <div class="row align-items-center">
                        <div class="col-md-5 text-center text-md-start mb-2 mb-md-0">
                            <span class="badge bg-warning text-dark fw-bold px-3 py-1 rounded-pill mb-1">FASE 1</span>
                            <h5 class="fw-bold mb-1">Acción de Mejora</h5>
                            <p class="small mb-0 opacity-90">El docente establece el aspecto a mejorar y el estudiante asume el compromiso dentro de las fechas acordadas.</p>
                        </div>
                        <div class="col-md-2 text-center my-2 my-md-0">
                            <div class="fs-2 text-warning"><i class="bi bi-arrow-down-circle-fill d-md-none"></i><i class="bi bi-arrow-right-circle-fill d-none d-md-inline"></i></div>
                            <small class="fw-bold text-light opacity-75">REVISIÓN</small>
                        </div>
                        <div class="col-md-5 text-center text-md-start">
                            <span class="badge bg-success text-white fw-bold px-3 py-1 rounded-pill mb-1">FASE 2</span>
                            <h5 class="fw-bold mb-1">Seguimiento Posterior</h5>
                            <p class="small mb-0 opacity-90">Se revisa posteriormente si el compromiso fue cumplido (En Proceso / Cumplido / No Cumplido) y se refleja en notas.</p>
                        </div>
                    </div>
                </div>

                <!-- Filtros de búsqueda para el curso -->
                <div class="card border-0 shadow-sm p-3 mb-4 rounded-3">
                    <div class="row g-2 align-items-center">
                        <div class="col-md-3">
                            <label class="form-label small fw-bold mb-1"><i class="bi bi-search me-1 text-primary"></i>Buscar Estudiante</label>
                            <input type="text" class="form-control form-control-sm" id="inputBuscarEstudianteMejoraDocente" placeholder="Escribir nombre..." oninput="filtrarMejorasDocenteCurso()">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-bold mb-1"><i class="bi bi-person me-1 text-primary"></i>Estudiante</label>
                            <select class="form-select form-select-sm" id="selectFiltroEstudianteMejoraDocente" onchange="filtrarMejorasDocenteCurso()">
                                <option value="todos">Todos los estudiantes</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-bold mb-1"><i class="bi bi-book me-1 text-primary"></i>Filtrar por Asignatura</label>
                            <select class="form-select form-select-sm" id="selectFiltroMateriaMejoraDocente" onchange="filtrarMejorasDocenteCurso()">
                                <option value="todas">Todas las asignaturas</option>
                                @if (ViewBag.Asignaturas != null)
                                {
                                    foreach (var asig in (IEnumerable<string>)ViewBag.Asignaturas)
                                    {
                                        <option value="@asig">@asig</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-bold mb-1"><i class="bi bi-check-circle me-1 text-primary"></i>Estado de Seguimiento</label>
                            <select class="form-select form-select-sm" id="selectFiltroEstadoMejoraDocente" onchange="filtrarMejorasDocenteCurso()">
                                <option value="todos">Todos los estados</option>
                                <option value="En Proceso">En Proceso</option>
                                <option value="Cumplido">Cumplido</option>
                                <option value="No Cumplido">No Cumplido</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Contenedor dinámico de tarjetas de Acciones de Mejora -->
                <div id="contenedorMejorasDocenteCurso">
                    <div class="text-center py-5 text-muted">
                        <div class="spinner-border text-primary" role="status"></div>
                        <p class="mt-2">Cargando acciones de mejora del curso...</p>
                    </div>
                </div>
            </div>

            <!-- MODAL: REGISTRAR NUEVA ACCIÓN DE MEJORA (DOCENTE) -->
            <div class="modal fade" id="modalCrearAccionMejora" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered modal-lg">
                    <div class="modal-content border-0 shadow" style="border-radius: 16px; overflow: hidden;">
                        <div class="modal-header text-white" style="background: linear-gradient(135deg, #0d2a4a 0%, #2980b9 100%);">
                            <h5 class="modal-title fw-bold"><i class="bi bi-plus-circle me-2"></i>Registrar Acción de Mejora & Compromiso</h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <form id="formCrearAccionMejora" onsubmit="guardarAccionMejora(event)">
                            <div class="modal-body p-4">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold">Estudiante <span class="text-danger">*</span></label>
                                        <select class="form-select" id="modalMejoraSelectEstudiante" required>
                                            <option value="">-- Seleccionar Estudiante --</option>
                                        </select>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold">Asignatura / Materia <span class="text-danger">*</span></label>
                                        <select class="form-select" id="modalMejoraSelectMateria" required>
                                            <option value="">-- Seleccionar Asignatura --</option>
                                            @if (ViewBag.Asignaturas != null)
                                            {
                                                foreach (var mat in (IEnumerable<string>)ViewBag.Asignaturas)
                                                {
                                                    <option value="@mat">@mat</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold">Periodo Académico <span class="text-danger">*</span></label>
                                        <select class="form-select" id="modalMejoraPeriodo" required>
                                            <option value="1">Periodo 1</option>
                                            <option value="2">Periodo 2</option>
                                            <option value="3">Periodo 3</option>
                                            <option value="4">Periodo 4</option>
                                        </select>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold">Fecha Límite del Compromiso</label>
                                        <input type="date" class="form-control" id="modalMejoraFechaCompromiso" />
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label small fw-bold">Aspecto a Mejorar (Establecido por el Docente) <span class="text-danger">*</span></label>
                                        <textarea class="form-control" id="modalMejoraAspecto" rows="2" placeholder="Ej: Presenta bajo rendimiento en resolución de problemas o entrega tardía de tareas..." required></textarea>
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label small fw-bold">Compromiso del Estudiante <span class="text-danger">*</span></label>
                                        <textarea class="form-control" id="modalMejoraCompromiso" rows="2" placeholder="Ej: El estudiante establece un compromiso de entregar las actividades dentro de las fechas establecidas." required>El estudiante establece un compromiso de entregar las actividades dentro de las fechas establecidas.</textarea>
                                        <small class="text-muted">Este compromiso quedará registrado en el historial pedagógico y se reflejará en las calificaciones.</small>
                                    </div>
                                </div>
                            </div>
                            <div class="modal-footer bg-light">
                                <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancelar</button>
                                <button type="submit" class="btn btn-docente-solido rounded-pill px-4 text-white" id="btnGuardarMejoraSubmit">
                                    <i class="bi bi-check-circle me-1"></i> Guardar Acción de Mejora
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- MODAL: ACTUALIZAR SEGUIMIENTO DE MEJORA (DOCENTE) -->
            <div class="modal fade" id="modalSeguimientoMejoraDocente" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content border-0 shadow" style="border-radius: 16px; overflow: hidden;">
                        <div class="modal-header text-white" style="background: linear-gradient(135deg, #0d2a4a 0%, #2980b9 100%);">
                            <h5 class="modal-title fw-bold"><i class="bi bi-clipboard2-check me-2"></i>Seguimiento de Cumplimiento</h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <form id="formSeguimientoMejora" onsubmit="guardarSeguimientoMejoraDocente(event)">
                            <input type="hidden" id="modalSeguimientoIdMejora" />
                            <div class="modal-body p-4">
                                <div class="mb-3">
                                    <label class="form-label small fw-bold">Estado de Cumplimiento del Compromiso <span class="text-danger">*</span></label>
                                    <select class="form-select" id="modalSeguimientoEstado" required>
                                        <option value="En Proceso">⏳ En Proceso (Aún en periodo de evaluación)</option>
                                        <option value="Cumplido">✅ Cumplido (El estudiante cumplió con la entrega y el compromiso)</option>
                                        <option value="No Cumplido">❌ No Cumplido (El compromiso no fue alcanzado)</option>
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label small fw-bold">Observación Docente del Seguimiento</label>
                                    <textarea class="form-control" id="modalSeguimientoObservacion" rows="3" placeholder="Describe los avances observados o el motivo de la calificación de cumplimiento..."></textarea>
                                </div>
                                <div class="p-2 bg-light rounded small text-muted">
                                    <i class="bi bi-info-circle me-1 text-primary"></i>Esta observación se reflejará como mensaje adicional en las calificaciones del estudiante.
                                </div>
                            </div>
                            <div class="modal-footer bg-light">
                                <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancelar</button>
                                <button type="submit" class="btn btn-docente-solido rounded-pill px-4 text-white">
                                    <i class="bi bi-save me-1"></i> Guardar Seguimiento
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

        </div>

    </div> <!-- Cierre definitivo del panel-docente general -->

    <div id="panel-acudiente" class="role-panel d-none">
        <!-- 1. MENÚ PRINCIPAL ACUDIENTE -->
        <div id="acudiente-main">
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
                <h2 style="color: #27ae60;" class="mb-0"><i class="bi bi-person-heart me-2"></i>Panel de Padres y Acudientes</h2>

                <div class="d-flex align-items-center bg-success text-white px-3 py-2 rounded-pill shadow-sm">
                    <span class="small me-2 fw-bold"><i class="bi bi-person-badge me-1"></i>Hijo(a):</span>
                    <select id="selectHijo" class="form-select form-select-sm border-0 bg-transparent text-white p-0 fw-bold" style="box-shadow: none; cursor: pointer; min-width: 160px;">
                        @if (ViewBag.ListaHijos != null)
                        {
                            foreach (var hijo in ViewBag.ListaHijos)
                            {
                                <option value="@hijo.ID_Usuario" class="text-dark">
                                    @hijo.NOMBRES @hijo.APELLIDOS
                                </option>
                            }
                        }
                        else
                        {
                            <option class="text-dark">Cargando estudiantes...</option>
                        }
                    </select>
                </div>
            </div>

            <div class="row">
                <!-- 1. Calificaciones -->
                <div class="col-md-3 col-sm-6 mb-4">
                    <div class="card p-4 text-center border-0 shadow-sm h-100 card-hover card-acudiente-limpia" 
                         style="border-top: 4px solid #27ae60 !important; cursor: pointer;"
                         onclick="verCalificacionesAcudiente()">
                        <i class="bi bi-journal-text fs-2 mb-2" style="color: #27ae60;"></i>
                        <h5 style="color: #27ae60; font-weight: bold;">Calificaciones</h5>
                        <p class="small text-muted mb-3" style="min-height: 44px; display: flex; align-items: center; justify-content: center;">
                            Promedio actual: <strong id="lblPromedioHijo" class="text-success ms-1">@ViewBag.PromedioRapido</strong>
                        </p>
                        <a id="btnVerNotas" href="#" class="btn btn-acudiente-solido btn-sm mt-auto w-100 text-white">
                            Ver Calificaciones
                        </a>
                    </div>
                </div>

                <!-- 2. Asistencia -->
                <div class="col-md-3 col-sm-6 mb-4">
                    <div class="card p-4 text-center border-0 shadow-sm h-100 card-hover card-acudiente-limpia" 
                         style="border-top: 4px solid #27ae60 !important; cursor: pointer;"
                         onclick="verAsistenciaAcudiente()">
                        <i class="bi bi-calendar-check fs-2 mb-2" style="color: #27ae60;"></i>
                        <h5 style="color: #27ae60; font-weight: bold;">Asistencia</h5>
                        <p class="small text-muted mb-3" style="min-height: 44px; display: flex; align-items: center; justify-content: center;">
                            Fallas registradas: <strong id="lblFallasHijo" class="text-danger ms-1">@(ViewBag.FallasRapidas ?? 0)</strong>
                        </p>
                        <button class="btn btn-acudiente-solido btn-sm mt-auto w-100 text-white">
                            Ver Asistencia
                        </button>
                    </div>
                </div>

                <!-- 3. Citaciones -->
                <div class="col-md-3 col-sm-6 mb-4">
                    <div class="card p-4 text-center border-0 shadow-sm h-100 card-hover card-acudiente-limpia" 
                         style="border-top: 4px solid #27ae60 !important; cursor: pointer;"
                         onclick="verCitacionesAcudiente()">
                        <i class="bi bi-envelope-paper-fill fs-2 mb-2" style="color: #27ae60;"></i>
                        <h5 style="color: #27ae60; font-weight: bold;">Citaciones</h5>
                        <p class="small text-muted mb-3" style="min-height: 44px; display: flex; align-items: center; justify-content: center;">
                            Citaciones activas: <strong id="lblCitacionesHijo" class="text-primary ms-1">@(ViewBag.TotalCitaciones ?? 0)</strong>
                        </p>
                        <button class="btn btn-acudiente-solido btn-sm mt-auto w-100 text-white">
                            Ver Citaciones
                        </button>
                    </div>
                </div>

                <!-- 4. Observador -->
                <div class="col-md-3 col-sm-6 mb-4">
                    <div class="card p-4 text-center border-0 shadow-sm h-100 card-hover card-acudiente-limpia" 
                         style="border-top: 4px solid #27ae60 !important; cursor: pointer;"
                         onclick="verObservadorAcudiente()">
                        <i class="bi bi-eye-fill fs-2 mb-2" style="color: #27ae60;"></i>
                        <h5 style="color: #27ae60; font-weight: bold;">Observador</h5>
                        <p class="small text-muted mb-3" style="min-height: 44px; display: flex; align-items: center; justify-content: center;">
                            Anotaciones: <strong id="lblObservadorHijo" class="text-warning ms-1">@(ViewBag.TotalObservaciones ?? 0)</strong>
                        </p>
                        <button class="btn btn-acudiente-solido btn-sm mt-auto w-100 text-white">
                            Ver Observador
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. SUBPANEL: ASISTENCIA (ACUDIENTE) -->
        <div id="acudiente-asistencia" class="d-none">
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
                <div>
                    <h3 class="fw-bold mb-1" style="color: #27ae60;">
                        <i class="bi bi-calendar-check me-2"></i>Historial de Asistencia del Estudiante
                    </h3>
                    <p class="text-muted small mb-0">Consulta el registro diario de asistencia escolar, justificaciones y fallas.</p>
                </div>
                <button class="btn btn-outline-secondary btn-sm rounded-pill px-4 shadow-sm" onclick="volverAcudiente()">
                    <i class="bi bi-arrow-left me-1"></i> Volver al Menú Principal
                </button>
            </div>

            <!-- Resumen KPIs -->
            <div class="row g-3 mb-4 text-center">
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm p-3 bg-white rounded-4" style="border-top: 4px solid #27ae60 !important;">
                        <span class="d-block small text-success fw-bold text-uppercase">Presentes</span>
                        <h3 class="fw-bold mb-0 text-success" id="kpiPresentesModal">@(ViewBag.PresentesRapidos ?? 0)</h3>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm p-3 bg-white rounded-4" style="border-top: 4px solid #e74c3c !important;">
                        <span class="d-block small text-danger fw-bold text-uppercase">Fallas</span>
                        <h3 class="fw-bold mb-0 text-danger" id="kpiFallasModal">@(ViewBag.FallasRapidas ?? 0)</h3>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm p-3 bg-white rounded-4" style="border-top: 4px solid #f39c12 !important;">
                        <span class="d-block small text-warning fw-bold text-uppercase">Retardos</span>
                        <h3 class="fw-bold mb-0 text-warning" id="kpiRetardosModal">@(ViewBag.RetardosRapidos ?? 0)</h3>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <h5 class="fw-bold text-dark mb-3"><i class="bi bi-list-check me-2" style="color: #27ae60;"></i>Registro Detallado de Asistencias</h5>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" id="tablaAsistenciaModal">
                        <thead class="table-light">
                            <tr>
                                <th>Fecha</th>
                                <th>Estado</th>
                                <th>Observación / Justificación</th>
                            </tr>
                        </thead>
                        <tbody id="tbodyAsistenciasModal">
                            @if (ViewBag.ListaAsistencias != null && ((List<ProyectoPAE.Models.Asistencia>)ViewBag.ListaAsistencias).Any())
                            {
                                foreach (var a in (List<ProyectoPAE.Models.Asistencia>)ViewBag.ListaAsistencias)
                                {
                                    string est = a.estado?.ToLower() ?? "";
                                    string badgeClass = est.Contains("falla") || est == "f" ? "bg-danger text-white" : (est.Contains("retardo") || est == "r" ? "bg-warning text-dark" : "bg-success text-white");
                                    string textoEstado = est.Contains("falla") || est == "f" ? "Falla" : (est.Contains("retardo") || est == "r" ? "Retardo" : "Presente");
                                    <tr>
                                        <td>@a.fecha.ToString("dd/MM/yyyy")</td>
                                        <td><span class="badge @badgeClass rounded-pill px-3 py-1">@textoEstado</span></td>
                                        <td>@(string.IsNullOrWhiteSpace(a.justificacion) ? "-" : a.justificacion)</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr id="sinAsistenciasRow">
                                    <td colspan="3" class="text-center text-muted py-4">No hay registros de asistencia para este estudiante.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- 3. SUBPANEL: CITACIONES (ACUDIENTE) -->
        <div id="acudiente-citaciones" class="d-none">
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
                <div>
                    <h3 class="fw-bold mb-1" style="color: #27ae60;">
                        <i class="bi bi-envelope-paper me-2"></i>Buzón de Citaciones y Comunicados
                    </h3>
                    <p class="text-muted small mb-0">Revisa los llamados, citaciones institucionales y avisos enviados por los profesores.</p>
                </div>
                <button class="btn btn-outline-secondary btn-sm rounded-pill px-4 shadow-sm" onclick="volverAcudiente()">
                    <i class="bi bi-arrow-left me-1"></i> Volver al Menú Principal
                </button>
            </div>

            <div id="listaCitaciones">
                @if (ViewBag.ListaCitaciones != null && ((List<ProyectoPAE.Models.Citacion>)ViewBag.ListaCitaciones).Any())
                {
                    foreach (var cita in (List<ProyectoPAE.Models.Citacion>)ViewBag.ListaCitaciones)
                    {
                        <div class="card border-0 shadow-sm mb-3 bg-white rounded-4 p-3" style="border-left: 5px solid #27ae60 !important;">
                            <div class="card-body p-2">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h5 class="fw-bold text-success mb-0">@cita.asunto</h5>
                                    <span class="badge bg-light text-dark border rounded-pill px-3 py-1">@cita.fecha.ToString("dd/MM/yyyy")</span>
                                </div>
                                <p class="mb-3 text-dark" style="font-size: 0.95rem;">@cita.mensaje</p>
                                <div class="border-top pt-2 mt-2">
                                    <small class="text-muted"><i class="bi bi-person-circle me-1 text-success"></i><strong>Remitente:</strong> @cita.remitente</small>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white" id="sinCitacionesMsg">
                        <i class="bi bi-chat-left-x fs-1 text-muted mb-2"></i>
                        <h5 class="fw-bold text-secondary">Sin citaciones pendientes</h5>
                        <p class="text-muted small mb-0">No tienes citaciones o mensajes pendientes para este estudiante.</p>
                    </div>
                }
            </div>
        </div>

        <!-- 4. SUBPANEL: OBSERVADOR (ACUDIENTE) -->
        <div id="acudiente-observador" class="d-none">
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
                <div>
                    <h3 class="fw-bold mb-1" style="color: #27ae60;">
                        <i class="bi bi-eye-fill me-2"></i>Observador del Alumno (Convivencia y Disciplina)
                    </h3>
                    <p class="text-muted small mb-0">Seguimiento integral, méritos y observaciones de comportamiento registradas por el cuerpo docente.</p>
                </div>
                <button class="btn btn-outline-secondary btn-sm rounded-pill px-4 shadow-sm" onclick="volverAcudiente()">
                    <i class="bi bi-arrow-left me-1"></i> Volver al Menú Principal
                </button>
            </div>

            <div id="listaObservacionesHijo">
                @if (ViewBag.ListaObservaciones != null && ((List<ProyectoPAE.Models.ObservacionEstudiante>)ViewBag.ListaObservaciones).Any())
                {
                    foreach (var obs in (List<ProyectoPAE.Models.ObservacionEstudiante>)ViewBag.ListaObservaciones)
                    {
                        string tipo = obs.tipo_nota?.ToLower() ?? "";
                        string borderCol = tipo.Contains("positiva") || tipo.Contains("merito") ? "#27ae60" : (tipo.Contains("llamado") || tipo.Contains("atencion") ? "#e74c3c" : "#f39c12");
                        string badgeCol = tipo.Contains("positiva") || tipo.Contains("merito") ? "bg-success" : (tipo.Contains("llamado") || tipo.Contains("atencion") ? "bg-danger" : "bg-warning text-dark");
                        <div class="card border-0 shadow-sm mb-3 bg-white rounded-4 p-3" style="border-left: 5px solid @borderCol !important;">
                            <div class="card-body p-2">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="badge @badgeCol rounded-pill px-3 py-1">@obs.tipo_nota</span>
                                    <span class="badge bg-light text-dark border rounded-pill px-3 py-1">@obs.fecha.ToString("dd/MM/yyyy")</span>
                                </div>
                                <p class="mb-3 text-dark" style="font-size: 0.95rem;">@obs.descripcion</p>
                                <div class="border-top pt-2 mt-2">
                                    <small class="text-muted"><i class="bi bi-person-badge me-1 text-primary"></i><strong>Docente:</strong> @obs.docente</small>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white" id="sinObservacionesMsg">
                        <i class="bi bi-journal-check fs-1 text-muted mb-2"></i>
                        <h5 class="fw-bold text-secondary">Sin anotaciones en el observador</h5>
                        <p class="text-muted small mb-0">El estudiante no registra llamados de atención ni anotaciones disciplinarias.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <div id="panel-estudiante" class="role-panel d-none">
        <div id="estudiante-main">
            <h2 class="mb-4" style="color: #6f42c1;"><i class="bi bi-mortarboard-fill me-2"></i>Mi Panel Académico</h2>

            <!-- MÓDULOS DEL ESTUDIANTE (CON ESTILO Y TAMAÑO idénticos al Docente en morado) -->
            <div class="row">
                <!-- 1. Horario de Clases -->
                <div class="col-md-4 mb-4">
                    <div class="card p-4 text-center border-0 shadow-sm h-100 card-hover card-estudiante-limpia"
                         style="border-top: 4px solid #6f42c1 !important;">
                        <i class="bi bi-calendar3 fs-2 mb-2" style="color: #6f42c1;"></i>
                        <h5 style="color: #6f42c1; font-weight: bold;">Horario de Clases</h5>
                        <p class="small text-muted">Consulta tus materias y salones.</p>

                        <a href="@Url.Action("MiHorario", "Horario")"
                           class="btn btn-estudiante-solido btn-sm mt-auto w-100 text-white">
                            Ver Horario
                        </a>
                    </div>
                </div>

                <!-- 2. Mis Calificaciones -->
                <div class="col-md-4 mb-4">
                    <div class="card p-4 text-center border-0 shadow-sm h-100 card-hover card-estudiante-limpia"
                         style="border-top: 4px solid #6f42c1 !important; cursor: pointer;"
                         onclick="location.href='@Url.Action("MisNotas", "Estudiante")'">
                        <i class="bi bi-file-earmark-bar-graph fs-2 mb-2" style="color: #6f42c1;"></i>
                        <h5 style="color: #6f42c1; font-weight: bold;">Mis Calificaciones</h5>
                        <p class="small text-muted">Consulta tu rendimiento académico.</p>
                        <a href="@Url.Action("MisNotas", "Estudiante")" class="btn btn-estudiante-solido btn-sm mt-auto w-100 text-white">
                            Ver Notas
                        </a>
                    </div>
                </div>

                <!-- 3. Actividades -->
                <div class="col-md-4 mb-4">
                    <div class="card p-4 text-center border-0 shadow-sm h-100 card-hover card-estudiante-limpia"
                         style="border-top: 4px solid #6f42c1 !important; cursor: pointer;"
                         onclick="verActividadesEstudiante()">
                        <i class="bi bi-list-task fs-2 mb-2" style="color: #6f42c1;"></i>
                        <h5 style="color: #6f42c1; font-weight: bold;">Actividades</h5>
                        <p class="small text-muted">Tareas y trabajos pendientes.</p>
                        <button class="btn btn-estudiante-solido btn-sm mt-auto w-100 text-white">Ver Tareas</button>
                    </div>
                </div>

                <!-- 4. Cursos Extracurriculares -->
                <div class="col-md-4 mb-4">
                    <div class="card p-4 text-center border-0 shadow-sm h-100 card-hover card-estudiante-limpia"
                         style="border-top: 4px solid #6f42c1 !important; cursor: pointer;"
                         onclick="verCursosExtra()">
                        <i class="bi bi-stars fs-2 mb-2" style="color: #6f42c1;"></i>
                        <h5 style="color: #6f42c1; font-weight: bold;">Cursos Extracurriculares</h5>
                        <p class="small text-muted">Actividades y talleres adicionales.</p>
                        <button class="btn btn-estudiante-solido btn-sm mt-auto w-100 text-white">Ver Cursos</button>
                    </div>
                </div>

                <!-- 5. Acciones de Mejora -->
                <div class="col-md-4 mb-4 element-modulo-estudiante">
                    <div class="card p-4 text-center border-0 shadow-sm h-100 card-hover card-estudiante-limpia"
                         style="border-top: 4px solid #6f42c1 !important; cursor: pointer;"
                         onclick="verModuloMejoras()">
                        <i class="bi bi-arrow-up-right-circle fs-2 mb-2" style="color: #6f42c1;"></i>
                        <h5 style="color: #6f42c1; font-weight: bold;">Mis Mejoras</h5>
                        <p class="small text-muted">Seguimiento y cumplimiento de tus acciones de mejora.</p>
                        <button class="btn btn-estudiante-solido btn-sm mt-auto w-100 text-white">Ver Mejoras</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Módulos Ocultos -->
        <div id="estudiante-calificaciones" class="d-none">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h3 style="color: #6f42c1;"><i class="bi bi-journal-check me-2"></i>Mis Calificaciones</h3>
                <button class="btn btn-outline-secondary btn-sm" onclick="volverEstudiante()">Volver</button>
            </div>
            <div class="card border-0 shadow-sm p-4">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Asignatura</th>
                            <th>Tarea 1</th>
                            <th>Examen</th>
                            <th>Definitiva</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Matemáticas</td>
                            <td>4.5</td>
                            <td>3.8</td>
                            <td><span class="badge bg-success">4.2</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- SUBPANEL: GESTIÓN DE MATERIAS Y AULA VIRTUAL GOOGLE CLASSROOM -->
        <div id="estudiante-actividades" class="d-none">

            <!-- VISTA 1: LISTADO DE MATERIAS ASOCIADAS (AULA VIRTUAL) -->
            <div id="vistaMateriasEstudiante">
                <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
                    <div>
                        <h3 class="fw-bold mb-1" style="color: #6f42c1;">
                            <i class="bi bi-journal-bookmark-fill me-2"></i>Mis Materias y Asignaturas
                        </h3>
                        <p class="text-muted small mb-0">Selecciona tu materia para entrar a su aula virtual, consultar tareas, fechas límite y avisos docentes.</p>
                    </div>
                    <button class="btn btn-outline-secondary btn-sm rounded-pill px-4 shadow-sm" onclick="volverEstudiante()">
                        <i class="bi bi-arrow-left me-1"></i> Volver al Menú Principal
                    </button>
                </div>

                <!-- Grid de Materias -->
                <div class="row" id="gridMateriasEstudiante">
                    @if (ViewBag.MateriasEstudiante != null)
                    {
                        var materiasList = (IEnumerable<string>)ViewBag.MateriasEstudiante;
                        foreach (var mat in materiasList)
                        {
                            var slug = mat.Replace(" ", "_").Replace("á","a").Replace("é","e").Replace("í","i").Replace("ó","o").Replace("ú","u").Replace("ñ","n");
                            string icono = "bi-book-fill";
                            if (mat.Contains("Matemát")) icono = "bi-calculator-fill";
                            else if (mat.Contains("Español") || mat.Contains("Lengua")) icono = "bi-journal-text";
                            else if (mat.Contains("Naturales") || mat.Contains("Biolog")) icono = "bi-flower1";
                            else if (mat.Contains("Sociales") || mat.Contains("Hist")) icono = "bi-globe-americas";
                            else if (mat.Contains("Inglés") || mat.Contains("Idioma")) icono = "bi-translate";
                            else if (mat.Contains("Tecnolog") || mat.Contains("Inform")) icono = "bi-laptop-fill";
                            else if (mat.Contains("Física")) icono = "bi-activity";
                            else if (mat.Contains("Ética")) icono = "bi-heart-fill";

                            <div class="col-md-4 mb-4">
                                <div class="card p-4 text-center border-0 shadow-sm h-100 card-hover card-estudiante-limpia" 
                                     style="border-top: 4px solid #6f42c1 !important; cursor: pointer;"
                                     onclick="entrarAClassroomMateria('@mat')">
                                    <i class="bi @icono fs-2 mb-2" style="color: #6f42c1;"></i>
                                    <h5 style="color: #6f42c1; font-weight: bold;">@mat</h5>
                                    <p class="small text-muted mb-2">Consulta tus tareas y novedades de @mat.</p>
                                    
                                    <div class="mb-3" id="badge-novedades-@slug">
                                        <span class="badge bg-light text-muted border rounded-pill px-3 py-1">
                                            <i class="bi bi-clock me-1"></i>Consultando novedades...
                                        </span>
                                    </div>

                                    <button class="btn btn-estudiante-solido btn-sm mt-auto w-100 text-white">
                                        <i class="bi bi-door-open me-1"></i> Entrar a la Materia
                                    </button>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            <!-- VISTA 2: AULA VIRTUAL ESTILO GOOGLE CLASSROOM -->
            <div id="vistaClassroomMateria" class="d-none">
                <!-- Barra superior Classroom -->
                <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 pb-2 border-bottom gap-2">
                    <div class="d-flex align-items-center gap-3">
                        <button class="btn btn-outline-secondary btn-sm rounded-pill px-3 shadow-sm" onclick="volverAListaMaterias()">
                            <i class="bi bi-arrow-left me-1"></i> Mis Materias
                        </button>
                        <h4 class="fw-bold mb-0 text-dark" id="classroomTituloTop">Materia</h4>
                    </div>

                    <!-- Pestañas estilo Google Classroom -->
                    <div class="d-flex classroom-tabs-wrapper">
                        <button class="classroom-nav-tab active" id="tabClassroomTablon" onclick="cambiarTabClassroom('tablon', this)">
                            <i class="bi bi-chat-square-text me-1"></i> Tablón
                        </button>
                        <button class="classroom-nav-tab" id="tabClassroomTrabajo" onclick="cambiarTabClassroom('trabajo', this)">
                            <i class="bi bi-card-checklist me-1"></i> Trabajo de clase
                        </button>
                        <button class="classroom-nav-tab" id="tabClassroomPersonas" onclick="cambiarTabClassroom('personas', this)">
                            <i class="bi bi-people me-1"></i> Personas
                        </button>
                    </div>
                </div>

                <!-- Banner estilo Google Classroom (Naranja / Gradiente vibrante como la foto) -->
                <div class="card border-0 rounded-4 shadow-sm text-white mb-4 position-relative overflow-hidden classroom-banner" id="classroomBannerPrincipal" style="background: linear-gradient(135deg, #d84315 0%, #f4511e 50%, #fb8c00 100%); min-height: 190px; padding: 2.2rem 2.5rem;">
                    <div class="position-relative" style="z-index: 2;">
                        <span class="badge bg-white text-dark px-3 py-1 rounded-pill mb-2 fw-bold shadow-sm" id="classroomBadgeGrado">AULA VIRTUAL PAE</span>
                        <h1 class="display-6 fw-bold mb-1" id="classroomBannerNombreMateria">Materia</h1>
                        <p class="fs-6 opacity-75 mb-0" id="classroomBannerDetalle">Docente Titular • Espacio de aprendizaje interactivo</p>
                    </div>
                    <div class="position-absolute end-0 bottom-0 opacity-25 me-4 mb-2 d-none d-md-block" style="z-index: 1;">
                        <i class="bi bi-mortarboard-fill" style="font-size: 8rem; color: rgba(255,255,255,0.4);"></i>
                    </div>
                </div>

                <!-- CONTENIDO: TABLÓN / TRABAJO DE CLASE -->
                <div id="seccionClassroomTablon">
                    <div class="row g-4">
                        <!-- Columna Izquierda: Próximas entregas -->
                        <div class="col-lg-3 col-md-4">
                            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white mb-3">
                                <h6 class="fw-bold text-dark mb-3">Próximas entregas</h6>
                                <div id="classroomProximasEntregasContainer">
                                    <p class="text-muted small mb-0">¡No tienes entregas pendientes para pronto!</p>
                                </div>
                                <div class="border-top pt-2 mt-3 text-end">
                                    <a href="javascript:void(0)" onclick="cambiarTabClassroom('trabajo', document.getElementById('tabClassroomTrabajo'))" class="small fw-bold text-decoration-none" style="color: #d84315;">
                                        Ver todo
                                    </a>
                                </div>
                            </div>
                        </div>

                        <!-- Columna Derecha: Tablón y Lista de Actividades como Google Classroom -->
                        <div class="col-lg-9 col-md-8">
                            <!-- Aviso / Anuncio de la clase -->
                            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white mb-3 d-flex flex-row align-items-center gap-3">
                                <div class="rounded-circle d-flex align-items-center justify-content-center text-white flex-shrink-0" style="width: 42px; height: 42px; background: linear-gradient(135deg, #6f42c1, #5a32a3);">
                                    <i class="bi bi-megaphone-fill"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <span class="text-muted small">Tablón de avisos y novedades de clase. Consulta a continuación las tareas publicadas por el docente.</span>
                                </div>
                            </div>

                            <!-- Lista de actividades en formato Google Classroom -->
                            <div id="classroomStreamActividades">
                                <div class="text-center py-5">
                                    <div class="spinner-border" style="color: #6f42c1;" role="status"></div>
                                    <p class="text-muted small mt-2">Cargando actividades...</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- PESTAÑA: PERSONAS (Docente y Compañeros de Aula) -->
                <div id="seccionClassroomPersonas" class="d-none">
                    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
                        <h5 class="fw-bold text-dark border-bottom pb-3 mb-3" style="color: #d84315 !important;">
                            <i class="bi bi-person-workspace me-2"></i>Profesores
                        </h5>
                        <div class="d-flex align-items-center gap-3 py-2">
                            <div class="rounded-circle bg-light border d-flex align-items-center justify-content-center fw-bold text-primary" style="width: 44px; height: 44px;">
                                <i class="bi bi-person-fill fs-4"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-0 text-dark">Docente Titular de la Asignatura</h6>
                                <small class="text-muted">Docente Encargado(a)</small>
                            </div>
                        </div>
                    </div>

                    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                        <h5 class="fw-bold text-dark border-bottom pb-3 mb-3" style="color: #d84315 !important;">
                            <i class="bi bi-people-fill me-2"></i>Compañeros de clase
                        </h5>
                        <p class="text-muted small mb-0">Estudiantes matriculados en esta misma asignatura y periodo académico institucional.</p>
                    </div>
                </div>

            </div>

        </div>

        <!-- MODAL: DETALLE Y ENTREGA DE ACTIVIDAD (ESTILO GOOGLE CLASSROOM PANTALLA COMPLETA) -->
        <div class="modal fade" id="modalSubirEntregaActividad" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
            <div class="modal-dialog modal-fullscreen">
                <div class="modal-content border-0 bg-light">
                    <!-- HEADER ESTILO CLASSROOM -->
                    <div class="modal-header bg-white border-bottom px-4 py-3 d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-3">
                            <button type="button" class="btn btn-outline-secondary btn-sm rounded-circle p-2" data-bs-dismiss="modal" title="Volver a la clase">
                                <i class="bi bi-arrow-left fs-5"></i>
                            </button>
                            <div>
                                <span class="badge rounded-pill text-white px-3 py-1 me-2 fw-bold" style="background-color: #6f42c1;" id="entregaMateriaBadge">Materia</span>
                                <span class="text-secondary small" id="classroomDetalleBreadcrumb">Aula Virtual &gt; Detalle de Tarea</span>
                            </div>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <!-- BODY ESTILO GOOGLE CLASSROOM (2 COLUMNAS) -->
                    <div class="modal-body p-4 overflow-auto">
                        <div class="container-fluid" style="max-width: 1300px;">
                            <div class="row g-4">
                                <!-- COLUMNA IZQUIERDA: DETALLES DE LA TAREA, INSTRUCCIONES, ARCHIVOS DEL DOCENTE Y COMENTARIOS -->
                                <div class="col-lg-8 col-xl-8">
                                    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                                        <div class="d-flex align-items-start gap-3 mb-3">
                                            <div class="rounded-circle d-flex align-items-center justify-content-center text-white flex-shrink-0 shadow-sm" 
                                                 style="width: 52px; height: 52px; background: linear-gradient(135deg, #e65100, #ff9800);">
                                                <i class="bi bi-clipboard-check-fill fs-3"></i>
                                            </div>
                                            <div class="flex-grow-1">
                                                <h2 class="fw-bold text-dark mb-1" id="entregaTituloActividad">Título de la Actividad</h2>
                                                <div class="text-muted small">
                                                    <span id="entregaDocenteNombre">Docente Titular</span> • <span id="entregaMateriaActividad" class="fw-bold text-dark">Materia</span>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- PUNTOS Y FECHA DE ENTREGA -->
                                        <div class="d-flex justify-content-between align-items-center small py-2 mb-3 border-bottom text-muted">
                                            <span class="fw-bold text-secondary">
                                                <i class="bi bi-award me-1 text-warning"></i>100 puntos / Escala institucional 5.0
                                            </span>
                                            <span class="fw-bold text-danger">
                                                <i class="bi bi-clock-history me-1"></i>Fecha de entrega: <span id="entregaFechaLimiteActividad">--</span>
                                            </span>
                                        </div>

                                        <!-- DESCRIPCIÓN E INSTRUCCIONES -->
                                        <div class="my-3">
                                            <h6 class="fw-bold text-secondary small text-uppercase mb-2">Instrucciones:</h6>
                                            <p class="text-dark" id="entregaDescripcionActividad" style="white-space: pre-line; line-height: 1.7; font-size: 0.98rem;">
                                                Lee atentamente la guía asignada y redacta tu respuesta o adjunta los archivos solicitados antes del plazo establecido.
                                            </p>
                                        </div>

                                        <!-- ARCHIVOS ADJUNTOS POR EL DOCENTE (TARJETA TIPO CLASSROOM) -->
                                        <div id="contenedorGuiaDocenteModal" class="mb-4 d-none">
                                            <h6 class="fw-bold text-secondary small text-uppercase mb-2"><i class="bi bi-paperclip me-1"></i>Materiales adjuntos</h6>
                                            <a id="btnDescargarGuiaDocente" href="#" target="_blank" class="card border rounded-3 text-decoration-none p-3 d-flex flex-row align-items-center gap-3 bg-white card-hover shadow-sm">
                                                <div class="rounded-3 d-flex align-items-center justify-content-center bg-danger-subtle text-danger" style="width: 48px; height: 48px;">
                                                    <i class="bi bi-file-earmark-pdf-fill fs-3"></i>
                                                </div>
                                                <div>
                                                    <h6 class="fw-bold text-dark mb-0" id="nombreArchivoGuiaDocente">Guía o Taller de Trabajo</h6>
                                                    <small class="text-primary"><i class="bi bi-download me-1"></i>Descargar material adjunto para desarrollar la tarea</small>
                                                </div>
                                            </a>
                                        </div>

                                        <!-- RETROALIMENTACIÓN Y NOTA SI ESTÁ CALIFICADA -->
                                        <div id="contenedorRetroalimentacionModal" class="p-3 rounded-4 bg-success-subtle border border-success-subtle mb-4 d-none">
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <span class="fw-bold text-success"><i class="bi bi-check-circle-fill me-1"></i>Calificación del Docente</span>
                                                <span class="badge bg-success fs-6 px-3 py-1" id="badgeNotaCalificacionModal">5.0 / 5.0</span>
                                            </div>
                                            <p class="small text-dark mb-0" id="textoRetroalimentacionModal"></p>
                                        </div>

                                        <!-- COMENTARIOS DE LA CLASE (ESTILO CLASSROOM) -->
                                        <div class="mt-4 pt-3 border-top">
                                            <h6 class="fw-bold text-dark mb-3"><i class="bi bi-people me-2"></i>Comentarios de la clase</h6>
                                            <div class="d-flex align-items-center gap-3">
                                                <div class="rounded-circle bg-light border text-secondary d-flex align-items-center justify-content-center fw-bold" style="width: 40px; height: 40px;">
                                                    <i class="bi bi-person-fill"></i>
                                                </div>
                                                <input type="text" class="form-control rounded-pill bg-light" placeholder="Añadir un comentario a la clase..." id="inputComentarioClaseFicticio" />
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- COLUMNA DERECHA: "TU TRABAJO" Y "COMENTARIOS PRIVADOS" (ESTILO GOOGLE CLASSROOM) -->
                                <div class="col-lg-4 col-xl-4">
                                    <!-- TARJETA: TU TRABAJO -->
                                    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-3">
                                        <div class="d-flex justify-content-between align-items-center mb-3">
                                            <h5 class="fw-bold text-dark mb-0">Tu trabajo</h5>
                                            <span class="badge rounded-pill px-3 py-1 fw-bold fs-6" id="badgeEstadoEntregaModal">Asignada</span>
                                        </div>

                                        <!-- SI YA ENTREGÓ ARCHIVO PREVIAMENTE -->
                                        <div id="contenedorArchivoYaEntregado" class="mb-3 d-none">
                                            <label class="small text-muted fw-bold mb-1"><i class="bi bi-file-earmark-check me-1"></i>Archivo entregado:</label>
                                            <div class="p-3 border rounded-3 bg-light d-flex align-items-center justify-content-between">
                                                <div class="d-flex align-items-center gap-2 text-truncate">
                                                    <i class="bi bi-file-earmark-arrow-up-fill text-success fs-4"></i>
                                                    <a href="#" target="_blank" id="linkArchivoYaEntregado" class="small fw-bold text-dark text-truncate text-decoration-underline">Archivo.pdf</a>
                                                </div>
                                                <span class="badge bg-success-subtle text-success border border-success-subtle">Subido</span>
                                            </div>
                                        </div>

                                        <!-- SI YA ENVIÓ TEXTO ESCRITO PREVIAMENTE -->
                                        <div id="contenedorTextoYaEntregado" class="mb-3 d-none">
                                            <label class="small text-muted fw-bold mb-1"><i class="bi bi-chat-left-text me-1"></i>Tu respuesta escrita anterior:</label>
                                            <div class="p-2 border rounded-3 bg-light small text-dark mb-2" id="textoYaEntregado" style="white-space: pre-line; max-height: 120px; overflow-y: auto;"></div>
                                        </div>

                                        <!-- FORMULARIO DE ENTREGA -->
                                        <form id="formSubirEntregaActividad" onsubmit="guardarEntregaEstudiante(event)">
                                            <input type="hidden" id="idActividadEntrega" name="idActividad" />

                                            <div class="mb-3">
                                                <label class="form-label small fw-bold text-dark mb-1">
                                                    <i class="bi bi-pencil-square text-primary me-1"></i>Respuesta escrita / Enlace:
                                                </label>
                                                <textarea id="inputComentarioEntrega" name="comentario" class="form-control rounded-3" rows="4" 
                                                          placeholder="Escribe tu desarrollo, resumen o pega enlaces web (Drive, Docs, Canva, etc.)..."></textarea>
                                            </div>

                                            <div class="mb-3">
                                                <label class="form-label small fw-bold text-dark mb-1 d-flex justify-content-between align-items-center">
                                                    <span><i class="bi bi-paperclip text-primary me-1"></i>+ Añadir archivo de trabajo:</span>
                                                    <span class="badge bg-light text-muted border">Máx. 5MB</span>
                                                </label>
                                                <input type="file" id="inputArchivoEntrega" name="archivo" class="form-control form-control-sm rounded-pill" 
                                                       accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.zip,.rar,.png,.jpg,.jpeg" onchange="validarTamanoArchivoEntrega(this)" />
                                                <small class="text-muted d-block mt-1" style="font-size: 0.75rem;">Formatos: PDF, Word, Excel, PowerPoint, ZIP, Imágenes</small>
                                            </div>

                                            <button type="submit" class="btn btn-primary w-100 rounded-pill py-2 fw-bold shadow-sm" id="btnEnviarEntrega" style="background-color: #1a73e8; border-color: #1a73e8;">
                                                <i class="bi bi-send-fill me-1"></i> <span id="textoBotonEntregaModal">Entregar</span>
                                            </button>
                                        </form>
                                    </div>

                                    <!-- TARJETA: COMENTARIOS PRIVADOS (ESTILO CLASSROOM) -->
                                    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                                        <h6 class="fw-bold text-dark mb-2"><i class="bi bi-lock-fill me-2 text-secondary"></i>Comentarios privados</h6>
                                        <p class="text-muted small mb-3">Envía un mensaje privado visible únicamente para tu profesor sobre esta actividad.</p>
                                        <div class="input-group">
                                            <input type="text" class="form-control rounded-start-pill small" placeholder="Añadir comentario privado..." id="inputComentarioPrivadoFicticio" />
                                            <button class="btn btn-outline-secondary rounded-end-pill" type="button" onclick="enviarComentarioPrivadoFicticio()"><i class="bi bi-send"></i></button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div id="estudiante-cursosextra" class="d-none">
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
                <div>
                    <h3 class="fw-bold mb-0" style="color: #6f42c1;">
                        <i class="bi bi-stars me-2"></i>Cursos Extracurriculares
                    </h3>
                    <p class="text-muted small mb-0">Explora talleres y actividades complementarias, consulta temarios y asegura tu cupo en tiempo real.</p>
                </div>
                <button class="btn btn-outline-secondary btn-sm" onclick="volverEstudiante()" style="border-radius: 8px;">
                    <i class="bi bi-arrow-left me-1"></i> Volver
                </button>
            </div>

            <!-- Navegación por pestañas: Catálogo vs Mis Inscripciones -->
            <ul class="nav nav-pills mb-4" id="pills-tab-extra" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active rounded-pill px-4 fw-bold" id="pills-catalogo-tab" data-bs-toggle="pill" data-bs-target="#pills-catalogo" type="button" role="tab" aria-controls="pills-catalogo" aria-selected="true" style="border: 1px solid #6f42c1;">
                        <i class="bi bi-grid-fill me-2"></i>Catálogo Disponible (@cursosExtraEstudiante.Count(c => c.Activo))
                    </button>
                </li>
                <li class="nav-item ms-2" role="presentation">
                    <button class="nav-link rounded-pill px-4 fw-bold text-dark" id="pills-miscursos-tab" data-bs-toggle="pill" data-bs-target="#pills-miscursos" type="button" role="tab" aria-controls="pills-miscursos" aria-selected="false" style="border: 1px solid #dee2e6;">
                        <i class="bi bi-check2-circle me-2"></i>Mis Cursos Inscritos (@misCursosExtraInscritos.Count)
                    </button>
                </li>
            </ul>

            <div class="tab-content" id="pills-tabContent-extra">
                <!-- PESTAÑA 1: CATÁLOGO DISPONIBLE -->
                <div class="tab-pane fade show active" id="pills-catalogo" role="tabpanel" aria-labelledby="pills-catalogo-tab">
                    @if (!cursosExtraEstudiante.Any(c => c.Activo))
                    {
                        <div class="card border-0 shadow-sm p-5 text-center rounded-4 bg-white">
                            <i class="bi bi-stars text-muted display-4 mb-3"></i>
                            <h5 class="fw-bold text-secondary">No hay cursos extracurriculares abiertos en este momento</h5>
                            <p class="text-muted small mb-0">Los docentes publicarán nuevas actividades y talleres complementarios próximamente. ¡Mantente atento!</p>
                        </div>
                    }
                    else
                    {
                        <div class="row g-3">
                            @foreach (var curso in cursosExtraEstudiante.Where(c => c.Activo))
                            {
                                var pctOcupacion = curso.CuposTotales > 0 ? (int)(((double)(curso.CuposTotales - curso.CuposDisponibles) / curso.CuposTotales) * 100) : 0;
                                var esGradoValido = curso.EsGradoValido(gradoEstudianteSesion);

                                <div class="col-lg-6 mb-3">
                                    <div class="card border-0 shadow-sm rounded-4 h-100 p-3 bg-white card-hover position-relative" style="border-top: 4px solid #6f42c1 !important;">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <h5 class="fw-bold text-dark mb-0" style="color: #4a154b;">@curso.Nombre</h5>
                                            @if (curso.EstaInscrito)
                                            {
                                                <span class="badge bg-success rounded-pill px-3 py-1"><i class="bi bi-check-circle-fill me-1"></i>Inscrito</span>
                                            }
                                            else if (curso.CuposDisponibles <= 0)
                                            {
                                                <span class="badge bg-danger rounded-pill px-3 py-1">Cupos Agotados</span>
                                            }
                                            else if (!curso.PeriodoInscripcionAbierto)
                                            {
                                                <span class="badge bg-secondary rounded-pill px-3 py-1">Inscripciones Cerradas</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-primary rounded-pill px-3 py-1" style="background-color: #6f42c1 !important;">Inscripción Abierta</span>
                                            }
                                        </div>

                                        <p class="text-muted small mb-2">
                                            <i class="bi bi-person-badge text-purple me-1" style="color: #6f42c1;"></i><strong>Docente:</strong> @curso.Instructor
                                            @if (!string.IsNullOrEmpty(curso.Horario))
                                            {
                                                <span class="ms-2"><i class="bi bi-clock-fill text-muted me-1"></i>@curso.Horario</span>
                                            }
                                        </p>

                                        <div class="p-3 rounded-3 mb-3" style="background-color: #f8f5fc; border-left: 3px solid #6f42c1;">
                                            <h6 class="fw-bold small mb-1" style="color: #6f42c1;">
                                                <i class="bi bi-mortarboard-fill me-1"></i>¿Qué vas a aprender?
                                            </h6>
                                            <p class="small text-muted mb-0" style="white-space: pre-line;">@(string.IsNullOrWhiteSpace(curso.Descripcion) ? "Sin descripción detallada." : curso.Descripcion)</p>
                                        </div>

                                        <div class="row g-2 small text-muted mb-3">
                                            <div class="col-6">
                                                <div class="border p-2 rounded-2 bg-light">
                                                    <span class="d-block text-secondary fw-semibold"><i class="bi bi-calendar-event me-1"></i>Inscripciones hasta:</span>
                                                    <span class="fw-bold text-dark">@curso.FechaFinInscripcion.ToString("dd/MM/yyyy")</span>
                                                </div>
                                            </div>
                                            <div class="col-6">
                                                <div class="border p-2 rounded-2 bg-light">
                                                    <span class="d-block text-secondary fw-semibold"><i class="bi bi-calendar-check me-1"></i>Inicio de clases:</span>
                                                    <span class="fw-bold text-dark">@curso.FechaInicio.ToString("dd/MM/yyyy")</span>
                                                </div>
                                            </div>
                                            <div class="col-12">
                                                <div class="border p-2 rounded-2 bg-light d-flex justify-content-between align-items-center">
                                                    <span><i class="bi bi-people me-1" style="color: #6f42c1;"></i>Rango de grados permitidos:</span>
                                                    <span class="badge text-white" style="background-color: #6f42c1;">Grados @(curso.GradoMin ?? 6)° a @(curso.GradoMax ?? 11)°</span>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Barra de cupos disponibles -->
                                        <div class="mb-3">
                                            <div class="d-flex justify-content-between align-items-center small mb-1">
                                                <span class="text-muted fw-semibold">Disponibilidad de cupos:</span>
                                                <span class="fw-bold @(curso.CuposDisponibles > 0 ? "text-success" : "text-danger")">
                                                    @curso.CuposDisponibles de @curso.CuposTotales cupos libres
                                                </span>
                                            </div>
                                            <div class="progress" style="height: 8px;">
                                                <div class="progress-bar @(pctOcupacion >= 100 ? "bg-danger" : (pctOcupacion >= 80 ? "bg-warning" : "bg-success"))" role="progressbar" style="width: @pctOcupacion%;" aria-valuenow="@pctOcupacion" aria-valuemin="0" aria-valuemax="100"></div>
                                            </div>
                                        </div>

                                        <!-- Botones de Acción -->
                                        <div class="d-flex justify-content-between align-items-center pt-2 border-top mt-auto">
                                            @if (curso.EstaInscrito)
                                            {
                                                <div class="d-flex align-items-center gap-2 w-100 justify-content-between">
                                                    <span class="text-success small fw-bold"><i class="bi bi-check-circle me-1"></i>Inscrito el @curso.FechaInscripcionEstudiante?.ToString("dd/MM/yyyy")</span>
                                                    @if (curso.IdInscripcion.HasValue)
                                                    {
                                                        <button class="btn btn-outline-danger btn-sm rounded-pill px-3" onclick="cancelarInscripcionEstudiante(@curso.IdInscripcion.Value, '@curso.Nombre')">
                                                            <i class="bi bi-x-circle me-1"></i> Cancelar Cupo
                                                        </button>
                                                    }
                                                </div>
                                            }
                                            else if (curso.CuposDisponibles <= 0)
                                            {
                                                <button class="btn btn-secondary btn-sm rounded-pill w-100 py-2" disabled>
                                                    <i class="bi bi-slash-circle me-1"></i> Cupos Agotados
                                                </button>
                                            }
                                            else if (!curso.PeriodoInscripcionAbierto)
                                            {
                                                <button class="btn btn-outline-secondary btn-sm rounded-pill w-100 py-2" disabled>
                                                    <i class="bi bi-clock-history me-1"></i> Fuera de periodo de inscripción
                                                </button>
                                            }
                                            else if (!esGradoValido)
                                            {
                                                <button class="btn btn-outline-warning text-dark btn-sm rounded-pill w-100 py-2" disabled>
                                                    <i class="bi bi-exclamation-triangle me-1"></i> No admitido para tu grado actual (@(gradoEstudianteSesion.HasValue ? $"{gradoEstudianteSesion}°" : "-"))
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn text-white btn-sm rounded-pill w-100 py-2 shadow-sm" style="background-color: #6f42c1;" onclick="inscribirseEstudiante(@curso.IdExtraCurso, '@curso.Nombre')">
                                                    <i class="bi bi-pencil-square me-1"></i> Inscribirme a este Curso
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- PESTAÑA 2: MIS CURSOS INSCRITOS -->
                <div class="tab-pane fade" id="pills-miscursos" role="tabpanel" aria-labelledby="pills-miscursos-tab">
                    @if (!misCursosExtraInscritos.Any())
                    {
                        <div class="card border-0 shadow-sm p-5 text-center rounded-4 bg-white">
                            <i class="bi bi-journal-x text-muted display-4 mb-3"></i>
                            <h5 class="fw-bold text-secondary">Aún no estás inscrito en ningún curso extracurricular</h5>
                            <p class="text-muted small mb-4">Revisa el catálogo disponible e inscríbete para aprovechar las actividades extracurriculares de la institución.</p>
                            <div>
                                <button class="btn text-white rounded-pill px-4 py-2 shadow-sm" style="background-color: #6f42c1;" onclick="document.getElementById('pills-catalogo-tab').click();">
                                    <i class="bi bi-search me-1"></i> Ver Catálogo Disponible
                                </button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="row g-3">
                            @foreach (var miCurso in misCursosExtraInscritos)
                            {
                                <div class="col-lg-6 mb-3">
                                    <div class="card border-0 shadow-sm rounded-4 h-100 p-3 bg-white" style="border-left: 5px solid #27ae60 !important;">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <h5 class="fw-bold text-dark mb-0">@miCurso.Nombre</h5>
                                            <span class="badge bg-success rounded-pill px-3 py-1"><i class="bi bi-check-circle me-1"></i>Activo</span>
                                        </div>

                                        <p class="text-muted small mb-2">
                                            <i class="bi bi-person-badge me-1 text-success"></i><strong>Docente:</strong> @miCurso.Instructor
                                            @if (!string.IsNullOrEmpty(miCurso.Horario))
                                            {
                                                <span class="ms-2"><i class="bi bi-clock-fill text-muted me-1"></i>@miCurso.Horario</span>
                                            }
                                        </p>

                                        <div class="p-3 bg-light rounded-3 mb-3">
                                            <h6 class="fw-bold text-secondary small mb-1"><i class="bi bi-info-circle me-1"></i>Temario:</h6>
                                            <p class="small text-muted mb-0">@(string.IsNullOrWhiteSpace(miCurso.Descripcion) ? "Sin descripción." : miCurso.Descripcion)</p>
                                        </div>

                                        <div class="row g-2 small text-muted mb-3">
                                            <div class="col-6">
                                                <div class="border p-2 rounded-2 bg-white">
                                                    <span class="d-block text-secondary fw-semibold">Fecha de Inscripción:</span>
                                                    <span class="fw-bold text-dark">@miCurso.FechaInscripcionEstudiante?.ToString("dd/MM/yyyy")</span>
                                                </div>
                                            </div>
                                            <div class="col-6">
                                                <div class="border p-2 rounded-2 bg-white">
                                                    <span class="d-block text-secondary fw-semibold">Periodo de Clases:</span>
                                                    <span class="fw-bold text-dark">@miCurso.FechaInicio.ToString("dd/MM/yyyy") - @miCurso.FechaFin.ToString("dd/MM/yyyy")</span>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- SECCIÓN: COLA DE DOCUMENTOS REQUERIDOS PARA EL ESTUDIANTE -->
                                        <div class="p-3 rounded-3 mb-3 border bg-light">
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <h6 class="fw-bold text-dark mb-0 small"><i class="bi bi-folder-symlink-fill text-primary me-1"></i>Documentos de Inscripción (Máx 5 MB)</h6>
                                                <span class="badge bg-secondary" style="font-size: 0.72rem;">Requisitos Obligatorios</span>
                                            </div>

                                            @if (miCurso.DocumentosRequeridosLista != null && miCurso.DocumentosRequeridosLista.Any())
                                            {
                                                <div class="d-flex flex-column gap-2">
                                                    @foreach (var docNombre in miCurso.DocumentosRequeridosLista)
                                                    {
                                                        var subido = miCurso.DocumentosSubidos != null ? miCurso.DocumentosSubidos.FirstOrDefault(d => d.TipoDocumento == docNombre) : null;
                                                        var estaCargado = subido != null && !string.IsNullOrEmpty(subido.RutaArchivo);

                                                        <div class="p-2 bg-white rounded-2 border d-flex flex-wrap justify-content-between align-items-center gap-2">
                                                            <div class="d-flex align-items-center gap-2">
                                                                <i class="bi @(estaCargado ? "bi-check-circle-fill text-success" : "bi-file-earmark-arrow-up text-warning") fs-6"></i>
                                                                <div>
                                                                    <span class="d-block small fw-bold text-dark" style="font-size: 0.8rem;">@docNombre</span>
                                                                    @if (estaCargado)
                                                                    {
                                                                        <small class="text-muted" style="font-size: 0.72rem;">Cargado el @subido!.FechaSubida.ToString("dd/MM/yyyy HH:mm")</small>
                                                                    }
                                                                    else
                                                                    {
                                                                        <small class="text-danger" style="font-size: 0.72rem;">Pendiente por adjuntar</small>
                                                                    }
                                                                </div>
                                                            </div>

                                                            <div class="d-flex align-items-center gap-1">
                                                                @if (estaCargado)
                                                                {
                                                                    <a href="@subido!.RutaArchivo" target="_blank" class="btn btn-sm btn-outline-success rounded-pill px-2 py-0" style="font-size: 0.75rem;" title="Ver archivo cargado">
                                                                        <i class="bi bi-eye"></i> Ver
                                                                    </a>
                                                                    <label class="btn btn-sm btn-outline-secondary rounded-pill px-2 py-0 mb-0" style="font-size: 0.75rem; cursor: pointer;" title="Reemplazar archivo">
                                                                        <i class="bi bi-arrow-repeat"></i>
                                                                        <input type="file" class="d-none" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png" onchange="subirDocumentoEstudianteExtra(@miCurso.IdInscripcion, '@docNombre', this)" />
                                                                    </label>
                                                                }
                                                                else
                                                                {
                                                                    <label class="btn btn-sm btn-primary rounded-pill px-3 py-1 mb-0 shadow-sm" style="font-size: 0.75rem; cursor: pointer; background-color: #6f42c1; border-color: #6f42c1;">
                                                                        <i class="bi bi-upload me-1"></i> Adjuntar
                                                                        <input type="file" class="d-none" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png" onchange="subirDocumentoEstudianteExtra(@miCurso.IdInscripcion, '@docNombre', this)" />
                                                                    </label>
                                                                }
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <small class="text-muted fst-italic">Este curso no requiere entrega de documentos adicionales.</small>
                                            }
                                        </div>

                                        <div class="d-flex justify-content-between align-items-center pt-2 border-top mt-auto">
                                            <span class="text-success small fw-semibold"><i class="bi bi-shield-check me-1"></i>Cupo asegurado</span>
                                            @if (miCurso.IdInscripcion.HasValue)
                                            {
                                                <button class="btn btn-outline-danger btn-sm rounded-pill px-3" onclick="cancelarInscripcionEstudiante(@miCurso.IdInscripcion.Value, '@miCurso.Nombre')">
                                                    <i class="bi bi-x-circle me-1"></i> Cancelar Inscripción
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <div id="estudiante-mejoras" class="d-none">

            <!-- VISTA 1: LISTADO DE MATERIAS PARA MEJORAS -->
            <div id="vistaMateriasMejorasEstudiante">
                <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
                    <div>
                        <h3 class="fw-bold mb-1" style="color: #6f42c1;">
                            <i class="bi bi-arrow-up-right-circle-fill me-2"></i>Mis Acciones de Mejora • Por Asignatura
                        </h3>
                        <p class="text-muted small mb-0">Selecciona tu asignatura para consultar tus compromisos académicos, aspectos a mejorar y el estado de seguimiento docente.</p>
                    </div>
                    <button class="btn btn-outline-secondary btn-sm rounded-pill px-4 shadow-sm" onclick="volverEstudiante()">
                        <i class="bi bi-arrow-left me-1"></i> Volver al Menú Principal
                    </button>
                </div>

                <!-- Grid de Materias del Estudiante -->
                <div class="row" id="gridMateriasMejorasEstudiante">
                    @if (ViewBag.MateriasEstudiante != null)
                    {
                        var materiasMejoraList = (IEnumerable<string>)ViewBag.MateriasEstudiante;
                        foreach (var mat in materiasMejoraList)
                        {
                            var slugMat = mat.Replace(" ", "_").Replace("á","a").Replace("é","e").Replace("í","i").Replace("ó","o").Replace("ú","u").Replace("ñ","n");
                            string iconoMat = "bi-journal-bookmark";
                            if (mat.Contains("Matemát")) iconoMat = "bi-calculator-fill";
                            else if (mat.Contains("Español") || mat.Contains("Lengua")) iconoMat = "bi-journal-text";
                            else if (mat.Contains("Naturales") || mat.Contains("Biolog")) iconoMat = "bi-flower1";
                            else if (mat.Contains("Sociales") || mat.Contains("Hist")) iconoMat = "bi-globe-americas";
                            else if (mat.Contains("Inglés") || mat.Contains("Idioma")) iconoMat = "bi-translate";
                            else if (mat.Contains("Tecnolog") || mat.Contains("Inform")) iconoMat = "bi-laptop-fill";

                            <div class="col-md-4 mb-4">
                                <div class="card p-4 text-center border-0 shadow-sm h-100 card-hover card-estudiante-limpia" 
                                     style="border-top: 4px solid #6f42c1 !important; cursor: pointer;"
                                     onclick="entrarAMejorasMateriaEstudiante('@mat')">
                                    <i class="bi @iconoMat fs-2 mb-2" style="color: #6f42c1;"></i>
                                    <h5 style="color: #6f42c1; font-weight: bold;">@mat</h5>
                                    <p class="small text-muted mb-2">Compromisos y acciones de mejora en @mat.</p>
                                    
                                    <div class="mb-3" id="badge-mejoras-est-@slugMat">
                                        <span class="badge bg-light text-muted border rounded-pill px-3 py-1">
                                            <i class="bi bi-arrow-repeat me-1"></i>Consultando compromisos...
                                        </span>
                                    </div>

                                    <button class="btn btn-estudiante-solido btn-sm mt-auto w-100 text-white">
                                        <i class="bi bi-door-open me-1"></i> Ver Mis Compromisos
                                    </button>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            <!-- VISTA 2: TABLERO DE ACCIONES DE MEJORA DE LA MATERIA SELECCIONADA -->
            <div id="vistaTableroMejorasEstudianteMateria" class="d-none">
                <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2 border-bottom pb-3">
                    <div class="d-flex align-items-center gap-3">
                        <button class="btn btn-outline-secondary btn-sm rounded-pill px-3 shadow-sm" onclick="volverAListaMateriasMejorasEstudiante()">
                            <i class="bi bi-arrow-left me-1"></i> Mis Materias
                        </button>
                        <div>
                            <h4 class="fw-bold mb-0 text-dark" id="tituloMateriaMejorasEstudiante">Materia</h4>
                            <small class="text-muted">Compromiso de entrega y seguimiento pedagógico</small>
                        </div>
                    </div>
                </div>

                <!-- Banner Informativo del Flujo Estudiante -->
                <div class="card border-0 shadow-sm rounded-4 p-4 text-white mb-4" style="background: linear-gradient(135deg, #3b0764 0%, #6f42c1 100%);">
                    <div class="row align-items-center">
                        <div class="col-md-5 text-center text-md-start mb-2 mb-md-0">
                            <span class="badge bg-warning text-dark fw-bold px-3 py-1 rounded-pill mb-1">FASE 1 • COMPROMISO</span>
                            <h5 class="fw-bold mb-1">Acción de Mejora</h5>
                            <p class="small mb-0 opacity-90">El estudiante establece un compromiso de entregar las actividades dentro de las fechas establecidas.</p>
                        </div>
                        <div class="col-md-2 text-center my-2 my-md-0">
                            <div class="fs-2 text-warning"><i class="bi bi-arrow-down-circle-fill d-md-none"></i><i class="bi bi-arrow-right-circle-fill d-none d-md-inline"></i></div>
                            <small class="fw-bold text-light opacity-75">REVISIÓN</small>
                        </div>
                        <div class="col-md-5 text-center text-md-start">
                            <span class="badge bg-success text-white fw-bold px-3 py-1 rounded-pill mb-1">FASE 2 • SEGUIMIENTO</span>
                            <h5 class="fw-bold mb-1">Seguimiento Docente</h5>
                            <p class="small mb-0 opacity-90">Se revisa posteriormente si el compromiso fue cumplido y se refleja en tus calificaciones oficiales.</p>
                        </div>
                    </div>
                </div>

                <!-- Contenedor dinámico de tarjetas de Acciones de Mejora del Estudiante -->
                <div id="contenedorMejorasEstudianteMateria">
                    <div class="text-center py-5 text-muted">
                        <div class="spinner-border text-purple" role="status" style="color: #6f42c1;"></div>
                        <p class="mt-2">Cargando compromisos de la materia...</p>
                    </div>
                </div>
            </div>

            <!-- MODAL: REGISTRAR AVANCE O RESPUESTA DEL ESTUDIANTE -->
            <div class="modal fade" id="modalAvanceEstudianteMejora" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content border-0 shadow" style="border-radius: 16px; overflow: hidden;">
                        <div class="modal-header text-white" style="background: linear-gradient(135deg, #3b0764 0%, #6f42c1 100%);">
                            <h5 class="modal-title fw-bold"><i class="bi bi-chat-left-dots me-2"></i>Registrar Avance de Mi Compromiso</h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <form id="formAvanceEstudianteMejora" onsubmit="guardarAvanceEstudianteMejora(event)">
                            <input type="hidden" id="modalAvanceIdMejora" />
                            <div class="modal-body p-4">
                                <div class="mb-3">
                                    <label class="form-label small fw-bold">Escribe tu avance, mensaje o respuesta al docente <span class="text-danger">*</span></label>
                                    <textarea class="form-control" id="modalAvanceTexto" rows="4" placeholder="Ej: Ya he realizado la entrega de la guía de actividades y el taller correspondiente en el aula virtual dentro del plazo..." required></textarea>
                                </div>
                                <div class="p-2 bg-light rounded small text-muted">
                                    <i class="bi bi-info-circle me-1 text-primary"></i>Tu docente podrá visualizar este avance para revisar el cumplimiento de tu compromiso.
                                </div>
                            </div>
                            <div class="modal-footer bg-light">
                                <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancelar</button>
                                <button type="submit" class="btn btn-estudiante-solido rounded-pill px-4 text-white">
                                    <i class="bi bi-send me-1"></i> Enviar Avance
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<script>
    /**
     * Oculta todos los paneles y subsecciones de la interfaz SPA.
     */
    function ocultarTodo() {
        const subs = [
            'admin-main', 'admin-matricula', 'admin-usuarios', 'admin-certificados', 'admin-notificaciones', 'admin-asignacion', 'admin-reportes',
            'docente-main', 'docente-planilla', 'docente-asistencia', 'docente-observaciones', 'docente-mejoras', 'docente-cursosextra', 'docente-actividades',
            'estudiante-main', 'estudiante-calificaciones', 'estudiante-actividades', 'estudiante-cursosextra', 'estudiante-mejoras',
            'acudiente-main', 'acudiente-asistencia', 'acudiente-citaciones', 'acudiente-observador'
        ];

        const panelesPrincipales = [
            'panel-admin', 'panel-docente', 'panel-estudiante', 'panel-acudiente'
        ];

        subs.forEach(id => {
            const el = document.getElementById(id);
            if (el) el.classList.add('d-none');
        });

        panelesPrincipales.forEach(id => {
            const p = document.getElementById(id);
            if (p) p.classList.add('d-none');
        });
    }

    /**
     * Cambia la vista activa según el selector o el rol enviado.
     */
    function switchRole() {
        const selector = document.getElementById('roleSelector');
        const inputRol = document.getElementById('rolOculto');

        let role = '';

        if (selector && selector.value) {
            role = selector.value.toLowerCase().trim();
        } else if (inputRol && inputRol.value) {
            role = inputRol.value.toLowerCase().trim();
        }

        if (!role) return;

        if (role === 'administrador') {
            role = 'admin';
        } else if (role === 'padre') {
            role = 'acudiente';
        } else if (role === 'profesor') {
            role = 'docente';
        }

        ocultarTodo();

        const panel = document.getElementById('panel-' + role);
        if (panel) {
            panel.classList.remove('d-none');

            const subMain = document.getElementById(role + '-main');
            if (subMain) subMain.classList.remove('d-none');

            if (role === 'estudiante') {
                cargarActividadesEstudiante();
            }
        }
    }

    // --- FUNCIONES DE NAVEGACIÓN ADMINISTRADOR ---
    function verMatricula() { ocultarTodo(); mostrarSubpanel('panel-admin', 'admin-matricula'); }
    function verCertificados() { ocultarTodo(); mostrarSubpanel('panel-admin', 'admin-certificados'); }
    function verNotificaciones() { ocultarTodo(); mostrarSubpanel('panel-admin', 'admin-notificaciones'); }
    function verAsignacion() { ocultarTodo(); mostrarSubpanel('panel-admin', 'admin-asignacion'); }
    function verReportes() { ocultarTodo(); mostrarSubpanel('panel-admin', 'admin-reportes'); }
    function volverAdmin() { ocultarTodo(); mostrarSubpanel('panel-admin', 'admin-main'); }

    // --- FUNCIONES DE NAVEGACIÓN DOCENTE ---
    function verPlanilla() { ocultarTodo(); mostrarSubpanel('panel-docente', 'docente-planilla'); }
    function verAsistencia() { ocultarTodo(); mostrarSubpanel('panel-docente', 'docente-asistencia'); }
    function verObservaciones() { ocultarTodo(); mostrarSubpanel('panel-docente', 'docente-observaciones'); }
    function verModuloMejorasDocente() { 
        ocultarTodo(); 
        mostrarSubpanel('panel-docente', 'docente-mejoras'); 
        if (typeof volverAListaCursosMejorasDocente === 'function') volverAListaCursosMejorasDocente();
        if (typeof actualizarBadgesCursosMejoras === 'function') actualizarBadgesCursosMejoras();
    }
    function verCursosExtraDocente() { ocultarTodo(); mostrarSubpanel('panel-docente', 'docente-cursosextra'); }
    function verActividadesDocente() { 
        ocultarTodo(); 
        mostrarSubpanel('panel-docente', 'docente-actividades'); 
        const vCursos = document.getElementById('vistaCursosDocente');
        const vClass = document.getElementById('vistaClassroomDocenteCurso');
        if (vCursos) vCursos.classList.remove('d-none');
        if (vClass) vClass.classList.add('d-none');
        cargarActividadesDocente(); 
    }
    function volverDocenteActividades() { ocultarTodo(); mostrarSubpanel('panel-docente', 'docente-main'); }
    function volverDocente() { ocultarTodo(); mostrarSubpanel('panel-docente', 'docente-main'); }

    // --- FUNCIONES DE NAVEGACIÓN ESTUDIANTE ---
    function verCalificacionesEstudiante() { ocultarTodo(); mostrarSubpanel('panel-estudiante', 'estudiante-calificaciones'); }
    function verActividadesEstudiante() { 
        ocultarTodo(); 
        mostrarSubpanel('panel-estudiante', 'estudiante-actividades'); 
        const vMat = document.getElementById('vistaMateriasEstudiante');
        const vClass = document.getElementById('vistaClassroomMateria');
        if (vMat) vMat.classList.remove('d-none');
        if (vClass) vClass.classList.add('d-none');
        cargarActividadesEstudiante(); 
    }
    function verCursosExtra() { ocultarTodo(); mostrarSubpanel('panel-estudiante', 'estudiante-cursosextra'); }
    function verModuloMejoras() { ocultarTodo(); mostrarSubpanel('panel-estudiante', 'estudiante-mejoras'); }
    function volverEstudiante() { ocultarTodo(); mostrarSubpanel('panel-estudiante', 'estudiante-main'); }

    // --- FUNCIONES DE NAVEGACIÓN ACUDIENTE ---
    function verCalificacionesAcudiente() {
        const selectHijo = document.getElementById("selectHijo");
        if (selectHijo && selectHijo.value) {
            location.href = `/Estudiante/MisNotas?idEstudiante=${selectHijo.value}`;
        }
    }
    function verAsistenciaAcudiente() { ocultarTodo(); mostrarSubpanel('panel-acudiente', 'acudiente-asistencia'); }
    function verCitacionesAcudiente() { ocultarTodo(); mostrarSubpanel('panel-acudiente', 'acudiente-citaciones'); }
    function verObservadorAcudiente() { ocultarTodo(); mostrarSubpanel('panel-acudiente', 'acudiente-observador'); }
    function volverAcudiente() { ocultarTodo(); mostrarSubpanel('panel-acudiente', 'acudiente-main'); }

    function mostrarSubpanel(panelId, subId) {
        const panel = document.getElementById(panelId);
        const sub = document.getElementById(subId);
        if (panel) panel.classList.remove('d-none');
        if (sub) sub.classList.remove('d-none');
    }

    // ===============================================
    // AJAX: GESTIÓN DE ACTIVIDADES Y AULA CLASSROOM (DOCENTE)
    // ===============================================

    let listaActividadesDocenteGlobal = [];
    let cursoClassroomDocenteSeleccionado = null;

    // Directorio de estudiantes asociados a cursos
    const listaEstudiantesCursoGlobal = [
        @if (ViewBag.EstudiantesAsistencia != null)
        {
            var listaEst = (List<ProyectoPAE.Models.Usuario>)ViewBag.EstudiantesAsistencia;
            var gradosMap = ViewBag.EstudianteGradosMap as Dictionary<int, string>;
            foreach (var est in listaEst)
            {
                string cursoEst = (gradosMap != null && gradosMap.ContainsKey(est.ID_Usuario)) ? gradosMap[est.ID_Usuario] : "";
                var nombreCompleto = !string.IsNullOrEmpty(est.NOMBRES) ? $"{est.NOMBRES} {est.APELLIDOS}".Trim() : est.NOMBRE_USUARIO;
                @:{ id: @est.ID_Usuario, nombre: "@Html.Raw(nombreCompleto.Replace("\"", "\\\""))", email: "@Html.Raw((est.CORREO_ELECTRONICO ?? "").Replace("\"", "\\\""))", curso: "@Html.Raw(cursoEst)" },
            }
        }
    ];

    function cargarActividadesDocente() {
        fetch('@Url.Action("ObtenerActividadesDocente", "Docente")')
            .then(res => res.json())
            .then(data => {
                listaActividadesDocenteGlobal = (data.success && data.actividades) ? data.actividades : [];
                actualizarNovedadesCursosDocente(listaActividadesDocenteGlobal);
                if (cursoClassroomDocenteSeleccionado) {
                    renderizarClassroomDocenteStream(cursoClassroomDocenteSeleccionado);
                }
            })
            .catch(err => {
                console.error('Error al cargar actividades docente:', err);
            });
    }

    function actualizarNovedadesCursosDocente(actividades) {
        const badgeContainers = document.querySelectorAll('[id^="badge-novedades-docente-"]');
        badgeContainers.forEach(el => {
            const cursoSlug = el.id.replace('badge-novedades-docente-', '');
            const cursoNombre = cursoSlug.replace(/_/g, ' ');

            const actsCurso = actividades.filter(a => {
                const g = (a.grado || '').trim();
                return g.toLowerCase() === cursoNombre.toLowerCase() || g.toLowerCase() === 'todos' || g === '';
            });

            const total = actsCurso.length;
            const pendientesCalificar = actsCurso.reduce((acc, a) => acc + (a.pendientes || 0), 0);

            if (total === 0) {
                el.innerHTML = `
                    <span class="badge bg-light text-muted border rounded-pill px-3 py-1">
                        <i class="bi bi-check2-circle me-1 text-success"></i>Sin tareas asignadas
                    </span>
                `;
            } else if (pendientesCalificar > 0) {
                el.innerHTML = `
                    <span class="badge bg-warning-subtle text-dark border border-warning-subtle rounded-pill px-3 py-1 fw-bold">
                        <i class="bi bi-bell-fill me-1 text-warning"></i>${total} ${total === 1 ? 'tarea' : 'tareas'} • ${pendientesCalificar} por calificar
                    </span>
                `;
            } else {
                el.innerHTML = `
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1 fw-bold">
                        <i class="bi bi-journal-text me-1"></i>${total} ${total === 1 ? 'tarea activa' : 'tareas activas'}
                    </span>
                `;
            }
        });
    }

    function entrarAClassroomDocenteCurso(cursoNombre) {
        cursoClassroomDocenteSeleccionado = cursoNombre;

        const vCursos = document.getElementById('vistaCursosDocente');
        const vClass = document.getElementById('vistaClassroomDocenteCurso');
        if (vCursos) vCursos.classList.add('d-none');
        if (vClass) vClass.classList.remove('d-none');

        const elTituloTop = document.getElementById('classroomDocenteTituloTop');
        if (elTituloTop) elTituloTop.textContent = 'Curso ' + cursoNombre;

        const elBanner = document.getElementById('classroomDocenteBannerTitulo');
        if (elBanner) elBanner.textContent = 'Curso ' + cursoNombre;

        const elDetalle = document.getElementById('classroomDocenteBannerDetalle');
        if (elDetalle) elDetalle.textContent = 'Gestión académica, asignación de tareas y calificaciones del Curso ' + cursoNombre;

        // Pestaña inicial: Tablón
        const tabBtn = document.getElementById('tabClassroomDocenteTablon');
        cambiarTabClassroomDocente('tablon', tabBtn);

        renderizarClassroomDocenteStream(cursoNombre);
        renderizarAlumnosCursoDocente(cursoNombre);
    }

    function volverAListaCursosDocente() {
        const vCursos = document.getElementById('vistaCursosDocente');
        const vClass = document.getElementById('vistaClassroomDocenteCurso');
        if (vClass) vClass.classList.add('d-none');
        if (vCursos) vCursos.classList.remove('d-none');

        cursoClassroomDocenteSeleccionado = null;
        actualizarNovedadesCursosDocente(listaActividadesDocenteGlobal);
    }

    function cambiarTabClassroomDocente(tabName, btn) {
        document.querySelectorAll('.classroom-docente-nav-tab').forEach(b => b.classList.remove('active'));
        if (btn) btn.classList.add('active');

        const secTablon = document.getElementById('seccionClassroomDocenteTablon');
        const secPersonas = document.getElementById('seccionClassroomDocentePersonas');

        if (tabName === 'tablon' || tabName === 'trabajo') {
            if (secTablon) secTablon.classList.remove('d-none');
            if (secPersonas) secPersonas.classList.add('d-none');
        } else if (tabName === 'personas') {
            if (secTablon) secTablon.classList.add('d-none');
            if (secPersonas) secPersonas.classList.remove('d-none');
            if (cursoClassroomDocenteSeleccionado) {
                renderizarAlumnosCursoDocente(cursoClassroomDocenteSeleccionado);
            }
        }
    }

    function abrirModalCrearActividadParaCurso() {
        const selectGrado = document.querySelector('#formCrearActividad select[name="Grado"]');
        if (selectGrado && cursoClassroomDocenteSeleccionado) {
            selectGrado.value = cursoClassroomDocenteSeleccionado;
        }
        const modalEl = document.getElementById('modalCrearActividad');
        if (modalEl) {
            const modal = new bootstrap.Modal(modalEl);
            modal.show();
        }
    }

    function renderizarClassroomDocenteStream(cursoNombre) {
        const streamContainer = document.getElementById('classroomDocenteStreamActividades');
        if (!streamContainer) return;

        const actsCurso = listaActividadesDocenteGlobal.filter(a => {
            const g = (a.grado || '').trim();
            return g.toLowerCase() === cursoNombre.toLowerCase() || g.toLowerCase() === 'todos' || g === '';
        });

        // Actualizar métricas del sidebar
        const elTotalTareas = document.getElementById('docenteMetricTotalTareas');
        const elTotalEntregas = document.getElementById('docenteMetricTotalEntregas');
        const elPorCalificar = document.getElementById('docenteMetricPorCalificar');

        const totalEntregas = actsCurso.reduce((acc, a) => acc + (a.totalEntregas || 0), 0);
        const totalPorCalificar = actsCurso.reduce((acc, a) => acc + (a.pendientes || 0), 0);

        if (elTotalTareas) elTotalTareas.textContent = actsCurso.length;
        if (elTotalEntregas) elTotalEntregas.textContent = totalEntregas;
        if (elPorCalificar) elPorCalificar.textContent = totalPorCalificar;

        if (actsCurso.length === 0) {
            streamContainer.innerHTML = `
                <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white">
                    <i class="bi bi-journal-x display-4 mb-3" style="color: #2980b9 !important;"></i>
                    <h5 class="fw-bold text-secondary">Aún no hay tareas publicadas para el Curso ${cursoNombre}</h5>
                    <p class="text-muted small mb-4">Comienza asignando un taller, guía o tarea académica para que los alumnos de este curso puedan responderla en su aula virtual.</p>
                    <div>
                        <button class="btn text-white px-4 py-2 shadow-sm rounded-pill" style="background-color: #2980b9;" onclick="abrirModalCrearActividadParaCurso()">
                            <i class="bi bi-plus-circle me-1"></i> Asignar Primera Tarea
                        </button>
                    </div>
                </div>
            `;
            return;
        }

        let html = '';
        actsCurso.forEach(act => {
            const badgeVencida = act.estaVencida 
                ? `<span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-1 fw-bold"><i class="bi bi-exclamation-triangle-fill me-1"></i>Vencida</span>` 
                : `<span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1 fw-bold"><i class="bi bi-check-circle-fill me-1"></i>Vigente</span>`;

            const linkAdjunto = act.archivoAdjunto 
                ? `<a href="${act.archivoAdjunto}" target="_blank" class="btn btn-sm btn-outline-secondary rounded-pill px-2 py-0" style="font-size: 0.78rem;">
                       <i class="bi bi-file-earmark-arrow-down me-1"></i>Guía / Material
                   </a>` 
                : '';

            html += `
                <div class="card p-3 bg-white rounded-4 shadow-sm mb-3 card-classroom-item">
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2 pb-2 border-bottom">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle d-flex align-items-center justify-content-center text-white flex-shrink-0" style="width: 44px; height: 44px; background-color: #e3f2fd; color: #1565c0;">
                                <i class="bi bi-clipboard-check-fill fs-5"></i>
                            </div>
                            <div>
                                <div class="d-flex gap-2 align-items-center flex-wrap">
                                    <span class="badge bg-primary rounded-pill px-3 py-1">${act.materia}</span>
                                    <span class="badge bg-light text-dark border rounded-pill px-2 py-1">Grado: ${act.grado || 'Todos'}</span>
                                    ${badgeVencida}
                                </div>
                                <h5 class="fw-bold text-dark mb-0 mt-1">${act.titulo}</h5>
                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-2">
                            <button class="btn btn-outline-danger btn-sm rounded-circle p-2" title="Eliminar tarea" onclick="eliminarActividadDocente(${act.idActividad})">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </div>

                    <p class="small text-muted mb-3" style="white-space: pre-line; max-height: 70px; overflow: hidden; text-overflow: ellipsis;">
                        ${act.descripcion || 'Sin descripción adicional.'}
                    </p>

                    <div class="d-flex justify-content-between align-items-center small text-muted p-2 bg-light rounded-3 mb-3">
                        <span><i class="bi bi-clock-history me-1 text-danger"></i>Fecha Límite: <strong>${act.fechaLimite}</strong></span>
                        ${linkAdjunto}
                    </div>

                    <!-- Métricas de Entregas Classroom -->
                    <div class="row g-2 mb-3 text-center">
                        <div class="col-4">
                            <div class="p-2 border rounded-3 bg-white shadow-sm">
                                <span class="d-block text-muted small" style="font-size: 0.75rem;">Total Entregas</span>
                                <span class="fs-5 fw-bold text-dark">${act.totalEntregas}</span>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-2 border rounded-3 bg-white shadow-sm">
                                <span class="d-block text-muted small" style="font-size: 0.75rem;">Calificadas</span>
                                <span class="fs-5 fw-bold text-success">${act.calificadas}</span>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-2 border rounded-3 bg-white shadow-sm">
                                <span class="d-block text-muted small" style="font-size: 0.75rem;">Por Calificar</span>
