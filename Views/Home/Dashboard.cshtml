    // --- FILTRADO + PAGINACIÓN DE MATRÍCULAS (20 por página) ---
    let matPaginaActual = 1;
    const MAT_POR_PAGINA = 20;

    function getFilasMatriculasFiltradas() {
        const selGrado = document.getElementById('filtroGrado');
        const selEstado = document.getElementById('filtroEstado');
        const valGrado  = selGrado  ? selGrado.value.toLowerCase().trim()  : 'todos';
        const valEstado = selEstado ? selEstado.value.toLowerCase().trim() : 'todos';

        const todasFilas = Array.from(document.querySelectorAll('#tbodyMatriculas tr.fila-mat'));
        return todasFilas.filter(fila => {
            const grado  = (fila.getAttribute('data-grado')  || '').toLowerCase();
            const estado = (fila.getAttribute('data-estado') || '').toLowerCase();
            const okGrado  = valGrado  === 'todos' || grado === valGrado;
            const okEstado = valEstado === 'todos' || estado.includes(valEstado) ||
                             (valEstado === 'activa' && (estado === 'activa' || estado === 'activo'));
            return okGrado && okEstado;
        });
    }

    function renderizarPaginacionMat() {
        const filasFiltradas = getFilasMatriculasFiltradas();
        const totalFilas = filasFiltradas.length;
        const totalPaginas = Math.max(1, Math.ceil(totalFilas / MAT_POR_PAGINA));

        // Ajustar página actual si se va de rango
        if (matPaginaActual > totalPaginas) matPaginaActual = totalPaginas;

        // Ocultar todas las filas primero
        document.querySelectorAll('#tbodyMatriculas tr.fila-mat').forEach(f => f.style.display = 'none');

        // Mostrar solo las de la página actual
        const inicio = (matPaginaActual - 1) * MAT_POR_PAGINA;
        const fin    = Math.min(inicio + MAT_POR_PAGINA, totalFilas);
        for (let i = inicio; i < fin; i++) {
            filasFiltradas[i].style.display = '';
        }

        // Info de página
        const info = document.getElementById('infoMatPagina');
        if (info) {
            if (totalFilas === 0) {
                info.textContent = 'Sin resultados para los filtros seleccionados';
            } else {
                info.textContent = `Mostrando ${inicio + 1}–${fin} de ${totalFilas} matrículas`;
            }
        }

        // Renderizar controles de paginación
        const ul = document.getElementById('paginacionMat');
        if (!ul) return;
        ul.innerHTML = '';

        if (totalPaginas <= 1) return;

        const crearLi = (label, pagina, activo, disabled) => {
            const li = document.createElement('li');
            li.className = `page-item${activo ? ' active' : ''}${disabled ? ' disabled' : ''}`;
            const a = document.createElement('a');
            a.className = 'page-link';
            a.innerHTML = label;
            a.href = '#';
            if (!disabled && !activo) {
                a.addEventListener('click', (e) => { e.preventDefault(); matPaginaActual = pagina; renderizarPaginacionMat(); });
            }
            li.appendChild(a);
            ul.appendChild(li);
        };

        crearLi('&laquo;', matPaginaActual - 1, false, matPaginaActual === 1);

        // Mostrar máximo 7 botones con elipsis
        const rango = 2;
        for (let p = 1; p <= totalPaginas; p++) {
            if (p === 1 || p === totalPaginas || (p >= matPaginaActual - rango && p <= matPaginaActual + rango)) {
                crearLi(p, p, p === matPaginaActual, false);
            } else if (p === matPaginaActual - rango - 1 || p === matPaginaActual + rango + 1) {
                crearLi('...', p, false, true);
            }
        }

        crearLi('&raquo;', matPaginaActual + 1, false, matPaginaActual === totalPaginas);
    }

    function filtrarMatriculas() {
        matPaginaActual = 1;
        renderizarPaginacionMat();
    }

    // --- INICIALIZACIÓN ÚNICA DEL DOM ---
    document.addEventListener("DOMContentLoaded", function() {
        switchRole();
        // Inicializar paginación de matrículas al cargar la página
        renderizarPaginacionMat();
        // Configuración de acudientes/hijos
        const selectHijo = document.getElementById("selectHijo");
        const btnVerNotas = document.getElementById("btnVerNotas");

        function actualizarEnlaceNotas() {
            if (selectHijo && btnVerNotas) {
                btnVerNotas.href = `/Estudiante/MisNotas?idEstudiante=${selectHijo.value}`;
            }
        }

        if (selectHijo && btnVerNotas) {
            actualizarEnlaceNotas();
            selectHijo.addEventListener("change", actualizarEnlaceNotas);
        }

        // --- (David) CÁLCULO AUTOMÁTICO DE NOTA DEFINITIVA EN TIEMPO REAL ---
        function calcularDefinitiva(fila) {
            const inputs = fila.querySelectorAll('.nota-input');
            const badgeDefinitiva = fila.querySelector('.nota-definitiva');
            if (!inputs.length || !badgeDefinitiva) return;

            let suma = 0, cantidad = 0;
            inputs.forEach(input => {
                const val = parseFloat(input.value.toString().replace(',', '.'));
                if (!isNaN(val)) { suma += val; cantidad++; }
            });

            if (cantidad > 0) {
                const promedio = (suma / cantidad).toFixed(1);
                badgeDefinitiva.textContent = promedio;
                badgeDefinitiva.className = parseFloat(promedio) >= 3.0
                    ? "badge bg-success fs-6 nota-definitiva"
                    : "badge bg-danger fs-6 nota-definitiva";
            }
        }

        // (David) Recalcular automáticamente al iniciar la pantalla
        document.querySelectorAll('tr').forEach(fila => {
            if (fila.querySelector('.nota-input')) {
                calcularDefinitiva(fila);
            }
        });

        // (David) Escuchar cambios al escribir o usar flechas del mouse
        ['input', 'change'].forEach(evento => {
            document.addEventListener(evento, function(e) {
                if (e.target.classList.contains('nota-input')) {
                    calcularDefinitiva(e.target.closest('tr'));
                }
            });
        });

        // Función para reiniciar/limpiar todas las calificaciones y observaciones de asistencia
        window.reiniciarAsistencias = function() {
            const radiosMarcados = document.querySelectorAll('#tablaAsistencia input[type="radio"]:checked');
            const observaciones = document.querySelectorAll('#tablaAsistencia input[type="text"]');
            let hayObservaciones = Array.from(observaciones).some(i => i.value.trim() !== '');

            if (radiosMarcados.length === 0 && !hayObservaciones) {
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'info',
                    title: 'La asistencia ya se encuentra limpia.',
                    showConfirmButton: false,
                    timer: 2000,
                    timerProgressBar: true
                });
                return;
            }

            Swal.fire({
                title: '¿Reiniciar calificación de asistencias?',
                text: 'Se desmarcarán todas las calificaciones (P, F, R) y observaciones anotadas.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#6c757d',
                confirmButtonText: '<i class="bi bi-arrow-counterclockwise me-1"></i> Sí, reiniciar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    document.querySelectorAll('#tablaAsistencia input[type="radio"]').forEach(radio => {
                        radio.checked = false;
                    });
                    observaciones.forEach(input => {
                        input.value = '';
                    });

                    Swal.fire({
                        toast: true,
                        position: 'top-end',
                        icon: 'success',
                        title: 'Se han reiniciado las calificaciones de asistencia.',
                        showConfirmButton: false,
                        timer: 2500,
                        timerProgressBar: true
                    });
                }
            });
        };

        // Función para marcar la asistencia de todos los estudiantes como Presente ('P')
        window.marcarTodosPresentes = function() {
            document.querySelectorAll('.radio-estado-p').forEach(radio => {
                radio.checked = true;
            });
        };

        // Función para guardar asistencias con validación de calificados y confirmación SweetAlert2
        window.guardarAsistenciaYObservaciones = function() {
            const filas = document.querySelectorAll('#tablaAsistencia tbody tr');
            let sinCalificar = [];

            filas.forEach(fila => {
                const inputNombre = fila.querySelector('.estudiante-nombre');
                const radios = fila.querySelectorAll('input[type="radio"]');

                if (radios.length > 0) {
                    const algunoSeleccionado = Array.from(radios).some(r => r.checked);
                    if (!algunoSeleccionado) {
                        const nombreEst = inputNombre ? inputNombre.innerText.trim() : "Estudiante";
                        sinCalificar.push(nombreEst);
                    }
                }
            });

            // 1. Si falta calificar a algún estudiante, mostrar ventana emergente con la lista
            if (sinCalificar.length > 0) {
                let listaHtml = sinCalificar.map(n => `<li class="text-danger fw-bold">${n}</li>`).join('');
                Swal.fire({
                    icon: 'warning',
                    title: '¡Falta calificar la asistencia!',
                    html: `<p>Falta calificar la asistencia a las siguientes personas:</p><ul class="text-start mb-0" style="max-height: 200px; overflow-y: auto;">${listaHtml}</ul>`,
                    confirmButtonText: 'Entendido',
                    confirmButtonColor: '#0d6efd'
                });
                return;
            }

            // 2. Si todos están calificados, mostrar ventana de confirmación antes de guardar
            Swal.fire({
                title: '¿Seguro que quieres guardar?',
                text: '¿Deseas guardar el control de asistencia para este grupo?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#0d6efd',
                cancelButtonColor: '#6c757d',
                confirmButtonText: '<i class="bi bi-save me-1"></i> Sí, guardar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire({
                        toast: true,
                        position: 'top-end',
                        icon: 'success',
                        title: '¡Asistencia y observaciones guardadas exitosamente!',
                        showConfirmButton: false,
                        timer: 3500,
                        timerProgressBar: true
                    });
                }
            });
        };

        // Filtrar el desplegable Grupo por Jornada (Mañana / Tarde) en Control de Asistencia
        const selectGrupoAsistencia = document.getElementById("selectGrupoAsistencia");
        const selectJornadaAsistencia = document.getElementById("selectJornadaAsistencia");

        function filtrarGruposAsistencia() {
            if (!selectGrupoAsistencia || !selectJornadaAsistencia) return;

            const jornada = selectJornadaAsistencia.value || '';
            const esManana = jornada.toLowerCase().includes('mañana') || jornada.toLowerCase().includes('manana') || jornada.toLowerCase().startsWith('m');
            const esTarde = jornada.toLowerCase().includes('tarde') || jornada.toLowerCase().startsWith('t');

            let seleccionadoVisible = false;

            Array.from(selectGrupoAsistencia.options).forEach(opt => {
                const txt = opt.text.trim();
                const val = opt.value.trim();
                let mostrar = true;

                if (esManana) {
                    mostrar = txt.endsWith('M') || txt.includes(' M') || val.endsWith('M');
                } else if (esTarde) {
                    mostrar = txt.endsWith('T') || txt.includes(' T') || val.endsWith('T');
                }

                opt.hidden = !mostrar;
                opt.disabled = !mostrar;
                opt.style.display = mostrar ? '' : 'none';

                if (mostrar && opt.selected) {
                    seleccionadoVisible = true;
                }
            });

            if (!seleccionadoVisible) {
                const primerVisible = Array.from(selectGrupoAsistencia.options).find(opt => !opt.hidden && !opt.disabled);
                if (primerVisible) {
                    selectGrupoAsistencia.value = primerVisible.value;
                }
            }
        }

        if (selectJornadaAsistencia) {
            selectJornadaAsistencia.addEventListener("change", filtrarGruposAsistencia);
            filtrarGruposAsistencia();
        }
    });
</script>

