@{
    ViewData["Title"] = "Panel de Control Educativo";
    @using Microsoft.AspNetCore.Http
}

@{
    var nombre = Context.Session.GetString("NombreUsuario");
    var rolReal = Context.Session.GetString("UserRol"); // Rol original de la sesión
    var rep = ViewBag.ReportesPro as ProyectoPAE.Models.ReportesProViewModel ?? new ProyectoPAE.Models.ReportesProViewModel();
    var cursosExtraDocente = ViewBag.CursosExtraDocente as List<ProyectoPAE.Models.ExtraCursoItemViewModel> ?? new List<ProyectoPAE.Models.ExtraCursoItemViewModel>();
    var cursosExtraEstudiante = ViewBag.CursosExtraEstudiante as List<ProyectoPAE.Models.ExtraCursoItemViewModel> ?? new List<ProyectoPAE.Models.ExtraCursoItemViewModel>();
    var misCursosExtraInscritos = ViewBag.MisCursosExtraInscritos as List<ProyectoPAE.Models.ExtraCursoItemViewModel> ?? new List<ProyectoPAE.Models.ExtraCursoItemViewModel>();
    int? gradoEstudianteSesion = ViewBag.GradoEstudiante as int?;
}

<input type="hidden" id="rolOculto" value="@ViewBag.Rol" />

<input type="hidden" id="rolRealSesion" value="@rolReal" />

<center><h2>Bienvenido/a, @nombre</h2></center>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const inputRol = document.getElementById('rolOculto');
        const selector = document.getElementById('roleSelector');

        // Rol activo que se quiere visualizar en la vista
        const rolActivo = inputRol ? inputRol.value.toLowerCase().trim() : '';

        if (selector && rolActivo) {
            // Asigna la opción seleccionada según el rol activo
            selector.value = rolActivo;

            // Cambia el panel visible
            if (typeof switchRole === "function") {
                switchRole();
            }
        }
    });
</script>

<!-- BARRA SUPERIOR AZUL -->
<div class="container-fluid fw-bold py-3 mb-4" style="background-color: #0d2a4a; color: white;">
    <div class="container d-flex justify-content-between align-items-center">
        <!-- Título a la izquierda -->
        <span><i class="bi bi-mortarboard-fill me-2"></i>SISTEMA DE GESTIÓN PAE</span>

        <!-- Selector de Rol a la derecha (solo visible para Administrador) -->
        @if (rolReal != null && (rolReal.ToLower() == "admin" || rolReal.ToLower() == "administrador"))
        {
            <div id="contenedorSelectorRol" class="d-flex align-items-center gap-2">
                <small class="opacity-75">Rol actual:</small>
                <select id="roleSelector" class="form-select form-select-sm" onchange="switchRole()" style="width: auto;">
                    <option value="admin">Administrador</option>
                    <option value="docente">Docente</option>
                    <option value="estudiante">Estudiante</option>
                    <option value="acudiente">Acudiente</option>
                </select>
            </div>
        }
    </div>
</div>

<div class="container pb-5">



    <div id="panel-admin" class="role-panel d-none">

        <div id="admin-main">
            <h2 class="mb-4" style="color: #e67e22;"><i class="bi bi-gear-fill me-2"></i>Gestión Administrativa</h2>


            <div class="row g-3 mb-3">
                <div class="col-md-3">
                    <div class="card p-3 shadow-sm border-0 h-100 text-center card-hover card-admin" onclick="verMatricula()" style="cursor: pointer;">
                        <i class="bi bi-clipboard-check fs-2 mb-2" style="color: #e67e22;"></i>
                        <h6>Matrículas</h6>
                        <p class="small text-muted mb-2">Consulta y gestiona las matrículas registradas.</p>
                        <button class="btn btn-sm btn-outline-warning mt-auto w-100">Ver Matrículas</button>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="card p-3 shadow-sm border-0 h-100 text-center card-hover card-admin" onclick="location.href='@Url.Action("Usuarios", "Admin")'" style="cursor: pointer;">
                        <i class="bi bi-people-fill fs-2 mb-2" style="color: #e67e22;"></i>
                        <h6>Gestión de Usuarios</h6>
                        <p class="small text-muted mb-2">Administra estudiantes, docentes y acudientes.</p>
                        <button class="btn btn-sm btn-outline-warning mt-auto w-100">Ver Usuarios</button>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="card p-3 shadow-sm border-0 h-100 text-center card-hover card-admin" onclick="verCertificados()" style="cursor: pointer;">
                        <i class="bi bi-file-earmark-pdf-fill fs-2 mb-2" style="color: #e67e22;"></i>
                        <h6>Certificados</h6>
                        <p class="small text-muted mb-2">Genera y descarga certificados oficiales.</p>
                        <button class="btn btn-sm btn-outline-warning mt-auto w-100">Ver Certificados</button>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="card p-3 shadow-sm border-0 h-100 text-center card-hover card-admin" onclick="location.href='@Url.Action("Notificaciones", "Admin")'" style="cursor: pointer;">
                        <i class="bi bi-megaphone-fill fs-2 mb-2" style="color: #e67e22;"></i>
                        <h6>Notificaciones</h6>
                        <p class="small text-muted mb-2">Envía comunicados a toda la institución.</p>
                        <button class="btn btn-sm btn-outline-warning mt-auto w-100">Ver Notificaciones</button>
                    </div>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-md-4">
                    <div class="card p-3 shadow-sm border-0 h-100 text-center card-hover card-admin" onclick="verAsignacion()" style="cursor: pointer;">
                        <i class="bi bi-diagram-3-fill fs-2 mb-2" style="color: #e67e22;"></i>
                        <h6>Asignación Académica</h6>
                        <p class="small text-muted mb-2">Asigna materias y grupos a los docentes.</p>
                        <button class="btn btn-sm btn-outline-warning mt-auto w-100">Ver Asignación</button>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card p-3 shadow-sm border-0 h-100 text-center card-hover card-admin" onclick="verReportes()" style="cursor: pointer;">
                        <i class="bi bi-graph-up-arrow fs-2 mb-2" style="color: #e67e22;"></i>
                        <h6>Reportes Pro</h6>
                        <p class="small text-muted mb-2">Estadísticas generales de la institución.</p>
                        <button class="btn btn-sm btn-outline-warning mt-auto w-100">Ver Reportes</button>
                    </div>
                </div>
            </div>
        </div>

        <div id="admin-matricula" class="d-none">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h3 style="color: #e67e22;"><i class="bi bi-clipboard-check me-2"></i>Matrículas</h3>
                <button class="btn btn-outline-secondary btn-sm" onclick="volverAdmin()">Volver</button>
            </div>

            <!-- Resumen (datos reales de MATRICULA) -->
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm p-4 h-100" style="border-left: 4px solid #0d2a4a !important;">
                        <p class="text-muted text-uppercase small mb-2">Matrículas Activas</p>
                        <div class="d-flex justify-content-between align-items-end">
                            <span class="fs-3 fw-bold" style="color: #0d2a4a;">@ViewBag.TotalMatriculadosActivos</span>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm p-4 h-100" style="border-left: 4px solid #e67e22 !important;">
                        <p class="text-muted text-uppercase small mb-2">Matrículas @DateTime.Now.Year</p>
                        <div class="d-flex justify-content-between align-items-end">
                            <span class="fs-3 fw-bold" style="color: #e67e22;">@ViewBag.MatriculasEsteAnio</span>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm p-4 h-100" style="border-left: 4px solid #0d2a4a99 !important;">
                        <p class="text-muted text-uppercase small mb-2">Matrículas Finalizadas</p>
                        <div class="d-flex justify-content-between align-items-end">
                            <span class="fs-3 fw-bold" style="color: #0d2a4a;">@ViewBag.MatriculasFinalizadas</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tabla -->
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white d-flex flex-wrap align-items-center justify-content-between gap-3 p-3">
                    <div class="d-flex gap-3">
                        <div>
                            <label class="form-label small mb-1">Filtrar por Grado</label>
                            <select id="filtroGrado" class="form-select form-select-sm" onchange="filtrarMatriculas()">
                                <option value="todos">Todos los Grados</option>
                                <option value="6">Grado 6</option>
                                <option value="7">Grado 7</option>
                                <option value="8">Grado 8</option>
                                <option value="9">Grado 9</option>
                                <option value="10">Grado 10</option>
                                <option value="11">Grado 11</option>
                            </select>
                        </div>
                        <div>
                            <label class="form-label small mb-1">Estado</label>
                            <select id="filtroEstado" class="form-select form-select-sm" onchange="filtrarMatriculas()">
                                <option value="todos">Cualquier Estado</option>
                                <option value="activa">Activa</option>
                                <option value="finalizada">Finalizada</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr class="small text-uppercase text-muted">
                                <th class="px-3 py-3">Estudiante</th>
                                <th class="px-3 py-3">Grado</th>
                                <th class="px-3 py-3">Periodo Académico</th>
                                <th class="px-3 py-3">Fecha Matrícula</th>
                                <th class="px-3 py-3">Estado</th>
                                <th class="px-3 py-3 text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="tbodyMatriculas">
                            @{
                                var listaMatriculas = ViewBag.ListaMatriculas as List<ProyectoPAE.Models.MatriculaAdminItemViewModel>;
                            }
                            @if (listaMatriculas != null && listaMatriculas.Any())
                            {
                                foreach (var mat in listaMatriculas)
                                {
                                    bool esActiva = mat.Estado != null && (mat.Estado.Equals("Activa", StringComparison.OrdinalIgnoreCase) || mat.Estado.Equals("Activo", StringComparison.OrdinalIgnoreCase));
                                    string colorFondo = esActiva ? "#0d2a4a1a" : "#6c757d1a";
                                    string colorTexto = esActiva ? "#0d2a4a" : "#6c757d";
                                    var iniciales = string.Join("", mat.NombreEstudiante.Split(' ').Take(2).Select(p => p.Length > 0 ? p[0].ToString().ToUpper() : ""));

                                    <tr class="fila-mat" data-grado="@mat.Grado" data-estado="@mat.Estado?.ToLower()">
                                        <td class="px-3 py-3">
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width:40px;height:40px;background:@colorFondo;color:@colorTexto;">@iniciales</div>
                                                <div>
                                                    <p class="fw-bold mb-0">@mat.NombreEstudiante</p>
                                                    <p class="text-muted small mb-0">ID: @mat.CodigoEstudiante</p>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="px-3 py-3">Grado @mat.Grado°</td>
                                        <td class="px-3 py-3">@mat.PeriodoAcademico</td>
                                        <td class="px-3 py-3">@mat.FechaMatricula.ToString("dd MMM, yyyy")</td>
                                        <td class="px-3 py-3">
                                            <span class="badge rounded-pill" style="background:@colorFondo;color:@colorTexto;">@mat.Estado.ToUpper()</span>
                                        </td>
                                        <td class="px-3 py-3 text-end">
                                            <div class="dropdown">
                                                <button class="btn btn-sm btn-light border" type="button"
                                                        id="accion-@mat.IdMatricula"
                                                        data-bs-toggle="dropdown" aria-expanded="false">
                                                    <i class="bi bi-three-dots-vertical"></i>
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-end shadow-sm"
                                                    aria-labelledby="accion-@mat.IdMatricula">
                                                    <li>
                                                        <button type="button" class="dropdown-item"
                                                                onclick="abrirModalEditarMatricula(@mat.IdMatricula, @mat.Grado, '@mat.Estado', '@mat.NombreEstudiante')">
                                                            <i class="bi bi-pencil-square text-primary me-2"></i>Editar
                                                        </button>
                                                    </li>
                                                    @if (!esActiva)
                                                    {
                                                        <li>
                                                            <form method="post" action="/Admin/CambiarEstadoMatricula" style="display:inline">
                                                                <input type="hidden" name="idMatricula" value="@mat.IdMatricula" />
                                                                <input type="hidden" name="nuevoEstado" value="Activa" />
                                                                @Html.AntiForgeryToken()
                                                                <button type="submit" class="dropdown-item"><i class="bi bi-check-circle text-success me-2"></i>Marcar Activa</button>
                                                            </form>
                                                        </li>
                                                    }
                                                    @if (esActiva)
                                                    {
                                                        <li>
                                                            <form method="post" action="/Admin/CambiarEstadoMatricula" style="display:inline">
                                                                <input type="hidden" name="idMatricula" value="@mat.IdMatricula" />
                                                                <input type="hidden" name="nuevoEstado" value="Finalizada" />
                                                                @Html.AntiForgeryToken()
                                                                <button type="submit" class="dropdown-item"><i class="bi bi-x-circle text-warning me-2"></i>Dar de Baja</button>
                                                            </form>
                                                        </li>
                                                    }
                                                    <li><hr class="dropdown-divider" /></li>
                                                    <li>
                                                        <form method="post" action="/Admin/EliminarMatricula" style="display:inline"
                                                              onsubmit="return confirm('¿Eliminar la matrícula de @mat.NombreEstudiante? Esta acción no se puede deshacer.')">
                                                            <input type="hidden" name="idMatricula" value="@mat.IdMatricula" />
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="dropdown-item text-danger"><i class="bi bi-trash me-2"></i>Eliminar</button>
                                                        </form>
                                                    </li>
                                                </ul>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr id="sinMatriculas">
                                    <td colspan="6" class="text-center text-muted py-4">No hay matrículas registradas.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- PAGINACIÓN MATRÍCULAS -->
                <div class="card-footer bg-white d-flex flex-wrap align-items-center justify-content-between gap-2 px-3 py-2">
                    <p class="text-muted small mb-0" id="infoMatPagina">Cargando...</p>
                    <nav aria-label="Paginación matrículas">
                        <ul class="pagination pagination-sm mb-0" id="paginacionMat"></ul>
                    </nav>
                </div>
            </div>

            @* Alertas de feedback para el CRUD de matrículas *@
            @if (TempData["MensajeMatriculas"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>@TempData["MensajeMatriculas"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["ErrorMatriculas"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMatriculas"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @* Modal de edición de matrícula *@
            <div class="modal fade" id="modalEditarMatricula" tabindex="-1" aria-labelledby="modalEditarMatriculaLabel" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <form method="post" action="/Admin/EditarMatricula">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="idMatricula" id="edit_idMatricula" />
                            <div class="modal-header" style="background:#0d2a4a;color:white;">
                                <h5 class="modal-title" id="modalEditarMatriculaLabel">
                                    <i class="bi bi-pencil-square me-2"></i>Editar Matrícula
                                </h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <p class="text-muted small mb-3" id="edit_nombreEstudiante"></p>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Grado (curso)</label>
                                    <select name="idCurso" id="edit_idCurso" class="form-select" required>
                                        @for (int g = 1; g <= 11; g++)
                                        {
                                            <option value="@g">Grado @g°</option>
                                        }
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Estado</label>
                                    <select name="estado" id="edit_estado" class="form-select" required>
                                        <option value="Activa">Activa</option>
                                        <option value="Finalizada">Finalizada</option>
                                        <option value="Retirada">Retirada</option>
                                    </select>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-save me-1"></i>Guardar Cambios
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <script>
                            function abrirModalEditarMatricula(idMatricula, grado, estado, nombre) {
                                document.getElementById('edit_idMatricula').value = idMatricula;
                                document.getElementById('edit_nombreEstudiante').textContent = 'Estudiante: ' + nombre;
                                var selectGrado = document.getElementById('edit_idCurso');
                                for (var i = 0; i < selectGrado.options.length; i++) {
                                    selectGrado.options[i].selected = (parseInt(selectGrado.options[i].value) === grado);
                                }
                                var selectEstado = document.getElementById('edit_estado');
                                for (var j = 0; j < selectEstado.options.length; j++) {
                                    selectEstado.options[j].selected = (selectEstado.options[j].value === estado);
                                }
                                var modal = new bootstrap.Modal(document.getElementById('modalEditarMatricula'));
                                modal.show();
                            }
            </script>
        </div>

        <div id="admin-certificados" class="d-none">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h3 style="color: #e67e22;"><i class="bi bi-file-earmark-pdf-fill me-2"></i>Certificados</h3>
                <button class="btn btn-outline-secondary btn-sm" onclick="volverAdmin()">Volver</button>
            </div>

            @if (TempData["ErrorMatricula"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["ErrorMatricula"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="card border-0 shadow-sm p-4">
                <h5 class="mb-3">Constancia de Matrícula</h5>
                <form action="@Url.Action("GenerarMatricula", "Certificado")" method="get" class="row g-3 align-items-end">
                    <div class="col-md-6">
                        <label class="form-label small">Número de documento del estudiante (TI / CC)</label>
                        <input type="text" name="numeroDocumento" class="form-control" placeholder="Ej: 1122334455" required />
                    </div>
                    <div class="col-md-6">
                        <button type="submit" class="btn btn-warning text-white w-100">
                            <i class="bi bi-file-earmark-pdf me-2"></i>Generar Constancia
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div id="admin-notificaciones" class="d-none">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h3 style="color: #e67e22;"><i class="bi bi-megaphone-fill me-2"></i>Notificaciones</h3>
                <button class="btn btn-outline-secondary btn-sm" onclick="volverAdmin()">Volver</button>
            </div>
            <div class="card border-0 shadow-sm p-4">
                <textarea class="form-control mb-3" rows="3" placeholder="Escriba el comunicado general..."></textarea>
                <button class="btn btn-warning text-white">Enviar a toda la institución</button>
            </div>
        </div>

        <div id="admin-asignacion" class="d-none">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h3 style="color: #e67e22;"><i class="bi bi-diagram-3-fill me-2"></i>Asignación Académica</h3>
                <button class="btn btn-outline-secondary btn-sm" onclick="volverAdmin()">Volver</button>
            </div>
            <div class="alert alert-info">Seleccione un docente para asignar sus materias y grupos correspondientes.</div>
        </div>

        <!-- ─── SECCIÓN: REPORTES PRO ANUAL CONSOLIDADO ────────────────── -->
        <div id="admin-reportes" class="d-none">
            <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
                <div>
                    <h3 class="fw-bold mb-1" style="color: #1b2a47;">
                        <i class="bi bi-graph-up-arrow me-2" style="color: #e67e22;"></i>Reportes Pro - Anual Consolidado
                    </h3>
                    <p class="text-muted small mb-0">Indicadores institucionales de rendimiento académico, convivencia, permanencia y matrículas.</p>
                </div>
                <button class="btn btn-outline-secondary rounded-pill px-4" onclick="volverAdmin()">
                    <i class="bi bi-arrow-left me-1"></i> Volver al Dashboard
                </button>
            </div>

            <!-- TARJETAS PRINCIPALES KPI -->
            <div class="row g-3 mb-4">
                <div class="col-md-3">
                    <div class="card border-0 shadow-sm p-3 h-100 rounded-4" style="border-left: 5px solid #1b2a47 !important;">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <p class="text-muted text-uppercase small fw-semibold mb-1">Estudiantes Registrados</p>
                                <h2 class="fw-bold mb-0" style="color: #1b2a47;">@rep.TotalEstudiantes</h2>
                            </div>
                            <div class="rounded-circle p-3 bg-light text-primary">
                                <i class="bi bi-people-fill fs-3" style="color: #1b2a47 !important;"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="card border-0 shadow-sm p-3 h-100 rounded-4" style="border-left: 5px solid #e67e22 !important;">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <p class="text-muted text-uppercase small fw-semibold mb-1">Promedio Institucional</p>
                                <h2 class="fw-bold mb-0" style="color: #e67e22;">@rep.PromedioInstitucional.ToString("0.0") / 5.0</h2>
                            </div>
                            <div class="rounded-circle p-3 bg-light">
                                <i class="bi bi-journal-bookmark-fill fs-3" style="color: #e67e22 !important;"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="card border-0 shadow-sm p-3 h-100 rounded-4" style="border-left: 5px solid #27ae60 !important;">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <p class="text-muted text-uppercase small fw-semibold mb-1">Asistencia Consolidada</p>
                                <h2 class="fw-bold mb-0 text-success">@rep.PorcentajeAsistencia%</h2>
                            </div>
                            <div class="rounded-circle p-3 bg-light text-success">
                                <i class="bi bi-calendar-check-fill fs-3"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="card border-0 shadow-sm p-3 h-100 rounded-4" style="border-left: 5px solid #e74c3c !important;">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <p class="text-muted text-uppercase small fw-semibold mb-1">Tasa de Deserción</p>
                                <h2 class="fw-bold mb-0 text-danger">@rep.PorcentajeDesercion%</h2>
                            </div>
                            <div class="rounded-circle p-3 bg-light text-danger">
                                <i class="bi bi-person-x-fill fs-3"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SECCIÓN 1: RENDIMIENTO ACADÉMICO ANUAL -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
                    <h5 class="fw-bold mb-0" style="color: #1b2a47;">
                        <i class="bi bi-award-fill me-2" style="color: #e67e22;"></i>1. Rendimiento Académico Anual
                    </h5>
                    <span class="badge bg-light text-dark border">Cierre de Período</span>
                </div>
                <div class="card-body p-4">
                    <div class="row g-4 mb-4">
                        <div class="col-lg-8">
                            <div class="card border-0 bg-light p-3 rounded-3 h-100">
                                <h6 class="fw-bold text-secondary mb-3">Notas Promedio Finales por Área / Materia</h6>
                                <div style="position: relative; height:260px;">
                                    <canvas id="chartPromediosMateria"></canvas>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-4">
                            <div class="card border-0 bg-light p-3 rounded-3 h-100">
                                <h6 class="fw-bold text-secondary mb-3">Tasa de Aprobación vs Reprobación</h6>
                                <div style="position: relative; height:200px;" class="d-flex justify-content-center">
                                    <canvas id="chartAprobacion"></canvas>
                                </div>
                                <div class="d-flex justify-content-around text-center mt-3 pt-2 border-top">
                                    <div>
                                        <span class="badge bg-success px-2 py-1">Aprobados</span>
                                        <p class="fw-bold mb-0 mt-1">@rep.Aprobados (@rep.PorcentajeAprobacion%)</p>
                                    </div>
                                    <div>
                                        <span class="badge bg-danger px-2 py-1">Reprobados</span>
                                        <p class="fw-bold mb-0 mt-1">@rep.Reprobados (@rep.PorcentajeReprobacion%)</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ALERTA DE DATO NO DISPONIBLE EN BD (PRUEBAS SABER) -->
                    <div class="alert alert-warning border-warning d-flex align-items-center rounded-3 mb-0" role="alert">
                        <i class="bi bi-exclamation-triangle-fill fs-3 me-3 flex-shrink-0 text-warning"></i>
                        <div>
                            <h6 class="fw-bold mb-1">Resultados de Pruebas de Estado (Pruebas Saber)</h6>
                            <p class="mb-0 small">
                                <strong>Estado de Base de Datos:</strong> Los datos históricos y puntajes de exámenes nacionales (Pruebas Saber ICFES) no se encuentran registrados en la base de datos actual.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SECCIÓN 2: REGISTROS DE CONVIVENCIA Y PERMANENCIA -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
                    <h5 class="fw-bold mb-0" style="color: #1b2a47;">
                        <i class="bi bi-shield-check me-2" style="color: #e67e22;"></i>2. Registros de Convivencia y Permanencia
                    </h5>
                    <span class="badge bg-light text-dark border">Asistencia & Retención</span>
                </div>
                <div class="card-body p-4">
                    <div class="row g-4 mb-3">
                        <div class="col-md-6">
                            <div class="p-3 border rounded-3 bg-light">
                                <div class="d-flex align-items-center mb-2">
                                    <i class="bi bi-calendar-range-fill text-success fs-4 me-2"></i>
                                    <h6 class="fw-bold mb-0 text-dark">Asistencia Escolar Consolidada</h6>
                                </div>
                                <h3 class="fw-bold text-success mb-1">@rep.PorcentajeAsistencia%</h3>
                                <p class="text-muted small mb-0">Total asistencias registradas: @rep.TotalAsistencias (@rep.AsistenciasPresentes registros de presencia).</p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 border rounded-3 bg-light">
                                <div class="d-flex align-items-center mb-2">
                                    <i class="bi bi-person-dash-fill text-danger fs-4 me-2"></i>
                                    <h6 class="fw-bold mb-0 text-dark">Tasa de Deserción Escolar</h6>
                                </div>
                                <h3 class="fw-bold text-danger mb-1">@rep.PorcentajeDesercion%</h3>
                                <p class="text-muted small mb-0">Matrículas retiradas o inactivas: @rep.Desertores de @rep.TotalMatriculas matrículas procesadas.</p>
                            </div>
                        </div>
                    </div>

                    <!-- ALERTA DE DATO NO DISPONIBLE EN BD (REPITENCIA) -->
                    <div class="alert alert-warning border-warning d-flex align-items-center rounded-3 mb-0" role="alert">
                        <i class="bi bi-exclamation-triangle-fill fs-3 me-3 flex-shrink-0 text-warning"></i>
                        <div>
                            <h6 class="fw-bold mb-1">Índices de Repitencia Escolar Consecutiva</h6>
                            <p class="mb-0 small">
                                <strong>Estado de Base de Datos:</strong> El historial consecutivo de repitencia de curso por estudiante no se encuentra registrado en el esquema de base de datos actual.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SECCIÓN 3: INFORMACIÓN DE MATRÍCULA Y EGRESO -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
                    <h5 class="fw-bold mb-0" style="color: #1b2a47;">
                        <i class="bi bi-mortarboard-fill me-2" style="color: #e67e22;"></i>3. Información de Matrícula por Grado y Género
                    </h5>
                    <span class="badge bg-light text-dark border">Consolidado por Nivel</span>
                </div>
                <div class="card-body p-4">
                    <div class="row g-4">
                        <div class="col-lg-7">
                            <div class="card border-0 bg-light p-3 rounded-3 h-100">
                                <h6 class="fw-bold text-secondary mb-3">Historial de Matrícula Registrada por Grado</h6>
                                <div style="position: relative; height:240px;">
                                    <canvas id="chartMatriculasGrado"></canvas>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-5">
                            <div class="card border-0 bg-light p-3 rounded-3 h-100">
                                <h6 class="fw-bold text-secondary mb-3">Distribución por Género</h6>
                                <div style="position: relative; height:200px;" class="d-flex justify-content-center">
                                    <canvas id="chartGenero"></canvas>
                                </div>
                                <div class="d-flex justify-content-around text-center mt-3 pt-2 border-top">
                                    <div>
                                        <span class="badge bg-primary px-2 py-1">Hombres</span>
                                        <p class="fw-bold mb-0 mt-1">@rep.TotalHombres</p>
                                    </div>
                                    <div>
                                        <span class="badge px-2 py-1" style="background-color: #e84393; color: white;">Mujeres</span>
                                        <p class="fw-bold mb-0 mt-1">@rep.TotalMujeres</p>
                                    </div>
                                    @if (rep.TotalSinGenero > 0)
                                    {
                                        <div>
                                            <span class="badge bg-secondary px-2 py-1">No Esp.</span>
                                            <p class="fw-bold mb-0 mt-1">@rep.TotalSinGenero</p>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    @if (TempData.Peek("ErrorMatricula") != null)
    {
        <script>
                document.addEventListener("DOMContentLoaded", function() {
                    mostrarAdminSub('admin-certificados');
                });
        </script>
    }



    <div id="panel-docente" class="role-panel d-none">

        <!--  -->
        <!-- 1. MENÚ PRINCIPAL DE TARJETA (DOCENTE MAIN) -->
        <!--  -->
        <div id="docente-main">
            <h2 class="mb-4" style="color: #2980b9;"><i class="bi bi-person-badge-fill me-2"></i>Panel del Docente</h2>

            <div class="row">
                <!-- Tarjeta: Planilla de Notas (Navega a la vista completa de Planilla de Calificaciones) -->
                <div class="col-md-4 mb-4" onclick="location.href='@Url.Action("Planilla", "Docente")'" style="cursor: pointer;">
                    <div class="card p-4 text-center border-0 shadow-sm h-100 card-hover" style="border-top: 4px solid #2980b9 !important;">
                        <i class="bi bi-clipboard-check fs-2 mb-2" style="color: #2980b9;"></i>
                        <h5 class="text-dark">Planilla de Notas</h5>
                        <p class="small text-muted">Gestión de calificaciones y promedios.</p>
                        <a href="@Url.Action("Planilla", "Docente")" class="btn btn-sm btn-outline-primary mt-auto w-100">Ver Planilla</a>
                    </div>
                </div>

                <!-- Tarjeta: Asistencia -->
                <div class="col-md-4 mb-4" onclick="verAsistencia()" style="cursor: pointer;">
                    <div class="card p-4 text-center border-0 shadow-sm h-100 card-hover" style="border-top: 4px solid #2980b9 !important;">
                        <i class="bi bi-calendar-check fs-2 mb-2" style="color: #2980b9;"></i>
                        <h5>Asistencia</h5>
                        <p class="small text-muted">Toma de lista diaria.</p>
                        <button class="btn btn-sm btn-outline-primary mt-auto w-100">Ver asistencias</button>
                    </div>
                </div>

                <!-- Tarjeta: Observador -->
                <div class="col-md-4 mb-4" onclick="verObservaciones()" style="cursor: pointer;">
                    <div class="card p-4 text-center border-0 shadow-sm h-100 card-hover" style="border-top: 4px solid #2980b9 !important;">
                        <i class="bi bi-chat-dots fs-2 mb-2" style="color: #2980b9;"></i>
                        <h5>Observador</h5>
                        <p class="small text-muted">Seguimiento convivencial.</p>
                        <button class="btn btn-sm btn-outline-primary mt-auto w-100">Ver observaciones</button>
                    </div>
                </div>

                <!-- Tarjeta: Reportes Generales -->
                <div class="col-md-4 mb-4" onclick="location.href='@Url.Action("ReporteGrupal", "Docente")'" style="cursor: pointer;">
                    <div class="card p-4 text-center border-0 shadow-sm h-100 card-hover" style="border-top: 4px solid #2980b9 !important;">
                        <i class="bi bi-bar-chart-line fs-2 mb-2" style="color: #2980b9;"></i>
                        <h5 class="text-dark">Reportes Generales</h5>
                        <p class="small text-muted">Estadísticas y promedios grupales del curso.</p>
                        <button class="btn btn-sm btn-outline-primary mt-auto w-100">Ver Estadísticas</button>
                    </div>
                </div>

                <!-- Tarjeta: Gestión de Acciones de Mejora -->
                <div class="col-md-4 mb-4" onclick="verModuloMejorasDocente()" style="cursor: pointer;">
                    <div class="card p-4 text-center border-0 shadow-sm h-100 card-hover" style="border-top: 4px solid #2980b9 !important;">
                        <i class="bi bi-arrow-up-right-circle fs-2 mb-2" style="color: #2980b9;"></i>
                        <h5 class="text-dark">Seguimiento de Mejoras</h5>
                        <p class="small text-muted">Asigna compromisos y escribe observaciones a tus estudiantes.</p>
                        <button class="btn btn-sm btn-outline-primary mt-auto w-100">Gestionar Mejoras</button>
                    </div>
                </div>

                <!-- Tarjeta: Horario de Clases -->
                <div class="col-md-4 mb-4" onclick="location.href='@Url.Action("MiHorario", "Horario")'" style="cursor: pointer;">
                    <div class="card p-4 text-center border-0 shadow-sm h-100 card-hover" style="border-top: 4px solid #2980b9 !important;">
                        <i class="bi bi-calendar-week fs-2 mb-2" style="color: #2980b9;"></i>
                        <h5 class="text-dark">Horario de Clases</h5>
                        <p class="small text-muted">Consulta la programación semanal de tus clases.</p>
                        <button class="btn btn-sm btn-outline-primary mt-auto w-100" type="button">Ver Horario</button>
                    </div>
                </div>

                <!-- Tarjeta: Cursos Extracurriculares (Docente) -->
                <div class="col-md-4 mb-4" onclick="verCursosExtraDocente()" style="cursor: pointer;">
                    <div class="card p-4 text-center border-0 shadow-sm h-100 card-hover" style="border-top: 4px solid #2980b9 !important;">
                        <i class="bi bi-stars fs-2 mb-2" style="color: #2980b9;"></i>
                        <h5 class="text-dark">Cursos Extracurriculares</h5>
                        <p class="small text-muted">Publica talleres, define fechas, cupos, temario y gestiona inscripciones.</p>
                        <button class="btn btn-sm btn-outline-primary mt-auto w-100">Gestionar Extracurriculares</button>
                    </div>
                </div>

                <!-- Tarjeta: Actividades y Tareas (Docente) -->
                <div class="col-md-4 mb-4" onclick="verActividadesDocente()" style="cursor: pointer;">
                    <div class="card p-4 text-center border-0 shadow-sm h-100 card-hover" style="border-top: 4px solid #2980b9 !important;">
                        <i class="bi bi-journal-check fs-2 mb-2" style="color: #2980b9;"></i>
                        <h5 class="text-dark">Actividades y Tareas</h5>
                        <p class="small text-muted">Crea talleres, recibe entregas, califica y sincroniza notas en planilla.</p>
                        <button class="btn btn-sm btn-outline-primary mt-auto w-100">Gestionar Actividades</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- ============================================================== -->
        <!-- 2. MÓDULOS INDEPENDIENTES Y COMPONENTES OCULTOS (DOCENTE)      -->
        <!-- ============================================================== -->

        <!-- MÓDULO: OBSERVADOR DEL ALUMNO & CITACIONES (DOCENTE) -->
        <div id="docente-observaciones" class="d-none">
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
                <div>
                    <h3 style="color: #2980b9;" class="fw-bold mb-0"><i class="bi bi-eye-fill me-2"></i>Observador del Alumno</h3>
                    <p class="text-muted small mb-0">Seguimiento convivencial, reconocimientos de mérito, compromisos y generación de informe institucional.</p>
                </div>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-sm btn-danger text-white shadow-sm" style="border-radius: 8px;" onclick="descargarObservadorDocentePdf()">
                        <i class="bi bi-file-earmark-pdf me-1"></i> Descargar Reporte PDF
                    </button>
                    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="volverDocente()" style="border-radius: 8px;">
                        <i class="bi bi-arrow-left me-1"></i> Volver
                    </button>
                </div>
            </div>

            <!-- 1. Filtros Previos: Curso, Jornada y Tipo de Nota -->
            <div class="card border-0 shadow-sm p-4 mb-4 rounded-3">
                <h5 class="fw-bold text-dark mb-3"><i class="bi bi-funnel-fill text-primary me-2"></i>Filtros de Búsqueda y Selección</h5>
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label small fw-bold">Curso / Grado</label>
                        <select class="form-select" id="selectCursoObservador" onchange="filtrarEstudiantesObservador()">
                            <option value="todos">Todos los Cursos</option>
                            @if (ViewBag.CursosAsistencia != null)
                            {
                                foreach (var c in (IEnumerable<string>)ViewBag.CursosAsistencia)
                                {
                                    <option value="@c">@c</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold">Jornada</label>
                        <select class="form-select" id="selectJornadaObservador" onchange="filtrarEstudiantesObservador()">
                            <option value="todos">Todas las Jornadas</option>
                            <option value="Mañana" selected>Mañana</option>
                            <option value="Tarde">Tarde</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold">Estudiante <span class="text-danger">*</span></label>
                        <select class="form-select" id="selectEstudianteObservacion" required onchange="cargarObservacionesEstudianteSeleccionado()">
                            <option value="">-- Seleccionar Estudiante --</option>
                            @if (ViewBag.EstudiantesAsistencia != null)
                            {
                                var gradosMap = ViewBag.EstudianteGradosMap as Dictionary<int, string>;
                                foreach (var est in (List<ProyectoPAE.Models.Usuario>)ViewBag.EstudiantesAsistencia)
                                {
                                    string cursoEst = (gradosMap != null && gradosMap.ContainsKey(est.ID_Usuario)) ? gradosMap[est.ID_Usuario] : "";
                                    <option value="@est.ID_Usuario" data-curso="@cursoEst">@(!string.IsNullOrEmpty(est.NOMBRES) ? $"{est.NOMBRES} {est.APELLIDOS}".Trim() : est.NOMBRE_USUARIO) @(!string.IsNullOrEmpty(cursoEst) ? $"({cursoEst})" : "")</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold">Tipo de Nota <span class="text-danger">*</span></label>
                        <select class="form-select" id="selectTipoNotaObservacion" onchange="cambiarCamposObservadorPorTipo()">
                            <option value="Positiva / Mérito" class="text-success fw-bold">Positiva / Mérito</option>
                            <option value="Seguimiento Académico" class="text-warning fw-bold">Seguimiento Académico (Compromiso)</option>
                            <option value="Llamado de Atención" class="text-danger fw-bold">Llamado de Atención (Disciplinario)</option>
                            <option value="Falta al Manual de Convivencia" class="text-danger">Falta al Manual de Convivencia</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- 2. Formulario Dinámico de Registro según Tipo de Nota -->
            <div class="row g-4 mb-4">
                <div class="col-lg-7">
                    <div class="card border-0 shadow-sm p-4 h-100 rounded-3" style="border-top: 4px solid #2980b9 !important;">
                        <h5 class="fw-bold mb-3 text-dark"><i class="bi bi-journal-plus text-primary me-2"></i>Registrar Anotación en Observador</h5>

                        <!-- Periodo Lectivo -->
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Periodo Lectivo</label>
                            <select class="form-select form-select-sm" id="selectPeriodoObservacion">
                                <option value="1">Primer Periodo</option>
                                <option value="2">Segundo Periodo</option>
                                <option value="3">Tercer Periodo</option>
                                <option value="4">Cuarto Periodo</option>
                            </select>
                        </div>

                        <!-- BLOQUE 1: Para notas Positivas / Mérito (1 Campo) -->
                        <div id="bloqueNotaPositiva">
                            <div class="mb-3">
                                <label class="form-label small fw-semibold text-success"><i class="bi bi-star-fill me-1"></i>Descripción del Mérito <span class="text-danger">*</span></label>
                                <textarea class="form-control" id="txtDescripcionMerito" rows="4" placeholder="Detalla el logro, felicitación, mérito académico o actitudinal destacado del estudiante..."></textarea>
                            </div>
                        </div>

                        <!-- BLOQUE 2: Para notas Negativas / Seguimiento Académico / Llamado de Atención (3 Campos) -->
                        <div id="bloqueNotaNegativa" class="d-none">
                            <div class="mb-3">
                                <label class="form-label small fw-semibold text-danger"><i class="bi bi-exclamation-circle-fill me-1"></i>1. Descripción del Suceso <span class="text-danger">*</span></label>
                                <textarea class="form-control" id="txtDescripcionSuceso" rows="3" placeholder="Detalle lo sucedido, fecha/hora y hechos ocurridos en el aula o institución..."></textarea>
                            </div>

                            <div class="mb-3">
                                <label class="form-label small fw-semibold text-warning text-dark"><i class="bi bi-arrow-up-right-circle-fill me-1 text-warning"></i>2. Aspectos a Mejorar del Estudiante <span class="text-danger">*</span></label>
                                <textarea class="form-control" id="txtAspectosMejorar" rows="3" placeholder="Especifique los compromisos pedagógicos, pautas de comportamiento y acciones de mejora a adoptar..."></textarea>
                            </div>

                            <div class="mb-3">
                                <label class="form-label small fw-semibold text-primary"><i class="bi bi-person-badge-fill me-1"></i>3. Quién le Pone la Nota / Docente que Registra <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="txtQuienRegistra" value="@nombre" placeholder="Nombre completo o cargo del docente/directivo" />
                            </div>
                        </div>

                        <div class="text-end mt-3">
                            <button type="button" class="btn text-white fw-bold px-4 shadow-sm" style="background-color: #2980b9;" onclick="guardarObservacionDocente()">
                                <i class="bi bi-save me-1"></i> Registrar en Observador
                            </button>
                        </div>
                    </div>
                </div>

                <!-- 3. Formulario de Citación a Padres -->
                <div class="col-lg-5">
                    <div class="card border-0 shadow-sm p-4 h-100 rounded-3" style="border-top: 4px solid #27ae60 !important;">
                        <h5 class="fw-bold mb-3 text-dark"><i class="bi bi-envelope-paper-fill text-success me-2"></i>Enviar Citación Oficial a Acudiente</h5>
                        <p class="text-muted small">Notifica formalmente al padre de familia o tutor legal sobre novedades académicas o citaciones presenciales.</p>

                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Asunto de la Citación <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="txtAsuntoCitacion" placeholder="Ej: Citación sobre rendimiento académico - Periodo 1" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Mensaje y Fecha/Hora de Citación <span class="text-danger">*</span></label>
                            <textarea class="form-control" id="txtMensajeCitacion" rows="4" placeholder="Estimado acudiente, se solicita su presencia el día..."></textarea>
                        </div>

                        <button type="button" class="btn btn-success fw-bold w-100 mt-auto text-white" onclick="guardarCitacionDocente()">
                            <i class="bi bi-send-fill me-1"></i> Enviar Citación al Acudiente
                        </button>
                    </div>
                </div>
            </div>

            <!-- 4. Historial de Observaciones del Estudiante Seleccionado -->
            <div class="card border-0 shadow-sm p-4 rounded-3">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold text-dark mb-0"><i class="bi bi-clock-history text-secondary me-2"></i>Historial de Anotaciones en el Observador</h5>
                    <span class="badge bg-secondary" id="conteoObservacionesEstudiante">Selecciona un estudiante</span>
                </div>
                <div id="contenedorHistorialObservaciones" class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 130px;">Fecha</th>
                                <th style="width: 110px;">Periodo</th>
                                <th style="width: 170px;">Tipo de Nota</th>
                                <th>Descripción / Hechos</th>
                                <th>Aspectos a Mejorar</th>
                                <th style="width: 150px;">Docente / Autor</th>
                            </tr>
                        </thead>
                        <tbody id="cuerpoHistorialObservaciones">
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">Seleccione un estudiante para consultar su historial de observador.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- MÓDULO: CONTROL DE ASISTENCIA (DOCENTE) -->
        <div id="docente-asistencia" class="d-none">
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
                <div>
                    <h3 style="color: #2980b9;" class="fw-bold mb-0"><i class="bi bi-calendar-check me-2"></i>Control de Asistencia</h3>
                    <p class="text-muted small mb-0">Selecciona el curso y la jornada para cargar la lista de estudiantes y registrar la asistencia diaria.</p>
                </div>
                <button type="button" class="btn btn-outline-secondary btn-sm" onclick="volverDocente()" style="border-radius: 8px;">
                    <i class="bi bi-arrow-left me-1"></i> Volver
                </button>
            </div>

            <!-- Filtros: Fecha, Grupo (Curso), Jornada y Botón Rápido -->
            <div class="card border-0 shadow-sm p-4 mb-4 rounded-3">
                <div class="row g-3 align-items-end">
                    <!-- 1. Campo Fecha -->
                    <div class="col-md-3">
                        <label class="form-label fw-bold small text-dark"><i class="bi bi-calendar3 me-1 text-primary"></i>Fecha de Asistencia</label>
                        <input type="date" class="form-control" id="inputFechaAsistencia" value="@DateTime.Now.ToString("yyyy-MM-dd")">
                    </div>

                    <!-- 2. Seleccionar Grupo / Curso -->
                    <div class="col-md-3">
                        <label class="form-label fw-bold small text-dark"><i class="bi bi-mortarboard me-1 text-primary"></i>Curso / Grupo <span class="text-danger">*</span></label>
                        <select class="form-select" id="selectGrupoAsistencia" onchange="filtrarAsistenciaPorCursoYJornada()">
                            <option value="todos">Todos los Cursos</option>
                            @if (ViewBag.CursosAsistencia != null && ((IEnumerable<string>)ViewBag.CursosAsistencia).Any())
                            {
                                foreach (var c in (IEnumerable<string>)ViewBag.CursosAsistencia)
                                {
                                    <option value="@c">@c</option>
                                }
                            }
                            else
                            {
                                <option value="601 M">601 M</option>
                                <option value="602 M">602 M</option>
                                <option value="701 M">701 M</option>
                                <option value="801 M">801 M</option>
                                <option value="901 M">901 M</option>
                                <option value="1001 M">1001 M</option>
                                <option value="1101 M">1101 M</option>
                            }
                        </select>
                    </div>

                    <!-- 3. Seleccionar Jornada (Mañana / Tarde) -->
                    <div class="col-md-3">
                        <label class="form-label fw-bold small text-dark"><i class="bi bi-clock-history me-1 text-primary"></i>Jornada</label>
                        <select class="form-select" id="selectJornadaAsistencia" onchange="filtrarAsistenciaPorCursoYJornada()">
                            <option value="todos">Todas las Jornadas</option>
                            <option value="Mañana" selected>Mañana</option>
                            <option value="Tarde">Tarde</option>
                        </select>
                    </div>

                    <!-- 4. Botón Marcar Todos como Presente -->
                    <div class="col-md-3 text-end">
                        <button type="button" class="btn btn-success w-100 fw-bold shadow-sm" onclick="marcarTodosPresentes()">
                            <i class="bi bi-check-all me-1"></i> Marcar todos como Presente
                        </button>
                    </div>
                </div>
            </div>

            <!-- Tabla Dinámica cargada desde la Base de Datos con Paginación Client-Side -->
            <div class="card border-0 shadow-sm overflow-hidden mb-4 rounded-3">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" id="tablaAsistencia">
                        <thead class="table-dark">
                            <tr>
                                <th class="ps-3">Estudiante</th>
                                <th class="text-center" style="width: 140px;">Curso</th>
                                <th class="text-center" style="width: 220px;">Estado (P / F / R)</th>
                                <th>Observación / Justificación</th>
                            </tr>
                        </thead>
                        <tbody id="tbodyAsistencia">
                            @if (ViewBag.EstudiantesAsistencia != null && ((List<ProyectoPAE.Models.Usuario>)ViewBag.EstudiantesAsistencia).Any())
                            {
                                var listaEst = (List<ProyectoPAE.Models.Usuario>)ViewBag.EstudiantesAsistencia;
                                var gradosMap = ViewBag.EstudianteGradosMap as Dictionary<int, string>;
                                for (int i = 0; i < listaEst.Count; i++)
                                {
                                    var est = listaEst[i];
                                    var radId = i + 1;
                                    string cursoEst = (gradosMap != null && gradosMap.ContainsKey(est.ID_Usuario)) ? gradosMap[est.ID_Usuario] : "";
                                    <tr class="fila-asistencia-estudiante" data-curso="@cursoEst">
                                        <td class="ps-3 fw-bold estudiante-nombre">
                                            <input type="hidden" name="estudiante_id_asistencia" value="@est.ID_Usuario" />
                                            @(!string.IsNullOrEmpty(est.NOMBRES) ? $"{est.NOMBRES} {est.APELLIDOS}".Trim() : est.NOMBRE_USUARIO)
                                        </td>
                                        <td class="text-center">
                                            @if (!string.IsNullOrEmpty(cursoEst))
                                            {
                                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle">@cursoEst</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-muted border">-</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            <div class="btn-group btn-group-sm" role="group">
                                                <input type="radio" class="btn-check radio-estado-p" name="ast_@est.ID_Usuario" id="p_@radId" value="P" checked>
                                                <label class="btn btn-outline-success fw-bold px-3" for="p_@radId" title="Presente">P</label>

                                                <input type="radio" class="btn-check" name="ast_@est.ID_Usuario" id="f_@radId" value="F">
                                                <label class="btn btn-outline-danger fw-bold px-3" for="f_@radId" title="Falla / Ausente">F</label>

                                                <input type="radio" class="btn-check" name="ast_@est.ID_Usuario" id="r_@radId" value="R">
                                                <label class="btn btn-outline-warning fw-bold px-3" for="r_@radId" title="Retardo / Llegada Tardía">R</label>
                                            </div>
                                        </td>
                                        <td>
                                            <input type="text" class="form-control form-control-sm" name="obs_@est.ID_Usuario" placeholder="Observación opcional...">
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-4">No hay estudiantes registrados en la base de datos.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Paginación Client-Side Asistencia -->
                <div class="card-footer bg-white d-flex flex-wrap align-items-center justify-content-between gap-2 px-3 py-2 border-top">
                    <p class="text-muted small mb-0" id="infoAsistenciaPagina">Cargando...</p>
                    <nav aria-label="Paginación asistencia">
                        <ul class="pagination pagination-sm mb-0" id="paginacionAsistencia"></ul>
                    </nav>
                </div>

                <!-- Botones de Acción: Reiniciar y Guardar Asistencia -->
                <div class="p-3 bg-light d-flex justify-content-between align-items-center border-top">
                    <button type="button" class="btn btn-outline-secondary fw-bold" onclick="reiniciarAsistencias()">
                        <i class="bi bi-arrow-counterclockwise me-2"></i>Reiniciar Calificación de Asistencias
                    </button>
                    <button type="button" class="btn text-white fw-bold px-4 shadow-sm" style="background-color: #2980b9;" onclick="guardarAsistenciaYObservaciones()">
                        <i class="bi bi-save me-2"></i>Guardar Asistencia y Observaciones
                    </button>
                </div>
            </div>
        </div>

        <!-- Módulo Oculto de Gestión de Cursos Extracurriculares (Docente) -->
        <div id="docente-cursosextra" class="d-none">
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
                <div>
                    <h3 class="fw-bold mb-0" style="color: #2980b9;">
                        <i class="bi bi-stars me-2"></i>Gestión de Cursos Extracurriculares
                    </h3>
                    <p class="text-muted small mb-0">Crea talleres institucionales, define temarios de aprendizaje, límites de cupos y consulta inscripciones en tiempo real.</p>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn text-white shadow-sm" style="background-color: #2980b9; border-radius: 8px;" data-bs-toggle="modal" data-bs-target="#modalCrearCursoExtra">
                        <i class="bi bi-plus-circle me-1"></i> Publicar Nuevo Curso
                    </button>
                    <button class="btn btn-outline-secondary btn-sm" onclick="volverDocente()" style="border-radius: 8px;">
                        <i class="bi bi-arrow-left me-1"></i> Volver
                    </button>
                </div>
            </div>

            <!-- KPIs de Cursos Extracurriculares -->
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm p-3 h-100 rounded-3" style="border-left: 4px solid #2980b9 !important;">
                        <span class="text-muted text-uppercase small fw-semibold">Cursos Registrados</span>
                        <h3 class="fw-bold mb-0 text-dark">@cursosExtraDocente.Count</h3>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm p-3 h-100 rounded-3" style="border-left: 4px solid #27ae60 !important;">
                        <span class="text-muted text-uppercase small fw-semibold">Cupos Totales Ofertados</span>
                        <h3 class="fw-bold mb-0 text-success">@cursosExtraDocente.Sum(c => c.CuposTotales)</h3>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm p-3 h-100 rounded-3" style="border-left: 4px solid #f39c12 !important;">
                        <span class="text-muted text-uppercase small fw-semibold">Cupos Disponibles Libres</span>
                        <h3 class="fw-bold mb-0 text-warning">@cursosExtraDocente.Sum(c => c.CuposDisponibles)</h3>
                    </div>
                </div>
            </div>

            @if (!cursosExtraDocente.Any())
            {
                <div class="card border-0 shadow-sm p-5 text-center rounded-4 bg-white">
                    <i class="bi bi-stars text-muted display-4 mb-3"></i>
                    <h5 class="fw-bold text-secondary">Aún no has publicado ningún curso extracurricular</h5>
                    <p class="text-muted small mb-4">Haz clic en el botón inferior para abrir las inscripciones a un nuevo taller o actividad extracurricular.</p>
                    <div>
                        <button class="btn text-white px-4 py-2 shadow-sm" style="background-color: #2980b9; border-radius: 8px;" data-bs-toggle="modal" data-bs-target="#modalCrearCursoExtra">
                            <i class="bi bi-plus-circle me-2"></i> Crear Primer Curso Extracurricular
                        </button>
                    </div>
                </div>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var curso in cursosExtraDocente)
                    {
                        var pctOcupacion = curso.CuposTotales > 0 ? (int)(((double)(curso.CuposTotales - curso.CuposDisponibles) / curso.CuposTotales) * 100) : 0;
                        var estadoClase = !curso.Activo ? "bg-secondary" : (curso.CuposDisponibles == 0 ? "bg-danger" : (curso.PeriodoInscripcionAbierto ? "bg-success" : "bg-warning text-dark"));
                        var estadoTexto = !curso.Activo ? "Inactivo / Pausado" : (curso.CuposDisponibles == 0 ? "Cupos Agotados" : (curso.PeriodoInscripcionAbierto ? "Inscripciones Abiertas" : "Fuera de Periodo"));

                        <div class="col-lg-6 mb-3">
                            <div class="card border-0 shadow-sm rounded-4 h-100 p-3 bg-white" style="border-top: 4px solid #2980b9 !important;">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h5 class="fw-bold text-dark mb-0">@curso.Nombre</h5>
                                    <span class="badge @estadoClase rounded-pill px-3 py-1">@estadoTexto</span>
                                </div>

                                <p class="text-muted small mb-2">
                                    <i class="bi bi-person-fill text-primary me-1"></i><strong>Instructor:</strong> @curso.Instructor
                                    @if (!string.IsNullOrEmpty(curso.Horario))
                                    {
                                        <span class="ms-2"><i class="bi bi-clock-fill text-secondary me-1"></i>@curso.Horario</span>
                                    }
                                </p>

                                <div class="p-3 bg-light rounded-3 mb-3">
                                    <h6 class="fw-bold text-secondary small mb-1"><i class="bi bi-journal-text me-1 text-primary"></i>¿Qué se va a aprender? / Temario:</h6>
                                    <p class="small text-muted mb-0" style="white-space: pre-line;">@(string.IsNullOrWhiteSpace(curso.Descripcion) ? "Sin descripción detallada." : curso.Descripcion)</p>
                                </div>

                                <div class="row g-2 small text-muted mb-3">
                                    <div class="col-6">
                                        <div class="border p-2 rounded-2 bg-white">
                                            <span class="d-block text-secondary fw-semibold"><i class="bi bi-calendar-event me-1"></i>Inscripciones:</span>
                                            <span class="fw-bold text-dark">@curso.FechaInicioInscripcion.ToString("dd/MM/yyyy") - @curso.FechaFinInscripcion.ToString("dd/MM/yyyy")</span>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="border p-2 rounded-2 bg-white">
                                            <span class="d-block text-secondary fw-semibold"><i class="bi bi-calendar-check me-1"></i>Clases del Curso:</span>
                                            <span class="fw-bold text-dark">@curso.FechaInicio.ToString("dd/MM/yyyy") - @curso.FechaFin.ToString("dd/MM/yyyy")</span>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <div class="border p-2 rounded-2 bg-white d-flex justify-content-between align-items-center">
                                            <span><i class="bi bi-mortarboard me-1 text-primary"></i>Grados admitidos:</span>
                                            <span class="badge bg-primary text-white">Grados @(curso.GradoMin ?? 6)° a @(curso.GradoMax ?? 11)°</span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Barra de cupos -->
                                <div class="mb-3">
                                    <div class="d-flex justify-content-between align-items-center small mb-1">
                                        <span class="text-muted fw-semibold">Disponibilidad de cupos:</span>
                                        <span class="fw-bold @(curso.CuposDisponibles > 0 ? "text-success" : "text-danger")">
                                            @curso.CuposDisponibles de @curso.CuposTotales disponibles (@(curso.CuposTotales - curso.CuposDisponibles) inscritos)
                                        </span>
                                    </div>
                                    <div class="progress" style="height: 8px;">
                                        <div class="progress-bar @(pctOcupacion >= 100 ? "bg-danger" : (pctOcupacion >= 80 ? "bg-warning" : "bg-primary"))" role="progressbar" style="width: @pctOcupacion%;" aria-valuenow="@pctOcupacion" aria-valuemin="0" aria-valuemax="100"></div>
                                    </div>
                                </div>

                                <div class="d-flex justify-content-between align-items-center pt-2 border-top mt-auto">
                                    <button class="btn btn-outline-primary btn-sm rounded-pill px-3" onclick="verInscritosCursoExtra(@curso.IdExtraCurso)">
                                        <i class="bi bi-people-fill me-1"></i> Ver Inscritos (@(curso.CuposTotales - curso.CuposDisponibles))
                                    </button>
                                    <div class="d-flex gap-1">
                                        <button class="btn btn-sm @(curso.Activo ? "btn-outline-warning" : "btn-outline-success") rounded-pill px-3" onclick="cambiarEstadoCursoExtra(@curso.IdExtraCurso, @(curso.Activo ? "false" : "true"))">
                                            @(curso.Activo ? "Pausar" : "Activar")
                                        </button>
                                        <button class="btn btn-outline-danger btn-sm rounded-pill px-2" title="Eliminar curso" onclick="eliminarCursoExtra(@curso.IdExtraCurso)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- MODAL: CREAR CURSO EXTRACURRICULAR -->
        <div class="modal fade" id="modalCrearCursoExtra" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
                    <div class="modal-header text-white" style="background-color: #2980b9; border-radius: 16px 16px 0 0;">
                        <h5 class="modal-title fw-bold"><i class="bi bi-stars me-2"></i>Publicar Nuevo Curso Extracurricular</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <form id="formCrearCursoExtra" onsubmit="guardarCursoExtra(event)">
                        <div class="modal-body p-4">
                            <div class="row g-3">
                                <div class="col-md-8">
                                    <label class="form-label fw-bold small">Nombre del Curso / Taller <span class="text-danger">*</span></label>
                                    <input type="text" name="Nombre" class="form-control" placeholder="Ej: Club de Robótica y Programación, Taller de Arte y Óleo..." required />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-bold small">Docente / Instructor</label>
                                    <input type="text" name="Instructor" class="form-control" value="@nombre" placeholder="Nombre del instructor" />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold small">Categoría / Tipo de Curso <span class="text-danger">*</span></label>
                                    <select name="TipoCurso" class="form-select" required>
                                        <option value="Deportivo">⚽ Deportivo (Fútbol, Baloncesto, Voleibol, Atletismo)</option>
                                        <option value="Matemático / Académico">📐 Matemático / Académico (Olimpiadas, Robótica, Ciencias)</option>
                                        <option value="Artístico y Cultural">🎨 Artístico y Cultural (Música, Teatro, Pintura, Danza)</option>
                                        <option value="Servicio Social y Comunitario">🤝 Servicio Social y Comunitario</option>
                                    </select>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold small">Cupos Totales <span class="text-danger">*</span></label>
                                    <input type="number" name="CuposTotales" class="form-control" min="1" max="500" value="20" required />
                                </div>

                                <div class="col-12">
                                    <label class="form-label fw-bold small">¿Qué se va a aprender? / Temario y Objetivos <span class="text-danger">*</span></label>
                                    <textarea name="Descripcion" class="form-control" rows="3" placeholder="Describe los contenidos del curso, competencias a desarrollar, materiales necesarios y dinámica de las sesiones..." required></textarea>
                                </div>

                                <!-- SECCIÓN: DOCUMENTOS REQUERIDOS ORGANIZADOS POR CATEGORÍAS -->
                                <div class="col-12">
                                    <div class="card p-3 border-0 rounded-3" style="background-color: #f0f7ff; border-left: 4px solid #2980b9 !important;">
                                        <h6 class="fw-bold text-dark mb-2"><i class="bi bi-file-earmark-check-fill text-primary me-2"></i>Documentos Requeridos para la Inscripción</h6>
                                        <p class="text-muted small mb-3">Selecciona los documentos que los estudiantes deberán adjuntar obligatoriamente (formato PDF/Imagen, máx. 5 MB c/u):</p>
                                        
                                        <div class="row g-3">
                                            <!-- Categoría 1: Obligatorios -->
                                            <div class="col-md-4">
                                                <div class="p-2 bg-white rounded-3 border h-100">
                                                    <span class="d-block fw-bold text-primary small mb-2"><i class="bi bi-person-vcard me-1"></i>1. Obligatorios</span>
                                                    <div class="form-check mb-1">
                                                        <input class="form-check-input check-doc-req" type="checkbox" value="Documento de Identidad (TI / RC)" id="docReqTI" checked>
                                                        <label class="form-check-label small" for="docReqTI">Doc. de Identidad (TI / RC)</label>
                                                    </div>
                                                    <div class="form-check">
                                                        <input class="form-check-input check-doc-req" type="checkbox" value="Formato de Autorización de Padres / Acudientes" id="docReqAut" checked>
                                                        <label class="form-check-label small" for="docReqAut">Autorización de Padres</label>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Categoría 2: Salud y Emergencias -->
                                            <div class="col-md-4">
                                                <div class="p-2 bg-white rounded-3 border h-100">
                                                    <span class="d-block fw-bold text-success small mb-2"><i class="bi bi-heart-pulse me-1"></i>2. Salud y Emergencias</span>
                                                    <div class="form-check mb-1">
                                                        <input class="form-check-input check-doc-req" type="checkbox" value="Certificado Médico de Aptitud Física" id="docReqMed">
                                                        <label class="form-check-label small" for="docReqMed">Certificado Médico Aptitud</label>
                                                    </div>
                                                    <div class="form-check">
                                                        <input class="form-check-input check-doc-req" type="checkbox" value="Copia de EPS o Seguro Estudiantil" id="docReqEPS" checked>
                                                        <label class="form-check-label small" for="docReqEPS">Copia de EPS / Seguro</label>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Categoría 3: Administrativos -->
                                            <div class="col-md-4">
                                                <div class="p-2 bg-white rounded-3 border h-100">
                                                    <span class="d-block fw-bold text-warning text-dark small mb-2"><i class="bi bi-folder-check me-1 text-warning"></i>3. Administrativos</span>
                                                    <div class="form-check mb-1">
                                                        <input class="form-check-input check-doc-req" type="checkbox" value="Foto Tipo Documento 3x4 Fondo Blanco" id="docReqFoto">
                                                        <label class="form-check-label small" for="docReqFoto">Foto tipo carné 3x4</label>
                                                    </div>
                                                    <div class="form-check">
                                                        <input class="form-check-input check-doc-req" type="checkbox" value="Paz y Salvo Institucional" id="docReqPaz">
                                                        <label class="form-check-label small" for="docReqPaz">Paz y Salvo</label>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold small">Grado Mínimo Permitido</label>
                                    <select name="GradoMin" class="form-select">
                                        <option value="6" selected>6° Grado</option>
                                        <option value="7">7° Grado</option>
                                        <option value="8">8° Grado</option>
                                        <option value="9">9° Grado</option>
                                        <option value="10">10° Grado</option>
                                        <option value="11">11° Grado</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold small">Grado Máximo Permitido</label>
                                    <select name="GradoMax" class="form-select">
                                        <option value="6">6° Grado</option>
                                        <option value="7">7° Grado</option>
                                        <option value="8">8° Grado</option>
                                        <option value="9">9° Grado</option>
                                        <option value="10">10° Grado</option>
                                        <option value="11" selected>11° Grado</option>
                                    </select>
                                </div>

                                <div class="col-md-12">
                                    <label class="form-label fw-bold small">Horario / Días de Clase</label>
                                    <input type="text" name="Horario" class="form-control" placeholder="Ej: Martes y Jueves de 3:30 PM a 5:00 PM (Aula de Informática)" />
                                </div>

                                <div class="col-md-6">
                                    <div class="card p-3 bg-light border-0 rounded-3">
                                        <h6 class="fw-bold small text-primary mb-2"><i class="bi bi-calendar-event me-1"></i>Periodo de Inscripción</h6>
                                        <div class="mb-2">
                                            <label class="form-label small mb-1">Fecha Inicio Inscripción:</label>
                                            <input type="date" name="FechaInicioInscripcion" class="form-control form-control-sm" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                                        </div>
                                        <div>
                                            <label class="form-label small mb-1">Fecha Cierre Inscripción:</label>
                                            <input type="date" name="FechaFinInscripcion" class="form-control form-control-sm" value="@DateTime.Now.AddDays(15).ToString("yyyy-MM-dd")" required />
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="card p-3 bg-light border-0 rounded-3">
                                        <h6 class="fw-bold small text-success mb-2"><i class="bi bi-calendar-check me-1"></i>Periodo de Clases</h6>
                                        <div class="mb-2">
                                            <label class="form-label small mb-1">Fecha Inicio del Curso:</label>
                                            <input type="date" name="FechaInicio" class="form-control form-control-sm" value="@DateTime.Now.AddDays(16).ToString("yyyy-MM-dd")" required />
                                        </div>
                                        <div>
                                            <label class="form-label small mb-1">Fecha Fin del Curso:</label>
                                            <input type="date" name="FechaFin" class="form-control form-control-sm" value="@DateTime.Now.AddMonths(3).ToString("yyyy-MM-dd")" required />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer bg-light" style="border-radius: 0 0 16px 16px;">
                            <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancelar</button>
                            <button type="submit" class="btn text-white rounded-pill px-4 shadow-sm" style="background-color: #2980b9;">
                                <i class="bi bi-check-circle me-1"></i> Publicar Curso
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- MODAL: VER ESTUDIANTES INSCRITOS -->
        <div class="modal fade" id="modalVerInscritosExtra" tabindex="-1" aria-hidden="true">
