        window.filtrarMejorasDocenteCurso = function() {
            const contenedor = document.getElementById('contenedorMejorasDocenteCurso');
            if (!contenedor) return;

            const inputBuscar = document.getElementById('inputBuscarEstudianteMejoraDocente');
            const selectEst = document.getElementById('selectFiltroEstudianteMejoraDocente');
            const selectMat = document.getElementById('selectFiltroMateriaMejoraDocente');
            const selectEstad = document.getElementById('selectFiltroEstadoMejoraDocente');

            const term = (inputBuscar ? inputBuscar.value : '').toLowerCase().trim();
            const idEst = selectEst ? selectEst.value : 'todos';
            const materia = selectMat ? selectMat.value : 'todas';
            const estado = selectEstad ? selectEstad.value : 'todos';

            const filtradas = listaMejorasDocenteCursoGlobal.filter(m => {
                const nom = (m.nombreEstudiante || '').toLowerCase();
                if (term !== '' && !nom.includes(term)) return false;
                if (idEst !== 'todos' && String(m.idEstudiante) !== String(idEst)) return false;
                if (materia !== 'todas' && (m.materia || '').toLowerCase() !== materia.toLowerCase()) return false;
                if (estado !== 'todos' && (m.estadoSeguimiento || '').toLowerCase() !== estado.toLowerCase()) return false;
                return true;
            });

            if (filtradas.length === 0) {
                contenedor.innerHTML = `
                    <div class="card border-0 shadow-sm p-5 text-center bg-white rounded-4">
                        <i class="bi bi-clipboard-check display-4 text-muted mb-3"></i>
                        <h5 class="fw-bold text-secondary">No hay acciones de mejora que coincidan</h5>
                        <p class="text-muted small mb-3">No se encontraron compromisos pedagógicos con los filtros actuales.</p>
                        <div>
                            <button class="btn btn-sm text-white px-3 py-2 rounded-pill shadow-sm" style="background-color: #2980b9;" onclick="abrirModalCrearMejoraParaCurso()">
                                <i class="bi bi-plus-circle me-1"></i> Nueva Acción de Mejora
                            </button>
                        </div>
                    </div>
                `;
                return;
            }

            let html = '<div class="row g-3">';
            filtradas.forEach(m => {
                let badgeEstado = '';
                if (m.estadoSeguimiento === 'Cumplido') {
                    badgeEstado = `<span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 rounded-pill fw-bold"><i class="bi bi-check-circle-fill me-1"></i>Cumplido</span>`;
                } else if (m.estadoSeguimiento === 'No Cumplido') {
                    badgeEstado = `<span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-1 rounded-pill fw-bold"><i class="bi bi-x-circle-fill me-1"></i>No Cumplido</span>`;
                } else {
                    badgeEstado = `<span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-3 py-1 rounded-pill fw-bold"><i class="bi bi-clock-history me-1"></i>En Proceso</span>`;
                }

                html += `
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 border-0 shadow-sm rounded-3 p-3 position-relative" style="border-top: 4px solid #2980b9 !important;">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="badge bg-light text-primary border rounded-pill px-2 py-1 small fw-bold">${m.materia}</span>
                                ${badgeEstado}
                            </div>
                            <h6 class="fw-bold text-dark mb-1">${m.nombreEstudiante}</h6>
                            <small class="text-muted d-block mb-2"><i class="bi bi-calendar3 me-1"></i>Periodo ${m.periodo || 1} • Registro: ${m.fechaRegistro || ''}</small>
                            
                            <div class="p-2 bg-light rounded-2 mb-2 small">
                                <strong class="text-dark d-block mb-1"><i class="bi bi-exclamation-circle text-warning me-1"></i>Aspecto a Mejorar:</strong>
                                <span class="text-muted">${m.aspectoMejorar}</span>
                            </div>

                            <div class="p-2 rounded-2 mb-3 small" style="background-color: #f0f7fd;">
                                <strong class="text-primary d-block mb-1"><i class="bi bi-check2-square me-1"></i>Compromiso del Estudiante:</strong>
                                <span class="text-dark">${m.compromisoEstudiante}</span>
                                ${m.fechaCompromiso ? `<div class="mt-1 text-muted" style="font-size: 0.75rem;"><i class="bi bi-clock me-1"></i>Fecha límite: ${m.fechaCompromiso}</div>` : ''}
                            </div>

                            ${m.observacionSeguimiento ? `
                                <div class="p-2 border rounded-2 mb-3 small bg-white">
                                    <strong class="text-secondary d-block" style="font-size: 0.76rem;"><i class="bi bi-chat-left-dots me-1"></i>Seguimiento Docente:</strong>
                                    <span class="text-dark">${m.observacionSeguimiento}</span>
                                    ${m.fechaSeguimiento ? `<div class="text-muted mt-1" style="font-size: 0.72rem;">Actualizado: ${m.fechaSeguimiento}</div>` : ''}
                                </div>
                            ` : ''}

                            <div class="mt-auto d-flex justify-content-between align-items-center pt-2 border-top">
                                <button class="btn btn-sm btn-outline-primary rounded-pill px-3" onclick="abrirModalSeguimientoMejora(${m.idMejora}, '${(m.estadoSeguimiento || 'En Proceso')}', '${escapeMejoraTexto(m.observacionSeguimiento || '')}')">
                                    <i class="bi bi-clipboard2-check me-1"></i> Seguimiento
                                </button>
                                <button class="btn btn-sm btn-outline-danger border-0 rounded-circle" title="Eliminar" onclick="eliminarMejoraDocente(${m.idMejora})">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                `;
            });
            html += '</div>';
            contenedor.innerHTML = html;
        };

        window.abrirModalCrearMejoraParaCurso = function() {
            const modalEl = document.getElementById('modalCrearAccionMejora');
            if (!modalEl) return;
            const form = document.getElementById('formCrearAccionMejora');
            if (form) form.reset();
            if (cursoMejorasDocenteSeleccionado) {
                poblarEstudiantesParaCursoMejoras(cursoMejorasDocenteSeleccionado);
            }
            const modal = new bootstrap.Modal(modalEl);
            modal.show();
        };

        window.guardarAccionMejora = function(event) {
            event.preventDefault();
            const selectEst = document.getElementById('modalMejoraSelectEstudiante');
            const selectMat = document.getElementById('modalMejoraSelectMateria');
            const selectPer = document.getElementById('modalMejoraPeriodo');
            const fechaLim = document.getElementById('modalMejoraFechaCompromiso');
            const aspecto = document.getElementById('modalMejoraAspecto');
            const compromiso = document.getElementById('modalMejoraCompromiso');

            if (!selectEst || !selectEst.value) {
                Swal.fire({ icon: 'warning', title: 'Campo requerido', text: 'Debe seleccionar un estudiante.' });
                return;
            }
            if (!selectMat || !selectMat.value) {
                Swal.fire({ icon: 'warning', title: 'Campo requerido', text: 'Debe seleccionar una asignatura.' });
                return;
            }

            const payload = {
                IdEstudiante: parseInt(selectEst.value),
                Materia: selectMat.value,
                Periodo: selectPer ? parseInt(selectPer.value) : 1,
                AspectoMejorar: aspecto ? aspecto.value.trim() : '',
                CompromisoEstudiante: compromiso ? compromiso.value.trim() : '',
                FechaCompromiso: fechaLim && fechaLim.value ? fechaLim.value : null
            };

            fetch('@Url.Action("GuardarAccionMejora", "Docente")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    Swal.fire({ icon: 'success', title: '¡Registrado!', text: data.message, timer: 2000, showConfirmButton: false });
                    const modalEl = document.getElementById('modalCrearAccionMejora');
                    const modal = bootstrap.Modal.getInstance(modalEl);
                    if (modal) modal.hide();
                    if (cursoMejorasDocenteSeleccionado) {
                        cargarMejorasDocenteCurso(cursoMejorasDocenteSeleccionado);
                    }
                } else {
                    Swal.fire({ icon: 'error', title: 'Error', text: data.message || 'No se pudo guardar la acción de mejora.' });
                }
            })
            .catch(err => {
                console.error(err);
                Swal.fire({ icon: 'error', title: 'Error de red', text: 'Ocurrió un error al intentar guardar.' });
            });
        };

        window.abrirModalSeguimientoMejora = function(idMejora, estadoActual, obsActual) {
            const inputId = document.getElementById('modalSeguimientoIdMejora');
            const selectEstado = document.getElementById('modalSeguimientoEstado');
            const txtObs = document.getElementById('modalSeguimientoObservacion');

            if (inputId) inputId.value = idMejora;
            if (selectEstado) selectEstado.value = estadoActual || 'Cumplido';
            if (txtObs) txtObs.value = obsActual || '';

            const modalEl = document.getElementById('modalSeguimientoMejoraDocente');
            if (modalEl) {
                const modal = new bootstrap.Modal(modalEl);
                modal.show();
            }
        };

        window.guardarSeguimientoMejoraDocente = function(event) {
            event.preventDefault();
            const inputId = document.getElementById('modalSeguimientoIdMejora');
            const selectEstado = document.getElementById('modalSeguimientoEstado');
            const txtObs = document.getElementById('modalSeguimientoObservacion');

            const payload = {
                IdMejora: parseInt(inputId.value),
                EstadoSeguimiento: selectEstado.value,
                ObservacionSeguimiento: txtObs ? txtObs.value.trim() : ''
            };

            fetch('@Url.Action("ActualizarSeguimientoMejora", "Docente")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    Swal.fire({ icon: 'success', title: '¡Actualizado!', text: data.message, timer: 2000, showConfirmButton: false });
                    const modalEl = document.getElementById('modalSeguimientoMejoraDocente');
                    const modal = bootstrap.Modal.getInstance(modalEl);
                    if (modal) modal.hide();
                    if (cursoMejorasDocenteSeleccionado) {
                        cargarMejorasDocenteCurso(cursoMejorasDocenteSeleccionado);
                    }
                } else {
                    Swal.fire({ icon: 'error', title: 'Error', text: data.message });
                }
            })
            .catch(err => {
                console.error(err);
                Swal.fire({ icon: 'error', title: 'Error de red', text: 'Ocurrió un error al actualizar el seguimiento.' });
            });
        };

        window.eliminarMejoraDocente = function(idMejora) {
            Swal.fire({
                title: '¿Eliminar Acción de Mejora?',
                text: 'Esta acción removerá el registro del historial del estudiante.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#e74c3c',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    fetch(`@Url.Action("EliminarAccionMejora", "Docente")?idMejora=${idMejora}`, {
                        method: 'POST'
                    })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            Swal.fire({ icon: 'success', title: 'Eliminado', text: data.message, timer: 2000, showConfirmButton: false });
                            if (cursoMejorasDocenteSeleccionado) {
                                cargarMejorasDocenteCurso(cursoMejorasDocenteSeleccionado);
                            }
                        } else {
                            Swal.fire({ icon: 'error', title: 'Error', text: data.message });
                        }
                    })
                    .catch(err => {
                        console.error(err);
                        Swal.fire({ icon: 'error', title: 'Error de red', text: 'No se pudo eliminar la acción de mejora.' });
                    });
                }
            });
        };

        window.actualizarBadgesCursosMejoras = function() {
            fetch('@Url.Action("ObtenerAccionesMejoraDocente", "Docente")')
                .then(res => res.json())
                .then(data => {
                    if (data.success && data.mejoras) {
                        const mapConteo = {};
                        data.mejoras.forEach(m => {
                            const c = (m.curso || '').trim().replace(/\s+/g, '_');
                            if (!mapConteo[c]) mapConteo[c] = { total: 0, proceso: 0 };
                            mapConteo[c].total++;
                            if (m.estadoSeguimiento === 'En Proceso') mapConteo[c].proceso++;
                        });

                        document.querySelectorAll('[id^="badge-mejoras-curso-"]').forEach(el => {
                            const slug = el.id.replace('badge-mejoras-curso-', '');
                            const info = mapConteo[slug] || { total: 0, proceso: 0 };
                            if (info.total === 0) {
                                el.innerHTML = `<span class="badge bg-light text-muted border rounded-pill px-3 py-1">Sin mejoras activas</span>`;
                            } else if (info.proceso > 0) {
                                el.innerHTML = `<span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-3 py-1 fw-bold"><i class="bi bi-clock-history me-1"></i>${info.proceso} en proceso</span>`;
                            } else {
                                el.innerHTML = `<span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1 fw-bold"><i class="bi bi-check-circle me-1"></i>${info.total} cumplidas</span>`;
                            }
                        });
                    }
                })
                .catch(err => console.error('Error al actualizar badges de mejoras:', err));
        };

        // ===============================================
        // MÓDULO: ACTIVIDADES Y TAREAS (FILTROS DE CURSOS Y ENTREGAS)
        // ===============================================

        window.filtrarGridCursosActividades = function() {
            const inputBuscar = document.getElementById('inputBuscarCursoActividades');
            const selectGrado = document.getElementById('selectGradoNivelCursosActividades');
            const selectJornada = document.getElementById('selectJornadaCursosActividades');

            const term = (inputBuscar ? inputBuscar.value : '').toLowerCase().trim();
            const grado = (selectGrado ? selectGrado.value : 'todos').trim();
            const jornada = (selectJornada ? selectJornada.value : 'todos').trim().toLowerCase();

            const esM = jornada.includes('mañana') || jornada.includes('manana') || jornada.startsWith('m');
            const esT = jornada.includes('tarde') || jornada.startsWith('t');

            const cards = document.querySelectorAll('#gridCursosDocente .card-curso-actividad-item');
            cards.forEach(card => {
                const c = (card.getAttribute('data-curso') || '').trim().toLowerCase();
                let visible = true;

                if (term !== '' && !c.includes(term)) visible = false;

                if (grado !== 'todos') {
                    const digits = c.replace(/\D/g, '');
                    if (!digits.startsWith(grado)) visible = false;
                }

                if (jornada !== 'todos') {
                    if (esM && !(c.endsWith('m') || c.includes(' m') || c.includes('m'))) visible = false;
                    if (esT && !(c.endsWith('t') || c.includes(' t') || c.includes('t'))) visible = false;
                }

                card.style.display = visible ? '' : 'none';
            });
        };

        window.filtrarEntregasEstudiante = function() {
            const term = (document.getElementById('inputBuscarEstudianteEntregas')?.value || '').toLowerCase().trim();
            const rows = document.querySelectorAll('#tablaCuerpoEntregas tr.fila-entrega-item');
            let visibles = 0;
            rows.forEach(r => {
                const nom = r.getAttribute('data-nombre') || '';
                const cor = r.getAttribute('data-correo') || '';
                const doc = r.getAttribute('data-doc') || '';
                const match = term === '' || nom.includes(term) || cor.includes(term) || doc.includes(term);
                r.style.display = match ? '' : 'none';
                if (match) visibles++;
            });
            const badge = document.getElementById('conteoEntregasBadge');
            if (badge) badge.textContent = `${visibles} entregas mostradas`;
        };

        // Inicializar paginación de asistencia y mejoras al cargar la página
        setTimeout(function() {
            renderizarPaginacionAsistencia();
            actualizarBadgesCursosMejoras();
        }, 300);
    });
</script>

