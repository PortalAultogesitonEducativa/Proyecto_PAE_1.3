    // Función: Subida individual de documentos extracurriculares por el estudiante (Máx 5 MB)
    function subirDocumentoEstudianteExtra(idInscripcion, tipoDoc, inputEl) {
        if (!inputEl.files || !inputEl.files[0]) return;
        const archivo = inputEl.files[0];
        const maxBytes = 5 * 1024 * 1024; // 5 MB
        if (archivo.size > maxBytes) {
            alert('El documento seleccionado (' + (archivo.size / (1024 * 1024)).toFixed(2) + ' MB) supera el tamaño máximo permitido de 5 MB.');
            inputEl.value = '';
            return;
        }

        const formData = new FormData();
        formData.append('idInscripcion', idInscripcion);
        formData.append('tipoDocumento', tipoDoc);
        formData.append('archivo', archivo);

        fetch('@Url.Action("SubirDocumentoExtraCurso", "Estudiante")', {
            method: 'POST',
            body: formData
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        icon: 'success',
                        title: '¡Documento Cargado!',
                        text: data.message,
                        timer: 2000,
                        showConfirmButton: false
                    }).then(() => window.location.reload());
                } else {
                    alert(data.message);
                    window.location.reload();
                }
            } else {
                alert('Error: ' + data.message);
            }
        })
        .catch(err => {
            console.error(err);
            alert('Ocurrió un error al subir el documento.');
        });
    }

