                                @if (ViewBag.DetalleNotas != null)
                                {
                                    foreach (var nota in (List<ProyectoPAE.Models.Evaluacion>)ViewBag.DetalleNotas)
                                    {
                                        <tr>
                                            <td>@(nota.id_materia == 1 ? "Matemáticas" : nota.id_materia == 2 ? "Español" : "Otras")</td>
                                            <td>@nota.tipo_evaluacion</td>
                                            <td>@nota.fecha_evaluacion.ToShortDateString()</td>
                                            <td class="text-center fw-bold @(nota.nota < 3 ? "text-danger" : "text-success")">@nota.nota</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr><td colspan="4" class="text-center text-muted">No hay notas registradas.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modalAsistencia" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title"><i class="bi bi-calendar-check me-2"></i>Detalle de Asistencia</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-center">
                    <h3 class="display-4 text-danger">@ViewBag.FallasRapidas</h3>
                    <p class="text-muted">Fallas totales en el periodo actual</p>
                    <hr>
                    <p class="small text-start text-muted italic">Próximamente: Listado detallado de fechas e inasistencias.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modalCitaciones" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title"><i class="bi bi-envelope-paper me-2"></i>Buzón de Citaciones</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="listaCitaciones">
                        @if (ViewBag.ListaCitaciones != null && ((List<ProyectoPAE.Models.Citacion>)ViewBag.ListaCitaciones).Any())
                        {
                            foreach (var cita in (List<ProyectoPAE.Models.Citacion>)ViewBag.ListaCitaciones)
                            {
                                <div class="alert alert-light border shadow-sm mb-3">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <h6 class="fw-bold text-success mb-1">@cita.asunto</h6>
                                        <span class="badge bg-secondary">@cita.fecha.ToShortDateString()</span>
                                    </div>
                                    <p class="mb-2 text-dark" style="font-size: 0.9rem;">@cita.mensaje</p>
                                    <div class="border-top pt-2 mt-1">
                                        <small class="text-muted"><strong>Remitente:</strong> @cita.remitente</small>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center py-4">
                                <i class="bi bi-chat-left-x fs-1 text-muted"></i>
                                <p class="text-muted mt-2">No tienes citaciones o mensajes pendientes.</p>
                            </div>
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    /**
     * Oculta todas las subsecciones y paneles principales de la interfaz SPA.
     * Utiliza la clase 'd-none' de Bootstrap.
     */
    function ocultarTodo() {
        const subs = [
            'admin-main', 'admin-matricula', 'admin-usuarios', 'admin-certificados', 'admin-notificaciones', 'admin-asignacion', 'admin-reportes',
            'docente-main', 'docente-planilla', 'docente-asistencia', 'docente-observaciones', 'docente-mejoras',
            'estudiante-main', 'estudiante-horario', 'estudiante-calificaciones', 'estudiante-actividades', 'estudiante-cursosextra', 'estudiante-mejoras'
        ];

        const panelesPrincipales = [
            'panel-admin', 'panel-docente', 'panel-estudiante', 'panel-acudiente'
        ];

        // Ocultar subsecciones
        subs.forEach(id => {
            const el = document.getElementById(id);
            if (el) el.classList.add('d-none');
        });

        // Ocultar paneles principales
        panelesPrincipales.forEach(id => {
            const p = document.getElementById(id);
            if (p) p.classList.add('d-none');
        });
    }

    // --- FUNCIONES DE NAVEGACIÓN ADMINISTRADOR ---
    function verMatricula() { ocultarTodo(); mostrarAdminSub('admin-matricula'); }
    function verUsuarios() { ocultarTodo(); mostrarAdminSub('admin-usuarios'); }
    function verCertificados() { ocultarTodo(); mostrarAdminSub('admin-certificados'); }
    function verNotificaciones() { ocultarTodo(); mostrarAdminSub('admin-notificaciones'); }
    function verAsignacion() { ocultarTodo(); mostrarAdminSub('admin-asignacion'); }
    function verReportes() { ocultarTodo(); mostrarAdminSub('admin-reportes'); }

    function mostrarAdminSub(id) {
        ocultarTodo();
        const panelAdmin = document.getElementById('panel-admin');
        if (panelAdmin) panelAdmin.classList.remove('d-none');

        const subSeccion = document.getElementById(id);
        if (subSeccion) subSeccion.classList.remove('d-none');
    }

    function volverAdmin() {
        ocultarTodo();
        const panelAdmin = document.getElementById('panel-admin');
        const adminMain = document.getElementById('admin-main');
        if (panelAdmin) panelAdmin.classList.remove('d-none');
        if (adminMain) adminMain.classList.remove('d-none');
    }

    // --- EVENTO DE INICIALIZACIÓN (SE EJECUTA AL CARGAR / RECARGAR LA PÁGINA) ---
    document.addEventListener("DOMContentLoaded", function() {
        const inputRol = document.getElementById('rolOculto');

        // Toma el valor enviado desde HomeController (ViewBag.Rol)
        const rolDesdeSesion = inputRol ? inputRol.value.toLowerCase().trim() : '';
        const selector = document.getElementById('roleSelector');

        if (selector && rolDesdeSesion) {
            // 1. Asigna el rol recibido al selector (ej. 'docente' si volviste desde Planilla)
            selector.value = rolDesdeSesion;

            // 2. Muestra automáticamente el panel correcto
            switchRole();

            // 3. Si el rol del login NO es administrador, oculta el desplegable de roles
            if (rolDesdeSesion !== 'admin' && rolDesdeSesion !== 'administrador') {
                selector.style.display = 'none';
                const etiquetaRol = document.querySelector('.opacity-75');
                if (etiquetaRol) etiquetaRol.style.display = 'none';
            } else {
                selector.style.display = 'block';
            }
        }
    });

    /**
     * Alterna la vista activa según el rol seleccionado en la barra superior.
     */
    function switchRole() {
        const selector = document.getElementById('roleSelector');
        if (!selector) return;

        let role = selector.value.toLowerCase().trim();
        console.log("Cambiando al rol: " + role);

        ocultarTodo();

        // Normalización para el rol Administrador
        if (role === 'administrador') {
            role = 'admin';
        }

        const panel = document.getElementById('panel-' + role);

        if (panel) {
            panel.classList.remove('d-none');

            // Enciende la tarjeta / menú principal de cada perfil
            if (role === 'admin') {
                const sub = document.getElementById('admin-main');
                if (sub) sub.classList.remove('d-none');
            }
            else if (role === 'docente') {
                const sub = document.getElementById('docente-main');
                if (sub) sub.classList.remove('d-none'); // Muestra las tarjetas del Docente
            }
            else if (role === 'estudiante') {
                const sub = document.getElementById('estudiante-main');
                if (sub) sub.classList.remove('d-none');
            }
        } else {
            console.error("No se encontró un panel con el ID: panel-" + role);
        }
    }

    // --- FUNCIONES DE NAVEGACIÓN DOCENTE ---
    // 1. Función para mostrar la planilla y ocultar el panel principal del docente
    // Función para mostrar la planilla dentro de la misma vista (SPA)
    function verPlanilla() {
        ocultarTodo(); // Limpia y oculta los demás paneles activos

        const panelDocente = document.getElementById('panel-docente');
        const docentePlanilla = document.getElementById('docente-planilla');

        // Mostramos el panel general del docente y el sub-panel de la planilla
        if (panelDocente) {
            panelDocente.classList.remove('d-none');
        }
        if (docentePlanilla) {
            docentePlanilla.classList.remove('d-none');
        }
    }

    // Función para regresar desde la planilla de calificaciones al menú principal del docente
    function volverDocente() {
        ocultarTodo(); // Oculta todos los paneles secundarios activos

        // Mostramos el contenedor general del panel docente
        const panelDocente = document.getElementById('panel-docente');
        if (panelDocente) {
            panelDocente.classList.remove('d-none');
        }

        // Mostramos explícitamente el contenedor de las tarjetas principales
        const docenteMain = document.getElementById('docente-main');
        if (docenteMain) {
            docenteMain.classList.remove('d-none');
        }
    }

    function verAsistencia() {
        ocultarTodo();
        const panelDocente = document.getElementById('panel-docente');
        const docenteAsistencia = document.getElementById('docente-asistencia');
        if (panelDocente) panelDocente.classList.remove('d-none');
        if (docenteAsistencia) docenteAsistencia.classList.remove('d-none');
    }

    function verModuloMejorasDocente() {
        ocultarTodo();
        const panelDocente = document.getElementById('panel-docente');
        const docenteMejoras = document.getElementById('docente-mejoras');
        if (panelDocente) panelDocente.classList.remove('d-none');
        if (docenteMejoras) docenteMejoras.classList.remove('d-none');
    }

    function volverDocenteMejoras() {
        volverDocente();
    }

    function verObservaciones() {
        ocultarTodo();
        const panelDocente = document.getElementById('panel-docente');
        const subVista = document.getElementById('docente-observaciones');
        if (panelDocente) panelDocente.classList.remove('d-none');
        if (subVista) subVista.classList.remove('d-none');
    }

    // --- FUNCIONES DE NAVEGACIÓN ESTUDIANTE ---
    function verHorario() {
        ocultarTodo();
        const panelEstudiante = document.getElementById('panel-estudiante');
        const sub = document.getElementById('estudiante-horario');
        if (panelEstudiante) panelEstudiante.classList.remove('d-none');
        if (sub) sub.classList.remove('d-none');
    }

    function verCalificacionesEstudiante() {
        ocultarTodo();
        const panelEstudiante = document.getElementById('panel-estudiante');
        const sub = document.getElementById('estudiante-calificaciones');
        if (panelEstudiante) panelEstudiante.classList.remove('d-none');
        if (sub) sub.classList.remove('d-none');
    }

    function verActividadesEstudiante() {
        ocultarTodo();
        const panelEstudiante = document.getElementById('panel-estudiante');
        const sub = document.getElementById('estudiante-actividades');
        if (panelEstudiante) panelEstudiante.classList.remove('d-none');
        if (sub) sub.classList.remove('d-none');
    }

    function volverEstudiante() {
        ocultarTodo();
        const panelEstudiante = document.getElementById('panel-estudiante');
        const estudianteMain = document.getElementById('estudiante-main');
        if (panelEstudiante) panelEstudiante.classList.remove('d-none');
        if (estudianteMain) estudianteMain.classList.remove('d-none');
    }

    function verCursosExtra() {
        ocultarTodo();
        const panelEstudiante = document.getElementById('panel-estudiante');
        const sub = document.getElementById('estudiante-cursosextra');
        if (panelEstudiante) panelEstudiante.classList.remove('d-none');
        if (sub) sub.classList.remove('d-none');
    }

    function verModuloMejoras() {
        ocultarTodo();
        const panelEstudiante = document.getElementById('panel-estudiante');
        const sub = document.getElementById('estudiante-mejoras');
        if (panelEstudiante) panelEstudiante.classList.remove('d-none');
        if (sub) sub.classList.remove('d-none');
    }

    function volverEstudianteMejoras() {
        volverEstudiante();
    }

    // --- GESTIÓN DE MODALES (ACCIONES DE MEJORA) ---
    function abrirCuadroTexto(idAccion, rol, tituloAccion) {
        document.getElementById('input_id_accion').value = idAccion;
        document.getElementById('input_remitente').value = rol;
        document.getElementById('txtComentario').value = "";

        const header = document.getElementById('modalMejoraHeader');
        const titulo = document.getElementById('modalMejoraTitulo');
        const desc = document.getElementById('modalMejoraDescripcion');
        const boton = document.getElementById('btnModalGuardar');

        if (rol === 'Estudiante') {
            if (header) header.style.backgroundColor = '#6f42c1';
            if (titulo) titulo.innerText = 'Registrar Avance: ' + tituloAccion;
            if (desc) desc.innerText = 'Describe el progreso o las correcciones que has realizado.';
            if (boton) boton.style.backgroundColor = '#6f42c1';
        } else {
            if (header) header.style.backgroundColor = '#2980b9';
            if (titulo) titulo.innerText = 'Escribir Observación: ' + tituloAccion;
            if (desc) desc.innerText = 'Redacta los pendientes o comentarios para el estudiante.';
            if (boton) boton.style.backgroundColor = '#2980b9';
        }

        const miModal = new bootstrap.Modal(document.getElementById('modalFormularioMejora'));
        miModal.show();
    }
</script>

<style>
    /* Clase para unificar el panel administrativo */
    .card-admin {
        border-left: 5px solid #fd7e14 !important; /* Línea naranja más marcada */
        transition: all 0.3s ease;
        cursor: pointer;
    }

        .card-admin:hover {
            background-color: #fffaf5; /* Un fondo naranja muy tenue al pasar el mouse */
            transform: scale(1.02);
            box-shadow: 0 10px 20px rgba(253, 126, 20, 0.1) !important;
        }
</style>

<style>
    /* 1. Quitamos el fondo azul de toda la tarjeta */
    .card-hover:hover {
        background-color: #ffffff !important; /* Se mantiene blanca */
        transform: translateY(-5px); /* Solo flota un poquito */
        box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
        transition: all 0.3s ease;
    }

        /* 2. El botón es el que se ilumina con fuerza */
        .card-hover:hover .btn-outline-primary {
            background-color: #2980b9 !important;
            color: white !important;
            box-shadow: 0 4px 8px rgba(41, 128, 185, 0.3);
        }

    /* 3. Aseguramos que los textos no cambien de color bruscamente */
    .card-hover h6, .card-hover p, .card-hover i {
        transition: color 0.3s ease;
    }
</style>

<style>
    /* Estilo del botón: Sólido, Morado y Rectangular */
    .btn-estudiante-solido {
        background-color: #6f42c1 !important;
        color: white !important;
        border: none !important;
        border-radius: 4px !important; /* Mantiene la forma del botón negro */
        padding: 8px 16px;
        font-weight: 500;
        transition: all 0.3s ease;
    }

        /* Efecto al pasar el mouse sobre el botón */
        .btn-estudiante-solido:hover {
            background-color: #5a32a3 !important; /* Un morado un poco más oscuro */
            color: white !important;
            box-shadow: 0 4px 8px rgba(111, 66, 193, 0.3);
        }

    /* Mantenemos la tarjeta limpia y blanca */
    .card-estudiante-limpia {
        transition: all 0.3s ease;
        background-color: white !important;
    }

        .card-estudiante-limpia:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
        }
</style>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const selectHijo = document.getElementById("selectHijo");
        const btnVerNotas = document.getElementById("btnVerNotas");

        function actualizarEnlace() {
            const idHijo = selectHijo.value;
            // Construimos la ruta hacia Estudiante/MisNotas pasando el idEstudiante
            btnVerNotas.href = `/Estudiante/MisNotas?idEstudiante=${idHijo}`;
        }

        // Actualizar el enlace apenas cargue la página
        actualizarEnlace();

        // Actualizar el enlace cada vez que el padre cambie de hijo en el select
        selectHijo.addEventListener("change", actualizarEnlace);
    });
</script>