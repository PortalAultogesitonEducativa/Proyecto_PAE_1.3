        <!-- SUBPANEL: GESTIÓN DE ACTIVIDADES Y TAREAS ACADÉMICAS (DOCENTE) -->
        <!--  -->
        <div id="docente-actividades" class="d-none">
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
                <div>
                    <h3 class="fw-bold mb-0" style="color: #2980b9;">
                        <i class="bi bi-journal-check me-2"></i>Gestión de Actividades y Tareas
                    </h3>
                    <p class="text-muted small mb-0">Publica talleres, consulta entregas en tiempo real, califica a los estudiantes y sincroniza sus notas con la planilla oficial.</p>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn text-white btn-sm shadow-sm px-3" style="background-color: #2980b9; border-radius: 8px;" data-bs-toggle="modal" data-bs-target="#modalCrearActividad">
                        <i class="bi bi-plus-circle me-1"></i> Nueva Actividad
                    </button>
                    <button class="btn btn-outline-secondary btn-sm" onclick="volverDocenteActividades()" style="border-radius: 8px;">
                        <i class="bi bi-arrow-left me-1"></i> Volver
                    </button>
                </div>
            </div>

            <!-- Listado de Actividades del Docente -->
            <div id="contenedorActividadesDocente" class="row g-3">
                <div class="col-12 text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="text-muted small mt-2">Cargando actividades académicas...</p>
                </div>
            </div>
        </div>

        <!-- MODAL: CREAR NUEVA ACTIVIDAD ACADÉMICA (DOCENTE) -->
        <div class="modal fade" id="modalCrearActividad" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
                    <div class="modal-header text-white" style="background: linear-gradient(135deg, #0d2a4a 0%, #2980b9 100%); border-radius: 16px 16px 0 0;">
                        <h5 class="modal-title fw-bold"><i class="bi bi-journal-plus me-2"></i>Crear Nueva Actividad / Tarea</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <form id="formCrearActividad" onsubmit="guardarNuevaActividad(event)">
                        <div class="modal-body p-4">
                            <div class="row g-3">
                                <div class="col-md-12">
                                    <label class="form-label fw-bold small">Título de la Actividad / Tarea <span class="text-danger">*</span></label>
                                    <input type="text" name="Titulo" class="form-control" placeholder="Ej: Taller 1 - Ecuaciones Cuadráticas, Ensayo Histórico..." required />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold small">Asignatura / Materia <span class="text-danger">*</span></label>
                                    <input type="text" name="Materia" list="listaMateriasSugeridas" class="form-control" placeholder="Selecciona o escribe la materia" required />
                                    <datalist id="listaMateriasSugeridas">
                                        @if (ViewBag.Asignaturas != null)
                                        {
                                            foreach (var asig in (IEnumerable<string>)ViewBag.Asignaturas)
                                            {
                                                <option value="@asig">@asig</option>
                                            }
                                        }
                                        <option value="Matemáticas">Matemáticas</option>
                                        <option value="Español y Literatura">Español y Literatura</option>
                                        <option value="Ciencias Naturales">Ciencias Naturales</option>
                                        <option value="Ciencias Sociales">Ciencias Sociales</option>
                                        <option value="Inglés">Inglés</option>
                                        <option value="Informática y Tecnología">Informática y Tecnología</option>
                                        <option value="Educación Física">Educación Física</option>
                                        <option value="Educación Artística">Educación Artística</option>
                                        <option value="Ética y Valores">Ética y Valores</option>
                                        <option value="Filosofía">Filosofía</option>
                                    </datalist>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold small">Grado / Grupo Destino</label>
                                    <select name="Grado" class="form-select">
                                        <option value="Todos">Todos los Grados</option>
                                        <option value="601">601</option>
                                        <option value="602">602</option>
                                        <option value="701">701</option>
                                        <option value="702">702</option>
                                        <option value="801">801</option>
                                        <option value="802">802</option>
                                        <option value="901">901</option>
                                        <option value="902">902</option>
                                        <option value="1001">1001</option>
                                        <option value="1002">1002</option>
                                        <option value="1101">1101</option>
                                        <option value="1102">1102</option>
                                    </select>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold small">Fecha y Hora Límite de Entrega <span class="text-danger">*</span></label>
                                    <input type="datetime-local" name="FechaLimite" class="form-control" value="@DateTime.Now.AddDays(7).ToString("yyyy-MM-ddTHH:mm")" required />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold small">Archivo Adjunto / Guía Docente (Opcional)</label>
                                    <input type="file" name="archivo" class="form-control" accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.zip,.rar,.png,.jpg,.jpeg" />
                                    <small class="text-muted" style="font-size: 0.75rem;">PDF, Word, Excel, PowerPoint, ZIP (Máx 25 MB)</small>
                                </div>

                                <div class="col-12">
                                    <label class="form-label fw-bold small">Descripción, Instrucciones y Criterios de Evaluación</label>
                                    <textarea name="Descripcion" class="form-control" rows="4" placeholder="Indica detalladamente los puntos a desarrollar, formato de entrega y rúbrica de calificación..."></textarea>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer bg-light" style="border-radius: 0 0 16px 16px;">
                            <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancelar</button>
                            <button type="submit" class="btn text-white rounded-pill px-4 shadow-sm" style="background-color: #2980b9;">
                                <i class="bi bi-cloud-arrow-up me-1"></i> Publicar Actividad
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- MODAL: REVISAR ENTREGAS Y CALIFICAR (DOCENTE) -->
        <div class="modal fade" id="modalRevisarEntregas" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
                    <div class="modal-header text-white" style="background: linear-gradient(135deg, #0d2a4a 0%, #2980b9 100%); border-radius: 16px 16px 0 0;">
                        <div>
                            <h5 class="modal-title fw-bold" id="tituloModalRevisarEntregas"><i class="bi bi-file-earmark-check me-2"></i>Entregas de Estudiantes</h5>
                            <small class="opacity-75" id="subtituloModalRevisarEntregas">Revisión, calificación y sincronización con planilla de notas</small>
                        </div>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-4">
                        <div class="alert alert-info border-0 rounded-3 d-flex align-items-center mb-4 py-2 px-3 small">
                            <i class="bi bi-info-circle-fill fs-5 me-2 text-primary"></i>
                            <span>Las calificaciones asignadas aquí (0.0 a 5.0) se <strong>guardan y sincronizan automáticamente en la Planilla Oficial de Notas</strong> del estudiante en la materia correspondiente.</span>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr class="small text-uppercase text-muted">
                                        <th>Estudiante</th>
                                        <th>Fecha Entrega</th>
                                        <th>Archivo / Comentario</th>
                                        <th style="width: 130px;">Periodo</th>
                                        <th style="width: 140px;">Calificación (0-5)</th>
                                        <th style="width: 220px;">Retroalimentación</th>
                                        <th class="text-end" style="width: 120px;">Acción</th>
                                    </tr>
                                </thead>
                                <tbody id="tablaCuerpoEntregas">
                                    <tr>
                                        <td colspan="7" class="text-center py-4 text-muted">Cargando entregas...</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="modal-footer bg-light" style="border-radius: 0 0 16px 16px;">
                        <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Cerrar</button>
                    </div>
                </div>
            </div>
        </div>

    </div> <!-- Cierre definitivo del panel-docente general -->

    <div id="panel-acudiente" class="role-panel d-none">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 style="color: #27ae60;"><i class="bi bi-person-heart me-2"></i>Panel de Padres</h2>

            <div class="d-flex align-items-center bg-success text-white px-3 py-1 rounded-pill shadow-sm">
                <span class="small me-2 fw-bold">Hijo(a):</span>
