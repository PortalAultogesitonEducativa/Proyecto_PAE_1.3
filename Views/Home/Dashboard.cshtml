        let cursoMejorasDocenteSeleccionado = null;
        let listaMejorasDocenteCursoGlobal = [];

        function escapeMejoraTexto(str) {
            if (!str) return '';
            return String(str).replace(/'/g, "\\'").replace(/"/g, '&quot;');
        }

        window.filtrarGridCursosMejoras = function() {
            const inputBuscar = document.getElementById('inputBuscarCursoMejoras');
            const selectGrado = document.getElementById('selectGradoNivelCursosMejoras');
            const selectJornada = document.getElementById('selectJornadaCursosMejoras');

            const term = (inputBuscar ? inputBuscar.value : '').toLowerCase().trim();
            const grado = (selectGrado ? selectGrado.value : 'todos').trim();
            const jornada = (selectJornada ? selectJornada.value : 'todos').trim().toLowerCase();

            const esM = jornada.includes('mañana') || jornada.includes('manana') || jornada.startsWith('m');
            const esT = jornada.includes('tarde') || jornada.startsWith('t');

            const cards = document.querySelectorAll('#gridCursosMejorasDocente .card-curso-mejora-item');
            cards.forEach(card => {
                const c = (card.getAttribute('data-curso') || '').trim().toLowerCase();
                let visible = true;

                if (term !== '' && !c.includes(term)) visible = false;

                if (grado !== 'todos') {
                    const digits = c.replace(/\D/g, '');
                    if (!digits.startsWith(grado)) visible = false;
                }

                if (jornada !== 'todos') {
                    if (esM && !(c.endsWith('m') || c.includes(' m') || c.includes('m'))) visible = false;
                    if (esT && !(c.endsWith('t') || c.includes(' t') || c.includes('t'))) visible = false;
                }

                card.style.display = visible ? '' : 'none';
            });
        };

