                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm p-4 h-100" style="border-left: 4px solid #0d2a4a99 !important;">
                        <p class="text-muted text-uppercase small mb-2">Cupos Disponibles</p>
                        <div class="d-flex justify-content-between align-items-end">
                            <span class="fs-3 fw-bold" style="color: #0d2a4a;">156</span>
                            <span class="text-muted small">Ciclo 2024</span>
                        </div>
                    </div>
                </div>
            </div>
 
            <!-- Tabla -->
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white d-flex flex-wrap align-items-center justify-content-between gap-3 p-3">
                    <div class="d-flex gap-3">
                        <div>
                            <label class="form-label small mb-1">Filtrar por Grado</label>
                            <select class="form-select form-select-sm">
                                <option>Todos los Grados</option>
                                <option>1° Grado de Secundaria</option>
                                <option>2° Grado de Secundaria</option>
                                <option>3° Grado de Secundaria</option>
                                <option>Pre-grado Universitario</option>
                            </select>
                        </div>
                        <div>
                            <label class="form-label small mb-1">Estado de Pago</label>
                            <select class="form-select form-select-sm">
                                <option>Cualquier Estado</option>
                                <option>Completado</option>
                                <option>Pendiente</option>
                                <option>En Revisión</option>
                            </select>
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-outline-secondary btn-sm"><i class="bi bi-funnel me-1"></i>Más Filtros</button>
                        <button class="btn btn-outline-secondary btn-sm"><i class="bi bi-download me-1"></i>Exportar</button>
                    </div>
                </div>
 
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr class="small text-uppercase text-muted">
                                <th class="px-3 py-3">Estudiante</th>
                                <th class="px-3 py-3">Grado / Curso</th>
                                <th class="px-3 py-3">Fecha Registro</th>
                                <th class="px-3 py-3">Estado de Pago</th>
                                <th class="px-3 py-3 text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="px-3 py-3">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width:40px;height:40px;background:#0d2a4a1a;color:#0d2a4a;">AL</div>
                                        <div>
                                            <p class="fw-bold mb-0">Alejandro Lopez</p>
                                            <p class="text-muted small mb-0">ID: 2024-0012</p>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-3 py-3">5° Grado B - Secundaria</td>
                                <td class="px-3 py-3">12 Oct, 2023</td>
                                <td class="px-3 py-3">
                                    <span class="badge rounded-pill" style="background:#0d2a4a1a;color:#0d2a4a;">PAGADO</span>
                                </td>
                                <td class="px-3 py-3 text-end">
                                    <button class="btn btn-sm btn-light"><i class="bi bi-three-dots-vertical"></i></button>
                                </td>
                            </tr>
                            <tr>
                                <td class="px-3 py-3">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width:40px;height:40px;background:#ffebd1;color:#e67e22;">MR</div>
                                        <div>
                                            <p class="fw-bold mb-0">Mariana Rodriguez</p>
                                            <p class="text-muted small mb-0">ID: 2024-0045</p>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-3 py-3">4° Grado A - Secundaria</td>
                                <td class="px-3 py-3">15 Oct, 2023</td>
                                <td class="px-3 py-3">
                                    <span class="badge rounded-pill" style="background:#ffebd1;color:#e67e22;">PENDIENTE</span>
                                </td>
                                <td class="px-3 py-3 text-end">
                                    <button class="btn btn-sm btn-light"><i class="bi bi-three-dots-vertical"></i></button>
                                </td>
                            </tr>
                            <tr>
                                <td class="px-3 py-3">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width:40px;height:40px;background:#0d2a4a1a;color:#0d2a4a;">CS</div>
                                        <div>
                                            <p class="fw-bold mb-0">Carlos Salazar</p>
                                            <p class="text-muted small mb-0">ID: 2024-0102</p>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-3 py-3">1° Grado C - Primaria</td>
                                <td class="px-3 py-3">18 Oct, 2023</td>
                                <td class="px-3 py-3">
                                    <span class="badge rounded-pill" style="background:#0d2a4a1a;color:#0d2a4a;">PAGADO</span>
                                </td>
                                <td class="px-3 py-3 text-end">
                                    <button class="btn btn-sm btn-light"><i class="bi bi-three-dots-vertical"></i></button>
                                </td>
                            </tr>
                            <tr>
                                <td class="px-3 py-3">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width:40px;height:40px;background:#ba1a1a1a;color:#ba1a1a;">BV</div>
                                        <div>
                                            <p class="fw-bold mb-0">Beatriz Vargas</p>
                                            <p class="text-muted small mb-0">ID: 2024-0158</p>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-3 py-3">Pre-grado Sistemas</td>
                                <td class="px-3 py-3">20 Oct, 2023</td>
                                <td class="px-3 py-3">
                                    <span class="badge rounded-pill" style="background:#ba1a1a1a;color:#ba1a1a;">VENCIDO</span>
                                </td>
                                <td class="px-3 py-3 text-end">
                                    <button class="btn btn-sm btn-light"><i class="bi bi-three-dots-vertical"></i></button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
 
                <div class="card-footer bg-white d-flex align-items-center justify-content-between">
                    <p class="text-muted small mb-0">Mostrando 1-4 de 1,284 estudiantes</p>
                    <div class="d-flex gap-1">
                        <button class="btn btn-sm btn-outline-secondary" disabled><i class="bi bi-chevron-left"></i></button>
                        <button class="btn btn-sm btn-outline-secondary active">1</button>
                        <button class="btn btn-sm btn-outline-secondary">2</button>
                        <button class="btn btn-sm btn-outline-secondary">3</button>
                        <button class="btn btn-sm btn-outline-secondary"><i class="bi bi-chevron-right"></i></button>
                    </div>
                </div>
            </div>
        </div>

        <div id="admin-usuarios" class="d-none">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h3 style="color: #e67e22;"><i class="bi bi-people-fill me-2"></i>Gestión de Usuarios</h3>
                <button class="btn btn-outline-secondary btn-sm" onclick="volverAdmin()">Volver</button>
            </div>
            <table class="table table-hover bg-white shadow-sm rounded">
                <thead class="table-light"><tr><th>Usuario</th><th>Rol</th><th>Acciones</th></tr></thead>
                <tbody><tr><td>admin_pae</td><td><span class="badge bg-warning">Admin</span></td><td><button class="btn btn-sm btn-light border">Editar</button></td></tr></tbody>
            </table>
        </div>

        <div id="admin-certificados" class="d-none">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h3 style="color: #e67e22;"><i class="bi bi-file-earmark-pdf-fill me-2"></i>Certificados</h3>
                <button class="btn btn-outline-secondary btn-sm" onclick="volverAdmin()">Volver</button>
            </div>
            <div class="card border-0 shadow-sm p-4">
                <input type="text" class="form-control mb-3" placeholder="Buscar por documento...">
                <div class="list-group">
                    <button class="list-group-item list-group-item-action d-flex justify-content-between">Certificado de Matrícula <i class="bi bi-download text-danger"></i></button>
                </div>
            </div>
        </div>

        <div id="admin-notificaciones" class="d-none">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h3 style="color: #e67e22;"><i class="bi bi-megaphone-fill me-2"></i>Notificaciones</h3>
                <button class="btn btn-outline-secondary btn-sm" onclick="volverAdmin()">Volver</button>
            </div>
            <div class="card border-0 shadow-sm p-4">
                <textarea class="form-control mb-3" rows="3" placeholder="Escriba el comunicado general..."></textarea>
                <button class="btn btn-warning text-white">Enviar a toda la institución</button>
            </div>
        </div>

        <div id="admin-asignacion" class="d-none">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h3 style="color: #e67e22;"><i class="bi bi-diagram-3-fill me-2"></i>Asignación Académica</h3>
                <button class="btn btn-outline-secondary btn-sm" onclick="volverAdmin()">Volver</button>
            </div>
            <div class="alert alert-info">Seleccione un docente para asignar sus materias y grupos correspondientes.</div>
        </div>

        <div id="admin-reportes" class="d-none">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h3 style="color: #e67e22;"><i class="bi bi-graph-up-arrow me-2"></i>Reportes Pro</h3>
                <button class="btn btn-outline-secondary btn-sm" onclick="volverAdmin()">Volver</button>
            </div>
            <div class="row g-3">
                <div class="col-md-6"><div class="card p-4 border-0 shadow-sm text-center"><h1 class="text-warning">92%</h1><p>Asistencia General</p></div></div>
                <div class="col-md-6"><div class="card p-4 border-0 shadow-sm text-center"><h1 class="text-warning">4.1</h1><p>Promedio Institucional</p></div></div>
            </div>
        </div>
    </div>

    <div id="panel-docente" class="role-panel d-none">

        <!-- ========================================== -->
        <!-- 1. MENÚ PRINCIPAL DE TARJETA (DOCENTE MAIN) -->
        <!-- ========================================== -->
        <div id="docente-main">
            <h2 class="mb-4" style="color: #2980b9;"><i class="bi bi-person-badge-fill me-2"></i>Panel del Docente</h2>

            <div class="row">
                <!-- Tarjeta: Planilla de Notas (Actualizado para usar la vista interna) -->
                <div class="col-md-4 mb-4" onclick="verPlanilla()" style="cursor: pointer;">
                    <div class="card p-4 text-center border-0 shadow-sm h-100 card-hover" style="border-top: 4px solid #2980b9 !important;">
                        <i class="bi bi-clipboard-check fs-2 mb-2" style="color: #2980b9;"></i>
                        <h5 class="text-dark">Planilla de Notas</h5>
                        <p class="small text-muted">Gestión de calificaciones y promedios.</p>
                        <button class="btn btn-sm btn-outline-primary mt-auto w-100" type="button">Ver Planilla</button>
                    </div>
                </div>

                <!-- Tarjeta: Asistencia -->
                <div class="col-md-4 mb-4" onclick="verAsistencia()" style="cursor: pointer;">
                    <div class="card p-4 text-center border-0 shadow-sm h-100 card-hover" style="border-top: 4px solid #2980b9 !important;">
                        <i class="bi bi-calendar-check fs-2 mb-2" style="color: #2980b9;"></i>
                        <h5>Asistencia</h5>
                        <p class="small text-muted">Toma de lista diaria.</p>
                        <button class="btn btn-sm btn-outline-primary mt-auto w-100">Ver asistencias</button>
                    </div>
                </div>

                <!-- Tarjeta: Observador -->
                <div class="col-md-4 mb-4" onclick="verObservaciones()" style="cursor: pointer;">
                    <div class="card p-4 text-center border-0 shadow-sm h-100 card-hover" style="border-top: 4px solid #2980b9 !important;">
                        <i class="bi bi-chat-dots fs-2 mb-2" style="color: #2980b9;"></i>
                        <h5>Observador</h5>
                        <p class="small text-muted">Seguimiento convivencial.</p>
                        <button class="btn btn-sm btn-outline-primary mt-auto w-100">Ver observaciones</button>
                    </div>
                </div>

                <!-- Tarjeta: Reportes Generales -->
                <div class="col-md-4 mb-4" onclick="location.href='@Url.Action("ReporteGrupal", "Docente")'" style="cursor: pointer;">
                    <div class="card p-4 text-center border-0 shadow-sm h-100 card-hover" style="border-top: 4px solid #2980b9 !important; min-width: 100%;">
                        <i class="bi bi-bar-chart-line fs-2 mb-2" style="color: #2980b9;"></i>
                        <h5 class="text-dark">Reportes Generales</h5>
                        <p class="small text-muted">Estadísticas y promedios grupales del curso.</p>
                        <button class="btn btn-sm btn-outline-primary mt-auto w-100">Ver Estadísticas</button>
                    </div>
                </div>

                <!-- Tarjeta: Gestión de Acciones de Mejora -->
                <div class="col-md-4 mb-4" onclick="verModuloMejorasDocente()" style="cursor: pointer;">
                    <div class="card p-4 text-center border-0 shadow-sm h-100 card-hover" style="border-top: 4px solid #2980b9 !important;">
                        <i class="bi bi-arrow-up-right-circle fs-2 mb-2" style="color: #2980b9;"></i>
                        <h5 class="text-dark">Seguimiento de Mejoras</h5>
                        <p class="small text-muted">Asigna compromisos y escribe observaciones a tus estudiantes.</p>
                        <button class="btn btn-sm btn-outline-primary mt-auto w-100">Gestionar Mejoras</button>
                    </div>
                </div>
            </div>
        </div>
        <!-- ========================================== -->
        <!-- 2. MÓDULOS INDEPENDIENTES Y COMPONENTES OCULTOS -->
        <!-- ========================================== -->
        <!-- Módulo Oculto de Acciones de Mejora (Docente) -->
        <div id="docente-mejoras" class="d-none">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h3 style="color: #2980b9; font-weight: bold;">
                    <i class="bi bi-arrow-up-right-circle me-2"></i> Control de Acciones de Mejora
                </h3>
                <button class="btn btn-sm btn-outline-secondary" onclick="volverDocenteMejoras()">
                    <i class="bi bi-arrow-left me-1"></i> Volver
                </button>
            </div>

            <div class="card border-0 shadow-sm p-4" style="border-radius: 15px;">
                <h5 class="fw-bold mb-3" style="color: #2980b9;">Revisión de Compromisos Académicos</h5>
                <p class="small text-muted">Selecciona un alumno para revisar su avance y redactar observaciones de mejora.</p>

                <div class="mt-2">
                    <button class="btn btn-sm text-white" style="background-color: #2980b9; border-radius: 8px;"
                            onclick="abrirCuadroTexto(1, 'Docente', 'Reforzamiento de Álgebra')">
                        <i class="bi bi-pencil-square me-2"></i> Escribir Observación
                    </button>
                </div>
            </div>
        </div>

        <!-- Módulo Oculto del Observador (Docente) -->
        <div id="docente-observaciones" class="d-none">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h3 style="color: #2980b9;"><i class="bi bi-eye-fill me-2"></i>Observador del Alumno</h3>
                <div>
                    <a href="@Url.Action("DescargarObservadorPdf", "Docente")" class="btn btn-sm btn-danger text-white me-2" style="border-radius: 8px;">
                        <i class="bi bi-file-earmark-pdf me-1"></i> Descargar Reporte PDF
                    </a>
                    <button class="btn btn-outline-secondary btn-sm" onclick="volverDocente()">Volver</button>
                </div>
            </div>

            <div class="card border-0 shadow-sm p-4 mb-4">
                <h5 class="mb-3 text-secondary">Crear Nueva Observación</h5>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label small fw-bold">Estudiante</label>
                        <select class="form-select">
                            <option>Ospina Juan Pablo</option>
                            <option>García María</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-bold">Tipo de Nota</label>
                        <select class="form-select">
                            <option class="text-success">Positiva / Mérito</option>
                            <option class="text-danger">Llamado de Atención</option>
                            <option class="text-warning">Seguimiento Académico</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label small fw-bold">Descripción del Evento</label>
                        <textarea class="form-control" rows="3" placeholder="Detalle lo sucedido..."></textarea>
