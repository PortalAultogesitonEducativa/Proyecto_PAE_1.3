        function poblarEstudiantesParaCursoMejoras(curso) {
            const selectObs = document.getElementById('selectEstudianteObservacion');
            const selectModal = document.getElementById('modalMejoraSelectEstudiante');
            const selectFiltro = document.getElementById('selectFiltroEstudianteMejoraDocente');
            if (!selectObs) return;

            const cursoNorm = (curso || '').trim().toLowerCase();
            let optsModal = '<option value="">-- Seleccionar Estudiante --</option>';
            let optsFiltro = '<option value="todos">Todos los estudiantes</option>';

            Array.from(selectObs.options).forEach((opt, idx) => {
                if (idx === 0) return;
                const cOpt = (opt.getAttribute('data-curso') || '').trim().toLowerCase();
                const match = (cursoNorm === '' || cOpt === cursoNorm || cOpt.startsWith(cursoNorm) || cursoNorm.startsWith(cOpt));
                if (match) {
                    optsModal += `<option value="${opt.value}">${opt.text}</option>`;
                    optsFiltro += `<option value="${opt.value}">${opt.text}</option>`;
                }
            });

            if (selectModal) selectModal.innerHTML = optsModal;
            if (selectFiltro) selectFiltro.innerHTML = optsFiltro;
        }

        window.cargarMejorasDocenteCurso = function(curso) {
            const contenedor = document.getElementById('contenedorMejorasDocenteCurso');
            if (!contenedor) return;

            contenedor.innerHTML = `
                <div class="text-center py-5 text-muted">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="mt-2">Cargando acciones de mejora del curso...</p>
                </div>
            `;

            fetch(`@Url.Action("ObtenerAccionesMejoraDocente", "Docente")?curso=${encodeURIComponent(curso)}`)
                .then(res => res.json())
                .then(data => {
                    if (data.success && data.mejoras) {
                        listaMejorasDocenteCursoGlobal = data.mejoras;
                        filtrarMejorasDocenteCurso();
                    } else {
                        contenedor.innerHTML = `<div class="alert alert-danger">Error al cargar acciones de mejora: ${data.message || 'Error desconocido'}</div>`;
