        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title"><i class="bi bi-journal-text me-2"></i>Boletín de Calificaciones</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Materia</th>
                                    <th>Tipo</th>
                                    <th>Fecha</th>
                                    <th class="text-center">Nota</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (ViewBag.DetalleNotas != null)
                                {
                                    foreach (var nota in (List<ProyectoPAE.Models.Evaluacion>)ViewBag.DetalleNotas)
                                    {
                                        <tr>
                                            <td>@(nota.id_materia == 1 ? "Matemáticas" : nota.id_materia == 2 ? "Español" : "Otras")</td>
                                            <td>@nota.tipo_evaluacion</td>
                                            <td>@nota.fecha_evaluacion.ToShortDateString()</td>
                                            <td class="text-center fw-bold @(nota.nota < 3 ? "text-danger" : "text-success")">@nota.nota</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr><td colspan="4" class="text-center text-muted">No hay notas registradas.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modalAsistencia" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title"><i class="bi bi-calendar-check me-2"></i>Detalle de Asistencia</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-center">
                    <h3 class="display-4 text-danger">@ViewBag.FallasRapidas</h3>
                    <p class="text-muted">Fallas totales en el periodo actual</p>
                    <hr>
                    <p class="small text-start text-muted italic">Próximamente: Listado detallado de fechas e inasistencias.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modalCitaciones" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title"><i class="bi bi-envelope-paper me-2"></i>Buzón de Citaciones</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="listaCitaciones">
                        @if (ViewBag.ListaCitaciones != null && ((List<ProyectoPAE.Models.Citacion>)ViewBag.ListaCitaciones).Any())
                        {
                            foreach (var cita in (List<ProyectoPAE.Models.Citacion>)ViewBag.ListaCitaciones)
                            {
                                <div class="alert alert-light border shadow-sm mb-3">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <h6 class="fw-bold text-success mb-1">@cita.asunto</h6>
                                        <span class="badge bg-secondary">@cita.fecha.ToShortDateString()</span>
                                    </div>
                                    <p class="mb-2 text-dark" style="font-size: 0.9rem;">@cita.mensaje</p>
                                    <div class="border-top pt-2 mt-1">
                                        <small class="text-muted"><strong>Remitente:</strong> @cita.remitente</small>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center py-4">
                                <i class="bi bi-chat-left-x fs-1 text-muted"></i>
                                <p class="text-muted mt-2">No tienes citaciones o mensajes pendientes.</p>
                            </div>
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    /**
     * Oculta todos los paneles y subsecciones de la interfaz SPA.
     */
    function ocultarTodo() {
        const subs = [
            'admin-main', 'admin-matricula', 'admin-usuarios', 'admin-certificados', 'admin-notificaciones', 'admin-asignacion', 'admin-reportes',
            'docente-main', 'docente-planilla', 'docente-asistencia', 'docente-observaciones', 'docente-mejoras',
            'estudiante-main', 'estudiante-calificaciones', 'estudiante-actividades', 'estudiante-cursosextra', 'estudiante-mejoras'
        ];

        const panelesPrincipales = [
            'panel-admin', 'panel-docente', 'panel-estudiante', 'panel-acudiente'
        ];

        subs.forEach(id => {
            const el = document.getElementById(id);
            if (el) el.classList.add('d-none');
        });

        panelesPrincipales.forEach(id => {
            const p = document.getElementById(id);
            if (p) p.classList.add('d-none');
        });
    }

    /**
     * Cambia la vista activa según el selector o el rol enviado.
     */
    function switchRole() {
        const selector = document.getElementById('roleSelector');
        const inputRol = document.getElementById('rolOculto');

        let role = '';

        if (selector && selector.value) {
            role = selector.value.toLowerCase().trim();
        } else if (inputRol && inputRol.value) {
            role = inputRol.value.toLowerCase().trim();
        }

        if (!role) return;

        if (role === 'administrador') {
            role = 'admin';
        } else if (role === 'padre') {
            role = 'acudiente';
        }

        ocultarTodo();

        const panel = document.getElementById('panel-' + role);
        if (panel) {
            panel.classList.remove('d-none');

            const subMain = document.getElementById(role + '-main');
            if (subMain) subMain.classList.remove('d-none');
        }
    }

    // --- FUNCIONES DE NAVEGACIÓN ADMINISTRADOR ---
    function verMatricula() { ocultarTodo(); mostrarSubpanel('panel-admin', 'admin-matricula'); }
    function verCertificados() { ocultarTodo(); mostrarSubpanel('panel-admin', 'admin-certificados'); }
    function verNotificaciones() { ocultarTodo(); mostrarSubpanel('panel-admin', 'admin-notificaciones'); }
    function verAsignacion() { ocultarTodo(); mostrarSubpanel('panel-admin', 'admin-asignacion'); }
    function verReportes() { ocultarTodo(); mostrarSubpanel('panel-admin', 'admin-reportes'); }
    function volverAdmin() { ocultarTodo(); mostrarSubpanel('panel-admin', 'admin-main'); }

    // --- FUNCIONES DE NAVEGACIÓN DOCENTE ---
    function verPlanilla() { ocultarTodo(); mostrarSubpanel('panel-docente', 'docente-planilla'); }
    function verAsistencia() { ocultarTodo(); mostrarSubpanel('panel-docente', 'docente-asistencia'); }
    function verObservaciones() { ocultarTodo(); mostrarSubpanel('panel-docente', 'docente-observaciones'); }
    function verModuloMejorasDocente() { ocultarTodo(); mostrarSubpanel('panel-docente', 'docente-mejoras'); }
    function volverDocente() { ocultarTodo(); mostrarSubpanel('panel-docente', 'docente-main'); }

    // --- FUNCIONES DE NAVEGACIÓN ESTUDIANTE ---
    function verCalificacionesEstudiante() { ocultarTodo(); mostrarSubpanel('panel-estudiante', 'estudiante-calificaciones'); }
    function verActividadesEstudiante() { ocultarTodo(); mostrarSubpanel('panel-estudiante', 'estudiante-actividades'); }
    function verCursosExtra() { ocultarTodo(); mostrarSubpanel('panel-estudiante', 'estudiante-cursosextra'); }
    function verModuloMejoras() { ocultarTodo(); mostrarSubpanel('panel-estudiante', 'estudiante-mejoras'); }
    function volverEstudiante() { ocultarTodo(); mostrarSubpanel('panel-estudiante', 'estudiante-main'); }

    function mostrarSubpanel(panelId, subId) {
        const panel = document.getElementById(panelId);
        const sub = document.getElementById(subId);
        if (panel) panel.classList.remove('d-none');
        if (sub) sub.classList.remove('d-none');
    }

    // --- INICIALIZACIÓN ÚNICA DEL DOM ---
    document.addEventListener("DOMContentLoaded", function() {
        switchRole();

        // Configuración de acudientes/hijos
        const selectHijo = document.getElementById("selectHijo");
        const btnVerNotas = document.getElementById("btnVerNotas");

        if (selectHijo && btnVerNotas) {
            const actualizarEnlace = () => {
                btnVerNotas.href = `/Estudiante/MisNotas?idEstudiante=${selectHijo.value}`;
            };
            actualizarEnlace();
            selectHijo.addEventListener("change", actualizarEnlace);
        }
    });
</script>

<style>
    /* Clase para unificar el panel administrativo */
    .card-admin {
        border-left: 5px solid #fd7e14 !important; /* Línea naranja más marcada */
        transition: all 0.3s ease;
        cursor: pointer;
    }

        .card-admin:hover {
            background-color: #fffaf5; /* Un fondo naranja muy tenue al pasar el mouse */
            transform: scale(1.02);
            box-shadow: 0 10px 20px rgba(253, 126, 20, 0.1) !important;
        }
</style>

<style>
    /* 1. Quitamos el fondo azul de toda la tarjeta */
    .card-hover:hover {
        background-color: #ffffff !important; /* Se mantiene blanca */
        transform: translateY(-5px); /* Solo flota un poquito */
        box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
        transition: all 0.3s ease;
    }

        /* 2. El botón es el que se ilumina con fuerza */
        .card-hover:hover .btn-outline-primary {
            background-color: #2980b9 !important;
            color: white !important;
            box-shadow: 0 4px 8px rgba(41, 128, 185, 0.3);
        }

    /* 3. Aseguramos que los textos no cambien de color bruscamente */
    .card-hover h6, .card-hover p, .card-hover i {
        transition: color 0.3s ease;
    }
</style>

<style>
    /* Estilo del botón: Sólido, Morado y Rectangular */
    .btn-estudiante-solido {
        background-color: #6f42c1 !important;
        color: white !important;
        border: none !important;
        border-radius: 4px !important; /* Mantiene la forma del botón negro */
        padding: 8px 16px;
        font-weight: 500;
        transition: all 0.3s ease;
    }

        /* Efecto al pasar el mouse sobre el botón */
        .btn-estudiante-solido:hover {
            background-color: #5a32a3 !important; /* Un morado un poco más oscuro */
            color: white !important;
            box-shadow: 0 4px 8px rgba(111, 66, 193, 0.3);
        }

    /* Mantenemos la tarjeta limpia y blanca */
    .card-estudiante-limpia {
        transition: all 0.3s ease;
        background-color: white !important;
    }

        .card-estudiante-limpia:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
        }
</style>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const selectHijo = document.getElementById("selectHijo");
        const btnVerNotas = document.getElementById("btnVerNotas");

        function actualizarEnlace() {
            // Solo ejecuta si ambos elementos existen en la vista (pantalla de acudiente)
            if (selectHijo && btnVerNotas) {
                const idHijo = selectHijo.value;
                btnVerNotas.href = `/Estudiante/MisNotas?idEstudiante=${idHijo}`;
            }
        }

        if (selectHijo && btnVerNotas) {
            actualizarEnlace();
            selectHijo.addEventListener("change", actualizarEnlace);
        }
    });
</script>

