    // 1. Docente: Guardar nuevo curso
    function guardarCursoExtra(event) {
        event.preventDefault();
        const form = document.getElementById('formCrearCursoExtra');
        const formData = new FormData(form);

        const checkedDocs = [];
        document.querySelectorAll('.check-doc-req:checked').forEach(chk => {
            checkedDocs.push(chk.value);
        });
        formData.append('DocumentosRequeridos', JSON.stringify(checkedDocs));

        fetch('@Url.Action("CrearCursoExtra", "Docente")', {
            method: 'POST',
            body: formData
        })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    alert(data.message);
                    const modalEl = document.getElementById('modalCrearCursoExtra');
                    const modal = bootstrap.Modal.getInstance(modalEl);
                    if (modal) modal.hide();
                    window.location.reload();
                } else {
                    alert('Error: ' + data.message);
                }
            })
            .catch(err => {
                console.error(err);
                alert('Ocurrió un error al procesar la solicitud.');
            });
    }

    // 2. Docente: Ver estudiantes inscritos
    function verInscritosCursoExtra(idCurso) {
        const tabla = document.getElementById('tablaCuerpoInscritos');
        tabla.innerHTML = '<tr><td colspan="7" class="text-center py-4 text-muted"><div class="spinner-border spinner-border-sm text-primary me-2"></div>Cargando lista de inscritos...</td></tr>';

        const modalEl = document.getElementById('modalVerInscritosExtra');
        const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
        modal.show();

        fetch(`@Url.Action("ObtenerInscritosCursoExtra", "Docente")?idCurso=${idCurso}`)
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    document.getElementById('tituloModalInscritos').innerHTML = `<i class="bi bi-people-fill me-2"></i>Inscritos en: ${data.nombreCurso}`;
                    document.getElementById('conteoInscritos').innerText = `Total Alumnos Inscritos: ${data.totalInscritos}`;
                    document.getElementById('badgeCuposModal').innerText = `Cupos Disponibles: ${data.cuposDisponibles} de ${data.cuposTotales}`;

                    if (!data.estudiantes || data.estudiantes.length === 0) {
                        tabla.innerHTML = '<tr><td colspan="7" class="text-center py-4 text-muted"><i class="bi bi-inbox me-2"></i>Aún no hay estudiantes inscritos en este curso.</td></tr>';
                    } else {
                        let html = '';
                        data.estudiantes.forEach((est, idx) => {
                            const fecha = new Date(est.fechaInscripcion).toLocaleDateString();
                            let docsHtml = '';
                            if (est.documentosSubidos && est.documentosSubidos.length > 0) {
                                docsHtml = est.documentosSubidos.map(d => `<a href="${d.rutaArchivo}" target="_blank" class="badge bg-success-subtle text-success border border-success-subtle me-1 text-decoration-none" title="Ver documento"><i class="bi bi-file-earmark-check me-1"></i>${d.tipoDocumento}</a>`).join('');
                            } else {
                                docsHtml = '<span class="badge bg-warning-subtle text-warning border border-warning-subtle text-dark"><i class="bi bi-clock me-1"></i>Pendientes</span>';
                            }

                            html += `
                                    <tr>
                                        <td><span class="fw-bold">${idx + 1}</span></td>
                                        <td class="fw-semibold text-dark">${est.nombreCompleto}</td>
                                        <td>${est.documento}</td>
                                        <td><small class="text-muted">${est.correo}</small></td>
                                        <td>${fecha}</td>
                                        <td>${docsHtml}</td>
                                        <td><span class="badge bg-success">Inscrito</span></td>
                                    </tr>
                                `;
                        });
                        tabla.innerHTML = html;
                    }
                } else {
                    tabla.innerHTML = `<tr><td colspan="7" class="text-center py-4 text-danger">${data.message || 'Error al cargar estudiantes.'}</td></tr>`;
                }
            })
            .catch(err => {
                console.error(err);
