                        <p class="text-muted text-uppercase small mb-2">Total Matriculados</p>
                        <div class="d-flex justify-content-between align-items-end">
                            <span class="fs-3 fw-bold" style="color: #0d2a4a;">1,284</span>
                            <span class="fw-bold" style="color: #0d2a4a;">+12%</span>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm p-4 h-100" style="border-left: 4px solid #e67e22 !important;">
                        <p class="text-muted text-uppercase small mb-2">Pagos Pendientes</p>
                        <div class="d-flex justify-content-between align-items-end">
                            <span class="fs-3 fw-bold" style="color: #e67e22;">42</span>
