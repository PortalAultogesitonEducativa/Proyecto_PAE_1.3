                        </select>
                    </div>

                    <!-- 3. Seleccionar Jornada (Mañana / Tarde) -->
                    <div class="col-md-3">
                        <label class="form-label fw-bold">Jornada</label>
                        <select class="form-select" id="selectJornadaAsistencia" name="jornada">
                            <option value="Mañana">Mañana</option>
                            <option value="Tarde">Tarde</option>
                        </select>
