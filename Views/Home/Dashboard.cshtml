<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function() {
        // 1. Gráfica Promedios por Materia
        const ctxMateria = document.getElementById('chartPromediosMateria');
        if (ctxMateria) {
            const labelsMat = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(rep.PromediosPorMateria.Select(p => p.Materia)));
            const dataMat = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(rep.PromediosPorMateria.Select(p => p.Promedio)));

            new Chart(ctxMateria, {
                type: 'bar',
                data: {
                    labels: labelsMat.length ? labelsMat : ['General'],
                    datasets: [{
                        label: 'Promedio (0 - 5.0)',
                        data: dataMat.length ? dataMat : [0],
                        backgroundColor: 'rgba(230, 126, 34, 0.65)',
                        borderColor: '#e67e22',
                        borderWidth: 1.5,
                        borderRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: { beginAtZero: true, max: 5 }
                    }
                }
            });
        }

        // 2. Gráfica Aprobación vs Reprobación
        const ctxApro = document.getElementById('chartAprobacion');
        if (ctxApro) {
            new Chart(ctxApro, {
                type: 'doughnut',
                data: {
                    labels: ['Aprobados', 'Reprobados'],
                    datasets: [{
                        data: [@rep.Aprobados, @rep.Reprobados],
                        backgroundColor: ['#27ae60', '#e74c3c'],
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { position: 'bottom' } }
                }
            });
        }

        // 3. Gráfica Matrículas por Grado
        const ctxGrado = document.getElementById('chartMatriculasGrado');
        if (ctxGrado) {
            const labelsGrados = ['Grado 6°', 'Grado 7°', 'Grado 8°', 'Grado 9°', 'Grado 10°', 'Grado 11°'];
            const dataGrados = [
                        @rep.MatriculasPorGrado.GetValueOrDefault(6, 0),
                        @rep.MatriculasPorGrado.GetValueOrDefault(7, 0),
                        @rep.MatriculasPorGrado.GetValueOrDefault(8, 0),
                        @rep.MatriculasPorGrado.GetValueOrDefault(9, 0),
                        @rep.MatriculasPorGrado.GetValueOrDefault(10, 0),
                        @rep.MatriculasPorGrado.GetValueOrDefault(11, 0)
                    ];

            new Chart(ctxGrado, {
                type: 'bar',
                data: {
                    labels: labelsGrados,
                    datasets: [{
                        label: 'Estudiantes Matriculados',
                        data: dataGrados,
                        backgroundColor: 'rgba(27, 42, 71, 0.75)',
                        borderColor: '#1b2a47',
                        borderWidth: 1.5,
                        borderRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: { beginAtZero: true, precision: 0 }
                    }
                }
            });
        }

        // 4. Gráfica Distribución por Género
        const ctxGenero = document.getElementById('chartGenero');
        if (ctxGenero) {
            new Chart(ctxGenero, {
                type: 'doughnut',
                data: {
                    labels: ['Hombres', 'Mujeres' @(rep.TotalSinGenero > 0 ? ", 'No especificado'" : "")],
                    datasets: [{
                        data: [@rep.TotalHombres, @rep.TotalMujeres @(rep.TotalSinGenero > 0 ? $", {rep.TotalSinGenero}" : "")],
                        backgroundColor: ['#2980b9', '#e84393', '#95a5a6'],
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { position: 'bottom' } }
                }
            });
        }
    });
</script>