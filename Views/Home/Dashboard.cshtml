        window.filtrarEstudiantesObservador = function() {
            const selectCurso = document.getElementById('selectCursoObservador');
            const selectJornada = document.getElementById('selectJornadaObservador');
            const selectEst = document.getElementById('selectEstudianteObservacion');
            if (!selectEst) return;

            const curso = selectCurso ? selectCurso.value.trim().toLowerCase() : 'todos';
            const jornada = selectJornada ? selectJornada.value.trim().toLowerCase() : 'todos';

            Array.from(selectEst.options).forEach((opt, idx) => {
                if (idx === 0) return;
                const cursoEst = (opt.getAttribute('data-curso') || '').trim().toLowerCase();
                let matchCurso = (curso === 'todos' || cursoEst === curso);
                let matchJornada = true;
                if (jornada === 'mañana' || jornada === 'manana' || jornada === 'm') {
                    matchJornada = cursoEst.endsWith('m') || cursoEst.includes('m') || cursoEst === '';
                } else if (jornada === 'tarde' || jornada === 't') {
                    matchJornada = cursoEst.endsWith('t') || cursoEst.includes('t') || cursoEst === '';
                }

                const visible = matchCurso && matchJornada;
                opt.hidden = !visible;
                opt.disabled = !visible;
                opt.style.display = visible ? '' : 'none';
            });

            if (selectEst.selectedOptions.length === 0 || selectEst.selectedOptions[0].hidden) {
                selectEst.value = "";
            }
            cargarObservacionesEstudianteSeleccionado();
        };

        window.cambiarCamposObservadorPorTipo = function() {
            const tipo = document.getElementById('selectTipoNotaObservacion') ? document.getElementById('selectTipoNotaObservacion').value : '';
            const bloquePositiva = document.getElementById('bloqueNotaPositiva');
            const bloqueNegativa = document.getElementById('bloqueNotaNegativa');

            if (tipo === 'Positiva / Mérito') {
                if (bloquePositiva) bloquePositiva.classList.remove('d-none');
                if (bloqueNegativa) bloqueNegativa.classList.add('d-none');
            } else {
                if (bloquePositiva) bloquePositiva.classList.add('d-none');
                if (bloqueNegativa) bloqueNegativa.classList.remove('d-none');
            }
        };

        window.guardarObservacionDocente = function() {
            const selectEst = document.getElementById('selectEstudianteObservacion');
            const selectTipo = document.getElementById('selectTipoNotaObservacion');
            const selectPeriodo = document.getElementById('selectPeriodoObservacion');

            if (!selectEst || !selectEst.value) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Campo obligatorio',
                    text: 'Debe seleccionar un estudiante para registrar la observación.'
                });
                return;
            }

            const tipo = selectTipo ? selectTipo.value : 'Seguimiento Académico';
            const periodo = selectPeriodo ? parseInt(selectPeriodo.value) : 1;

            let descripcion = '';
            let aspectosMejorar = '';
            let quienRegistra = document.getElementById('txtQuienRegistra') ? document.getElementById('txtQuienRegistra').value.trim() : '';

            if (tipo === 'Positiva / Mérito') {
                const txtMerito = document.getElementById('txtDescripcionMerito');
                if (!txtMerito || !txtMerito.value.trim()) {
                    Swal.fire({ icon: 'warning', title: 'Campo obligatorio', text: 'Debe ingresar la descripción del mérito o felicitación.' });
                    return;
                }
                descripcion = txtMerito.value.trim();
            } else {
                const txtSuceso = document.getElementById('txtDescripcionSuceso');
                const txtMejorar = document.getElementById('txtAspectosMejorar');
                if (!txtSuceso || !txtSuceso.value.trim()) {
                    Swal.fire({ icon: 'warning', title: 'Campo obligatorio', text: 'Debe ingresar la descripción del suceso o falta.' });
                    return;
                }
                if (!txtMejorar || !txtMejorar.value.trim()) {
                    Swal.fire({ icon: 'warning', title: 'Campo obligatorio', text: 'Debe especificar los aspectos y compromisos a mejorar.' });
                    return;
                }
                descripcion = txtSuceso.value.trim();
                aspectosMejorar = txtMejorar.value.trim();
            }

            const payload = {
                IdEstudiante: parseInt(selectEst.value),
                TipoNota: tipo,
                Periodo: periodo,
                Descripcion: descripcion,
                AspectosMejorar: aspectosMejorar,
                QuienRegistra: quienRegistra
            };

            fetch('@Url.Action("RegistrarObservacion", "Docente")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    Swal.fire({
                        icon: 'success',
                        title: '¡Anotación Guardada!',
                        text: data.message || 'Se registró correctamente en el observador del alumno.',
                        timer: 3000,
                        showConfirmButton: false
                    });
                    if (document.getElementById('txtDescripcionMerito')) document.getElementById('txtDescripcionMerito').value = '';
                    if (document.getElementById('txtDescripcionSuceso')) document.getElementById('txtDescripcionSuceso').value = '';
                    if (document.getElementById('txtAspectosMejorar')) document.getElementById('txtAspectosMejorar').value = '';
                    cargarObservacionesEstudianteSeleccionado();
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: data.message || 'No se pudo registrar la observación.'
                    });
                }
            })
            .catch(err => {
                console.error(err);
                Swal.fire({
                    icon: 'error',
                    title: 'Error de conexión',
                    text: 'No se pudo conectar con el servidor.'
                });
            });
        };

        window.cargarObservacionesEstudianteSeleccionado = function() {
            const selectEst = document.getElementById('selectEstudianteObservacion');
            const tbody = document.getElementById('cuerpoHistorialObservaciones');
            const badgeConteo = document.getElementById('conteoObservacionesEstudiante');
            if (!tbody) return;

            if (!selectEst || !selectEst.value) {
                tbody.innerHTML = '<tr><td colspan="6" class="text-center py-4 text-muted">Seleccione un estudiante para consultar su historial de observador.</td></tr>';
                if (badgeConteo) badgeConteo.textContent = 'Selecciona un estudiante';
                return;
            }

            tbody.innerHTML = '<tr><td colspan="6" class="text-center py-3 text-muted"><div class="spinner-border spinner-border-sm text-primary me-2"></div>Cargando historial del observador...</td></tr>';

            fetch(`@Url.Action("ObtenerObservacionesEstudiante", "Docente")?idEstudiante=${selectEst.value}`)
                .then(res => res.json())
                .then(data => {
                    if (data.success && data.observaciones && data.observaciones.length > 0) {
                        if (badgeConteo) badgeConteo.textContent = `${data.observaciones.length} anotaciones registradas`;
                        let html = '';
                        data.observaciones.forEach(obs => {
                            const badgeTipo = obs.tipoNota === 'Positiva / Mérito' 
                                ? `<span class="badge bg-success">${obs.tipoNota}</span>` 
                                : `<span class="badge bg-danger">${obs.tipoNota}</span>`;
                            html += `
                                <tr>
                                    <td><small class="text-muted fw-bold">${obs.fecha}</small></td>
                                    <td><span class="badge bg-light text-dark border">Periodo ${obs.periodo || 1}</span></td>
                                    <td>${badgeTipo}</td>
                                    <td>${obs.descripcion}</td>
                                    <td>${obs.aspectosMejorar ? `<span class="text-warning text-dark small"><i class="bi bi-arrow-up-right me-1"></i>${obs.aspectosMejorar}</span>` : '<span class="text-muted small">-</span>'}</td>
                                    <td><small class="fw-semibold text-primary">${obs.quienRegistra || 'Docente'}</small></td>
                                </tr>
                            `;
                        });
                        tbody.innerHTML = html;
                    } else {
                        if (badgeConteo) badgeConteo.textContent = '0 anotaciones';
                        tbody.innerHTML = '<tr><td colspan="6" class="text-center py-4 text-muted"><i class="bi bi-clipboard-check me-2"></i>El estudiante no registra anotaciones disciplinarias o de seguimiento aún.</td></tr>';
                    }
                })
                .catch(err => {
                    console.error(err);
                    tbody.innerHTML = '<tr><td colspan="6" class="text-center py-4 text-danger">Error al cargar el historial del observador.</td></tr>';
                });
        };

        window.descargarObservadorDocentePdf = function() {
            const selectEst = document.getElementById('selectEstudianteObservacion');
            const selectCurso = document.getElementById('selectCursoObservador');

            let url = '@Url.Action("DescargarObservadorPdf", "Docente")';
            const params = [];
            if (selectEst && selectEst.value) {
                params.push(`idEstudiante=${selectEst.value}`);
            }
            if (selectCurso && selectCurso.value && selectCurso.value !== 'todos') {
                params.push(`curso=${encodeURIComponent(selectCurso.value)}`);
            }

            if (params.length > 0) {
                url += '?' + params.join('&');
            }

            window.open(url, '_blank');
        };

        // Función para enviar Citación a Padres desde Docente
        window.guardarCitacionDocente = function() {
            const selectEst = document.getElementById('selectEstudianteObservacion');
            const txtAsunto = document.getElementById('txtAsuntoCitacion');
            const txtMsg = document.getElementById('txtMensajeCitacion');

            if (!selectEst || !selectEst.value) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Campo obligatorio',
                    text: 'Debe seleccionar un estudiante en los filtros de arriba para enviar la citación.'
                });
                return;
            }

            if (!txtAsunto || !txtAsunto.value.trim()) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Campo obligatorio',
                    text: 'Debe ingresar el asunto de la citación.'
                });
                return;
            }

            if (!txtMsg || !txtMsg.value.trim()) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Campo obligatorio',
                    text: 'Debe ingresar el mensaje o detalles de la citación.'
                });
                return;
            }

            const payload = {
                IdEstudiante: parseInt(selectEst.value),
                Asunto: txtAsunto.value.trim(),
                Mensaje: txtMsg.value.trim()
            };

            fetch('@Url.Action("RegistrarCitacion", "Docente")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    Swal.fire({
                        icon: 'success',
                        title: '¡Citación Enviada!',
                        text: data.message || 'La citación ha sido enviada al acudiente del estudiante.',
                        timer: 3000,
                        showConfirmButton: false
                    });
                    txtAsunto.value = '';
                    txtMsg.value = '';
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: data.message || 'No se pudo enviar la citación.'
                    });
                }
            })
            .catch(err => {
                console.error(err);
                Swal.fire({
                    icon: 'error',
                    title: 'Error de conexión',
                    text: 'No se pudo conectar con el servidor.'
                });
            });
        };

        // ===============================================
        // MÓDULO: CONTROL DE ASISTENCIA (PAGINACIÓN & FILTROS)
        // ===============================================

        let paginaActualAsistencia = 1;
        const itemsPorPaginaAsistencia = 10;

        window.filtrarAsistenciaPorCursoYJornada = function() {
            paginaActualAsistencia = 1;
            renderizarPaginacionAsistencia();
        };

        window.renderizarPaginacionAsistencia = function() {
            const selectGrupo = document.getElementById('selectGrupoAsistencia');
            const selectJornada = document.getElementById('selectJornadaAsistencia');
            const cursoSeleccionado = (selectGrupo ? selectGrupo.value : 'todos').trim().toLowerCase();
            const jornadaSeleccionada = (selectJornada ? selectJornada.value : 'todos').trim().toLowerCase();

            const todasFilas = Array.from(document.querySelectorAll('#tbodyAsistencia .fila-asistencia-estudiante'));
            
            const filasFiltradas = todasFilas.filter(fila => {
                const cursoFila = (fila.getAttribute('data-curso') || '').trim().toLowerCase();
                let matchCurso = (cursoSeleccionado === 'todos' || cursoFila === cursoSeleccionado);
                let matchJornada = true;
                if (jornadaSeleccionada === 'mañana' || jornadaSeleccionada === 'manana' || jornadaSeleccionada === 'm') {
                    matchJornada = cursoFila.endsWith('m') || cursoFila.includes('m') || cursoFila === '';
                } else if (jornadaSeleccionada === 'tarde' || jornadaSeleccionada === 't') {
                    matchJornada = cursoFila.endsWith('t') || cursoFila.includes('t') || cursoFila === '';
                }
                return matchCurso && matchJornada;
            });

            const totalItems = filasFiltradas.length;
            const totalPaginas = Math.ceil(totalItems / itemsPorPaginaAsistencia) || 1;
            if (paginaActualAsistencia > totalPaginas) paginaActualAsistencia = totalPaginas;

            todasFilas.forEach(f => f.style.display = 'none');

            const inicio = (paginaActualAsistencia - 1) * itemsPorPaginaAsistencia;
            const fin = inicio + itemsPorPaginaAsistencia;
            filasFiltradas.slice(inicio, fin).forEach(f => f.style.display = '');

            const infoP = document.getElementById('infoAsistenciaPagina');
            if (infoP) {
                if (totalItems === 0) {
                    infoP.textContent = 'Mostrando 0 estudiantes para los filtros seleccionados.';
                } else {
                    infoP.textContent = `Mostrando ${inicio + 1} - ${Math.min(fin, totalItems)} de ${totalItems} estudiantes (Página ${paginaActualAsistencia} de ${totalPaginas})`;
                }
            }

            const ulPaginacion = document.getElementById('paginacionAsistencia');
            if (ulPaginacion) {
                let pagHtml = '';
                if (totalPaginas > 1) {
                    pagHtml += `<li class="page-item ${paginaActualAsistencia === 1 ? 'disabled' : ''}"><a class="page-link" href="javascript:void(0)" onclick="cambiarPaginaAsistencia(${paginaActualAsistencia - 1})">Anterior</a></li>`;
                    for (let p = 1; p <= totalPaginas; p++) {
                        pagHtml += `<li class="page-item ${paginaActualAsistencia === p ? 'active' : ''}"><a class="page-link" href="javascript:void(0)" onclick="cambiarPaginaAsistencia(${p})">${p}</a></li>`;
                    }
                    pagHtml += `<li class="page-item ${paginaActualAsistencia === totalPaginas ? 'disabled' : ''}"><a class="page-link" href="javascript:void(0)" onclick="cambiarPaginaAsistencia(${paginaActualAsistencia + 1})">Siguiente</a></li>`;
                }
                ulPaginacion.innerHTML = pagHtml;
            }
        };

        window.cambiarPaginaAsistencia = function(pagina) {
            if (pagina < 1) return;
            paginaActualAsistencia = pagina;
            renderizarPaginacionAsistencia();
        };

        // Inicializar paginación de asistencia al cargar la página
        setTimeout(function() {
            renderizarPaginacionAsistencia();
        }, 300);
    });
</script>

