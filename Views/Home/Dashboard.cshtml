        // Función para guardar asistencias con validación de calificados y confirmación SweetAlert2
        window.guardarAsistenciaYObservaciones = function() {
            const filas = document.querySelectorAll('#tablaAsistencia tbody tr');
            let sinCalificar = [];

            filas.forEach(fila => {
                const inputNombre = fila.querySelector('.estudiante-nombre');
                const radios = fila.querySelectorAll('input[type="radio"]');

                if (radios.length > 0) {
                    const algunoSeleccionado = Array.from(radios).some(r => r.checked);
                    if (!algunoSeleccionado) {
                        const nombreEst = inputNombre ? inputNombre.innerText.trim() : "Estudiante";
                        sinCalificar.push(nombreEst);
                    }
                }
            });

            // 1. Si falta calificar a algún estudiante, mostrar ventana emergente con la lista
            if (sinCalificar.length > 0) {
                let listaHtml = sinCalificar.map(n => `<li class="text-danger fw-bold">${n}</li>`).join('');
                Swal.fire({
                    icon: 'warning',
                    title: '¡Falta calificar la asistencia!',
                    html: `<p>Falta calificar la asistencia a las siguientes personas:</p><ul class="text-start mb-0" style="max-height: 200px; overflow-y: auto;">${listaHtml}</ul>`,
                    confirmButtonText: 'Entendido',
                    confirmButtonColor: '#0d6efd'
                });
                return;
            }

            // 2. Si todos están calificados, mostrar ventana de confirmación antes de guardar
            Swal.fire({
                title: '¿Seguro que quieres guardar?',
                text: '¿Deseas guardar el control de asistencia para este grupo?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#0d6efd',
                cancelButtonColor: '#6c757d',
                confirmButtonText: '<i class="bi bi-save me-1"></i> Sí, guardar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    const registros = [];
                    filas.forEach(fila => {
                        const inputId = fila.querySelector('input[name="estudiante_id_asistencia"]');
                        const radioChecked = fila.querySelector('input[type="radio"]:checked');
                        const inputObs = fila.querySelector('input[type="text"]');

                        if (inputId && radioChecked) {
                            registros.push({
                                IdEstudiante: parseInt(inputId.value),
                                Estado: radioChecked.value,
                                Observacion: inputObs ? inputObs.value.trim() : ""
                            });
                        }
                    });

                    fetch('@Url.Action("GuardarControlAsistencia", "Docente")', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify(registros)
                    })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            Swal.fire({
                                toast: true,
                                position: 'top-end',
                                icon: 'success',
                                title: data.message || '¡Asistencia y observaciones guardadas exitosamente!',
                                showConfirmButton: false,
                                timer: 3500,
                                timerProgressBar: true
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error al guardar',
                                text: data.message || 'No se pudo guardar la asistencia.'
                            });
                        }
                    })
                    .catch(err => {
                        console.error(err);
                        Swal.fire({
                            icon: 'error',
                            title: 'Error de red',
                            text: 'Ocurrió un error al intentar guardar la asistencia.'
                        });
                    });
                }
            });
        };

