    function renderizarAlumnosCursoDocente(cursoNombre) {
        const contenedor = document.getElementById('listaAlumnosClassroomDocente');
        const badge = document.getElementById('badgeTotalAlumnosCurso');
        if (!contenedor) return;

        if (typeof listaEstudiantesCursoGlobal === 'undefined' || listaEstudiantesCursoGlobal.length === 0) {
            contenedor.innerHTML = `<div class="col-12 text-muted small py-3">No hay lista de estudiantes disponible.</div>`;
            return;
        }

        const alumnos = listaEstudiantesCursoGlobal.filter(e => (e.curso || '').trim().toLowerCase() === cursoNombre.trim().toLowerCase());

        if (badge) badge.textContent = `${alumnos.length} ${alumnos.length === 1 ? 'Estudiante' : 'Estudiantes'}`;

        if (alumnos.length === 0) {
            contenedor.innerHTML = `
                <div class="col-12 py-4 text-center text-muted">
                    <i class="bi bi-people fs-2 mb-2 d-block"></i>
                    <p class="small mb-0">No se encontraron estudiantes matriculados en el Curso ${cursoNombre}.</p>
                </div>
            `;
            return;
        }

        let html = '';
        alumnos.forEach(al => {
            html += `
                <div class="col-md-6 mb-2">
                    <div class="d-flex align-items-center gap-3 p-2 bg-light rounded-3 border">
                        <div class="rounded-circle bg-white border d-flex align-items-center justify-content-center fw-bold text-primary flex-shrink-0" style="width: 38px; height: 38px;">
                            <i class="bi bi-person"></i>
                        </div>
                        <div class="overflow-hidden">
                            <div class="fw-bold text-dark small text-truncate">${al.nombre}</div>
                            <div class="text-muted" style="font-size: 0.76rem;">${al.email || 'Estudiante'}</div>
                        </div>
                    </div>
                </div>
            `;
        });

        contenedor.innerHTML = html;
    }

    function guardarNuevaActividad(event) {
        event.preventDefault();
        const form = document.getElementById('formCrearActividad');
        const formData = new FormData(form);

        fetch('@Url.Action("CrearActividad", "Docente")', {
            method: 'POST',
            body: formData
        })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    if (typeof Swal !== 'undefined') {
                        Swal.fire({ icon: 'success', title: '¡Éxito!', text: data.message, timer: 2000, showConfirmButton: false });
                    } else {
                        alert(data.message);
                    }
                    const modalEl = document.getElementById('modalCrearActividad');
                    const modal = bootstrap.Modal.getInstance(modalEl);
                    if (modal) modal.hide();
                    form.reset();
                    cargarActividadesDocente();
                } else {
                    if (typeof Swal !== 'undefined') {
                        Swal.fire({ icon: 'error', title: 'Atención', text: data.message });
                    } else {
                        alert('Error: ' + data.message);
                    }
                }
            })
            .catch(err => {
                console.error(err);
                alert('Ocurrió un error al publicar la actividad.');
            });
    }

    function abrirModalRevisarEntregas(idActividad) {
        const tbody = document.getElementById('tablaCuerpoEntregas');
        if (!tbody) return;

        tbody.innerHTML = `<tr><td colspan="7" class="text-center py-4 text-muted"><div class="spinner-border spinner-border-sm text-primary"></div> Cargando entregas...</td></tr>`;

        const modalEl = document.getElementById('modalRevisarEntregas');
        const modal = new bootstrap.Modal(modalEl);
        modal.show();

        fetch(`@Url.Action("ObtenerEntregasActividad", "Docente")?idActividad=${idActividad}`)
            .then(res => res.json())
            .then(data => {
                if (!data.success) {
                    tbody.innerHTML = `<tr><td colspan="7" class="text-center py-4 text-danger">${data.message}</td></tr>`;
                    return;
                }

                document.getElementById('tituloModalRevisarEntregas').innerHTML = `<i class="bi bi-file-earmark-check me-2"></i>Entregas: ${data.tituloActividad}`;
                document.getElementById('subtituloModalRevisarEntregas').textContent = `Materia: ${data.materia} | Grado: ${data.grado || 'Todos'} | Total entregas: ${data.totalEntregas}`;

                if (!data.entregas || data.entregas.length === 0) {
                    tbody.innerHTML = `<tr><td colspan="7" class="text-center py-4 text-muted">Ningún estudiante ha subido su entrega todavía.</td></tr>`;
                    return;
                }

                let html = '';
                data.entregas.forEach(ent => {
                    const badgeEstado = ent.estado === 'Calificado' 
                        ? `<span class="badge bg-success" id="badge-estado-${ent.idEntrega}">Calificado</span>` 
                        : `<span class="badge bg-warning text-dark" id="badge-estado-${ent.idEntrega}">Pendiente</span>`;

                    const linkArchivo = ent.archivoRuta 
                        ? `<a href="${ent.archivoRuta}" target="_blank" class="btn btn-sm btn-outline-primary py-0 px-2 rounded-pill" style="font-size: 0.8rem;">
                               <i class="bi bi-file-earmark-arrow-down me-1"></i>${ent.archivoNombre || 'Descargar Trabajo'}
                           </a>` 
                        : `<span class="text-muted small">Sin archivo adjunto</span>`;

                    const comentarioEstudiante = ent.comentario 
                        ? `<div class="p-2 bg-light rounded mt-1 small text-dark border" style="font-size: 0.78rem;">
                               <i class="bi bi-chat-left-quote me-1 text-primary"></i>${ent.comentario}
                           </div>` 
                        : '';

                    const valorNota = ent.calificacion !== null && ent.calificacion !== undefined 
                        ? Number(ent.calificacion).toFixed(1) 
                        : '';

                    html += `
                        <tr id="fila-entrega-${ent.idEntrega}" class="fila-entrega-item" data-nombre="${(ent.nombreEstudiante || '').toLowerCase()}" data-correo="${(ent.correo || '').toLowerCase()}" data-doc="${(ent.documento || '').toLowerCase()}">
                            <td>
                                <strong class="d-block text-dark">${ent.nombreEstudiante}</strong>
                                <small class="text-muted">${ent.correo} | Doc: ${ent.documento}</small>
                            </td>
                            <td>
                                <small class="text-muted">${ent.fechaEntrega}</small>
                                <div class="mt-1">${badgeEstado}</div>
                            </td>
                            <td>
                                ${linkArchivo}
                                ${comentarioEstudiante}
                            </td>
                            <td>
                                <select class="form-select form-select-sm" id="periodo-entrega-${ent.idEntrega}">
                                    <option value="1" selected>Periodo 1</option>
                                    <option value="2">Periodo 2</option>
                                    <option value="3">Periodo 3</option>
                                    <option value="4">Periodo 4</option>
                                </select>
                            </td>
                            <td>
                                <div class="input-group input-group-sm">
                                    <input type="number" step="0.1" min="0" max="5" class="form-control form-control-sm text-center fw-bold text-primary" 
                                           id="nota-entrega-${ent.idEntrega}" value="${valorNota}" placeholder="0.0 - 5.0" />
                                </div>
                            </td>
                            <td>
                                <textarea class="form-control form-control-sm" id="retro-entrega-${ent.idEntrega}" rows="2" placeholder="Observaciones o retroalimentación...">${ent.retroalimentacion || ''}</textarea>
                            </td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm btn-success rounded-pill px-3 shadow-sm" onclick="guardarCalificacionEntrega(${ent.idEntrega})">
                                    <i class="bi bi-check-lg me-1"></i>Guardar
                                </button>
                            </td>
                        </tr>
                    `;
                });

                tbody.innerHTML = html;
                const inputBuscar = document.getElementById('inputBuscarEstudianteEntregas');
                if (inputBuscar) inputBuscar.value = '';
                if (typeof filtrarEntregasEstudiante === 'function') filtrarEntregasEstudiante();
            })
            .catch(err => {
                console.error(err);
                tbody.innerHTML = `<tr><td colspan="7" class="text-center py-4 text-danger">Error al cargar entregas.</td></tr>`;
            });
    }

    function guardarCalificacionEntrega(idEntrega) {
        const inputNota = document.getElementById(`nota-entrega-${idEntrega}`);
        const inputRetro = document.getElementById(`retro-entrega-${idEntrega}`);
        const selectPeriodo = document.getElementById(`periodo-entrega-${idEntrega}`);

        const notaVal = inputNota ? inputNota.value.trim() : '';
        const retroVal = inputRetro ? inputRetro.value.trim() : '';
        const periodoVal = selectPeriodo ? selectPeriodo.value : '1';

        if (!notaVal) {
            alert('Por favor ingresa una nota válida entre 0.0 y 5.0');
            return;
        }

        const notaNum = parseFloat(notaVal.replace(',', '.'));
        if (isNaN(notaNum) || notaNum < 0 || notaNum > 5.0) {
            alert('La calificación debe ser un valor numérico entre 0.0 y 5.0');
            return;
        }

        const formData = new FormData();
        formData.append('idEntrega', idEntrega);
        formData.append('nota', notaVal);
        formData.append('retroalimentacion', retroVal);
        formData.append('periodo', periodoVal);

        fetch('@Url.Action("CalificarEntrega", "Docente")', {
            method: 'POST',
            body: formData
        })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    if (typeof Swal !== 'undefined') {
                        Swal.fire({
                            toast: true,
                            position: 'top-end',
                            icon: 'success',
                            title: '¡Calificación registrada y sincronizada en planilla!',
                            showConfirmButton: false,
                            timer: 3000
                        });
                    } else {
                        alert(data.message);
                    }

                    const badge = document.getElementById(`badge-estado-${idEntrega}`);
                    if (badge) {
                        badge.className = 'badge bg-success';
                        badge.textContent = 'Calificado';
                    }

                    cargarActividadesDocente();
                } else {
                    alert('Error: ' + data.message);
                }
            })
            .catch(err => {
                console.error(err);
                alert('Ocurrió un error al guardar la calificación.');
            });
    }

    function eliminarActividadDocente(idActividad) {
        if (!confirm('¿Estás seguro de eliminar esta actividad?')) return;

        const formData = new FormData();
        formData.append('idActividad', idActividad);

        fetch('@Url.Action("EliminarActividad", "Docente")', {
            method: 'POST',
            body: formData
        })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    cargarActividadesDocente();
                } else {
                    alert(data.message);
                }
            })
            .catch(err => {
                console.error(err);
                alert('Error al eliminar actividad.');
            });
    }

    // ===============================================
    // AJAX: ACTIVIDADES Y AULA GOOGLE CLASSROOM (ESTUDIANTE)
    // ===============================================

    let listaActividadesEstudianteGlobal = [];
    let materiaClassroomSeleccionada = null;

    function cargarActividadesEstudiante() {
        fetch('@Url.Action("ObtenerActividades", "Estudiante")')
            .then(res => res.json())
            .then(data => {
                if (!data.success || !data.actividades) {
                    listaActividadesEstudianteGlobal = [];
                    actualizarNovedadesMaterias([]);
                    return;
                }

                listaActividadesEstudianteGlobal = data.actividades;
                actualizarNovedadesMaterias(data.actividades);

                if (materiaClassroomSeleccionada) {
                    renderizarClassroomStream(materiaClassroomSeleccionada);
                }
            })
            .catch(err => {
                console.error('Error al cargar actividades del estudiante:', err);
            });
    }

    function actualizarNovedadesMaterias(actividades) {
        const materiasCount = {};
        actividades.forEach(a => {
            const mat = (a.materia || '').trim();
            if (!materiasCount[mat]) {
                materiasCount[mat] = { pendientes: 0, total: 0 };
            }
            materiasCount[mat].total++;
            if (a.estado === 'Pendiente' || (!a.entregada && !a.vencida)) {
                materiasCount[mat].pendientes++;
            }
        });

        document.querySelectorAll('[id^="badge-novedades-"]').forEach(el => {
            const slug = el.id.replace('badge-novedades-', '');
            let match = Object.keys(materiasCount).find(m => m.replace(/ /g, "_").replace(/á/g,"a").replace(/é/g,"e").replace(/í/g,"i").replace(/ó/g,"o").replace(/ú/g,"u").replace(/ñ/g,"n") === slug);
            if (match) {
                const info = materiasCount[match];
                if (info.pendientes > 0) {
                    el.innerHTML = `<span class="badge bg-warning text-dark border border-warning px-3 py-1 fw-bold"><i class="bi bi-bell-fill me-1"></i>${info.pendientes} Tarea(s) Pendiente(s)</span>`;
                } else {
                    el.innerHTML = `<span class="badge bg-success text-white px-3 py-1"><i class="bi bi-check-circle-fill me-1"></i>Al día (${info.total} Actividades)</span>`;
                }
            } else {
                el.innerHTML = `<span class="badge bg-light text-muted border px-3 py-1"><i class="bi bi-check2 me-1"></i>Sin actividades pendientes</span>`;
            }
        });
    }

    // Entrar a la materia seleccionada estilo Google Classroom
    function entrarAClassroomMateria(materiaNombre) {
        materiaClassroomSeleccionada = materiaNombre;

        const vMat = document.getElementById('vistaMateriasEstudiante');
        const vClass = document.getElementById('vistaClassroomMateria');
        if (vMat) vMat.classList.add('d-none');
        if (vClass) vClass.classList.remove('d-none');

        const elTituloTop = document.getElementById('classroomTituloTop');
        if (elTituloTop) elTituloTop.textContent = materiaNombre;

        const elBanner = document.getElementById('classroomBannerNombreMateria');
        if (elBanner) elBanner.textContent = materiaNombre;

        // Selección de gradiente / banner estilo Google Classroom
        const bannerCard = document.getElementById('classroomBannerPrincipal');
        if (bannerCard) {
            let grad = 'linear-gradient(135deg, #d84315 0%, #f4511e 50%, #fb8c00 100%)'; // Estilo naranja Classroom
            if (materiaNombre.includes('Matemát') || materiaNombre.includes('Físic')) {
                grad = 'linear-gradient(135deg, #0d47a1 0%, #1976d2 50%, #0288d1 100%)';
            } else if (materiaNombre.includes('Natural') || materiaNombre.includes('Biolog')) {
                grad = 'linear-gradient(135deg, #1b5e20 0%, #2e7d32 50%, #43a047 100%)';
            } else if (materiaNombre.includes('Lengua') || materiaNombre.includes('Español')) {
                grad = 'linear-gradient(135deg, #4a148c 0%, #6a1b9a 50%, #8e24aa 100%)';
            } else if (materiaNombre.includes('Social') || materiaNombre.includes('Hist')) {
                grad = 'linear-gradient(135deg, #bf360c 0%, #d84315 50%, #e65100 100%)';
            } else if (materiaNombre.includes('Inglés') || materiaNombre.includes('Tecnolog')) {
                grad = 'linear-gradient(135deg, #004d40 0%, #00695c 50%, #00897b 100%)';
            }
            bannerCard.style.background = grad;
        }

        // Restablecer pestaña activa a Tablón
        const tabBtn = document.getElementById('tabClassroomTablon');
        cambiarTabClassroom('tablon', tabBtn);

        renderizarClassroomStream(materiaNombre);
    }

    // Alias para compatibilidad previa si fuera llamado
    function entrarAMateria(materiaNombre) {
        entrarAClassroomMateria(materiaNombre);
    }

    // Volver a la lista de materias desde el aula Classroom
    function volverAListaMaterias() {
        const vMat = document.getElementById('vistaMateriasEstudiante');
        const vClass = document.getElementById('vistaClassroomMateria');
        if (vClass) vClass.classList.add('d-none');
        if (vMat) vMat.classList.remove('d-none');

        materiaClassroomSeleccionada = null;
        actualizarNovedadesMaterias(listaActividadesEstudianteGlobal);
    }

    // Control de pestañas de Classroom (Tablón, Trabajo de clase, Personas)
    function cambiarTabClassroom(tabName, btn) {
        document.querySelectorAll('.classroom-nav-tab').forEach(b => b.classList.remove('active'));
        if (btn) btn.classList.add('active');

        const secTablon = document.getElementById('seccionClassroomTablon');
        const secPersonas = document.getElementById('seccionClassroomPersonas');

        if (tabName === 'tablon' || tabName === 'trabajo') {
            if (secTablon) secTablon.classList.remove('d-none');
            if (secPersonas) secPersonas.classList.add('d-none');
        } else if (tabName === 'personas') {
            if (secTablon) secTablon.classList.add('d-none');
            if (secPersonas) secPersonas.classList.remove('d-none');
        }
    }

    // Renderiza la lista estilo Classroom para la materia activa
    function renderizarClassroomStream(materiaNombre) {
        const streamContainer = document.getElementById('classroomStreamActividades');
        const proximasContainer = document.getElementById('classroomProximasEntregasContainer');

        if (!streamContainer) return;

        const actividadesMateria = listaActividadesEstudianteGlobal.filter(a => 
            (a.materia || '').toLowerCase().trim() === (materiaNombre || '').toLowerCase().trim()
        );

        // 1. Renderizar "Próximas entregas" en la columna lateral
        if (proximasContainer) {
            const pendientes = actividadesMateria.filter(a => a.estado === 'Pendiente' || (!a.entregada && !a.vencida));
            if (pendientes.length === 0) {
                proximasContainer.innerHTML = `<p class="text-muted small mb-0">¡No tienes entregas pendientes para pronto!</p>`;
            } else {
                let proxHtml = '';
                pendientes.slice(0, 3).forEach(p => {
                    proxHtml += `
                        <div class="mb-2 pb-2 border-bottom">
                            <small class="text-danger d-block fw-bold"><i class="bi bi-clock me-1"></i>Entrega: ${p.fechaLimite}</small>
                            <a href="javascript:void(0)" onclick="abrirModalClassroomEntrega(${p.idActividad})" class="fw-bold text-dark text-decoration-none small">
                                <i class="bi bi-arrow-right-short text-primary"></i>${p.titulo}
                            </a>
                        </div>
                    `;
                });
                proximasContainer.innerHTML = proxHtml;
            }
        }

        // 2. Renderizar Stream de actividades (Estilo foto 2 Google Classroom)
        if (actividadesMateria.length === 0) {
            streamContainer.innerHTML = `
                <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white">
                    <i class="bi bi-journal-check text-muted display-4 mb-3" style="color: #d84315 !important;"></i>
                    <h5 class="fw-bold text-secondary">Aún no hay publicaciones en esta materia</h5>
                    <p class="text-muted small mb-0">Cuando tu docente publique tareas o talleres para ${materiaNombre}, aparecerán aquí como en Google Classroom.</p>
                </div>
            `;
            return;
        }

        let html = '';
        actividadesMateria.forEach(act => {
            let badgeEstado = '';
            if (act.estado === 'Calificado') {
                const nota = act.calificacion !== null ? Number(act.calificacion).toFixed(1) : '5.0';
                badgeEstado = `<span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1 fw-bold"><i class="bi bi-check2-all me-1"></i>Calificado: ${nota}</span>`;
            } else if (act.entregada) {
                badgeEstado = `<span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill px-3 py-1 fw-bold"><i class="bi bi-send-check me-1"></i>Entregado</span>`;
            } else if (act.vencida) {
                badgeEstado = `<span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-1 fw-bold"><i class="bi bi-exclamation-octagon me-1"></i>Sin entregar</span>`;
            } else {
                badgeEstado = `<span class="badge bg-warning-subtle text-dark border border-warning-subtle rounded-pill px-3 py-1 fw-bold"><i class="bi bi-clock me-1"></i>Asignada</span>`;
            }

            html += `
                <div class="card p-3 bg-white rounded-4 shadow-sm mb-3 card-classroom-item" onclick="abrirModalClassroomEntrega(${act.idActividad})">
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle d-flex align-items-center justify-content-center text-white flex-shrink-0" style="width: 44px; height: 44px; background-color: #fbe9e7; color: #d84315;">
                                <i class="bi bi-clipboard-check-fill fs-5"></i>
                            </div>
                            <div>
                                <div class="fw-bold text-dark" style="font-size: 0.96rem;">
                                    Docente ha publicado una nueva tarea: <span class="text-primary">${act.titulo}</span>
                                </div>
                                <div class="text-muted small d-flex flex-wrap align-items-center gap-3 mt-1">
                                    <span><i class="bi bi-calendar-event me-1"></i>Fecha límite: <strong>${act.fechaLimite}</strong></span>
                                    ${act.archivoAdjunto ? '<span class="badge bg-light text-primary border rounded-pill"><i class="bi bi-paperclip me-1"></i>Material adjunto</span>' : ''}
                                </div>
                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-3 ms-auto">
                            ${badgeEstado}
                            <i class="bi bi-three-dots-vertical text-muted fs-5"></i>
                        </div>
                    </div>
                </div>
            `;
        });

        streamContainer.innerHTML = html;
    }

    // Abrir Modal de Actividad estilo Google Classroom Pantalla Completa
    function abrirModalClassroomEntrega(idActividad) {
        const act = listaActividadesEstudianteGlobal.find(a => a.idActividad === idActividad);
        if (!act) return;

        document.getElementById('idActividadEntrega').value = act.idActividad;

        const elTitulo = document.getElementById('entregaTituloActividad');
        if (elTitulo) elTitulo.textContent = act.titulo;

        const elMateria = document.getElementById('entregaMateriaActividad');
        if (elMateria) elMateria.textContent = act.materia;

        const elMateriaBadge = document.getElementById('entregaMateriaBadge');
        if (elMateriaBadge) elMateriaBadge.textContent = act.materia;

        const elBreadcrumb = document.getElementById('classroomDetalleBreadcrumb');
        if (elBreadcrumb) elBreadcrumb.textContent = `${act.materia} > ${act.titulo}`;

        const elFecha = document.getElementById('entregaFechaLimiteActividad');
        if (elFecha) elFecha.textContent = act.fechaLimite;

        const elDesc = document.getElementById('entregaDescripcionActividad');
        if (elDesc) elDesc.textContent = act.descripcion || 'Lee atentamente las pautas de trabajo y envía tu entrega antes de la fecha límite.';

        // Materiales adjuntos por el docente
        const contenedorGuia = document.getElementById('contenedorGuiaDocenteModal');
        const btnGuia = document.getElementById('btnDescargarGuiaDocente');
        const nombreGuia = document.getElementById('nombreArchivoGuiaDocente');
        if (act.archivoAdjunto && contenedorGuia && btnGuia) {
            btnGuia.href = act.archivoAdjunto;
            if (nombreGuia) {
                const nombreLimpio = act.archivoAdjunto.split('/').pop().split('\\').pop() || 'Guía o Taller Adjunto';
                nombreGuia.textContent = nombreLimpio;
            }
            contenedorGuia.classList.remove('d-none');
        } else if (contenedorGuia) {
            contenedorGuia.classList.add('d-none');
        }

        // Calificación y Retroalimentación
        const contenedorRetro = document.getElementById('contenedorRetroalimentacionModal');
        const badgeNota = document.getElementById('badgeNotaCalificacionModal');
        const textoRetro = document.getElementById('textoRetroalimentacionModal');
        if (act.estado === 'Calificado' && contenedorRetro) {
            const notaVal = act.calificacion !== null ? Number(act.calificacion).toFixed(1) : '5.0';
            if (badgeNota) badgeNota.textContent = `${notaVal} / 5.0`;
            if (textoRetro) textoRetro.textContent = act.retroalimentacion || 'Buen trabajo académico entregado.';
            contenedorRetro.classList.remove('d-none');
        } else if (contenedorRetro) {
            contenedorRetro.classList.add('d-none');
        }

        // Estado en "Tu trabajo"
        const badgeEstado = document.getElementById('badgeEstadoEntregaModal');
        const textoBoton = document.getElementById('textoBotonEntregaModal');
        if (badgeEstado) {
            if (act.estado === 'Calificado') {
                badgeEstado.className = 'badge rounded-pill px-3 py-1 fw-bold fs-6 bg-success';
                badgeEstado.textContent = 'Calificada';
                if (textoBoton) textoBoton.textContent = 'Reenviar Trabajo';
            } else if (act.entregada) {
                badgeEstado.className = 'badge rounded-pill px-3 py-1 fw-bold fs-6 bg-info text-dark';
                badgeEstado.textContent = 'Entregada';
                if (textoBoton) textoBoton.textContent = 'Modificar / Volver a Entregar';
            } else if (act.vencida) {
                badgeEstado.className = 'badge rounded-pill px-3 py-1 fw-bold fs-6 bg-danger';
                badgeEstado.textContent = 'Sin entregar';
                if (textoBoton) textoBoton.textContent = 'Entrega Extemporánea';
            } else {
                badgeEstado.className = 'badge rounded-pill px-3 py-1 fw-bold fs-6 bg-primary';
                badgeEstado.textContent = 'Asignada';
                if (textoBoton) textoBoton.textContent = 'Entregar';
            }
        }

        // Previsualizar archivo previamente entregado
        const contenedorArchivoYa = document.getElementById('contenedorArchivoYaEntregado');
        const linkArchivoYa = document.getElementById('linkArchivoYaEntregado');
        if (act.archivoRuta && contenedorArchivoYa && linkArchivoYa) {
            linkArchivoYa.href = act.archivoRuta;
            linkArchivoYa.textContent = act.archivoNombre || 'Archivo entregado';
            contenedorArchivoYa.classList.remove('d-none');
        } else if (contenedorArchivoYa) {
            contenedorArchivoYa.classList.add('d-none');
        }

        // Previsualizar texto previamente entregado
        const contenedorTextoYa = document.getElementById('contenedorTextoYaEntregado');
        const textoYa = document.getElementById('textoYaEntregado');
        if (act.comentario && contenedorTextoYa && textoYa) {
            textoYa.textContent = act.comentario;
            contenedorTextoYa.classList.remove('d-none');
        } else if (contenedorTextoYa) {
            contenedorTextoYa.classList.add('d-none');
        }

        // Limpiar inputs del formulario
        const inputArchivo = document.getElementById('inputArchivoEntrega');
        if (inputArchivo) inputArchivo.value = '';
        const inputComentario = document.getElementById('inputComentarioEntrega');
        if (inputComentario) inputComentario.value = act.comentario || '';

        const modalEl = document.getElementById('modalSubirEntregaActividad');
        const modal = new bootstrap.Modal(modalEl);
        modal.show();
    }

    // Alias para compatibilidad
    function abrirModalSubirEntrega(idActividad, titulo, materia, fechaLimite, descripcion, archivoAdjunto) {
        abrirModalClassroomEntrega(idActividad);
    }

    function validarTamanoArchivoEntrega(input) {
        if (input.files && input.files[0]) {
            const file = input.files[0];
            const maxBytes = 5 * 1024 * 1024; // 5 MB
            if (file.size > maxBytes) {
                alert('El archivo seleccionado (' + (file.size / (1024 * 1024)).toFixed(2) + ' MB) supera el límite máximo permitido de 5 MB.');
                input.value = '';
            }
        }
    }

    function guardarEntregaEstudiante(event) {
        event.preventDefault();
        const form = document.getElementById('formSubirEntregaActividad');
        const btn = document.getElementById('btnEnviarEntrega');
        const inputArchivo = document.getElementById('inputArchivoEntrega');

        if (inputArchivo && inputArchivo.files && inputArchivo.files[0]) {
            const maxBytes = 5 * 1024 * 1024; // 5 MB
            if (inputArchivo.files[0].size > maxBytes) {
                alert('El archivo seleccionado supera los 5 MB permitidos.');
                return;
            }
        }

        const formData = new FormData(form);

        if (btn) {
            btn.disabled = true;
            btn.innerHTML = `<span class="spinner-border spinner-border-sm me-1"></span> Enviando...`;
        }

        fetch('@Url.Action("SubirEntregaActividad", "Estudiante")', {
            method: 'POST',
            body: formData
        })
            .then(res => res.json())
            .then(data => {
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = `<i class="bi bi-send-fill me-1"></i> Guardar Entrega`;
                }

                if (data.success) {
                    if (typeof Swal !== 'undefined') {
                        Swal.fire({
                            icon: 'success',
                            title: '¡Entrega Enviada!',
                            text: data.message,
                            timer: 2500,
                            showConfirmButton: false
                        });
                    } else {
                        alert(data.message);
                    }

                    const modalEl = document.getElementById('modalSubirEntregaActividad');
                    const modal = bootstrap.Modal.getInstance(modalEl);
                    if (modal) modal.hide();

                    cargarActividadesEstudiante();
                } else {
                    if (typeof Swal !== 'undefined') {
                        Swal.fire({ icon: 'error', title: 'Atención', text: data.message });
                    } else {
                        alert('Error: ' + data.message);
                    }
                }
            })
            .catch(err => {
                console.error(err);
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = `<i class="bi bi-send-fill me-1"></i> Guardar Entrega`;
                }
                alert('Ocurrió un error al subir tu entrega.');
            });
    }

    function enviarComentarioPrivadoFicticio() {
        const input = document.getElementById('inputComentarioPrivadoFicticio');
        if (!input || !input.value.trim()) return;
        if (typeof Swal !== 'undefined') {
            Swal.fire({
                icon: 'success',
                title: 'Comentario Privado Enviado',
                text: 'Tu mensaje fue transmitido de forma privada a tu profesor.',
                timer: 2000,
                showConfirmButton: false
            });
        } else {
            alert('Comentario enviado al profesor.');
        }
        input.value = '';
    }

