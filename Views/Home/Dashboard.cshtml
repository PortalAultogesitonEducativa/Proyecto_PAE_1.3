        window.filtrarOpcionesCursosObservador = function() {
            const selectCurso = document.getElementById('selectCursoObservador');
            const selectJornada = document.getElementById('selectJornadaObservador');
            const selectGradoNivel = document.getElementById('selectGradoNivelObservador');
            if (!selectCurso) return;

            const j = selectJornada ? selectJornada.value : 'todos';
            const g = selectGradoNivel ? selectGradoNivel.value : 'todos';
            const esM = j.toLowerCase().includes('mañana') || j.toLowerCase().includes('manana') || j.toLowerCase().startsWith('m');
            const esT = j.toLowerCase().includes('tarde') || j.toLowerCase().startsWith('t');

            Array.from(selectCurso.options).forEach((opt, idx) => {
                if (idx === 0) return;
                const txt = opt.text.trim();
                let mostrar = true;

                if (j !== 'todos') {
                    if (esM && !(txt.endsWith('M') || txt.includes(' M') || txt.toLowerCase().includes('m'))) mostrar = false;
                    if (esT && !(txt.endsWith('T') || txt.includes(' T') || txt.toLowerCase().includes('t'))) mostrar = false;
                }

                if (g !== 'todos') {
                    const digits = txt.replace(/\D/g, '');
                    if (!digits.startsWith(g)) mostrar = false;
                }

                opt.hidden = !mostrar;
                opt.disabled = !mostrar;
                opt.style.display = mostrar ? '' : 'none';
            });
        };

        window.filtrarEstudiantesObservador = function() {
            const inputBuscar = document.getElementById('inputBuscarEstudianteObservador');
            const selectGradoNivel = document.getElementById('selectGradoNivelObservador');
            const selectCurso = document.getElementById('selectCursoObservador');
            const selectJornada = document.getElementById('selectJornadaObservador');
            const selectEst = document.getElementById('selectEstudianteObservacion');
            if (!selectEst) return;

            const term = (inputBuscar ? inputBuscar.value : '').toLowerCase().trim();
            const gradoNivel = (selectGradoNivel ? selectGradoNivel.value : 'todos').trim();
            const curso = selectCurso ? selectCurso.value.trim().toLowerCase() : 'todos';
            const jornada = selectJornada ? selectJornada.value.trim().toLowerCase() : 'todos';

            Array.from(selectEst.options).forEach((opt, idx) => {
                if (idx === 0) return;
                const textoEst = opt.text.toLowerCase();
                const cursoEst = (opt.getAttribute('data-curso') || '').trim().toLowerCase();

                let matchBusqueda = (term === '' || textoEst.includes(term));
                let matchCurso = (curso === 'todos' || cursoEst === curso || cursoEst.includes(curso));
                let matchJornada = true;
                if (jornada === 'mañana' || jornada === 'manana' || jornada === 'm') {
                    matchJornada = cursoEst.endsWith('m') || cursoEst.includes(' m') || cursoEst.includes('m') || cursoEst === '';
                } else if (jornada === 'tarde' || jornada === 't') {
                    matchJornada = cursoEst.endsWith('t') || cursoEst.includes(' t') || cursoEst.includes('t') || cursoEst === '';
                }

                let matchGrado = true;
                if (gradoNivel !== 'todos') {
                    const digits = cursoEst.replace(/\D/g, '');
                    if (!digits.startsWith(gradoNivel)) matchGrado = false;
                }

                const visible = matchBusqueda && matchCurso && matchJornada && matchGrado;
                opt.hidden = !visible;
                opt.disabled = !visible;
                opt.style.display = visible ? '' : 'none';
            });

            if (selectEst.selectedOptions.length === 0 || selectEst.selectedOptions[0].hidden) {
                const primerVisible = Array.from(selectEst.options).find((opt, idx) => idx > 0 && !opt.hidden && !opt.disabled);
                selectEst.value = primerVisible ? primerVisible.value : "";
            }
