    let listaActividadesEstudianteGlobal = [];

    function cargarActividadesEstudiante() {
        const contenedor = document.getElementById('contenedorActividadesEstudiante');
        if (!contenedor) return;

        contenedor.innerHTML = `
            <div class="col-12 text-center py-5">
                <div class="spinner-border" style="color: #6f42c1;" role="status"></div>
                <p class="text-muted small mt-2">Cargando tus actividades académicas...</p>
            </div>
        `;

        fetch('@Url.Action("ObtenerActividades", "Estudiante")')
            .then(res => res.json())
            .then(data => {
                if (!data.success || !data.actividades || data.actividades.length === 0) {
                    contenedor.innerHTML = `
                        <div class="col-12">
                            <div class="card border-0 shadow-sm p-5 text-center rounded-4 bg-white">
                                <i class="bi bi-journal-check text-muted display-4 mb-3" style="color: #6f42c1 !important;"></i>
                                <h5 class="fw-bold text-secondary">¡Todo al día! No tienes actividades pendientes</h5>
                                <p class="text-muted small mb-0">Cuando tus docentes publiquen tareas o talleres académicos, aparecerán aquí.</p>
                            </div>
                        </div>
                    `;
                    listaActividadesEstudianteGlobal = [];
                    return;
                }

                listaActividadesEstudianteGlobal = data.actividades;
                renderizarActividadesEstudiante(listaActividadesEstudianteGlobal);
            })
            .catch(err => {
                console.error(err);
                contenedor.innerHTML = `<div class="col-12 text-center text-danger py-4">Error al cargar las actividades.</div>`;
            });
    }

    function renderizarActividadesEstudiante(actividades) {
        const contenedor = document.getElementById('contenedorActividadesEstudiante');
        if (!contenedor) return;

        if (actividades.length === 0) {
            contenedor.innerHTML = `
                <div class="col-12">
                    <div class="card border-0 shadow-sm p-4 text-center rounded-4 bg-white">
                        <p class="text-muted small mb-0">No se encontraron actividades con el filtro seleccionado.</p>
                    </div>
                </div>
            `;
            return;
        }

        let html = '';
        actividades.forEach(act => {
            let badgeEstado = '';
            let accionBoton = '';
            let bloqueCalificacion = '';

            if (act.estado === 'Calificado') {
                const notaFormateada = act.calificacion !== null ? Number(act.calificacion).toFixed(1) : '5.0';
                const colorNota = Number(notaFormateada) >= 3.0 ? 'bg-success' : 'bg-danger';

                badgeEstado = `<span class="badge bg-success rounded-pill px-3 py-1"><i class="bi bi-check2-all me-1"></i>Calificado</span>`;
                bloqueCalificacion = `
                    <div class="p-3 rounded-3 mb-3 bg-light border-start border-4 border-success">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="small fw-bold text-success"><i class="bi bi-award-fill me-1"></i>Nota Obtenida:</span>
                            <span class="badge ${colorNota} fs-6 px-3 py-1">${notaFormateada} / 5.0</span>
                        </div>
                        ${act.retroalimentacion ? `<p class="small text-muted mb-0 mt-1"><strong>Comentario del docente:</strong> "${act.retroalimentacion}"</p>` : ''}
                    </div>
                `;
                accionBoton = `
                    <button class="btn btn-outline-secondary btn-sm rounded-pill px-3" onclick="abrirModalSubirEntrega(${act.idActividad}, '${escapeJsString(act.titulo)}', '${escapeJsString(act.materia)}', '${act.fechaLimite}')">
                        <i class="bi bi-arrow-repeat me-1"></i> Actualizar Entrega
                    </button>
                `;
            } else if (act.entregada) {
                badgeEstado = `<span class="badge bg-info text-dark rounded-pill px-3 py-1"><i class="bi bi-send-check me-1"></i>Entregado</span>`;
                bloqueCalificacion = `
                    <div class="p-2 rounded-3 mb-3 bg-light border small text-muted">
                        <i class="bi bi-info-circle me-1 text-primary"></i>Entregado el <strong>${act.fechaEntrega || 'recientemente'}</strong>. En espera de revisión por el docente.
                    </div>
                `;
                accionBoton = `
                    <button class="btn btn-outline-primary btn-sm rounded-pill px-3" onclick="abrirModalSubirEntrega(${act.idActividad}, '${escapeJsString(act.titulo)}', '${escapeJsString(act.materia)}', '${act.fechaLimite}')">
                        <i class="bi bi-pencil-square me-1"></i> Reenviar / Modificar
                    </button>
                `;
            } else if (act.vencida) {
                badgeEstado = `<span class="badge bg-danger rounded-pill px-3 py-1"><i class="bi bi-exclamation-octagon me-1"></i>Vencido</span>`;
                accionBoton = `
                    <button class="btn btn-outline-danger btn-sm rounded-pill px-3" onclick="abrirModalSubirEntrega(${act.idActividad}, '${escapeJsString(act.titulo)}', '${escapeJsString(act.materia)}', '${act.fechaLimite}')">
                        <i class="bi bi-cloud-arrow-up me-1"></i> Entrega Extemporánea
                    </button>
                `;
            } else {
                badgeEstado = `<span class="badge bg-warning text-dark rounded-pill px-3 py-1"><i class="bi bi-clock me-1"></i>Pendiente</span>`;
                accionBoton = `
                    <button class="btn text-white btn-sm rounded-pill px-4 shadow-sm" style="background-color: #6f42c1;" onclick="abrirModalSubirEntrega(${act.idActividad}, '${escapeJsString(act.titulo)}', '${escapeJsString(act.materia)}', '${act.fechaLimite}')">
                        <i class="bi bi-cloud-arrow-up me-1"></i> Entregar Actividad
                    </button>
                `;
            }

            const linkGuiaDocente = act.archivoAdjunto 
                ? `<a href="${act.archivoAdjunto}" target="_blank" class="btn btn-sm btn-outline-primary rounded-pill px-2 py-1" style="font-size: 0.8rem;">
                       <i class="bi bi-file-earmark-arrow-down me-1"></i>Descargar Guía / Taller
                   </a>` 
                : '';

            const linkArchivoSubido = act.archivoRuta 
                ? `<div class="mt-2 small text-muted">
                       <i class="bi bi-paperclip me-1 text-primary"></i>Tu archivo entregado: 
                       <a href="${act.archivoRuta}" target="_blank" class="text-primary text-decoration-underline">${act.archivoNombre || 'Ver Archivo'}</a>
                   </div>` 
                : '';

            html += `
                <div class="col-lg-6 mb-3">
                    <div class="card border-0 shadow-sm rounded-4 h-100 p-3 bg-white" style="border-top: 4px solid #6f42c1 !important;">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="badge text-white rounded-pill px-3 py-1" style="background-color: #6f42c1;">${act.materia}</span>
                            ${badgeEstado}
                        </div>

                        <h5 class="fw-bold text-dark mb-1">${act.titulo}</h5>
                        
                        <p class="small text-muted mb-2" style="white-space: pre-line;">
                            ${act.descripcion || 'Sin descripción detallada.'}
                        </p>

                        <div class="d-flex justify-content-between align-items-center small text-muted p-2 bg-light rounded-3 mb-3">
                            <span><i class="bi bi-calendar-event me-1 text-danger"></i>Fecha Límite: <strong>${act.fechaLimite}</strong></span>
                            ${linkGuiaDocente}
                        </div>

                        ${bloqueCalificacion}
                        ${linkArchivoSubido}

                        <div class="d-flex justify-content-end align-items-center pt-2 border-top mt-auto">
                            ${accionBoton}
                        </div>
                    </div>
                </div>
            `;
        });

        contenedor.innerHTML = html;
    }

    let materiaFiltroActividadActual = 'todas';
    let estadoFiltroActividadActual = 'todas';

    function validarTamanoArchivoEntrega(input) {
        if (input.files && input.files[0]) {
            const file = input.files[0];
            const maxBytes = 5 * 1024 * 1024; // 5 MB
            if (file.size > maxBytes) {
                alert('El archivo seleccionado (' + (file.size / (1024 * 1024)).toFixed(2) + ' MB) supera el límite máximo permitido de 5 MB.');
                input.value = '';
            }
        }
    }

    function filtrarActividadesPorMateria(materia, btn) {
        materiaFiltroActividadActual = materia;
        document.querySelectorAll('.filtro-materia-btn').forEach(b => {
            b.classList.remove('active');
            b.classList.remove('btn-outline-purple');
            b.classList.add('btn-outline-secondary');
            b.style.color = '';
            b.style.backgroundColor = '';
            b.style.borderColor = '#dee2e6';
        });
        if (btn) {
            btn.classList.add('active');
            btn.classList.remove('btn-outline-secondary');
            btn.style.borderColor = '#6f42c1';
            btn.style.backgroundColor = '#6f42c1';
            btn.style.color = '#fff';
        }
        aplicarFiltrosActividadesEstudiante();
    }

    function filtrarActividadesEstudiante(estado, btn) {
        estadoFiltroActividadActual = estado;
        document.querySelectorAll('.filtro-act-btn').forEach(b => {
            b.classList.remove('active');
            b.classList.remove('btn-primary');
            b.classList.remove('btn-warning');
            b.classList.remove('btn-info');
            b.classList.remove('btn-success');
        });

        if (btn) btn.classList.add('active');
        aplicarFiltrosActividadesEstudiante();
    }

    function aplicarFiltrosActividadesEstudiante() {
        let filtradas = listaActividadesEstudianteGlobal;
        if (materiaFiltroActividadActual !== 'todas') {
            filtradas = filtradas.filter(a => (a.materia || '').toLowerCase().trim() === materiaFiltroActividadActual.toLowerCase().trim());
        }
        if (estadoFiltroActividadActual !== 'todas') {
            filtradas = filtradas.filter(a => a.estado === estadoFiltroActividadActual || (estadoFiltroActividadActual === 'Entregado' && a.entregada && a.estado !== 'Calificado'));
        }
        renderizarActividadesEstudiante(filtradas);
    }

    function escapeJsString(str) {
        if (!str) return '';
        return str.replace(/'/g, "\\'").replace(/"/g, '&quot;');
    }

    function abrirModalSubirEntrega(idActividad, titulo, materia, fechaLimite) {
        document.getElementById('idActividadEntrega').value = idActividad;
        document.getElementById('entregaTituloActividad').textContent = titulo;
        document.getElementById('entregaMateriaActividad').textContent = materia;
        document.getElementById('entregaFechaLimiteActividad').textContent = fechaLimite;

        document.getElementById('inputArchivoEntrega').value = '';
        document.getElementById('inputComentarioEntrega').value = '';

        const modalEl = document.getElementById('modalSubirEntregaActividad');
        const modal = new bootstrap.Modal(modalEl);
        modal.show();
    }

    function guardarEntregaEstudiante(event) {
        event.preventDefault();
        const form = document.getElementById('formSubirEntregaActividad');
        const btn = document.getElementById('btnEnviarEntrega');
        const inputArchivo = document.getElementById('inputArchivoEntrega');

        if (inputArchivo && inputArchivo.files && inputArchivo.files[0]) {
            const maxBytes = 5 * 1024 * 1024; // 5 MB
            if (inputArchivo.files[0].size > maxBytes) {
                alert('El archivo seleccionado supera los 5 MB permitidos.');
                return;
            }
        }

        const formData = new FormData(form);

        if (btn) {
            btn.disabled = true;
            btn.innerHTML = `<span class="spinner-border spinner-border-sm me-1"></span> Enviando...`;
        }

        fetch('@Url.Action("SubirEntregaActividad", "Estudiante")', {
            method: 'POST',
            body: formData
        })
            .then(res => res.json())
            .then(data => {
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = `<i class="bi bi-send me-1"></i> Guardar y Enviar Entrega`;
                }

                if (data.success) {
                    if (typeof Swal !== 'undefined') {
                        Swal.fire({
                            icon: 'success',
                            title: '¡Entrega Enviada!',
                            text: data.message,
                            timer: 2500,
                            showConfirmButton: false
                        });
                    } else {
                        alert(data.message);
                    }

                    const modalEl = document.getElementById('modalSubirEntregaActividad');
                    const modal = bootstrap.Modal.getInstance(modalEl);
                    if (modal) modal.hide();

                    cargarActividadesEstudiante();
                } else {
                    if (typeof Swal !== 'undefined') {
                        Swal.fire({ icon: 'error', title: 'Atención', text: data.message });
                    } else {
                        alert('Error: ' + data.message);
                    }
                }
            })
            .catch(err => {
                console.error(err);
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = `<i class="bi bi-send me-1"></i> Guardar y Enviar Entrega`;
                }
                alert('Ocurrió un error al subir tu entrega.');
            });
    }

