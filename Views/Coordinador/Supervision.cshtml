@model ProyectoPAE.Models.SupervisionDocentesViewModel
@using ProyectoPAE.Models
@{
    ViewData["Title"] = "Supervisión Docente y Coordinación Académica";
}

<div class="container-fluid py-3 px-md-4">
    <div class="panel-con-sidebar">
        @await Html.PartialAsync("_SidebarAdmin")
        <main class="submodulo-activo flex-grow-1" role="main" aria-label="Supervisión docente y coordinación académica">
            <div class="card border-0 shadow-sm p-3 p-md-4 bg-white rounded-4">
                <!-- 1. ENCABEZADO DE COORDINACIÓN -->
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3 pb-3 border-bottom">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="badge bg-warning text-dark px-3 py-1 rounded-pill fw-bold">COORDINACIÓN ACADÉMICA</span>
                            <span class="badge bg-primary text-white px-3 py-1 rounded-pill">Periodo Activo: P@(Model.PeriodoActivo)</span>
                            @if (Model.AnioEscolar.HasValue)
                            {
                                <span class="badge bg-light text-secondary border rounded-pill">Año Escolar: @Model.AnioEscolar</span>
                            }
                        </div>
                        <h2 class="mb-0 fw-bold" style="color: #0d2a4a;">
                            <i class="bi bi-clipboard-data-fill me-2" style="color: #e67e22;"></i>Supervisión Docente
                        </h2>
                        <small class="text-muted">Coordina y programa las fechas de apertura y cierre para el registro de calificaciones, supervisa la carga académica, cobertura institucional y seguimiento pedagógico.</small>
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        <a href="@Url.Action("Seguimiento", "Coordinador")" class="btn btn-outline-primary btn-sm rounded-pill px-3 shadow-sm fw-semibold">
                            <i class="bi bi-people-fill me-1"></i> Seguimiento Estudiantil
                        </a>
                        <a href="@Url.Action("ReporteGrupal", "Docente")" class="btn btn-outline-warning btn-sm rounded-pill px-3 shadow-sm text-dark fw-semibold">
                            <i class="bi bi-bar-chart-line-fill me-1 text-warning"></i> Reporte Grupal
                        </a>
                        <a href="@Url.Action("ExportarSupervision", "Coordinador")" class="btn btn-outline-success btn-sm rounded-pill px-3 shadow-sm fw-semibold" title="Descargar reporte general en formato Excel CSV">
                            <i class="bi bi-file-earmark-excel-fill me-1"></i> Exportar a Excel
                        </a>
                        <a href="@Url.Action("AsignacionAcademica", "Horario")" class="btn btn-outline-secondary btn-sm rounded-pill px-3 shadow-sm">
                            <i class="bi bi-diagram-3-fill me-1"></i> Asignación Académica
                        </a>
                        <a href="@Url.Action("Dashboard", "Home")" class="btn btn-pae-volver">
                            Volver al Panel
                        </a>
                    </div>
                </div>

                <!-- 2. COORDINACIÓN Y CONTROL DE PERIODOS DE SUBIDA DE NOTAS -->
                <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 text-white" style="background: linear-gradient(135deg, #0d2a4a 0%, #1e4b75 100%);">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3">
                        <div>
                            <h4 class="fw-bold mb-1"><i class="bi bi-calendar2-range-fill text-warning me-2"></i>Cronograma y Apertura de Subida de Calificaciones</h4>
                            <p class="small mb-0 text-white-50">Habilita o cierra el ingreso de calificaciones en las planillas docentes por periodo, y define los plazos límites oficiales.</p>
                        </div>
                        <button type="button" class="btn btn-warning text-dark btn-sm rounded-pill px-3 fw-bold shadow-sm" onclick="notificarDocentesRecordatorio(@Model.PeriodoActivo)">
                            <i class="bi bi-bell-fill me-1"></i> Enviar Recordatorio a Docentes (P@(Model.PeriodoActivo))
                        </button>
                    </div>

                    <!-- Cuadrícula de los 4 Periodos -->
                    <div class="row g-3">
                        @if (Model.Periodos != null && Model.Periodos.Any())
                        {
                            foreach (var p in Model.Periodos)
                            {
                                bool esElActivo = (p.Periodo == Model.PeriodoActivo);
                                <div class="col-lg-3 col-md-6">
                                    <div class="card border-0 rounded-3 p-3 h-100 shadow-sm" style="background: rgba(255, 255, 255, 0.95); color: #0d2a4a; border-top: 4px solid @(p.Activo ? "#27ae60" : "#95a5a6") !important;">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <span class="badge @(p.Activo ? "bg-success" : "bg-secondary") rounded-pill px-2.5 py-1 small">
                                                <i class="bi @(p.Activo ? "bi-unlock-fill" : "bi-lock-fill") me-1"></i>
                                                @(p.Activo ? "Subida Abierta" : "Subida Cerrada")
                                            </span>
                                            <span class="badge bg-light text-dark border rounded-pill">@p.Porcentaje%</span>
                                        </div>
                                        <h5 class="fw-bold mb-1 text-dark">Periodo @p.Periodo</h5>
                                        <small class="text-muted d-block mb-2">@p.Nombre</small>

                                        <div class="bg-light p-2 rounded-2 mb-3 small" style="font-size: 0.8rem;">
                                            <div class="d-flex justify-content-between text-muted mb-1">
                                                <span>Apertura:</span>
                                                <strong class="text-dark">@p.FechaInicio.ToString("dd/MM/yyyy")</strong>
                                            </div>
                                            <div class="d-flex justify-content-between text-muted mb-1">
                                                <span>Cierre:</span>
                                                <strong class="text-dark">@p.FechaCierre.ToString("dd/MM/yyyy")</strong>
                                            </div>
                                            @if (p.Activo)
                                            {
                                                <div class="d-flex justify-content-between text-muted">
                                                    <span>Plazo restante:</span>
                                                    <span class="badge bg-warning-subtle text-dark border">@p.DiasRestantes días</span>
                                                </div>
                                            }
                                        </div>

                                        <div class="d-flex gap-1 mt-auto">
                                            <button type="button" 
                                                    class="btn btn-sm w-100 rounded-pill @(p.Activo ? "btn-outline-danger" : "btn-success")" 
                                                    style="font-size: 0.78rem;"
                                                    onclick="cambiarEstadoPeriodoSubida(@p.Periodo, @((!p.Activo).ToString().ToLower()))">
                                                <i class="bi @(p.Activo ? "bi-lock" : "bi-unlock") me-1"></i>
                                                @(p.Activo ? "Cerrar Subida" : "Habilitar Subida")
                                            </button>
                                            <button type="button" 
                                                    class="btn btn-sm btn-outline-secondary rounded-pill px-2" 
                                                    title="Modificar fechas de inicio y cierre"
                                                    onclick="abrirModalEditarFechasPeriodo(@p.Periodo, '@p.Nombre', '@p.FechaInicio.ToString("yyyy-MM-dd")', '@p.FechaCierre.ToString("yyyy-MM-dd")', @p.Porcentaje, '@(p.Observaciones ?? "")')">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>

                <!-- 3. TARJETAS DE MÉTRICAS GENERALES -->
                <div class="row g-3 mb-3">
                    <div class="col-6 col-md-3">
                        <div class="card border-0 shadow-sm h-100 text-center p-3 rounded-3" style="border-top: 4px solid #0d6efd !important;">
                            <div class="fs-3 fw-bold text-dark">@Model.Docentes.Count</div>
                            <div class="small text-muted">Docentes Activos</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="card border-0 shadow-sm h-100 text-center p-3 rounded-3" style="border-top: 4px solid #27ae60 !important;">
                            <div class="fs-3 fw-bold text-success">@Model.DocentesConNotasAlDia</div>
                            <div class="small text-muted">Docentes al Día (Notas P@(Model.PeriodoActivo))</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="card border-0 shadow-sm h-100 text-center p-3 rounded-3" style="border-top: 4px solid #f39c12 !important;">
                            <div class="fs-3 fw-bold text-warning">@Model.DocentesConNotasPendientes</div>
                            <div class="small text-muted">Docentes Pendientes (P@(Model.PeriodoActivo))</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="card border-0 shadow-sm h-100 text-center p-3 rounded-3" style="border-top: 4px solid #dc3545 !important;">
                            <div class="fs-3 fw-bold text-danger">@Model.TotalEntregasSinCalificar</div>
                            <div class="small text-muted">Entregas sin Calificar</div>
                        </div>
                    </div>
                </div>

                <!-- 3.1 TARJETAS DE COBERTURA Y ALERTAS INSTITUCIONALES -->
                <div class="row g-3 mb-4">
                    <div class="col-6 col-md-3">
                        <div class="card border-0 shadow-sm h-100 text-center p-3 rounded-3" style="border-top: 4px solid @(Model.DocentesConAlerta > 0 ? "#f39c12" : "#27ae60") !important;">
                            <div class="fs-3 fw-bold @(Model.DocentesConAlerta > 0 ? "text-warning" : "text-success")">@Model.DocentesConAlerta</div>
                            <div class="small text-muted">Docentes con Alertas</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="card border-0 shadow-sm h-100 text-center p-3 rounded-3" style="border-top: 4px solid @(Model.MateriasSinDocente.Count > 0 ? "#dc3545" : "#27ae60") !important;">
                            <div class="fs-3 fw-bold @(Model.MateriasSinDocente.Count > 0 ? "text-danger" : "text-success")">@Model.MateriasSinDocente.Count</div>
                            <div class="small text-muted">Materias sin Docente</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="card border-0 shadow-sm h-100 text-center p-3 rounded-3" style="border-top: 4px solid @(Model.Choques.Count > 0 ? "#dc3545" : "#27ae60") !important;">
                            <div class="fs-3 fw-bold @(Model.Choques.Count > 0 ? "text-danger" : "text-success")">@Model.Choques.Count</div>
                            <div class="small text-muted">Choques de Horario</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="card border-0 shadow-sm h-100 text-center p-3 rounded-3" style="border-top: 4px solid #6f42c1 !important;">
                            <div class="fs-3 fw-bold text-purple" style="color: #6f42c1;">@Model.TotalClases</div>
                            <div class="small text-muted">Clases Asignadas</div>
                        </div>
                    </div>
                </div>

                <!-- 4. TABLA DE SUPERVISIÓN DOCENTE -->
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3">
                            <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-people-fill text-primary me-2"></i>Monitoreo de Carga, Actividades y Calificaciones por Docente</h5>
                            <div class="d-flex flex-wrap align-items-center gap-3">
                                <div class="form-check mb-0">
                                    <input class="form-check-input" type="checkbox" id="soloAlertas" />
                                    <label class="form-check-label small fw-semibold" for="soloAlertas">Mostrar solo con alertas</label>
                                </div>
                                <div class="input-group" style="max-width: 320px;">
                                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                                    <input type="text" id="buscarDocente" class="form-control bg-light border-start-0" placeholder="Buscar por docente, materia o curso..." />
                                </div>
                            </div>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Docente</th>
                                        <th class="text-center">Clases</th>
                                        <th>Materias</th>
                                        <th>Cursos</th>
                                        <th class="text-center">Notas Periodo @Model.PeriodoActivo</th>
                                        <th class="text-center">Actividades</th>
                                        <th class="text-center">Sin calificar</th>
                                        <th class="text-center">Planes de mejora</th>
                                        <th>Estado General</th>
                                        <th class="text-center">Acción</th>
                                    </tr>
                                </thead>
                                <tbody id="tbodyDocentes">
                                    @if (Model.Docentes.Any())
                                    {
                                        foreach (var d in Model.Docentes)
                                        {
                                            string claseEstado = d.EstadoClase;
                                            string badgeEstado = "bg-" + claseEstado + (claseEstado == "warning" ? " text-dark" : " text-white");

                                            <tr class="fila-docente" data-alerta="@d.NivelAlerta">
                                                <td>
                                                    <a href="@Url.Action("DetalleDocente", "Coordinador", new { id = d.IdUsuario })" class="fw-semibold text-primary text-decoration-none">
                                                        @d.Nombre
                                                    </a>
                                                    <div class="small text-muted">@d.Correo</div>
                                                </td>
                                                <td class="text-center">
                                                    <div class="fw-bold">@d.Clases</div>
                                                    @if (d.Clases > 0)
                                                    {
                                                        <div class="small text-muted">@d.HorasSemanales.ToString("0.#") h/sem</div>
                                                    }
                                                    @if (d.ChoquesHorario > 0)
                                                    {
                                                        <span class="badge bg-danger mt-1" title="Clases del docente que se cruzan en día y hora">@d.ChoquesHorario choque(s)</span>
                                                    }
                                                </td>
                                                <td>
                                                    @if (d.Materias.Any())
                                                    {
                                                        foreach (var materia in d.Materias)
                                                        {
                                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle me-1 mb-1">@materia</span>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted small">—</span>
                                                    }
                                                </td>
                                                <td>
                                                    @if (d.Cursos.Any())
                                                    {
                                                        @string.Join(", ", d.Cursos)
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted small">—</span>
                                                    }
                                                </td>
                                                <td class="text-center">
                                                    @if (d.Clases == 0)
                                                    {
                                                        <span class="badge bg-light text-muted border">Sin clases</span>
                                                    }
                                                    else if (d.TieneNotasRegistradas)
                                                    {
                                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1" title="Notas registradas en el periodo @Model.PeriodoActivo">
                                                            <i class="bi bi-check-circle-fill me-1"></i> @d.NotasRegistradasPeriodoActivo notas
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-warning-subtle text-dark border border-warning px-2 py-1" title="Sin registros de notas en el periodo @Model.PeriodoActivo">
                                                            <i class="bi bi-clock-history me-1"></i> Pendiente
                                                        </span>
                                                    }
                                                </td>
                                                <td class="text-center">
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle" title="Vigentes">@d.ActividadesVigentes vigentes</span>
                                                    @if (d.ActividadesVencidas > 0)
                                                    {
                                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle" title="Con fecha límite vencida">@d.ActividadesVencidas vencidas</span>
                                                    }
                                                    <div class="small text-muted mt-1">
                                                        @(d.UltimaActividad.HasValue ? d.UltimaActividad.Value.ToString("dd/MM/yyyy") : "Sin actividades")
                                                    </div>
                                                </td>
                                                <td class="text-center">
                                                    @if (d.EntregasSinCalificar > 0)
                                                    {
                                                        <span class="badge bg-danger">@d.EntregasSinCalificar</span>
                                                        @if (d.EntregasSinCalificarAtrasadas > 0)
                                                        {
                                                            <div class="small text-danger mt-1 fw-bold">@d.EntregasSinCalificarAtrasadas con más de @SupervisionDocentesViewModel.DiasEntregaAtrasada días</div>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">0</span>
                                                    }
                                                </td>
                                                <td class="text-center">
                                                    @if (d.PlanesMejoraActivos == 0)
                                                    {
                                                        <span class="text-muted small">Sin planes</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle" title="Planes de mejora registrados">@d.PlanesMejoraActivos reg.</span>
                                                        @if (d.PlanesMejoraVencidos > 0)
                                                        {
                                                            <div class="small text-danger fw-bold mt-1">@d.PlanesMejoraVencidos vencidos</div>
                                                        }
                                                    }
                                                </td>
                                                <td>
                                                    <span class="badge @badgeEstado">@d.EstadoTexto</span>
                                                </td>
                                                <td class="text-center">
                                                    <a href="@Url.Action("DetalleDocente", "Coordinador", new { id = d.IdUsuario })" class="btn btn-sm btn-outline-primary rounded-pill px-2" title="Ver detalle integral del docente">
                                                        <i class="bi bi-eye"></i> Detalle
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="10" class="text-center text-muted py-4">No hay docentes activos registrados en la institución.</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- 5. COBERTURA ACADÉMICA Y CONTROL DE CRUCES -->
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-3 text-dark"><i class="bi bi-diagram-3-fill me-2 text-secondary"></i>Cobertura Institucional y Choques de Horarios</h5>

                        <div class="row g-4">
                            <div class="col-lg-6">
                                <h6 class="fw-semibold text-dark"><i class="bi bi-exclamation-triangle-fill text-warning me-1"></i> Materias del plan sin docente asignado</h6>
                                @if (Model.MateriasSinDocente.Any())
                                {
                                    <div class="table-responsive border rounded-3 mb-2" style="max-height: 280px; overflow-y: auto;">
                                        <table class="table table-sm table-hover align-middle mb-0">
                                            <thead class="table-light">
                                                <tr><th>Curso</th><th>Materia</th></tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var m in Model.MateriasSinDocente)
                                                {
                                                    <tr>
                                                        <td class="fw-semibold">@m.Curso</td>
                                                        <td>@m.Materia</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                    <a href="@Url.Action("AsignacionAcademica", "Horario")" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                                        <i class="bi bi-diagram-3-fill me-1"></i> Resolver en Asignación Académica
                                    </a>
                                }
                                else
                                {
                                    <div class="alert alert-success small mb-0 rounded-3">
                                        <i class="bi bi-check-circle-fill me-1"></i> Todas las materias del plan de estudios de cada curso tienen un horario con docente asignado.
                                    </div>
                                }
                            </div>

                            <div class="col-lg-6">
                                <h6 class="fw-semibold text-dark"><i class="bi bi-calendar-x-fill text-danger me-1"></i> Choques de horario de un mismo docente</h6>
                                @if (Model.Choques.Any())
                                {
                                    <div class="table-responsive border rounded-3" style="max-height: 280px; overflow-y: auto;">
                                        <table class="table table-sm table-hover align-middle mb-0">
                                            <thead class="table-light">
                                                <tr><th>Docente</th><th>Día</th><th>Clases que se cruzan</th></tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var c in Model.Choques)
                                                {
                                                    <tr>
                                                        <td class="fw-semibold">@c.Docente</td>
                                                        <td><span class="badge bg-secondary-subtle text-secondary border">@c.Dia</span></td>
                                                        <td class="small text-danger">@c.Detalle</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                                else
                                {
                                    <div class="alert alert-success small mb-0 rounded-3">
                                        <i class="bi bi-check-circle-fill me-1"></i> Ningún docente presenta clases que se crucen en día y hora en la asignación horaria.
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <p class="small text-muted mt-2 mb-0">
                    Estudiantes activos en el sistema: <strong>@Model.TotalEstudiantes</strong>. La apertura y cierre de subida de notas rige inmediatamente para las planillas de los docentes.
                </p>
            </div>
        </main>
    </div>
</div>

<!-- MODAL: CONFIGURAR FECHAS DE PLAZO DE SUBIDA DE NOTAS (COORDINACIÓN) -->
<div class="modal fade" id="modalConfigurarPeriodoSubida" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow" style="border-radius: 16px; overflow: hidden;">
            <div class="modal-header text-white" style="background: linear-gradient(135deg, #0d2a4a 0%, #1e4b75 100%);">
                <h5 class="modal-title fw-bold" id="modalPeriodoTitulo"><i class="bi bi-calendar-event me-2"></i>Configurar Fechas del Periodo</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="formConfigurarPeriodo" onsubmit="guardarFechasPeriodoSubmit(event)">
                <input type="hidden" id="cfgPeriodoNumero" />
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Fecha de Apertura (Inicio de Subida)</label>
                        <input type="date" class="form-control" id="cfgFechaInicio" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Fecha Límite Oficial (Cierre de Subida)</label>
                        <input type="date" class="form-control" id="cfgFechaCierre" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Porcentaje de Evaluación (%)</label>
                        <input type="number" class="form-control" id="cfgPorcentaje" min="1" max="100" value="25" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Observaciones / Indicaciones para Docentes</label>
                        <textarea class="form-control" id="cfgObservaciones" rows="2" placeholder="Ej: Plazo improrrogable para entrega de planillas definitivas."></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-3" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn text-white rounded-pill px-4" style="background: #0d2a4a;">
                        <i class="bi bi-save me-1"></i> Guardar Configuración
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    // Filtro combinado de búsqueda y solo alertas
    function aplicarFiltros() {
        const texto = (document.getElementById('buscarDocente')?.value || '').toLowerCase().trim();
        const soloAlertas = document.getElementById('soloAlertas')?.checked || false;

        document.querySelectorAll('#tbodyDocentes .fila-docente').forEach(function (fila) {
            const coincideTexto = !texto || fila.textContent.toLowerCase().includes(texto);
            const alerta = parseInt(fila.getAttribute('data-alerta') || '0', 10);
            const coincideAlerta = !soloAlertas || alerta > 0;

            fila.style.display = (coincideTexto && coincideAlerta) ? '' : 'none';
        });
    }

    document.getElementById('buscarDocente')?.addEventListener('input', aplicarFiltros);
    document.getElementById('soloAlertas')?.addEventListener('change', aplicarFiltros);

    // Cambiar estado (Habilitar / Cerrar subida de notas)
    function cambiarEstadoPeriodoSubida(periodo, nuevoEstado) {
        const accionTexto = nuevoEstado ? 'habilitar la subida de calificaciones' : 'cerrar y bloquear la subida de calificaciones';
        Swal.fire({
            title: `¿Confirmar cambio en Periodo ${periodo}?`,
            text: `¿Desea ${accionTexto} para los docentes?`,
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: nuevoEstado ? '#27ae60' : '#d33',
            cancelButtonColor: '#6c757d',
            confirmButtonText: nuevoEstado ? 'Sí, Habilitar' : 'Sí, Cerrar Subida',
            cancelButtonText: 'Cancelar'
        }).then((result) => {
            if (result.isConfirmed) {
                const formData = new FormData();
                formData.append('periodo', periodo);
                formData.append('activo', nuevoEstado);

                fetch('@Url.Action("TogglePeriodoSubida", "Coordinador")', {
                    method: 'POST',
                    body: formData
                })
                .then(r => r.json())
                .then(data => {
                    if (data.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Estado Actualizado',
                            text: data.message,
                            timer: 2000,
                            showConfirmButton: false
                        }).then(() => location.reload());
                    } else {
                        Swal.fire('Error', data.message, 'error');
                    }
                })
                .catch(err => {
                    Swal.fire('Error', 'No se pudo comunicar con el servidor.', 'error');
                });
            }
        });
    }

    // Modal para editar fechas del periodo
    function abrirModalEditarFechasPeriodo(periodo, nombre, inicio, cierre, porcentaje, obs) {
        document.getElementById('cfgPeriodoNumero').value = periodo;
        document.getElementById('modalPeriodoTitulo').innerHTML = `<i class="bi bi-calendar-event me-2"></i>Configurar Fechas: Periodo ${periodo}`;
        document.getElementById('cfgFechaInicio').value = inicio;
        document.getElementById('cfgFechaCierre').value = cierre;
        document.getElementById('cfgPorcentaje').value = porcentaje || 25;
        document.getElementById('cfgObservaciones').value = obs || '';

        const modal = new bootstrap.Modal(document.getElementById('modalConfigurarPeriodoSubida'));
        modal.show();
    }

    function guardarFechasPeriodoSubmit(e) {
        e.preventDefault();
        const periodo = document.getElementById('cfgPeriodoNumero').value;
        const inicio = document.getElementById('cfgFechaInicio').value;
        const cierre = document.getElementById('cfgFechaCierre').value;
        const porcentaje = document.getElementById('cfgPorcentaje').value;
        const obs = document.getElementById('cfgObservaciones').value;

        if (cierre < inicio) {
            Swal.fire('Atención', 'La fecha de cierre no puede ser anterior a la de inicio.', 'warning');
            return;
        }

        const formData = new FormData();
        formData.append('periodo', periodo);
        formData.append('fechaInicio', inicio);
        formData.append('fechaCierre', cierre);
        formData.append('porcentaje', porcentaje);
        formData.append('observaciones', obs);

        fetch('@Url.Action("GuardarFechasPeriodo", "Coordinador")', {
            method: 'POST',
            body: formData
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                bootstrap.Modal.getInstance(document.getElementById('modalConfigurarPeriodoSubida'))?.hide();
                Swal.fire({
                    icon: 'success',
                    title: 'Guardado',
                    text: data.message,
                    timer: 2000,
                    showConfirmButton: false
                }).then(() => location.reload());
            } else {
                Swal.fire('Error', data.message, 'error');
            }
        })
        .catch(err => {
            Swal.fire('Error', 'No se pudo guardar la configuración.', 'error');
        });
    }

    // Recordatorio masivo institucional a docentes
    function notificarDocentesRecordatorio(periodo) {
        Swal.fire({
            title: `¿Emitir recordatorio oficial para Periodo ${periodo}?`,
            text: `Se enviará un anuncio institucional a las bandejas de todos los docentes recordando el cierre de subida de notas del Periodo ${periodo}.`,
            icon: 'info',
            showCancelButton: true,
            confirmButtonColor: '#0d2a4a',
            cancelButtonColor: '#6c757d',
            confirmButtonText: 'Sí, Enviar Recordatorio',
            cancelButtonText: 'Cancelar'
        }).then((result) => {
            if (result.isConfirmed) {
                const formData = new FormData();
                formData.append('periodo', periodo);

                fetch('@Url.Action("NotificarDocentesPendientes", "Coordinador")', {
                    method: 'POST',
                    body: formData
                })
                .then(r => r.json())
                .then(data => {
                    if (data.success) {
                        Swal.fire('Enviado', data.message, 'success');
                    } else {
                        Swal.fire('Error', data.message, 'error');
                    }
                })
                .catch(err => {
                    Swal.fire('Error', 'Error de conexión al emitir recordatorio.', 'error');
                });
            }
        });
    }
</script>
