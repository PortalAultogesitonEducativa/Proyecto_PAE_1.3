@* Barra lateral de navegación - Panel Estudiante *@
@using Microsoft.AspNetCore.Http

@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentSeccion = Context.Request.Query["seccion"].ToString().ToLowerInvariant();

    string ActiveIf(string ctrl, string act, string? seccion = null)
    {
        if (!currentController.Equals(ctrl, StringComparison.OrdinalIgnoreCase))
            return "";

        if (!currentAction.Equals(act, StringComparison.OrdinalIgnoreCase))
            return "";

        if (seccion != null)
        {
            return currentSeccion == seccion ? " active" : "";
        }

        return string.IsNullOrEmpty(currentSeccion) ? " active" : "";
    }
}

<aside class="pae-sidebar-lateral" aria-label="Menú lateral estudiante">
    <div class="pae-sidebar-card shadow-sm border-0">
        <div class="pae-sidebar-header d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-mortarboard-fill fs-5" style="color: #e67e22;"></i>
                <div>
                    <div class="fw-bold small">Módulos Estudiante</div>
                    <span class="text-white-50" style="font-size: 0.72rem;">Navegación Rápida</span>
                </div>
            </div>
        </div>

        <div class="p-2 border-bottom bg-light">
            <a href="@Url.Action("Dashboard", "Home")"
               class="btn btn-outline-secondary btn-sm w-100 text-start d-flex align-items-center justify-content-between py-1 px-2"
               title="Regresar al panel principal">
                <span><i class="bi bi-grid-fill me-2" style="color: #e67e22;"></i><strong>Inicio (Cuadros)</strong></span>
                <i class="bi bi-arrow-left small"></i>
            </a>
        </div>

        <div class="pae-sidebar-nav">
            <a href="@Url.Action("MiHorario", "Horario")"
               class="pae-sidebar-nav-item@(ActiveIf("Horario","MiHorario"))">
                <i class="bi bi-calendar3"></i>
                <span>Mi Horario</span>
            </a>
            <a href="@Url.Action("MisNotas", "Estudiante")"
               class="pae-sidebar-nav-item@(ActiveIf("Estudiante","MisNotas"))">
                <i class="bi bi-award-fill"></i>
                <span>Mis Calificaciones</span>
            </a>
            <a href="@Url.Action("Dashboard", "Home", new { seccion = "actividades" })"
               class="pae-sidebar-nav-item@(ActiveIf("Home","Dashboard","actividades"))">
                <i class="bi bi-journal-check"></i>
                <span>Tareas y Classroom</span>
            </a>
            <a href="@Url.Action("Dashboard", "Home", new { seccion = "cursosextra" })"
               class="pae-sidebar-nav-item@(ActiveIf("Home","Dashboard","cursosextra"))">
                <i class="bi bi-star-fill"></i>
                <span>Cursos Extra</span>
            </a>
            <a href="@Url.Action("Dashboard", "Home", new { seccion = "mejoras" })"
               class="pae-sidebar-nav-item@(ActiveIf("Home","Dashboard","mejoras"))">
                <i class="bi bi-shield-check"></i>
                <span>Planes de Nivelación</span>
            </a>
            <a href="@Url.Action("Index", "Pqr")"
               class="pae-sidebar-nav-item@(ActiveIf("Pqr","Index"))">
                <i class="bi bi-chat-heart-fill"></i>
                <span>Módulo PQR</span>
            </a>
        </div>

        <div class="p-2 border-top bg-light">
            <button type="button" class="btn btn-sm btn-outline-primary w-100 py-1"
                    onclick="if(typeof abrirModalAyudaGlobal==='function') abrirModalAyudaGlobal();"
                    style="font-size: 0.8rem;">
                <i class="bi bi-question-circle-fill text-warning me-1"></i> Ayuda del Módulo
            </button>
        </div>
    </div>
</aside>
