@* Barra lateral de navegación - Panel Administrador / Coordinador *@
@using Microsoft.AspNetCore.Http

@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentSeccion = Context.Request.Query["seccion"].ToString().ToLowerInvariant();
    var rolSesion = Context.Session.GetString("UserRol");
    bool esCoordinador = ProyectoPAE.Servicios.Permisos.NormalizarRol(rolSesion) == "coordinador";

    string ActiveIf(string ctrl, string act, string? seccion = null)
    {
        if (!currentController.Equals(ctrl, StringComparison.OrdinalIgnoreCase))
            return "";

        if (!currentAction.Equals(act, StringComparison.OrdinalIgnoreCase))
            return "";

        if (seccion != null)
        {
            return currentSeccion == seccion ? " active" : "";
        }

        return string.IsNullOrEmpty(currentSeccion) ? " active" : "";
    }
}

<aside class="pae-sidebar-lateral" aria-label="Menú lateral de navegación administrativa">
    <div class="pae-sidebar-card shadow-sm border-0">
        <div class="pae-sidebar-header d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-shield-lock-fill fs-5" style="color: #e67e22;"></i>
                <div>
                    <div class="fw-bold small">@(esCoordinador ? "Módulos Coordinación" : "Módulos Admin")</div>
                    <span class="text-white-50" style="font-size: 0.72rem;">Navegación Rápida</span>
                </div>
            </div>
        </div>

        <div class="p-2 border-bottom bg-light">
            <a href="@Url.Action("Dashboard", "Home")"
               class="btn btn-outline-secondary btn-sm w-100 text-start d-flex align-items-center justify-content-between py-1 px-2"
               title="Regresar al panel principal">
                <span><i class="bi bi-grid-fill me-2" style="color: #e67e22;"></i><strong>Inicio (Cuadros)</strong></span>
                <i class="bi bi-arrow-left small"></i>
            </a>
        </div>

        <div class="pae-sidebar-nav">
            @if (esCoordinador)
            {
                <a href="@Url.Action("Supervision", "Coordinador")"
                   class="pae-sidebar-nav-item@(ActiveIf("Coordinador","Supervision"))">
                    <i class="bi bi-clipboard-data-fill"></i>
                    <span>Supervisión Docente</span>
                </a>
                <a href="@Url.Action("AsignacionAcademica", "Horario")"
                   class="pae-sidebar-nav-item@(ActiveIf("Horario","AsignacionAcademica"))">
                    <i class="bi bi-diagram-3-fill"></i>
                    <span>Asignación Académica</span>
                </a>
                <a href="@Url.Action("ReporteGrupal", "Docente")"
                   class="pae-sidebar-nav-item@(ActiveIf("Docente","ReporteGrupal"))">
                    <i class="bi bi-bar-chart-line-fill"></i>
                    <span>Reporte Grupal</span>
                </a>
                <a href="@Url.Action("Dashboard", "Home", new { seccion = "matricula" })"
                   class="pae-sidebar-nav-item@(ActiveIf("Home","Dashboard","matricula"))">
                    <i class="bi bi-clipboard-check"></i>
                    <span>Matrículas</span>
                </a>
                <a href="@Url.Action("Dashboard", "Home", new { seccion = "certificados" })"
                   class="pae-sidebar-nav-item@(ActiveIf("Home","Dashboard","certificados"))">
                    <i class="bi bi-file-earmark-pdf-fill"></i>
                    <span>Certificados</span>
                </a>
                <a href="@Url.Action("Dashboard", "Home", new { seccion = "reportes" })"
                   class="pae-sidebar-nav-item@(ActiveIf("Home","Dashboard","reportes"))">
                    <i class="bi bi-graph-up-arrow"></i>
                    <span>Reportes Pro</span>
                </a>
                <a href="@Url.Action("Index", "Pqr")"
                   class="pae-sidebar-nav-item@(ActiveIf("Pqr","Index"))">
                    <i class="bi bi-chat-heart-fill"></i>
                    <span>Módulo PQR</span>
                </a>
            }
            else
            {
                <a href="@Url.Action("Dashboard", "Home", new { seccion = "matricula" })"
                   class="pae-sidebar-nav-item@(ActiveIf("Home","Dashboard","matricula"))">
                    <i class="bi bi-clipboard-check"></i>
                    <span>Matrículas</span>
                </a>
                <a href="@Url.Action("Usuarios", "Admin")"
                   class="pae-sidebar-nav-item@(ActiveIf("Admin","Usuarios"))">
                    <i class="bi bi-people-fill"></i>
                    <span>Gestión de Usuarios</span>
                </a>
                <a href="@Url.Action("Supervision", "Coordinador")"
                   class="pae-sidebar-nav-item@(ActiveIf("Coordinador","Supervision"))">
                    <i class="bi bi-clipboard-data-fill"></i>
                    <span>Supervisión Docente</span>
                </a>
                <a href="@Url.Action("Dashboard", "Home", new { seccion = "certificados" })"
                   class="pae-sidebar-nav-item@(ActiveIf("Home","Dashboard","certificados"))">
                    <i class="bi bi-file-earmark-pdf-fill"></i>
                    <span>Certificados</span>
                </a>
                <a href="@Url.Action("Notificaciones", "Admin")"
                   class="pae-sidebar-nav-item@(ActiveIf("Admin","Notificaciones"))">
                    <i class="bi bi-megaphone-fill"></i>
                    <span>Notificaciones</span>
                </a>
                <a href="@Url.Action("AsignacionAcademica", "Horario")"
                   class="pae-sidebar-nav-item@(ActiveIf("Horario","AsignacionAcademica"))">
                    <i class="bi bi-diagram-3-fill"></i>
                    <span>Asignación Académica</span>
                </a>
                <a href="@Url.Action("Dashboard", "Home", new { seccion = "reportes" })"
                   class="pae-sidebar-nav-item@(ActiveIf("Home","Dashboard","reportes"))">
                    <i class="bi bi-graph-up-arrow"></i>
                    <span>Reportes Pro</span>
                </a>
                <a href="@Url.Action("Index", "Pqr")"
                   class="pae-sidebar-nav-item@(ActiveIf("Pqr","Index"))">
                    <i class="bi bi-chat-heart-fill"></i>
                    <span>Módulo PQR</span>
                </a>
            }
        </div>

        <div class="p-2 border-top bg-light">
            <button type="button" class="btn btn-sm btn-outline-primary w-100 py-1"
                    onclick="if(typeof abrirModalAyudaGlobal==='function') abrirModalAyudaGlobal();"
                    style="font-size: 0.8rem;">
                <i class="bi bi-question-circle-fill text-warning me-1"></i> Ayuda del Módulo
            </button>
        </div>
    </div>
</aside>
