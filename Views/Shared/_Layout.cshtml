                                </div>

                                <!-- Input del Chat en Azul PAE -->
                                <div class="p-3 border-top" style="background: #0b2545; border-color: rgba(255,255,255,0.1) !important;">
                                    <div class="d-flex align-items-center gap-2">
                                        <input type="text" id="chatIdalgoInput" class="form-control rounded-pill text-white shadow-none" 
                                               style="background: #071e3d; border: 1px solid rgba(255,255,255,0.2); padding: 0.65rem 1.2rem; font-size: 0.92rem;" 
                                               placeholder="Escribe tu consulta a Idalgo (ej: notas, tareas, plazo, certificados)..." 
                                               onkeypress="if(event.key === 'Enter') enviarMensajeIdalgo()" />
                                        <button type="button" class="btn btn-warning rounded-circle d-flex align-items-center justify-content-center shadow-lg" 
                                                style="width: 44px; height: 44px; flex-shrink: 0;" 
                                                onclick="enviarMensajeIdalgo()" title="Enviar mensaje a Idalgo">
                                            <i class="bi bi-send-fill text-dark fs-5"></i>
                                        </button>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center mt-2 px-2">
                                        <small class="text-white-50" style="font-size: 0.75rem;">
                                            <i class="bi bi-lightbulb-fill text-warning me-1"></i>Tip: Puedes preguntar escribiendo palabras clave como <em>"entrega"</em>, <em>"plazo"</em> o <em>"notas"</em>.
                                        </small>
                                        <small class="text-white-50" style="font-size: 0.75rem;">PAE Asistente Virtual 🦉</small>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <script>
            // Base de conocimiento de la mascota Idalgo (Español e Inglés)
            const chatIdalgoRespuestasES = {
                saludo: "¡Hola! Soy <strong>Idalgo</strong> 🦉, la mascota guía de PAE. Puedo explicarte cómo entregar tareas, qué pasa cuando vence la fecha límite, cómo ver tus notas, cómo funcionan los planes de mejora o cómo radicar una PQR.",
                entrega: "<strong>📝 ¿Cómo entrego tareas?</strong><br>1. Ingresa a <em>Actividades y Classroom</em> y selecciona tu materia.<br>2. Haz clic en la tarea pendiente.<br>3. Escribe tu respuesta en el cuadro de texto y/o adjunta tus archivos (PDF, Word, Excel, PowerPoint, ZIP o imágenes hasta 25 MB).<br>4. Presiona el botón <strong>Entregar</strong>.<br><em>Nota:</em> Puedes revertir la entrega mientras el docente no la haya calificado y el plazo siga abierto.",
                plazo: "<strong>⏰ ¿Qué pasa si vence la fecha límite?</strong><br>Una vez llega la fecha y hora límite configurada por el docente:<br>• El sistema bloquea automáticamente nuevas entregas y ediciones.<br>• No podrás enviar ni revertir archivos.<br>• Si tienes una excusa justificada, comunícate con tu docente mediante los <em>comentarios privados</em> de la tarea o solicita un plan de apoyo.",
                notas: "<strong>📈 ¿Dónde veo mis notas?</strong><br>Puedes consultar tus calificaciones por período y el promedio acumulado entrando al módulo <strong>Mis Calificaciones</strong> desde el menú principal o la barra lateral. Allí también verás si aprobaste o si tienes planes de mejora asignados.",
                mejora: "<strong>🔄 Planes de Apoyo y Mejoras</strong><br>Si obtuviste desempeño bajo en alguna asignatura, tu docente puede asignarte un compromiso pedagógico en <strong>Planes de Nivelación / Mejoras</strong>:<br>• <strong>Fase 1:</strong> Revisa el aspecto a mejorar y envía tu evidencia o avance.<br>• <strong>Fase 2:</strong> El docente evalúa tu cumplimiento y actualiza tu seguimiento académico.",
                comentarios: "<strong>💬 Comentarios de clase y privados</strong><br>Dentro de cada tarea en Classroom encontrarás dos espacios:<br>• <strong>Comentarios de la clase:</strong> Visibles para el docente y todos los compañeros del curso.<br>• <strong>Comentarios privados:</strong> Comunicación directa y confidencial únicamente entre tú y el docente de la materia.",
                cursos: "<strong>⚽ Cursos Extracurriculares</strong><br>En el módulo <strong>Cursos Extra</strong> puedes explorar talleres deportivos, artísticos, científicos o de servicio social. Revisa los cupos disponibles, adjunta los documentos requeridos (si el curso los pide) y envía tu solicitud.",
                certificados: "<strong>📄 Certificados de Estudio</strong><br>Los certificados oficiales de matrícula y notas cuentan con código alfanumérico único y código QR de verificación institucional. Puedes solicitarlos o validarlos desde el módulo de <strong>Certificados</strong>.",
                pqr: "<strong>📬 ¿Cómo radicar PQR?</strong><br>Si necesitas presentar una Petición, Queja o Reclamo formal ante la institución, haz clic en <strong>PQR</strong> en la barra superior o en el botón <em>Ir al Módulo PQR</em>. Recibirás un número de radicado único para hacer seguimiento a la respuesta.",
                ayuda: "Puedo ayudarte con cualquiera de estos temas:<br>• <strong>Entrega de tareas</strong> en Classroom<br>• <strong>Fechas límite</strong> y bloqueos<br>• <strong>Calificaciones</strong> y boletines<br>• <strong>Planes de apoyo / mejoras</strong><br>• <strong>Cursos extracurriculares</strong><br>• <strong>Certificados y PQR</strong><br>Escribe una palabra clave o elige un botón de la izquierda."
            };

            const chatIdalgoRespuestasEN = {
                saludo: "Hello! I'm <strong>Idalgo</strong> 🦉, PAE's guide mascot. I can explain how to submit assignments, what happens after a due date, how to check your grades, how remedial plans work, or how to submit a PQR request.",
                entrega: "<strong>📝 How do I submit assignments?</strong><br>1. Go to <em>Activities & Classroom</em> and select your subject.<br>2. Click on the pending assignment.<br>3. Type your response and/or attach your files (PDF, Word, Excel, PowerPoint, ZIP, or images up to 25 MB).<br>4. Click the <strong>Submit</strong> button.<br><em>Note:</em> You can unsubmit your work as long as the teacher has not graded it and the deadline has not passed.",
                plazo: "<strong>⏰ What happens after the due date?</strong><br>Once the deadline set by the teacher passes:<br>• The system automatically locks new submissions and edits.<br>• You will no longer be able to upload or unsubmit files.<br>• If you have a valid excuse, contact your teacher via <em>private comments</em> on the assignment or request a support plan.",
                notas: "<strong>📈 Where can I see my grades?</strong><br>You can check your grades per term and your cumulative average in the <strong>My Grades</strong> module from the main dashboard or sidebar. You will also see whether you passed or have assigned remedial plans.",
                mejora: "<strong>🔄 Support & Remedial Plans</strong><br>If you had low performance in a subject, your teacher may assign a pedagogical commitment in <strong>Remedial Plans / Improvements</strong>:<br>• <strong>Phase 1:</strong> Review the area to improve and submit your evidence or progress.<br>• <strong>Phase 2:</strong> The teacher evaluates your completion and updates your academic record.",
                comentarios: "<strong>💬 Class & private comments</strong><br>Inside each Classroom assignment you will find two spaces:<br>• <strong>Class comments:</strong> Visible to the teacher and all classmates in the course.<br>• <strong>Private comments:</strong> Direct, confidential communication solely between you and the subject teacher.",
                cursos: "<strong>⚽ Extracurricular Courses</strong><br>In the <strong>Extra Courses</strong> module you can explore sports, arts, academic, or community service workshops. Check available spots, attach required documents (if any), and submit your application.",
                certificados: "<strong>📄 Study Certificates</strong><br>Official enrollment and grade certificates include a unique alphanumeric code and an institutional verification QR code. You can request or validate them in the <strong>Certificates</strong> module.",
                pqr: "<strong>📬 How do I submit a PQR?</strong><br>If you need to file a formal Petition, Complaint, or Claim with the institution, click <strong>Requests</strong> in the top bar or <em>Go to PQR Module</em>. You will receive a unique tracking ID to follow up on the official response.",
                ayuda: "I can help you with any of these topics:<br>• <strong>Submitting assignments</strong> in Classroom<br>• <strong>Due dates</strong> and submission locks<br>• <strong>Grades</strong> and academic reports<br>• <strong>Support / remedial plans</strong><br>• <strong>Extracurricular courses</strong><br>• <strong>Certificates and PQR requests</strong><br>Type a keyword or select one of the buttons on the left."
            };

            function esIdiomaInglesIdalgo() {
                return (window.PAE_IDIOMA === 'en') ||
                    (document.documentElement.getAttribute('lang') || '').toLowerCase().startsWith('en') ||
                    document.cookie.includes('c=en') || document.cookie.includes('uic=en');
            }

            function obtenerDiccionarioIdalgo() {
                return esIdiomaInglesIdalgo() ? chatIdalgoRespuestasEN : chatIdalgoRespuestasES;
            }

            function obtenerEtiquetaUsuarioIdalgo() {
                return esIdiomaInglesIdalgo() ? 'You' : 'Tú';
            }

            // 1. Función que abre el modal grande de Idalgo y cierra el modal de ayuda previo
            function abrirChatIdalgo() {
                const modalAyudaEl = document.getElementById('modalAyudaPAE');
                const modalChatEl = document.getElementById('modalChatIdalgo');

                if (modalAyudaEl && typeof bootstrap !== 'undefined') {
                    const instanciaAyuda = bootstrap.Modal.getInstance(modalAyudaEl);
                    if (instanciaAyuda) instanciaAyuda.hide();
                }

                if (modalChatEl && typeof bootstrap !== 'undefined') {
                    const instanciaChat = bootstrap.Modal.getOrCreateInstance(modalChatEl);
                    instanciaChat.show();
                    setTimeout(() => {
                        const input = document.getElementById('chatIdalgoInput');
                        if (input) input.focus();
                    }, 300);
                }
            }

            // 2. Función para los botones laterales y chips rápidos dentro del chat
            function seleccionarPreguntaIdalgo(claveTema) {
                const dict = obtenerDiccionarioIdalgo();
                const en = esIdiomaInglesIdalgo();

                const mapaTemas = {
                    entregar_tarea: {
                        pregunta: en ? "How do I submit assignments?" : "¿Cómo entrego tareas?",
                        respuesta: dict.entrega
                    },
                    fecha_limite: {
                        pregunta: en ? "What happens after the due date?" : "¿Qué pasa si vence la fecha límite?",
                        respuesta: dict.plazo
                    },
                    calificaciones: {
                        pregunta: en ? "Where can I see my grades?" : "¿Dónde veo mis notas?",
                        respuesta: dict.notas
                    },
                    mejoras: {
                        pregunta: en ? "Support & Remedial Plans" : "Planes de Apoyo / Mejoras",
                        respuesta: dict.mejora
                    },
                    comentarios: {
                        pregunta: en ? "Class & private comments" : "Comentarios de clase y privados",
                        respuesta: dict.comentarios
                    },
                    extracurriculares: {
                        pregunta: en ? "Extracurricular Courses" : "Cursos Extracurriculares",
                        respuesta: dict.cursos
                    },
                    certificados: {
                        pregunta: en ? "Study Certificates" : "Certificados de Estudio",
                        respuesta: dict.certificados
                    },
                    pqr: {
                        pregunta: en ? "How do I submit a PQR?" : "¿Cómo radicar una PQR?",
                        respuesta: dict.pqr
                    }
                };

                const item = mapaTemas[claveTema];
                if (!item) return;

                agregarBurbujaIdalgo(item.pregunta, true);
                setTimeout(() => {
                    agregarBurbujaIdalgo(item.respuesta, false);
                }, 200);
            }

            function obtenerRespuestaIdalgo(texto) {
                const dict = obtenerDiccionarioIdalgo();
                const q = (texto || "").toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
                if (q.includes("hola") || q.includes("buenos") || q.includes("buenas") || q.includes("quien eres") || q.includes("hello") || q.includes("hi")) return dict.saludo;
                if (q.includes("entreg") || q.includes("subir") || q.includes("tarea") || q.includes("archivo") || q.includes("enviar") || q.includes("submit") || q.includes("upload") || q.includes("task")) return dict.entrega;
                if (q.includes("plazo") || q.includes("limite") || q.includes("venc") || q.includes("tarde") || q.includes("cerrad") || q.includes("bloque") || q.includes("deadline") || q.includes("due") || q.includes("late")) return dict.plazo;
                if (q.includes("nota") || q.includes("calific") || q.includes("boletin") || q.includes("promedio") || q.includes("grade") || q.includes("score")) return dict.notas;
                if (q.includes("mejor") || q.includes("apoyo") || q.includes("nivelac") || q.includes("recuper") || q.includes("compromiso") || q.includes("remedial") || q.includes("support")) return dict.mejora;
                if (q.includes("coment") || q.includes("privad") || q.includes("mensaje") || q.includes("profesor") || q.includes("docente") || q.includes("comment") || q.includes("private")) return dict.comentarios;
                if (q.includes("curso") || q.includes("extra") || q.includes("taller") || q.includes("inscri") || q.includes("cupo") || q.includes("course")) return dict.cursos;
                if (q.includes("certific") || q.includes("constancia") || q.includes("qr") || q.includes("pdf")) return dict.certificados;
                if (q.includes("pqr") || q.includes("queja") || q.includes("reclamo") || q.includes("peticion") || q.includes("radic") || q.includes("request") || q.includes("claim")) return dict.pqr;
                return dict.ayuda;
            }

            function agregarBurbujaIdalgo(htmlContenido, esUsuario) {
                const contenedor = document.getElementById('chatIdalgoMensajes');
                if (!contenedor) return;

                const wrapper = document.createElement('div');
                wrapper.className = esUsuario
                    ? 'd-flex justify-content-end mb-3'
                    : 'd-flex align-items-start gap-3 mb-3';

                if (esUsuario) {
                    wrapper.innerHTML = `
                        <div class="bg-warning text-dark rounded-4 p-3 shadow-sm fw-medium" style="max-width: 82%; font-size: 0.9rem;">
                            <div class="small opacity-75 fw-bold mb-1 text-end">${obtenerEtiquetaUsuarioIdalgo()}</div>
                            <div>${htmlContenido}</div>
                        </div>`;
                } else {
                    wrapper.innerHTML = `
                        <img src="/images/idalgo.png" alt="Idalgo" class="rounded-circle bg-white shadow-sm flex-shrink-0" style="width: 40px; height: 40px; object-fit: cover; border: 2px solid #f59e0b;" onerror="this.src='/images/buho.png'">
                        <div class="p-3 rounded-4 shadow-sm text-white" style="background: #134074; border: 1px solid rgba(255,255,255,0.15); max-width: 85%; font-size: 0.9rem; line-height: 1.5;">
                            <div class="fw-bold text-warning small mb-1">🦉 Idalgo</div>
                            <div style="color: #f1f5f9;">${htmlContenido}</div>
                        </div>`;
                }

                contenedor.appendChild(wrapper);
                contenedor.scrollTop = contenedor.scrollHeight;
            }

            function enviarPreguntaIdalgo(texto) {
                const clean = (texto || "").trim();
                if (!clean) return;
                const safeText = clean.replace(/</g, "&lt;").replace(/>/g, "&gt;");
                agregarBurbujaIdalgo(safeText, true);
                setTimeout(() => {
                    agregarBurbujaIdalgo(obtenerRespuestaIdalgo(clean), false);
                }, 220);
            }

            // 3. Función conectada al input #chatIdalgoInput y al botón de enviar
            function enviarMensajeIdalgo() {
                const input = document.getElementById('chatIdalgoInput');
                if (!input) return;
                const texto = input.value;
                input.value = '';
                enviarPreguntaIdalgo(texto);
                input.focus();
            }

            function reiniciarChatIdalgo() {
                const contenedor = document.getElementById('chatIdalgoMensajes');
                if (!contenedor) return;
                const dict = obtenerDiccionarioIdalgo();
                contenedor.innerHTML = '';
                agregarBurbujaIdalgo(dict.saludo, false);
            }
        </script>

        <!-- ─── FEEDBACK COMUNICATIVO Y ALERTAS GLOBALES (REQUERIMIENTO 1.6) ───────────── -->
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                @if (TempData["Exito"] != null)
                {
                    <text>
                        if (window.PAE && typeof PAE.toast === 'function') {
                            PAE.toast("@Html.Raw(TempData["Exito"]?.ToString()?.Replace("\"", "\\\""))", 'success');
                        }
                    </text>
                }
                @if (TempData["Mensaje"] != null)
                {
                    <text>
                        if (window.PAE && typeof PAE.toast === 'function') {
                            PAE.toast("@Html.Raw(TempData["Mensaje"]?.ToString()?.Replace("\"", "\\\""))", 'info');
                        }
                    </text>
                }
                @if (TempData["Error"] != null)
                {
                    <text>
                        if (window.PAE && typeof PAE.error === 'function') {
                            PAE.error("@Html.Raw(TempData["Error"]?.ToString()?.Replace("\"", "\\\""))");
                        }
                    </text>
                }
            });
        </script>
    </body>
</html>
