                                <button type="button" class="btn btn-sm text-white rounded-pill py-1 px-2.5 small" style="background: #0b2545; border: 1px solid #f87171;" onclick="seleccionarPreguntaIdalgo('fecha_limite')">⏰ ¿Qué pasa si vence la fecha límite?</button>
                                <button type="button" class="btn btn-sm text-white rounded-pill py-1 px-2.5 small" style="background: #0b2545; border: 1px solid #4ade80;" onclick="seleccionarPreguntaIdalgo('calificaciones')">📈 ¿Dónde veo mis notas?</button>
                                <button type="button" class="btn btn-sm text-white rounded-pill py-1 px-2.5 small" style="background: #0b2545; border: 1px solid #c084fc;" onclick="seleccionarPreguntaIdalgo('mejoras')">🔄 Planes de Apoyo / Mejoras</button>
                                <button type="button" class="btn btn-sm text-white rounded-pill py-1 px-2.5 small" style="background: #0b2545; border: 1px solid #fbbf24;" onclick="seleccionarPreguntaIdalgo('comentarios')">💬 Comentarios de clase y privados</button>
                            </div>
                        </div>
                    </div>
                `;
            }

            const chatIdalgoRespuestas = {
                'entregar_tarea': {
                    titulo: '📝 ¿Cómo entrego una actividad o tarea?',
                    contenido: `<p class="mb-2 text-white"><strong>Pasos para enviar tu actividad:</strong></p>
                    <ol class="ps-3 mb-2 small" style="color: #e2e8f0;">
                        <li>Ingresa al módulo <strong>Actividades y Classroom</strong> desde tu menú lateral.</li>
                        <li>Haz clic en <strong>Entrar a la Materia</strong> correspondiente.</li>
                        <li>En el tablón, presiona sobre la tarea asignada.</li>
                        <li>En la columna derecha <strong>"Tu trabajo"</strong>, escribe tu respuesta o pega enlaces, y si lo deseas adjunta tu archivo (PDF, Word, Excel, PowerPoint o imagen de hasta 5 MB).</li>
                        <li>Presiona el botón azul <strong>"Entregar"</strong>.</li>
                    </ol>
                    <div class="p-2 rounded-3 small mb-0" style="background: rgba(56, 189, 248, 0.15); border: 1px solid rgba(56, 189, 248, 0.3); color: #7dd3fc;"><i class="bi bi-lightbulb-fill text-warning me-1"></i>¡Asegúrate de entregar antes de la fecha límite!</div>`
                },
                'fecha_limite': {
                    titulo: '⏰ ¿Qué pasa si vence la fecha límite de entrega?',
                    contenido: `<p class="mb-2 text-white"><strong>Regla estricta de plazos en el PAE:</strong></p>
                    <ul class="ps-3 mb-2 small" style="color: #e2e8f0;">
                        <li>Cada actividad asignada por tu profesor cuenta con una <strong>fecha y hora límite</strong>.</li>
                        <li><strong>Una vez vencido el plazo:</strong> el sistema <strong>bloquea automáticamente</strong> cualquier envío nuevo o modificación de trabajos ya entregados.</li>
                        <li>El botón cambiará a <span class="badge bg-danger">Entrega Cerrada (Plazo Vencido)</span> y los campos quedarán desactivados.</li>
                        <li>Esta regla aplica de igual forma para las <strong>Actividades de Clase</strong> como para los <strong>Planes de Apoyo y Mejoras</strong>.</li>
                    </ul>
                    <p class="mb-0 small" style="color: #94a3b8;"><i class="bi bi-chat-lock-fill me-1 text-warning"></i>Si tuviste una fuerza mayor justificada, comunícate con tu profesor a través de los <strong>Comentarios Privados</strong> de la tarea.</p>`
                },
                'calificaciones': {
                    titulo: '📈 ¿Dónde consulto mis notas y calificaciones?',
                    contenido: `<p class="mb-2 text-white"><strong>Consulta académica y boletines:</strong></p>
                    <ul class="ps-3 mb-2 small" style="color: #e2e8f0;">
                        <li>Ve al módulo <strong>Mis Calificaciones</strong> en tu panel de estudiante.</li>
                        <li>Allí encontrarás tus asignaturas con las calificaciones registradas por periodo (1, 2, 3 y 4), tu promedio ponderado y la escala de desempeño (Superior, Alto, Básico o Bajo).</li>
                        <li>También tienes acceso al botón para descargar tu <strong>Boletín de Calificaciones en PDF</strong> con la firma institucional.</li>
                    </ul>`
                },
                'mejoras': {
                    titulo: '🔄 ¿Cómo funcionan los Planes de Apoyo y Nivelación (Mejoras)?',
                    contenido: `<p class="mb-2 text-white"><strong>Módulo de Planes de Apoyo:</strong></p>
                    <ul class="ps-3 mb-2 small" style="color: #e2e8f0;">
                        <li>Ingresa a <strong>Planes de Apoyo</strong> en el menú lateral.</li>
                        <li>Verás tus materias asignadas exactamente igual que en Actividades y Classroom.</li>
                        <li>Al hacer clic en <strong>Entrar a la Materia</strong>, accederás al <strong>Classroom de Mejoras</strong>, donde tu profesor publica talleres pedagógicos, guías de recuperación y compromisos.</li>
                        <li>Podrás subir tus trabajos de nivelación antes de la fecha límite para mejorar tu valoración académica.</li>
                    </ul>`
                },
                'comentarios': {
                    titulo: '💬 ¿Cómo funcionan los comentarios de clase y comentarios privados?',
                    contenido: `<p class="mb-2 text-white"><strong>Canales de comunicación en Classroom:</strong></p>
                    <ul class="ps-3 mb-2 small" style="color: #e2e8f0;">
                        <li><strong>Comentarios de la clase:</strong> Ubicados debajo de las instrucciones de la tarea. Son visibles para todos tus compañeros de aula y el profesor. Ideales para preguntas generales sobre el tema.</li>
                        <li><strong>Comentarios privados:</strong> Ubicados en la tarjeta derecha "Tu trabajo". Solo los pueden leer <strong>tú y tu profesor</strong>. Ideales para justificaciones personales o dudas puntuales de tu entrega.</li>
                    </ul>`
                },
                'extracurriculares': {
                    titulo: '⚽ ¿Cómo me inscribo a un Curso Extracurricular?',
                    contenido: `<p class="mb-2 text-white"><strong>Inscripción a Cursos y Talleres:</strong></p>
                    <ol class="ps-3 mb-2 small" style="color: #e2e8f0;">
                        <li>Ve a <strong>Cursos Extracurriculares</strong>.</li>
                        <li>El sistema filtra los cursos permitidos para tu grado escolar (de 6° a 11°).</li>
                        <li>Haz clic en <strong>Inscribirme</strong>.</li>
                        <li><strong>Requisito obligatorio:</strong> Debes adjuntar todos los documentos requeridos (ej: autorización de acudiente, EPS o certificado médico).</li>
                        <li>Al enviar los documentos, tu solicitud entrará a la lista de espera del docente para su revisión y aprobación.</li>
                    </ol>`
                },
                'certificados': {
                    titulo: '📄 ¿Cómo solicito un Certificado de Estudio?',
                    contenido: `<p class="mb-2 text-white"><strong>Expedición de Certificados Oficiales:</strong></p>
                    <ul class="ps-3 mb-2 small" style="color: #e2e8f0;">
                        <li>Ingresa al módulo <strong>Certificados</strong>.</li>
                        <li>Selecciona el tipo de documento requerido (Certificado de Estudio, Certificado de Calificaciones, etc.).</li>
                        <li>Verifica tus datos escolares y presiona <strong>Generar</strong>.</li>
                        <li>El documento se genera de forma inmediata con firma electrónica y código QR de autenticidad institucional.</li>
                    </ul>`
                },
                'pqr': {
                    titulo: '📬 ¿Cómo radicar una PQR (Petición, Queja o Reclamo)?',
                    contenido: `<p class="mb-2 text-white"><strong>Módulo PQR oficial:</strong></p>
                    <ul class="ps-3 mb-2 small" style="color: #e2e8f0;">
                        <li>Haz clic en el botón <strong>PQR</strong> ubicado en la parte superior derecha de la pantalla.</li>
                        <li>Elige el tipo de solicitud: Petición, Queja, Reclamo, Sugerencia o Felicitación.</li>
                        <li>Redacta detalladamente tu solicitud y adjunta evidencias si las tienes.</li>
                        <li>El sistema te generará un código de radicado único para consultar el estado y la respuesta de la institución.</li>
                    </ul>`
                }
            };

            function seleccionarPreguntaIdalgo(clave) {
                const info = chatIdalgoRespuestas[clave];
                if (!info) return;

                agregarBurbujaUsuario(info.titulo);
                mostrarEscribiendoIdalgo();

                setTimeout(() => {
                    quitarEscribiendoIdalgo();
                    agregarBurbujaIdalgo(info.contenido);
                }, 350);
            }

            function enviarMensajeIdalgo() {
                const input = document.getElementById('chatIdalgoInput');
                if (!input) return;
                const texto = input.value.trim();
                if (!texto) return;

                input.value = '';
                agregarBurbujaUsuario(texto);
                mostrarEscribiendoIdalgo();

                setTimeout(() => {
                    quitarEscribiendoIdalgo();
                    procesarConsultaTextoIdalgo(texto);
                }, 380);
            }

            function procesarConsultaTextoIdalgo(texto) {
                const q = texto.toLowerCase();

                if (q.includes('tarea') || q.includes('actividad') || q.includes('subir') || q.includes('adjunt') || q.includes('entreg')) {
                    seleccionarPreguntaIdalgoDirecta('entregar_tarea');
                } else if (q.includes('plazo') || q.includes('limite') || q.includes('venc') || q.includes('tiempo') || q.includes('tard') || q.includes('cerrad')) {
                    seleccionarPreguntaIdalgoDirecta('fecha_limite');
                } else if (q.includes('nota') || q.includes('calific') || q.includes('promedio') || q.includes('boletin')) {
                    seleccionarPreguntaIdalgoDirecta('calificaciones');
                } else if (q.includes('mejora') || q.includes('nivelac') || q.includes('apoyo') || q.includes('recuper')) {
                    seleccionarPreguntaIdalgoDirecta('mejoras');
                } else if (q.includes('comentario') || q.includes('privad') || q.includes('mensaje') || q.includes('profesor') || q.includes('docente')) {
                    seleccionarPreguntaIdalgoDirecta('comentarios');
                } else if (q.includes('extra') || q.includes('curso') || q.includes('futbol') || q.includes('arte') || q.includes('deporte') || q.includes('taller')) {
                    seleccionarPreguntaIdalgoDirecta('extracurriculares');
                } else if (q.includes('certific') || q.includes('constancia') || q.includes('documento')) {
                    seleccionarPreguntaIdalgoDirecta('certificados');
                } else if (q.includes('pqr') || q.includes('reclamo') || q.includes('queja') || q.includes('peticion') || q.includes('ayuda') || q.includes('soporte')) {
                    seleccionarPreguntaIdalgoDirecta('pqr');
                } else {
                    const fallbackHtml = `
                        <p class="mb-2 text-white">Comprendo tu inquietud sobre: <em>"${texto}"</em>.</p>
                        <p class="mb-2 small text-white-50">Aquí tienes los temas más consultados donde puedes encontrar la respuesta:</p>
                        <div class="d-flex flex-wrap gap-1.5 mb-2">
                            <button type="button" class="btn btn-sm text-white rounded-pill py-1 px-2.5 small" style="background: #0b2545; border: 1px solid #38bdf8;" onclick="seleccionarPreguntaIdalgo('entregar_tarea')">📝 Entregar Tareas</button>
                            <button type="button" class="btn btn-sm text-white rounded-pill py-1 px-2.5 small" style="background: #0b2545; border: 1px solid #f87171;" onclick="seleccionarPreguntaIdalgo('fecha_limite')">⏰ Fechas Límite</button>
                            <button type="button" class="btn btn-sm text-white rounded-pill py-1 px-2.5 small" style="background: #0b2545; border: 1px solid #4ade80;" onclick="seleccionarPreguntaIdalgo('calificaciones')">📈 Ver Calificaciones</button>
                            <button type="button" class="btn btn-sm text-white rounded-pill py-1 px-2.5 small" style="background: #0b2545; border: 1px solid #c084fc;" onclick="seleccionarPreguntaIdalgo('mejoras')">🔄 Planes de Mejora</button>
                        </div>
                        <p class="small text-white-50 mb-0">Si tu caso requiere atención especial del personal administrativo, puedes <a href="/Pqr/Index" class="fw-bold text-warning text-decoration-underline">radicar una PQR oficial aquí</a>.</p>
                    `;
                    agregarBurbujaIdalgo(fallbackHtml);
                }
            }

            function seleccionarPreguntaIdalgoDirecta(clave) {
                const info = chatIdalgoRespuestas[clave];
                if (info) {
                    agregarBurbujaIdalgo(info.contenido);
                }
            }

            function agregarBurbujaUsuario(texto) {
                const cont = document.getElementById('chatIdalgoMensajes');
                if (!cont) return;

                const wrapper = document.createElement('div');
                wrapper.className = 'd-flex justify-content-end mb-3';
                wrapper.innerHTML = `
                    <div class="p-3 rounded-4 text-white shadow-sm" style="background: linear-gradient(135deg, #1d6fa5 0%, #2980b9 100%); max-width: 82%;">
                        <div class="small fw-semibold mb-0" style="line-height: 1.4;">${texto}</div>
                    </div>
                `;
                cont.appendChild(wrapper);
                cont.scrollTop = cont.scrollHeight;
            }

            function mostrarEscribiendoIdalgo() {
                const cont = document.getElementById('chatIdalgoMensajes');
                if (!cont) return;

                const typingDiv = document.createElement('div');
                typingDiv.id = 'chatIdalgoTyping';
                typingDiv.className = 'd-flex align-items-center gap-2 mb-3';
                typingDiv.innerHTML = `
                    <img src="/images/idalgo.png" style="width:36px;height:36px;border-radius:50%;object-fit:cover;border:1.5px solid #f59e0b;background:#fff;" alt="Idalgo" />
                    <div class="p-2.5 px-3 rounded-pill shadow-sm text-white-50 small d-flex align-items-center gap-2" style="background: #134074; border: 1px solid rgba(255,255,255,0.15);">
                        <span class="spinner-grow spinner-grow-sm text-warning" style="width: 0.65rem; height: 0.65rem;" role="status"></span>
                        <span style="font-size: 0.8rem; color: #cbd5e1;">Idalgo está consultando la guía...</span>
                    </div>
                `;
                cont.appendChild(typingDiv);
                cont.scrollTop = cont.scrollHeight;
            }

            function quitarEscribiendoIdalgo() {
                const typing = document.getElementById('chatIdalgoTyping');
                if (typing) typing.remove();
            }

            function agregarBurbujaIdalgo(htmlContenido) {
                const cont = document.getElementById('chatIdalgoMensajes');
                if (!cont) return;

                const wrapper = document.createElement('div');
                wrapper.className = 'd-flex align-items-start gap-3 mb-3';
                wrapper.innerHTML = `
                    <img src="/images/idalgo.png" style="width:42px;height:42px;border-radius:50%;object-fit:cover;border:2px solid #f59e0b;background:#fff;flex-shrink:0;" alt="Idalgo" />
                    <div class="p-3 rounded-4 shadow-sm text-white" style="background: #134074; border: 1px solid rgba(255,255,255,0.15); max-width: 88%;">
                        <div class="fw-bold text-warning mb-1 small d-flex align-items-center gap-1">
                            <span>🦉 Idalgo &bull; Mascota Guía PAE</span>
                        </div>
                        <div class="small" style="line-height: 1.5; color: #f1f5f9;">
                            ${htmlContenido}
                        </div>
                        <div class="mt-2 pt-2 border-top d-flex justify-content-between align-items-center" style="border-color: rgba(255,255,255,0.12) !important;">
                            <small class="text-white-50" style="font-size: 0.72rem;">¿Te sirvió esta respuesta?</small>
                            <div class="btn-group btn-group-sm">
                                <button type="button" class="btn btn-outline-light py-0 px-2 rounded-pill" onclick="this.parentElement.innerHTML='<span class=\\'badge bg-success-subtle text-success border border-success-subtle\\'>¡Me alegra ayudarte! 🦉</span>'"><i class="bi bi-hand-thumbs-up"></i></button>
                                <button type="button" class="btn btn-outline-warning py-0 px-2 rounded-pill ms-1" onclick="abrirPqrDesdeChat()"><i class="bi bi-headset"></i> PQR</button>
                            </div>
                        </div>
                    </div>
                `;
                cont.appendChild(wrapper);
                cont.scrollTop = cont.scrollHeight;
            }

            function abrirPqrDesdeChat() {
                window.location.href = '@Url.Action("Index", "Pqr")';
            }
        </script>

        <!-- ─── FEEDBACK COMUNICATIVO Y ALERTAS GLOBALES (REQUERIMIENTO 1.6) ───────────── -->
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                @if (TempData["Exito"] != null)
                {
                    <text>
                        if (window.PAE && typeof PAE.toast === 'function') {
                            PAE.toast("@Html.Raw(TempData["Exito"]?.ToString()?.Replace("\"", "\\\""))", 'success');
                        }
                    </text>
                }
                @if (TempData["Mensaje"] != null)
                {
                    <text>
                        if (window.PAE && typeof PAE.toast === 'function') {
                            PAE.toast("@Html.Raw(TempData["Mensaje"]?.ToString()?.Replace("\"", "\\\""))", 'info');
                        }
                    </text>
                }
                @if (TempData["Error"] != null)
                {
                    <text>
                        if (window.PAE && typeof PAE.error === 'function') {
                            PAE.error("@Html.Raw(TempData["Error"]?.ToString()?.Replace("\"", "\\\""))");
                        }
                    </text>
                }
            });
        </script>
    </body>
</html>
