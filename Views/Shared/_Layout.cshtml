        <script>
            function obtenerStorageKeyDaltonismo() {
                var userId = '@(Context.Session.GetString("UserIdStr") ?? "anon")';
                return 'pae_filtro_daltonismo_' + userId;
            }

            function aplicarFiltroDaltonismo(tipo) {
                const root = document.documentElement;
                const body = document.body;
                const storageKey = obtenerStorageKeyDaltonismo();
                const clasesFiltro = ['filtro-normal', 'filtro-protanopia', 'filtro-deuteranopia', 'filtro-tritanopia', 'filtro-acromatopsia'];

                root.classList.remove(...clasesFiltro);
                if (body) body.classList.remove(...clasesFiltro);

                const filtroValido = (tipo && tipo !== 'normal') ? tipo : 'normal';

                if (filtroValido !== 'normal') {
                    root.classList.add('filtro-' + filtroValido);
                    if (body) body.classList.add('filtro-' + filtroValido);
                }

                localStorage.setItem(storageKey, filtroValido);
                localStorage.setItem('pae_filtro_daltonismo', filtroValido);

                actualizarUIFiltros();

                if (window.PAE && typeof PAE.toast === 'function') {
                    const nombres = {
                        'normal': 'Visión Normal (Filtros desactivados)',
                        'deuteranopia': 'Modo Deuteranopía activado',
                        'protanopia': 'Modo Protanopía activado',
                        'tritanopia': 'Modo Tritanopía activado',
                        'acromatopsia': 'Modo Acromatopsia activado'
                    };
                    PAE.toast(nombres[filtroValido] || 'Preferencia guardada', 'info');
                }
            }

            function actualizarUIFiltros() {
                const storageKey = obtenerStorageKeyDaltonismo();
                const actual = localStorage.getItem(storageKey) || localStorage.getItem('pae_filtro_daltonismo') || 'normal';
                const root = document.documentElement;
                const body = document.body;
                const clasesFiltro = ['filtro-normal', 'filtro-protanopia', 'filtro-deuteranopia', 'filtro-tritanopia', 'filtro-acromatopsia'];

                root.classList.remove(...clasesFiltro);
                if (body) body.classList.remove(...clasesFiltro);

                if (actual !== 'normal') {
                    root.classList.add('filtro-' + actual);
                    if (body) body.classList.add('filtro-' + actual);
                }

                document.querySelectorAll('#opcionesDaltonismo .accesibilidad-item').forEach(item => {
                    const f = item.getAttribute('data-filtro');
                    const check = item.querySelector('.check-filtro');
                    if (f === actual) {
                        item.classList.add('active');
                        if (check) check.classList.remove('d-none');
                    } else {
                        item.classList.remove('active');
                        if (check) check.classList.add('d-none');
                    }
                });
            }

            document.addEventListener('DOMContentLoaded', actualizarUIFiltros);
        </script>

