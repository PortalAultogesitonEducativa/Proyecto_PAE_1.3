<!DOCTYPE html>
<html lang="es">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>@ViewData["Title"] - PAE</title>
        <link rel="icon" type="image/png" href="~/images/favicon-buho.png" />
        <link rel="shortcut icon" type="image/png" href="~/images/favicon-buho.png" />
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap-reboot.css" />
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
        <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
        <script>
            (function () {
                var userId = '@(Context.Session.GetString("UserIdStr") ?? "anon")';
                var storageKey = 'pae_filtro_daltonismo_' + userId;
                var f = localStorage.getItem(storageKey) || localStorage.getItem('pae_filtro_daltonismo') || 'normal';
                if (f && f !== 'normal') {
                    document.documentElement.classList.add('filtro-' + f);
                }
            })();
        </script>
    </head>
    <body>
        <div id="pae-live-announcer" class="visually-hidden" aria-live="polite" aria-atomic="true"></div>
        <header>
            <nav class="navbar navbar-expand-md navbar-light border-bottom box-shadow mb-3" style="background-color: #ffffff;">
                <div class="container">
                    @using Microsoft.AspNetCore.Http
                    @if (Context.Session.GetString("NombreUsuario") != null)
                    {
                        <a class="navbar-brand d-flex align-items-center" id="navbarBrandLink" href="#" data-bs-toggle="modal" data-bs-target="#modalConfirmarSalida">
                            <img src="~/images/logo.png" alt="PAE Logo" style="height: 45px;" class="me-2">
                            <span class="fw-bold" style="color: #0d2a4a; font-size: 1.2rem;">Portal de Autogestión Educativa</span>
                        </a>
                    }
                    else
                    {
                        <a class="navbar-brand d-flex align-items-center" id="navbarBrandLink" asp-controller="Home" asp-action="Index">
                            <img src="~/images/logo.png" alt="PAE Logo" style="height: 45px;" class="me-2">
                            <span class="fw-bold" style="color: #0d2a4a; font-size: 1.2rem;">Portal de Autogestión Educativa</span>
                        </a>
                    }
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="navbar-collapse collapse d-sm-inline-flex">
                        @if (Context.Session.GetString("NombreUsuario") == null)
                        {
                            <ul class="navbar-nav flex-grow-1 justify-content-center">
                                <li class="nav-item">
                                    <a class="nav-link text-dark mx-2" asp-controller="Home" asp-action="Index">Inicio</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark mx-2" asp-controller="Home" asp-action="Nosotros">Nosotros</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark mx-2" asp-controller="Home" asp-action="Cursos">Módulos</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark px-3" asp-controller="Home" asp-action="Blog">Blog</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark mx-2" asp-controller="Home" asp-action="Contacto">Contacto</a>
                                </li>
                            </ul>
                        }
                        else
                        {
                            <div class="flex-grow-1"></div>
                        }
                        <div class="d-flex align-items-center">
                            @if (Context.Session.GetString("NombreUsuario") != null)
                            {
                                string userRolLayout = (Context.Session.GetString("UserRol") ?? "").Trim().ToLower();

                                <!-- Botón de Ayuda Global (Requerimiento 1.5) -->
                                <button type="button" class="btn btn-outline-secondary btn-sm me-2 rounded-pill px-3 d-flex align-items-center" onclick="abrirModalAyudaGlobal()" title="Centro de Ayuda e Instrucciones del Sistema">
                                    <i class="bi bi-question-circle-fill text-warning me-1"></i>
                                    <span class="d-none d-sm-inline">Ayuda</span>
                                </button>

                                <a href="@Url.Action("Index", "Pqr")" class="btn btn-outline-warning text-dark btn-sm me-3 rounded-pill px-3 d-flex align-items-center" title="Módulo de Peticiones, Quejas y Reclamos">
                                    <i class="bi bi-chat-heart-fill text-warning me-1"></i>
                                    <span class="d-none d-sm-inline">PQR</span>
                                </a>

                                @* Campana de notificaciones — sólo para roles que reciben notifs (no admin) *@
                                if (userRolLayout != "admin")
                                {
                                    <div class="dropdown me-3 position-relative" id="campanaDropdown">
                                        <button type="button" id="btnCampana"
                                                class="btn position-relative p-2 rounded-circle"
                                                style="background-color: transparent; border: 2px solid #e67e22; color: #e67e22; width: 40px; height: 40px; display:flex; align-items:center; justify-content:center;"
                                                data-bs-toggle="dropdown" aria-expanded="false" title="Notificaciones">
                                            <i class="bi bi-bell-fill fs-5"></i>
                                            <span id="badgeCampana"
                                                  class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
                                                  style="font-size: 0.65rem; display:none;">0</span>
                                        </button>

                                        <div class="dropdown-menu dropdown-menu-end shadow border-0 rounded-4 p-0"
                                             id="panelCampana"
                                             style="width: 360px; max-height: 480px; overflow-y: auto; overflow-x: hidden; word-break: break-word; overflow-wrap: anywhere;">
                                            <div class="d-flex justify-content-between align-items-center px-4 py-3 rounded-top-4"
                                                 style="background: linear-gradient(135deg, #1b2a47 0%, #2c3e50 100%);">
                                                <h6 class="mb-0 fw-bold text-white">
                                                    <i class="bi bi-bell-fill me-2" style="color:#e67e22;"></i>Notificaciones y Comunicados
                                                </h6>
                                                <span id="badgePanelCount" class="badge rounded-pill" style="background-color:#e67e22;">0</span>
                                            </div>
                                            <div id="listaCampana" class="p-3">
                                                <div class="text-center text-muted py-4 small">
                                                    <i class="bi bi-inbox fs-3 d-block mb-2 opacity-50"></i>
                                                    Sin comunicados nuevos
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }

                                <div class="dropdown me-2">
                                    <button class="btn btn-link text-decoration-none dropdown-toggle d-flex align-items-center fw-bold"
                                            type="button" id="dropdownMenuPerfil" data-bs-toggle="dropdown" aria-expanded="false"
                                            style="color: #0d2a4a;">
                                        <i class="bi bi-person-circle me-1"></i>
                                        @Context.Session.GetString("NombreUsuario")
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow border-0" aria-labelledby="dropdownMenuPerfil">
                                        <li>
                                            <a class="dropdown-item py-2" asp-controller="Home" asp-action="Perfil">
                                                <i class="bi bi-person-badge me-2"></i> Ver Mi Perfil
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item py-2" asp-controller="Pqr" asp-action="Index">
                                                <i class="bi bi-chat-heart-fill me-2 text-warning"></i> Mis Solicitudes PQR
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <a class="dropdown-item text-danger py-2" href="#" data-bs-toggle="modal" data-bs-target="#modalConfirmarSalida">
                                                <i class="bi bi-box-arrow-right me-2"></i> Cerrar Sesión
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            }
                            else
                            {
                                <a asp-controller="Login" asp-action="Index" class="btn text-white px-4" style="background-color: #e67e22; border-radius: 10px;">
                                    Iniciar Sesión
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </nav>
        </header>

        <div class="main-wrapper container-fluid p-0">
            <main role="main">
                @RenderBody()
            </main>
        </div>

        <footer class="border-top footer text-muted mt-5" style="background-color: #ffffff; padding: 40px 0;">
            <div class="container">
                <div class="row text-dark">
                    <div class="col-md-4">
                        <h5 class="fw-bold">PAE</h5>
                        <p class="small">Portal de Autogestión Educativa.</p>
                    </div>
                    <div class="col-md-4">
                        <h5 class="fw-bold">Enlaces</h5>
                        <ul class="list-unstyled small">
                            <li><a asp-action="Index" class="text-decoration-none text-muted">Inicio</a></li>
                            <li><a asp-action="Nosotros" class="text-decoration-none text-muted">Nosotros</a></li>
                        </ul>
                    </div>
                    <div class="col-md-4">
                        <h5 class="fw-bold">Contacto</h5>
                        <p class="small">info@pae.edu.co</p>
                    </div>
                </div>
            </div>
        </footer>

        <script src="~/lib/jquery/dist/jquery.min.js"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
        <script src="~/js/site.js" asp-append-version="true"></script>
        @await RenderSectionAsync("Scripts", required: false)

        @if (Context.Session.GetString("NombreUsuario") != null)
        {
            <text>
                <!-- Modal de advertencia de expiración de sesión -->
                <div class="modal fade" id="modalSesion" tabindex="-1" data-bs-backdrop="static">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content border-0 shadow">
                            <div class="modal-header" style="background-color: #e67e22;">
                                <h5 class="modal-title text-white">
                                    <i class="bi bi-clock-history me-2"></i>Sesión por expirar
                                </h5>
                            </div>
                            <div class="modal-body text-center py-4">
                                <p class="fs-5">Tu sesión expirará en</p>
                                <h2 id="cuentaRegresiva" class="fw-bold" style="color: #e67e22;">60</h2>
                                <p class="text-muted">segundos. ¿Deseas continuar?</p>
                            </div>
                            <div class="modal-footer justify-content-center">
                                <button onclick="continuarSesion()" class="btn btn-primary px-4">
                                    <i class="bi bi-arrow-clockwise me-1"></i> Continuar sesión
                                </button>
                                <a href="/Login/Logout" class="btn btn-outline-danger px-4">
                                    <i class="bi bi-box-arrow-right me-1"></i> Cerrar sesión
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Modal de confirmación al salir del sistema / ir al inicio -->
                <div class="modal fade" id="modalConfirmarSalida" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered" style="max-width: 480px;">
                        <div class="modal-content border-0 shadow-lg overflow-hidden" style="border-radius: 8px;">
                            <!-- Encabezado Azul Oscuro -->
                            <div class="modal-header px-4 py-3 border-0" style="background-color: #0b2b48;">
                                <h5 class="modal-title text-white fw-bold d-flex align-items-center mb-0" style="font-size: 1.25rem;">
                                    <i class="bi bi-exclamation-triangle-fill me-2 fs-4 text-white"></i>
                                    ¿Salir del sistema?
                                </h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <!-- Cuerpo del Modal -->
                            <div class="modal-body text-center py-4 px-4 bg-white">
                                <p class="fs-5 fw-medium mb-1" style="color: #1b2a47; line-height: 1.4;">
                                    Si continúas, se cerrará tu sesión actual
                                </p>
                                <p class="fs-5 fw-medium mb-0" style="color: #1b2a47; line-height: 1.4;">
                                    y tendrás que iniciar sesión de nuevo. ¿Deseas continuar?
                                </p>
                            </div>
                            <!-- Botones del Modal -->
                            <div class="modal-footer justify-content-center border-top border-light-subtle bg-white pt-3 pb-4 px-4 gap-3">
                                <button type="button" class="btn btn-outline-secondary px-4 py-2 fw-medium rounded-3" data-bs-dismiss="modal" style="min-width: 120px; border-color: #ced4da; color: #555555;">
                                    Cancelar
                                </button>
                                <a href="/Login/Logout" class="btn text-white px-4 py-2 fw-medium rounded-3" style="background-color: #e53935; border: none; min-width: 160px;">
                                    <i class="bi bi-box-arrow-right me-1"></i> Sí, cerrar sesión
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <script>
                            // Tiempo total de sesión en segundos (debe coincidir con Program.cs)
                            const TIEMPO_SESION = 15 * 60; // 15 minutos
                            const AVISO_ANTES  = 60;       // mostrar alerta 1 minuto antes

                            let tiempoRestante = TIEMPO_SESION;
                            let intervalo;
                            let modalMostrado = false;
                            const elemSesion = document.getElementById('modalSesion');
                            let modal = elemSesion ? new bootstrap.Modal(elemSesion) : null;

                            function iniciarTemporizador() {
                                if (!modal) return;
                                intervalo = setInterval(() => {
                                    tiempoRestante--;

                                    // Mostrar alerta cuando queda 1 minuto
                                    if (tiempoRestante <= AVISO_ANTES && !modalMostrado) {
                                        modalMostrado = true;
                                        modal.show();
                                        iniciarCuentaRegresiva();
                                    }

                                    // Redirigir al login cuando llega a 0
                                    if (tiempoRestante <= 0) {
                                        clearInterval(intervalo);
                                        window.location.href = '/Login/Logout';
                                    }
                                }, 1000);
                            }

                            function iniciarCuentaRegresiva() {
                                let segundos = AVISO_ANTES;
                                const cuentaRegElem = document.getElementById('cuentaRegresiva');
                                if (cuentaRegElem) cuentaRegElem.textContent = segundos;

                                let cuentaIntervalo = setInterval(() => {
                                    segundos--;
                                    if (cuentaRegElem) cuentaRegElem.textContent = segundos;
                                    if (segundos <= 0) clearInterval(cuentaIntervalo);
                                }, 1000);
                            }

                            function continuarSesion() {
                                // Hacer una petición al servidor para renovar la sesión
                                fetch('/Home/RenovarSesion')
                                    .then(() => {
                                        tiempoRestante = TIEMPO_SESION;
                                        modalMostrado  = false;
                                        if (modal) modal.hide();
                                    });
                            }

                            // Reiniciar el temporizador cuando el usuario hace algo
                            ['click', 'keypress', 'mousemove', 'scroll'].forEach(evento => {
                                document.addEventListener(evento, () => {
                                    tiempoRestante = TIEMPO_SESION;
                                    modalMostrado  = false;
                                });
                            });

                            iniciarTemporizador();
                </script>
            </text>
        }

        @* Script de la campana de notificaciones — sólo si el elemento existe en el DOM *@
        <script>
            (function () {
                const btnCampana = document.getElementById('btnCampana');
                if (!btnCampana) return; // solo aplica a roles no-admin

                const badge = document.getElementById('badgeCampana');
                const badgeCount = document.getElementById('badgePanelCount');
                const lista = document.getElementById('listaCampana');

                function renderNotif(notif) {
                    const iconos = {
                        'todos': '🌐',
                        'estudiante': '🎓',
                        'docente': '👨‍🏫',
                        'acudiente': '👨‍👩‍👧',
                        'admin': '⚙️'
                    };
                    let icono = iconos[notif.rolDestino] || '📢';
                    if (notif.rolDestino && notif.rolDestino.startsWith('user_')) {
                        if (notif.titulo && notif.titulo.toLowerCase().includes('contraseña')) {
                            icono = '🔑';
                        } else {
                            icono = '👤';
                        }
                    }

                    const esAlta = (notif.prioridad === 'alta');
                    const badgePrioridad = esAlta
                        ? `<span class="badge bg-danger rounded-pill px-2 py-0.5 ms-1" style="font-size: 0.65rem;"><i class="bi bi-exclamation-triangle-fill me-1"></i>Alta</span>`
                        : `<span class="badge bg-success-subtle text-success rounded-pill px-2 py-0.5 ms-1" style="font-size: 0.65rem;">Leve</span>`;

                    const btnDescartar = esAlta
                        ? `<span class="text-muted small" title="Notificación de alta prioridad (Obligatoria)" style="font-size: 0.7rem;"><i class="bi bi-lock-fill text-danger me-1"></i>Fija</span>`
                        : `<button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 rounded-pill btn-marcar-leida" onclick="marcarNotifLeida(event, ${notif.iD_Notificacion})" title="Marcar como leída / Descartar" style="font-size: 0.7rem;">
                            <i class="bi bi-check2-all text-success me-1"></i>Leída
                          </button>`;

                    const fechaExpHtml = notif.fechaExpiracion
                        ? `<div class="mt-1 text-muted" style="font-size:0.68rem;"><i class="bi bi-hourglass-split me-1 text-warning"></i>Expira: ${escHtml(notif.fechaExpiracion)}</div>`
                        : '';

                    const borderColor = esAlta ? '#dc3545' : '#e67e22';

                    return `<div class="card border-0 mb-2 shadow-sm rounded-3 notif-item-${notif.iD_Notificacion}" style="border-left:4px solid ${borderColor} !important; word-break: break-word; overflow-wrap: anywhere;">
                        <div class="card-body py-2 px-3">
                            <div class="d-flex justify-content-between align-items-start mb-1 gap-2">
                                <h6 class="mb-0 fw-bold small text-wrap" style="color:#1b2a47; word-break: break-word; overflow-wrap: anywhere;">
                                    ${icono} ${escHtml(notif.titulo)} ${badgePrioridad}
                                </h6>
                                <small class="text-muted text-nowrap" style="font-size: 0.7rem;">${escHtml(notif.fecha)}</small>
                            </div>
                            <p class="mb-1 text-secondary small" style="font-size:0.78rem; white-space:pre-line; word-break: break-word; overflow-wrap: anywhere;">${escHtml(notif.mensaje)}</p>
                            ${fechaExpHtml}
                            <div class="d-flex justify-content-end align-items-center mt-1">
                                ${btnDescartar}
                            </div>
                        </div>
                    </div>`;
                }

                function escHtml(str) {
                    if (!str) return '';
                    return String(str)
                        .replace(/&/g, '&amp;')
                        .replace(/</g, '&lt;')
                        .replace(/>/g, '&gt;')
                        .replace(/"/g, '&quot;');
                }

                window.marcarNotifLeida = function(event, idNotificacion) {
                    if (event) event.stopPropagation();

                    fetch('/Home/MarcarNotificacionLeida', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ idNotificacion: idNotificacion })
                    })
                    .then(r => r.json())
                    .then(res => {
                        if (res.success) {
                            cargarNotificaciones();
                        } else if (res.message) {
                            alert(res.message);
                        }
                    })
                    .catch(() => {});
                };

                function cargarNotificaciones() {
                    fetch('/Home/GetNotificacionesCampana')
                        .then(r => r.json())
                        .then(data => {
                            // Badge en el botón
                            if (data.count > 0) {
                                badge.textContent = data.count > 20 ? '20+' : data.count;
                                badge.style.display = '';
                                badgeCount.textContent = data.count;
                                btnCampana.style.backgroundColor = '#fff3e0';
                                btnCampana.style.borderColor = '#e67e22';
                                btnCampana.style.animation = 'bellShake 0.6s ease';
                            } else {
                                badge.style.display = 'none';
                                badgeCount.textContent = '0';
                                btnCampana.style.backgroundColor = 'transparent';
                                btnCampana.style.animation = '';
                            }

                            // Contenido del panel
                            if (data.items && data.items.length > 0) {
                                lista.innerHTML = data.items.map(renderNotif).join('');
                            } else {
                                lista.innerHTML = '<div class="text-center text-muted py-4 small"><i class="bi bi-inbox fs-3 d-block mb-2 opacity-50"></i>Sin comunicados nuevos</div>';
                            }
                        })
                        .catch(() => {});
                }

                // Carga inicial y polling cada 60 seg
                cargarNotificaciones();
                setInterval(cargarNotificaciones, 60000);
            })();
        </script>

        <style>
            @@keyframes bellShake {
                0%, 100% { transform: rotate(0deg); }
                20%       { transform: rotate(-15deg); }
                40%       { transform: rotate(15deg); }
                60%       { transform: rotate(-10deg); }
                80%       { transform: rotate(10deg); }
            }
            #btnCampana { transition: background-color 0.3s, box-shadow 0.3s; }
            #btnCampana:hover {
                background-color: #fff3e0 !important;
                box-shadow: 0 0 0 4px rgba(230,126,34,0.2) !important;
            }
        </style>

        <!-- FILTROS SVG DE ACCESIBILIDAD PARA DALTONISMO -->
        <svg style="position: absolute; width: 0; height: 0; overflow: hidden; pointer-events: none; opacity: 0;" aria-hidden="true">
            <defs>
                <!-- Protanopía (Rojo-Ciego) -->
                <filter id="protanopia-filter">
                    <feColorMatrix type="matrix" values="
                        0.56667 0.43333 0.00000 0 0
                        0.55833 0.44167 0.00000 0 0
                        0.00000 0.24167 0.75833 0 0
                        0       0       0       1 0"/>
                </filter>
                <!-- Deuteranopía (Verde-Ciego) -->
                <filter id="deuteranopia-filter">
                    <feColorMatrix type="matrix" values="
                        0.625 0.375 0.000 0 0
                        0.700 0.300 0.000 0 0
                        0.000 0.300 0.700 0 0
                        0     0     0     1 0"/>
                </filter>
                <!-- Tritanopía (Azul-Ciego) -->
                <filter id="tritanopia-filter">
                    <feColorMatrix type="matrix" values="
                        0.950 0.050 0.000 0 0
                        0.000 0.433 0.567 0 0
                        0.000 0.475 0.525 0 0
                        0     0     0     1 0"/>
                </filter>
            </defs>
        </svg>

        <!-- WIDGET FLOTANTE DE ACCESIBILIDAD (DALTONISMO) -->
        <div class="accesibilidad-widget dropdown dropup">
            <button type="button" class="accesibilidad-btn" data-bs-toggle="dropdown" aria-expanded="false" title="Filtros de Accesibilidad Visual (Daltonismo)">
                <i class="bi bi-universal-access"></i>
            </button>
            <div class="dropdown-menu accesibilidad-menu p-3 border-0 shadow-lg rounded-4 mb-2">
                <div class="d-flex align-items-center mb-2 pb-2 border-bottom">
                    <i class="bi bi-eye-fill me-2 fs-5" style="color: #e67e22;"></i>
                    <div>
                        <h6 class="mb-0 fw-bold" style="color: #1b2a47;">Accesibilidad Visual</h6>
                        <small class="text-muted" style="font-size: 0.72rem;">Filtros para Daltonismo</small>
                    </div>
                </div>
                <div class="vstack gap-1" id="opcionesDaltonismo">
                    <div class="accesibilidad-item d-flex align-items-center justify-content-between" onclick="aplicarFiltroDaltonismo('normal')" data-filtro="normal">
                        <span>👁️ Visión Normal</span>
                        <i class="bi bi-check-circle-fill text-success d-none check-filtro"></i>
                    </div>
                    <div class="accesibilidad-item d-flex align-items-center justify-content-between" onclick="aplicarFiltroDaltonismo('deuteranopia')" data-filtro="deuteranopia">
                        <div>
