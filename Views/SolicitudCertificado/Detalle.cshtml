@model ProyectoPAE.Models.SolicitudCertificadoDetalleViewModel
@using ProyectoPAE.Models
@{
    var s = Model.Solicitud;
    var p = Model.Plazo;
    ViewData["Title"] = "Solicitud " + s.CodigoRadicado;

    string rolActual = ViewBag.RolActual ?? "estudiante";
    bool esGestor = Model.EsGestor;
    bool abierta = s.Estado == EstadoSolicitudCertificado.Pendiente || s.Estado == EstadoSolicitudCertificado.EnProceso;

    string badgePlazo = "bg-" + p.Clase + (p.Clase == "warning" ? " text-dark" : " text-white");
    string badgeEstado = s.Estado == "Entregada" ? "bg-success text-white"
        : s.Estado == "En proceso" ? "bg-info text-dark"
        : s.Estado == "Cancelada" ? "bg-secondary text-white"
        : "bg-light text-dark border";
    string hoy = DateTime.Now.ToString("yyyy-MM-dd");
}

<div class="container-fluid py-3 px-md-4">
    <div class="panel-con-sidebar">
        <!-- Barra lateral contextual según el rol del usuario -->
        @if (rolActual == "admin" || rolActual == "coordinador")
        {
            @await Html.PartialAsync("_SidebarAdmin")
        }
        else if (rolActual == "docente")
        {
            @await Html.PartialAsync("_SidebarDocente")
        }
        else if (rolActual == "acudiente" || rolActual == "padre")
        {
            @await Html.PartialAsync("_SidebarAcudiente")
        }
        else
        {
            @await Html.PartialAsync("_SidebarEstudiante")
        }

        <main class="submodulo-activo flex-grow-1" role="main" aria-label="Detalle de la solicitud">
            <div class="card pae-header-card border-0 mb-4 p-4 shadow-sm" style="background: linear-gradient(135deg, #0d2a4a 0%, #1a3d66 100%);">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <div class="text-white">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="badge @badgeEstado px-2.5 py-1 rounded-pill fw-bold">@s.Estado</span>
                            <span class="badge @badgePlazo px-2.5 py-1 rounded-pill fw-bold"><i class="bi @p.Icono me-1"></i>@p.Texto</span>
                        </div>
                        <h2 class="h3 fw-bold mb-1 text-white">
                            <i class="bi bi-file-earmark-text-fill me-2" style="color: #e67e22;"></i>Solicitud @s.CodigoRadicado
                        </h2>
                        <p class="text-white-50 mb-0 small">@EstadoSolicitudCertificado.NombreTipo(s.TipoCertificado) &bull; @s.NombreEstudiante</p>
                    </div>
                    <a href="@Url.Action("Index", "SolicitudCertificado")" class="btn btn-outline-light rounded-pill px-3">
                        <i class="bi bi-arrow-left me-1"></i> Volver a solicitudes
                    </a>
                </div>
            </div>

            @if (TempData["Exito"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 d-flex align-items-center gap-2" role="alert" aria-live="polite">
                    <i class="bi bi-check-circle-fill fs-5 text-success"></i>
                    <div>@TempData["Exito"]</div>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 d-flex align-items-center gap-2" role="alert" aria-live="assertive">
                    <i class="bi bi-exclamation-triangle-fill fs-5 text-danger"></i>
                    <div>@TempData["Error"]</div>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                </div>
            }

            @if (p.Clave == "vencida" || p.Clave == "por-vencer")
            {
                <div class="alert alert-@p.Clase d-flex align-items-center gap-3 shadow-sm border-0" role="alert">
                    <i class="bi @p.Icono fs-4"></i>
                    <div>
                        <strong>@p.Texto.</strong>
                        La fecha límite de entrega es el @s.FechaLimite.ToString("dd/MM/yyyy").
                    </div>
                </div>
            }

            <div class="row g-4">
                <!-- Datos de la solicitud -->
                <div class="col-lg-6">
                    <div class="card border-0 shadow-sm rounded-3 h-100">
                        <div class="card-header bg-white fw-bold border-0 pt-3">
                            <i class="bi bi-person-vcard-fill me-1 text-primary"></i> Datos de la solicitud
                        </div>
                        <div class="card-body">
                            <dl class="row mb-0">
                                <dt class="col-sm-5">Radicado</dt>
                                <dd class="col-sm-7">@s.CodigoRadicado</dd>
                                <dt class="col-sm-5">Estudiante</dt>
                                <dd class="col-sm-7">@s.NombreEstudiante</dd>
                                <dt class="col-sm-5">Certificado</dt>
                                <dd class="col-sm-7">@EstadoSolicitudCertificado.NombreTipo(s.TipoCertificado)</dd>
                                <dt class="col-sm-5">Solicitado por</dt>
                                <dd class="col-sm-7">@s.NombreSolicitante <span class="text-muted">(@s.RolSolicitante)</span></dd>
                                <dt class="col-sm-5">Observaciones</dt>
                                <dd class="col-sm-7">@(string.IsNullOrWhiteSpace(s.ObservacionesSolicitante) ? "—" : s.ObservacionesSolicitante)</dd>
                                @if (esGestor && !string.IsNullOrWhiteSpace(s.NombreGestor))
                                {
                                    <dt class="col-sm-5">Última gestión</dt>
                                    <dd class="col-sm-7">@s.NombreGestor</dd>
                                }
                            </dl>
                        </div>
                    </div>
                </div>

                <!-- Plazo de entrega -->
                <div class="col-lg-6">
                    <div class="card border-0 shadow-sm rounded-3 h-100">
                        <div class="card-header bg-white fw-bold border-0 pt-3">
                            <i class="bi bi-calendar-check-fill me-1 text-warning"></i> Plazo de entrega
                        </div>
                        <div class="card-body">
                            <dl class="row mb-0">
                                <dt class="col-sm-5">Fecha de solicitud</dt>
                                <dd class="col-sm-7">@s.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")</dd>
                                <dt class="col-sm-5">Fecha límite</dt>
                                <dd class="col-sm-7 fw-bold">@s.FechaLimite.ToString("dd/MM/yyyy")</dd>
                                <dt class="col-sm-5">Estado</dt>
                                <dd class="col-sm-7"><span class="badge @badgeEstado">@s.Estado</span></dd>
                                <dt class="col-sm-5">Plazo</dt>
                                <dd class="col-sm-7"><span class="badge @badgePlazo"><i class="bi @p.Icono me-1"></i>@p.Texto</span></dd>
                                <dt class="col-sm-5">Fecha de entrega</dt>
                                <dd class="col-sm-7">@(s.FechaEntrega.HasValue ? s.FechaEntrega.Value.ToString("dd/MM/yyyy HH:mm") : "Aún no entregada")</dd>
                            </dl>

                            @if (Model.Certificado != null)
                            {
                                <hr />
                                <div class="small text-muted mb-2">Certificado generado: <strong>@Model.Certificado.CodigoVerificacion</strong> (emitido el @Model.Certificado.FechaEmision.ToString("dd/MM/yyyy"))</div>
                                <a href="@Url.Action("Confirmacion", "Certificado", new { id = Model.Certificado.IdCertificado })" class="btn btn-sm btn-outline-primary me-1">
                                    <i class="bi bi-eye-fill me-1"></i>Ver certificado
                                </a>
                                <a href="@Url.Action("DescargarPdf", "Certificado", new { id = Model.Certificado.IdCertificado })" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-file-earmark-pdf-fill me-1"></i>Descargar PDF
                                </a>
                            }
                        </div>
                    </div>
                </div>

                <!-- Gestión (solo coordinador y admin) -->
                @if (esGestor && abierta)
                {
                    <div class="col-12">
                        <div class="card border-0 shadow-sm rounded-3">
                            <div class="card-header bg-white fw-bold border-0 pt-3">
                                <i class="bi bi-gear-fill me-1 text-secondary"></i> Gestión de la solicitud
                            </div>
                            <div class="card-body">
                                <div class="d-flex flex-wrap gap-2 mb-3">
                                    @if (s.Estado == EstadoSolicitudCertificado.Pendiente)
                                    {
                                        <form method="post" action="@Url.Action("CambiarEstado", "SolicitudCertificado")" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@s.IdSolicitud" />
                                            <input type="hidden" name="estado" value="@EstadoSolicitudCertificado.EnProceso" />
                                            <button type="submit" class="btn btn-info text-dark fw-semibold">
                                                <i class="bi bi-play-circle-fill me-1"></i>Iniciar trámite
                                            </button>
                                        </form>
                                    }

                                    @if (s.TipoCertificado == EstadoSolicitudCertificado.TipoMatricula)
                                    {
                                        <form method="post" action="@Url.Action("EntregarMatricula", "SolicitudCertificado")" class="d-inline"
                                              onsubmit="return confirm('Se generará la constancia de matrícula y la solicitud quedará entregada. ¿Continuar?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@s.IdSolicitud" />
                                            <button type="submit" class="btn btn-success fw-semibold">
                                                <i class="bi bi-patch-check-fill me-1"></i>Generar y entregar constancia
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <a href="@Url.Action("Generar", "Certificado", new { idEstudiante = s.IdEstudiante, idSolicitud = s.IdSolicitud })" class="btn btn-success fw-semibold">
                                            <i class="bi bi-patch-check-fill me-1"></i>Generar certificado de notas
                                        </a>
                                    }
                                </div>

                                <div class="accordion" id="accionesSolicitud">
                                    <div class="accordion-item">
                                        <h2 class="accordion-header">
                                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#colEntrega">
                                                Registrar entrega manual
                                            </button>
                                        </h2>
                                        <div id="colEntrega" class="accordion-collapse collapse" data-bs-parent="#accionesSolicitud">
                                            <div class="accordion-body">
                                                <p class="small text-muted">Úsalo cuando el certificado ya se entregó por otra vía (por ejemplo, se generó desde el reporte grupal).</p>
                                                <form method="post" action="@Url.Action("RegistrarEntrega", "SolicitudCertificado")" class="row g-2 align-items-end">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@s.IdSolicitud" />
                                                    <div class="col-md-3">
                                                        <label class="form-label small fw-semibold mb-1">Fecha de entrega</label>
                                                        <input type="date" name="fechaEntrega" value="@hoy" max="@hoy" min="@s.FechaSolicitud.ToString("yyyy-MM-dd")" class="form-control" />
                                                    </div>
                                                    <div class="col-md-7">
                                                        <label class="form-label small fw-semibold mb-1">Observaciones (opcional)</label>
                                                        <input type="text" name="observaciones" maxlength="300" class="form-control" />
                                                    </div>
                                                    <div class="col-md-2">
                                                        <button type="submit" class="btn btn-outline-success w-100">Registrar</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="accordion-item">
                                        <h2 class="accordion-header">
                                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#colPlazo">
                                                Ajustar plazo
                                            </button>
                                        </h2>
                                        <div id="colPlazo" class="accordion-collapse collapse" data-bs-parent="#accionesSolicitud">
                                            <div class="accordion-body">
                                                <form method="post" action="@Url.Action("AjustarPlazo", "SolicitudCertificado")" class="row g-2 align-items-end">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@s.IdSolicitud" />
                                                    <div class="col-md-3">
                                                        <label class="form-label small fw-semibold mb-1">Nueva fecha límite</label>
                                                        <input type="date" name="fechaLimite" value="@s.FechaLimite.ToString("yyyy-MM-dd")" min="@s.FechaSolicitud.ToString("yyyy-MM-dd")" class="form-control" required />
                                                    </div>
                                                    <div class="col-md-7">
                                                        <label class="form-label small fw-semibold mb-1">Motivo del ajuste</label>
                                                        <input type="text" name="motivo" maxlength="300" minlength="5" class="form-control" required />
                                                    </div>
                                                    <div class="col-md-2">
                                                        <button type="submit" class="btn btn-outline-primary w-100">Ajustar</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="accordion-item">
                                        <h2 class="accordion-header">
                                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#colCancelar">
                                                Cancelar solicitud
                                            </button>
                                        </h2>
                                        <div id="colCancelar" class="accordion-collapse collapse" data-bs-parent="#accionesSolicitud">
                                            <div class="accordion-body">
                                                <form method="post" action="@Url.Action("CambiarEstado", "SolicitudCertificado")" class="row g-2 align-items-end"
                                                      onsubmit="return confirm('¿Seguro que deseas cancelar esta solicitud? Esta acción no se puede deshacer.');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@s.IdSolicitud" />
                                                    <input type="hidden" name="estado" value="@EstadoSolicitudCertificado.Cancelada" />
                                                    <div class="col-md-10">
                                                        <label class="form-label small fw-semibold mb-1">Motivo de la cancelación</label>
                                                        <input type="text" name="observaciones" maxlength="300" minlength="5" class="form-control" required />
                                                    </div>
                                                    <div class="col-md-2">
                                                        <button type="submit" class="btn btn-outline-danger w-100">Cancelar solicitud</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <!-- Bitácora de gestión -->
                @if (esGestor && !string.IsNullOrWhiteSpace(s.ObservacionesGestion))
                {
                    <div class="col-12">
                        <div class="card border-0 shadow-sm rounded-3">
                            <div class="card-header bg-white fw-bold border-0 pt-3">
                                <i class="bi bi-journal-text me-1 text-secondary"></i> Bitácora de gestión
                            </div>
                            <div class="card-body">
                                <div class="small" style="white-space: pre-line;">@s.ObservacionesGestion</div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </main>
    </div>
</div>
