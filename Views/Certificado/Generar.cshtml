@model List<ProyectoPAE.Models.Calificacion>

@{
    ViewData["Title"] = "Generar Certificado";
    var estudiante = ViewBag.Estudiante as ProyectoPAE.Models.Usuario;
}

<div class="container mt-4">
    <div class="d-flex align-items-center justify-content-between p-3 rounded-3 text-white mb-4"
         style="background: var(--pae-gradient-primary);">
        <div class="d-flex align-items-center gap-3">
            <div class="rounded-circle d-flex align-items-center justify-content-center"
                 style="width:50px;height:50px;background:rgba(255,255,255,.18); flex-shrink: 0;">
                <i class="bi bi-patch-check-fill fs-3 text-white"></i>
            </div>
            <div>
                <h4 class="mb-0 fw-bold">Generar Certificado</h4>
                <small class="opacity-75">Expedición oficial de constancias y certificados académicos</small>
            </div>
        </div>
        <a href="javascript:void(0);" onclick="volverGenerarCertificado()" class="btn btn-pae-volver">
            <i class="bi bi-arrow-left me-1"></i> Volver al Panel
        </a>
    </div>

    <div class="card border-0 shadow-sm p-4">
        <p class="fs-5 mb-4"><strong>Estudiante:</strong> @estudiante?.NOMBRES @estudiante?.APELLIDOS</p>

        <form asp-action="Generar" method="post">
            <input type="hidden" name="idEstudiante" value="@estudiante?.ID_Usuario" />

            <div class="mb-4">
                <label class="form-label fw-bold">Tipo de certificado</label>
                <input type="text" name="tipoCertificado" class="form-control" value="Reporte de calificaciones" />
            </div>

            <div class="table-responsive mb-4">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 50px;">
                                <input type="checkbox" id="checkTodos" class="form-check-input" checked onchange="toggleSeleccionarTodos(this)" title="Seleccionar todas" />
                            </th>
                            <th>Materia</th>
                            <th>Periodo</th>
                            <th>Nota</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model == null || !Model.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-3">
                                    <i class="bi bi-info-circle me-1"></i> No se encontraron calificaciones registradas para este estudiante.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var c in Model)
                            {
                                <tr>
                                    <td>
                                        <input type="checkbox" name="idsCalificacion" value="@c.ID_Calificacion" class="form-check-input check-materia" checked />
                                    </td>
                                    <td><strong>@c.Materia</strong></td>
                                    <td><span class="badge bg-secondary-subtle text-secondary border rounded-pill px-2">Periodo @c.Periodo</span></td>
                                    <td><span class="fw-bold @(c.Nota >= 3.0m ? "text-success" : "text-danger")">@c.Nota.ToString("F1")</span></td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a href="javascript:void(0);" onclick="volverGenerarCertificado()" class="btn btn-pae-volver">
                    <i class="bi bi-arrow-left me-1"></i> Volver
                </a>
                <button type="submit" class="btn btn-primary" @(Model == null || !Model.Any() ? "disabled" : "")>Generar certificado</button>
            </div>
        </form>
    </div>
</div>

<script>
    function toggleSeleccionarTodos(master) {
        const checkboxes = document.querySelectorAll('.check-materia');
        checkboxes.forEach(cb => cb.checked = master.checked);
    }

    function volverGenerarCertificado() {
        if (document.referrer && document.referrer !== window.location.href && !document.referrer.includes('login')) {
            window.location.href = document.referrer;
        } else if (window.history.length > 1) {
            window.history.back();
        } else {
            window.location.href = '@Url.Action("Dashboard", "Home")';
        }
    }
</script>
