@model List<ProyectoPAE.Models.Calificacion>

@{
    ViewData["Title"] = "Generar Certificado";
    var estudiante = ViewBag.Estudiante as ProyectoPAE.Models.Usuario;
}

<div class="container mt-4">
    <div class="d-flex align-items-center justify-content-between p-3 rounded-3 text-white mb-4"
         style="background: var(--pae-gradient-primary);">
        <div class="d-flex align-items-center gap-3">
            <div class="rounded-circle d-flex align-items-center justify-content-center"
                 style="width:50px;height:50px;background:rgba(255,255,255,.18); flex-shrink: 0;">
                <i class="bi bi-patch-check-fill fs-3 text-white"></i>
            </div>
            <div>
                <h4 class="mb-0 fw-bold">Generar Certificado</h4>
                <small class="opacity-75">Expedición oficial de constancias y certificados académicos</small>
            </div>
        </div>
        <button onclick="history.back()" class="btn btn-pae-volver">
            Volver al Panel
        </button>
    </div>

    <div class="card border-0 shadow-sm p-4">
        <p class="fs-5 mb-4"><strong>Estudiante:</strong> @estudiante?.NOMBRES @estudiante?.APELLIDOS</p>

        <form asp-action="Generar" method="post">
            <input type="hidden" name="idEstudiante" value="@estudiante?.ID_Usuario" />

            <div class="mb-4">
                <label class="form-label fw-bold">Tipo de certificado</label>
                <input type="text" name="tipoCertificado" class="form-control" value="Reporte de calificaciones" />
            </div>

            <div class="table-responsive mb-4">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 50px;"></th>
                            <th>Materia</th>
                            <th>Periodo</th>
                            <th>Nota</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model)
                        {
                            <tr>
                                <td>
                                    <input type="checkbox" name="idsCalificacion" value="@c.ID_Calificacion" class="form-check-input" />
                                </td>
                                <td>@c.Materia</td>
                                <td>@c.Periodo</td>
                                <td>@c.Nota</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <button type="button" onclick="history.back()" class="btn btn-pae-volver">Volver</button>
                <button type="submit" class="btn btn-primary">Generar certificado</button>
            </div>
        </form>
    </div>
</div>
