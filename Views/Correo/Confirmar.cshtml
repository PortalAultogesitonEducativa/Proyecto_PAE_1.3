@model ProyectoPAE.Servicios.ResultadoCambioCorreo
@{
    ViewData["Title"] = "Confirmación de correo";
}

<div class="container my-5" style="max-width: 560px;">
    <div class="card shadow-lg border-0 text-center">
        <div class="card-body p-5">
            @if (Model.Exito)
            {
                <i class="bi bi-check-circle-fill text-success" style="font-size: 3.5rem;"></i>
                <h3 class="mt-3 mb-2">Correo confirmado</h3>
            }
            else
            {
                <i class="bi bi-x-circle-fill text-danger" style="font-size: 3.5rem;"></i>
                <h3 class="mt-3 mb-2">No se pudo confirmar</h3>
            }

            <p class="text-muted">@Model.Mensaje</p>

            <div class="d-flex justify-content-center gap-2 mt-4">
                @if (Model.Exito)
                {
                    <a href="@Url.Action("Index", "Login")" class="btn btn-primary px-4">Iniciar sesión</a>
                }
                else
                {
                    <a href="@Url.Action("EditarPerfil", "Home")" class="btn btn-primary px-4">Ir a mi perfil</a>
                    <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary px-4">Ir al inicio</a>
                }
            </div>
        </div>
    </div>
</div>
