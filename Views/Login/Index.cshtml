@{
    ViewData["Title"] = "Iniciar Sesión";
}
<style>
    .login-bg {
        position: fixed;
        top: -30px;
        left: -30px;
        right: -30px;
        bottom: -30px;
        background-image: url('@Url.Content("~/images/login-bg.jpg")');
        background-size: cover;
        background-position: center center;
        background-repeat: no-repeat;
        filter: blur(10px) brightness(0.85);
        transform: scale(1.08);
        z-index: -2;
    }

    .login-bg-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(135deg, rgba(13, 42, 74, 0.45) 0%, rgba(20, 61, 106, 0.3) 100%);
        backdrop-filter: blur(2px);
        z-index: -1;
    }

    .btn-login-main {
        background-color: #0d2a4a;
        border-radius: 10px;
        border: none;
        transition: all 0.3s ease;
    }

        .btn-login-main:hover {
            background-color: #143d6a;
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(13, 42, 74, 0.25);
        }

    .btn-login-forgot {
        background-color: #0d2a4a;
        color: #ffffff !important;
        border-radius: 10px;
        border: none;
        transition: all 0.3s ease;
    }

        .btn-login-forgot:hover {
            background-color: #081a2e;
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(13, 42, 74, 0.25);
        }

    .text-capslock {
        color: #0d2a4a;
    }
</style>

<div class="login-bg"></div>
<div class="login-bg-overlay"></div>
 
<div class="container my-5 py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card border-0 shadow-lg" style="border-radius: 20px; background-color: #fdf8f3;">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <img src="~/images/logo.png" alt="PAE" style="height: 80px;" class="mb-3">
                        <h3 class="fw-bold" style="color: #0d2a4a;">Bienvenido a PAE</h3>
                        <p class="text-muted small">Portal de Autogestión Educativa</p>
                    </div>
 
                    <form asp-action="Ingresar" asp-controller="Login" method="post">
 
                        <div class="mb-3">
                            <label class="form-label fw-bold">Usuario o Correo</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0">
                                    <i class="bi bi-person"></i>
                                </span>
                                <input type="text" name="correo"
                                       class="form-control @(ViewBag.ErrorCorreo != null ? "is-invalid" : "")"
                                       placeholder="correo@ejemplo.com" required>
                            </div>
                        </div>
 
                        <div class="mb-4">
                            <label class="form-label fw-bold">Contraseña</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0">
                                    <i class="bi bi-lock"></i>
                                </span>
                                <input type="password" id="passwordInput" name="password"
                                       class="form-control bg-light border-start-0 border-end-0 @(ViewBag.ErrorPassword != null ? "is-invalid" : "")"
                                       placeholder="••••••••" required>
                                <button class="btn btn-light border border-start-0"
                                        type="button" onclick="togglePassword()">
                                    <i id="toggleIcon" class="bi bi-eye"></i>
                                </button>
                            </div>
                            <small id="capsLockWarning" class="text-capslock fw-bold d-none">
                                <i class="bi bi-exclamation-triangle-fill me-1"></i>Bloq Mayús activado
                            </small>
                        </div>
 
                        <div class="d-grid gap-3 mb-3">
                            <button type="submit" class="btn btn-lg text-white btn-login-main">
                                Ingresar al Sistema
                            </button>
                            <a href="/Login/OlvideContraseña"
                               class="btn btn-lg text-white btn-login-forgot d-flex justify-content-center align-items-center">
                                <i class="bi bi-question-circle me-2"></i> ¿Olvidó su contraseña?
                            </a>
                        </div>
 
                    </form>

                    <div class="text-center mt-4 pt-3 border-top">
                        <small class="text-muted d-block fw-semibold" style="font-size: 0.78rem;">
                            &copy; @DateTime.Now.Year Portal de Autogestión Educativa - PAE. Todos los derechos reservados.
                        </small>
                        <small class="text-muted d-block mt-1" style="font-size: 0.73rem;">
                            Tratamiento de datos conforme a la Ley 1581 de 2012 de Colombia.
                            <br />
                            <a asp-controller="Home" asp-action="Politicas" class="text-primary text-decoration-none fw-bold">
                                <i class="bi bi-shield-check me-1"></i>Ver Políticas de Protección de Datos
                            </a>
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
 
@* {{!-- MODAL ERROR CORREO --}} *@
@if (ViewBag.ErrorCorreo != null)
{
    <div class="modal fade show d-block" tabindex="-1"
         style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
                <div class="modal-header border-0"
                     style="background-color: #E77A1F; border-radius: 16px 16px 0 0;">
                    <h5 class="modal-title text-white w-100 text-center">
                        <i class="bi bi-envelope-x-fill me-2"></i>Correo incorrecto
                    </h5>
                </div>
                <div class="modal-body text-center px-4 py-4">
                    <i class="bi bi-exclamation-circle-fill text-warning mb-3"
                       style="font-size: 2.5rem;"></i>
                    <p class="fw-bold mb-1">@ViewBag.ErrorCorreo</p>
                    <p class="text-muted small">
                        Verifica que el correo esté bien escrito e intenta de nuevo.
                    </p>
                </div>
                <div class="modal-footer border-0 pt-0 px-4 pb-4">
                    <button type="button" class="btn btn-warning w-100 text-white"
                            style="border-radius: 10px;"
                            onclick="cerrarModal(this)">
                        <i class="bi bi-arrow-left me-2"></i>Volver a intentarlo
                    </button>
                </div>
            </div>
        </div>
    </div>
}
 
@* {{!-- MODAL ERROR CONTRASEÑA --}} *@
@if (ViewBag.ErrorPassword != null)
{
    <div class="modal fade show d-block" tabindex="-1"
         style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
                <div class="modal-header border-0"
                     style="background-color: #E77A1F border-radius: 16px 16px 0 0;">
                    <h5 class="modal-title text-white w-100 text-center">
                        <i class="bi bi-lock-fill me-2"></i>Contraseña incorrecta
                    </h5>
                </div>
                <div class="modal-body text-center px-4 py-4">
                    <i class="bi bi-shield-exclamation text-warning mb-3"
                       style="font-size: 2.5rem;"></i>
                    <p class="fw-bold mb-1">@ViewBag.ErrorPassword</p>
                    <p class="text-muted small">
                        Recuerda que después de 3 intentos fallidos
                        tu cuenta será bloqueada por seguridad.
                    </p>
                </div>
                <div class="modal-footer border-0 pt-0 px-4 pb-4">
                    <button type="button" class="btn w-100 text-white"
                            style="border-radius: 10px; background-color: #E77A1F;"
                            onclick="cerrarModal(this)">
                        <i class="bi bi-arrow-left me-2"></i>Volver a intentarlo
                    </button>
                </div>
            </div>
        </div>
    </div>
}
 
@* {{!-- MODAL BLOQUEO TEMPORAL (15 MINUTOS) --}} *@
@if (ViewBag.BloqueoTemporal == true)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.6);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
                <div class="modal-header border-0" style="background-color: #d97706; border-radius: 16px 16px 0 0;">
                    <h5 class="modal-title text-white w-100 text-center pb-1">
                        <i class="bi bi-clock-history me-2"></i>Acceso Bloqueado Temporalmente
                    </h5>
                </div>
                <div class="modal-body text-center px-4 py-4">
                    <i class="bi bi-hourglass-split text-warning mb-3" style="font-size: 3rem;"></i>
                    <h5 class="fw-bold mb-2">Bloqueo de 15 minutos</h5>
                    <p class="text-secondary small mb-2">
                        @(ViewBag.MensajeBloqueo ?? $"Ha fallado 3 intentos consecutivos. Su acceso se ha pausado por {ViewBag.MinutosRestantes ?? 15} minutos.")
                    </p>
                    <div class="alert alert-warning py-2 mb-0 small">
                        <i class="bi bi-shield-exclamation me-1"></i>
                        Al transcurrir este lapso, el sistema le habilitará automáticamente 3 nuevos intentos.
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0 px-4 pb-4">
                    <button type="button" class="btn btn-warning w-100 text-white fw-bold" style="border-radius: 10px;" onclick="cerrarModal(this)">
                        Entendido, esperaré el tiempo
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* {{!-- MODAL ESTUDIANTE VETADO (MATRÍCULA CANCELADA O FINALIZADA) --}} *@
@if (ViewBag.EstudianteVetado == true)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.65);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
                <div class="modal-header border-0 bg-danger text-white" style="border-radius: 16px 16px 0 0;">
                    <h5 class="modal-title text-white w-100 text-center pb-1">
                        <i class="bi bi-slash-circle-fill me-2"></i>Acceso Denegado (Matrícula Inactiva)
                    </h5>
                </div>
                <div class="modal-body text-center px-4 py-4">
                    <i class="bi bi-person-x-fill text-danger mb-3" style="font-size: 3.2rem;"></i>
                    <h5 class="fw-bold mb-2 text-danger">Usuario Inactivo / Vetado</h5>
                    <p class="text-secondary small mb-3">
                        @(ViewBag.MensajeBloqueo ?? "Su matrícula académica ha sido Cancelada o Finalizada. Su cuenta ha sido inhabilitada para acceder al portal.")
                    </p>
                    <div class="alert alert-danger py-2 mb-0 small text-start">
                        <i class="bi bi-info-circle-fill me-1"></i>
                        <strong>Motivo institucional:</strong> Al no contar con una matrícula activa vigente, los servicios de acompañamiento y notas han sido suspendidos. Por favor comuníquese con Secretaría Académica.
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0 px-4 pb-4">
                    <button type="button" class="btn btn-secondary w-100" style="border-radius: 10px;" onclick="cerrarModal(this)">
                        Cerrar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* {{!-- MODAL CUENTA INACTIVA / DESACTIVADA --}} *@
@if (ViewBag.CuentaInactiva == true)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.65);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
                <div class="modal-header border-0 bg-secondary text-white" style="border-radius: 16px 16px 0 0;">
                    <h5 class="modal-title text-white w-100 text-center pb-1">
                        <i class="bi bi-person-slash me-2"></i>Cuenta Inactiva
                    </h5>
                </div>
                <div class="modal-body text-center px-4 py-4">
                    <i class="bi bi-shield-x text-secondary mb-3" style="font-size: 3.2rem;"></i>
                    <h5 class="fw-bold mb-2">Usuario Deshabilitado</h5>
                    <p class="text-secondary small mb-0">
                        @(ViewBag.MensajeBloqueo ?? "Su cuenta se encuentra desactivada en la plataforma. Comuníquese con la administración.")
                    </p>
                </div>
                <div class="modal-footer border-0 pt-0 px-4 pb-4">
                    <button type="button" class="btn btn-secondary w-100" style="border-radius: 10px;" onclick="cerrarModal(this)">
                        Cerrar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* {{!-- MODAL CUENTA BLOQUEADA DEFINITIVA (3ER CICLO: RECUPERACIÓN OBLIGATORIA) --}} *@
@if (ViewBag.CuentaBloqueadaDefinitiva == true || ViewBag.CuentaBloqueada == true)
{
    <div class="modal fade show d-block" tabindex="-1"
         style="background: rgba(0,0,0,0.65);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
                <div class="modal-header border-0"
                     style="background-color: #7f1d1d; border-radius: 16px 16px 0 0;">
                    <h5 class="modal-title text-white w-100 text-center pb-2">
                        <i class="bi bi-shield-lock-fill me-2"></i>Bloqueo Definitivo de Seguridad
                    </h5>
                </div>
                <div class="modal-body text-center px-4 py-4">
                    <i class="bi bi-exclamation-triangle-fill text-danger mb-3"
                       style="font-size: 3rem;"></i>
                    <h5 class="fw-bold mb-2">Tercer Ciclo de Fallos Agotado</h5>
                    <p class="text-secondary small mb-3">
                        @(ViewBag.MensajeBloqueo ?? "Su cuenta ha sido bloqueada definitivamente. Se ha enviado un correo con instrucciones para restablecer obligatoriamente su contraseña.")
                    </p>
                    <div class="alert alert-danger py-2 mb-0 small text-start">
                        <i class="bi bi-key-fill me-1"></i>
                        <strong>Recuperación Obligatoria:</strong> Debe ingresar a su correo institucional o hacer clic a continuación para generar una nueva clave segura y desbloquear su cuenta.
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0 px-4 pb-4">
                    <a href="/Login/OlvideContraseña"
                       class="btn btn-danger w-100 fw-bold"
                       style="border-radius: 10px;">
                        <i class="bi bi-envelope-paper-heart-fill me-2"></i>Ir a Restablecer Contraseña
                    </a>
                </div>
            </div>
        </div>
    </div>
}
 
<script>
    function togglePassword() {
        const passwordInput = document.getElementById('passwordInput');
        const toggleIcon = document.getElementById('toggleIcon');
        if (passwordInput.type === 'password') {
            passwordInput.type = 'text';
            toggleIcon.classList.replace('bi-eye', 'bi-eye-slash');
        } else {
            passwordInput.type = 'password';
            toggleIcon.classList.replace('bi-eye-slash', 'bi-eye');
        }
    }
 
    function cerrarModal(btn) {
        // Oculta el modal y quita el fondo oscuro
        const modal = btn.closest('.modal');
        modal.classList.remove('show', 'd-block');
        modal.style.display = 'none';
    }
 
    // Aviso de Bloq Mayús activado en el campo de contraseña
    (function() {
        const passwordInput = document.getElementById('passwordInput');
        const capsLockWarning = document.getElementById('capsLockWarning');
 
        function checkCapsLock(event) {
            if (typeof event.getModifierState === 'function') {
                const activo = event.getModifierState('CapsLock');
                capsLockWarning.classList.toggle('d-none', !activo);
            }
        }
 
        passwordInput.addEventListener('keydown', checkCapsLock);
        passwordInput.addEventListener('keyup', checkCapsLock);
        passwordInput.addEventListener('blur', function() {
            capsLockWarning.classList.add('d-none');
        });
    })();
</script>