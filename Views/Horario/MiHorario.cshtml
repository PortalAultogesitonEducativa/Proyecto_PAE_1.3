@model IEnumerable<ProyectoPAE.Models.HorarioDetalleViewModel>

@*
    ===================================================================
    VISTA: MiHorario.cshtml
    PROPÓSITO: Renderizar la matriz de horarios semanal para docentes y alumnos,
