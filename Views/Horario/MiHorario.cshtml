    ViewData["Title"] = "Horario de Clases - Docente";

    var diasSemana = new[] { "Lunes", "Martes", "Miércoles", "Jueves", "Viernes" };
    var meses = new Dictionary<int, string>
    {
        { 1, "Enero" }, { 2, "Febrero" }, { 3, "Marzo" }, { 4, "Abril" },
        { 5, "Mayo" }, { 6, "Junio" }, { 7, "Julio" }, { 8, "Agosto" },
        { 9, "Septiembre" }, { 10, "Octubre" }, { 11, "Noviembre" }, { 12, "Diciembre" }
    };

    int mesActual = ViewBag.MesSeleccionado != null ? (int)ViewBag.MesSeleccionado : DateTime.Now.Month;
    string materiaSel = ViewBag.MateriaSeleccionada as string ?? "";
    string nombreDocente = ViewBag.NombreProfesor ?? "Docente";

    var franjasHorarias = Model != null && Model.Any()
        ? Model.Select(h => new { h.HoraInicio, h.HoraFin, h.EsDescanso })
               .Distinct()
               .OrderBy(h => h.HoraInicio)
               .ToList()
        : new[] {
            new { HoraInicio = new TimeSpan(6, 0, 0), HoraFin = new TimeSpan(7, 30, 0), EsDescanso = false },
            new { HoraInicio = new TimeSpan(7, 30, 0), HoraFin = new TimeSpan(9, 0, 0), EsDescanso = false },
            new { HoraInicio = new TimeSpan(9, 0, 0), HoraFin = new TimeSpan(9, 30, 0), EsDescanso = true },
            new { HoraInicio = new TimeSpan(9, 30, 0), HoraFin = new TimeSpan(10, 45, 0), EsDescanso = false },
            new { HoraInicio = new TimeSpan(10, 45, 0), HoraFin = new TimeSpan(12, 0, 0), EsDescanso = false }
          }.ToList();
}

<div class="container-fluid mt-4 px-4" style="max-width: 1300px; margin: 0 auto;">

    <!-- Encabezado Institucional en Azul Marino (#0f2a4a) -->
    <div class="card border-0 shadow-sm mb-4 rounded-3 overflow-hidden">
        <div class="d-flex justify-content-between align-items-center px-4 py-3 text-white"
             style="background: linear-gradient(135deg, #0f2a4a 0%, #1b3f6e 100%);">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle d-flex align-items-center justify-content-center"
                     style="width:48px;height:48px;background:rgba(255,255,255,0.15);">
                    <i class="bi bi-calendar-week-fill fs-4 text-white"></i>
                </div>
                <div>
                    <h4 class="mb-0 fw-bold">Horario de Clases</h4>
                    <span class="badge bg-light text-dark fw-bold mt-1 px-3 py-1" style="font-size:0.88rem;">
                        <i class="bi bi-person-fill me-1 text-primary"></i> Prof. @nombreDocente
                    </span>
                </div>
            </div>
            <a href="@Url.Action("Dashboard", "Home")" class="btn btn-outline-light btn-sm fw-bold px-3 shadow-sm" style="border-width: 2px;">
                <i class="bi bi-arrow-left me-1"></i> Volver
            </a>
        </div>
    </div>

    <!-- Card Principal con Filtros y Contenido -->
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden mb-4">
        <div class="card-body p-4">

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> @ViewBag.Error
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <!-- Filtros: Asignatura, Mes, Año y Periodo -->
            <div class="card bg-light border-0 p-3 mb-4 rounded-3">
                <form method="get" action="@Url.Action("MiHorario", "Horario")" class="row g-3 align-items-end">

                    <!-- Filtro por Asignatura / Materia -->
                    <div class="col-md-3">
                        <label class="form-label fw-bold text-dark small mb-1">
                            <i class="bi bi-book me-1 text-primary"></i> Asignatura
                        </label>
                        <select class="form-select form-select-sm" name="materia_filtro" onchange="this.form.submit()">
                            <option value="">-- Todas las Asignaturas --</option>
                            @if (ViewBag.Materias != null)
                            {
                                foreach (var mat in ViewBag.Materias)
                                {
                                    if (mat == materiaSel)
                                    {
                                        <option value="@mat" selected="selected">@mat</option>
                                    }
                                    else
                                    {
                                        <option value="@mat">@mat</option>
                                    }
                                }
                            }
                        </select>
                    </div>

                    <!-- Filtro por Mes -->
                    <div class="col-md-3">
                        <label class="form-label fw-bold text-dark small mb-1">
                            <i class="bi bi-calendar-month me-1 text-primary"></i> Mes
                        </label>
                        <select class="form-select form-select-sm" name="mes_filtro" onchange="this.form.submit()">
                            @foreach (var m in meses)
                            {
                                if (m.Key == mesActual)
                                {
                                    <option value="@m.Key" selected="selected">@m.Value</option>
                                }
                                else
                                {
                                    <option value="@m.Key">@m.Value</option>
                                }
                            }
                        </select>
                    </div>

                    <!-- Filtro por Año -->
                    <div class="col-md-2">
                        <label class="form-label fw-bold text-dark small mb-1">
                            <i class="bi bi-calendar-event me-1 text-primary"></i> Año
                        </label>
                        <select class="form-select form-select-sm" name="ano_filtro" onchange="this.form.submit()">
                            @{
                                int anoSel = ViewBag.AnoSeleccionado != null ? (int)ViewBag.AnoSeleccionado : DateTime.Now.Year;
                                int[] anos = new[] { 2024, 2025, 2026, 2027 };
                                foreach (var a in anos)
                                {
                                    if (a == anoSel)
                                    {
                                        <option value="@a" selected="selected">@a</option>
                                    }
                                    else
                                    {
                                        <option value="@a">@a</option>
                                    }
                                }
                            }
                        </select>
                    </div>

                    <!-- Filtro por Periodo -->
                    <div class="col-md-2">
                        <label class="form-label fw-bold text-dark small mb-1">
                            <i class="bi bi-bookmarks me-1 text-primary"></i> Periodo
                        </label>
                        <select class="form-select form-select-sm" name="periodo_filtro" onchange="this.form.submit()">
                            @{
                                int pSel = ViewBag.PeriodoSeleccionado != null ? (int)ViewBag.PeriodoSeleccionado : 1;
                                for (int p = 1; p <= 4; p++)
                                {
                                    if (p == pSel)
                                    {
                                        <option value="@p" selected="selected">Periodo @p</option>
                                    }
                                    else
                                    {
                                        <option value="@p">Periodo @p</option>
                                    }
                                }
                            }
                        </select>
                    </div>

                    <!-- Botón Filtrar -->
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-sm fw-bold text-white w-100 py-2" style="background-color: #0f2a4a;">
                            <i class="bi bi-funnel-fill me-1"></i> Filtrar
                        </button>
                    </div>
                </form>
            </div>

            <!-- Tabla de Horario o Estado Vacío -->
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-bordered align-middle text-center mb-0" style="min-width: 900px;">
                        <thead class="table-light text-uppercase small fw-bold">
                            <tr>
                                <th style="width: 15%; background-color: #f8f9fa;">Hora</th>
                                @foreach (var dia in diasSemana)
                                {
                                    <th style="width: 17%;">@dia</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var franja in franjasHorarias)
                            {
                                <tr>
                                    <!-- Rango de Hora -->
                                    <td class="fw-bold text-muted bg-light">
                                        <i class="bi bi-clock me-1"></i>
                                        @franja.HoraInicio.ToString(@"hh\:mm") - @franja.HoraFin.ToString(@"hh\:mm")
                                    </td>

                                    @if (franja.EsDescanso)
                                    {
                                        <td colspan="5" class="py-3 align-middle" style="background-color: #fff8f0 !important; border-top: 2px solid #ffe8cc; border-bottom: 2px solid #ffe8cc;">
                                            <span class="fw-bold text-uppercase" style="color: #d97706; letter-spacing: 2px;">
                                                <i class="bi bi-cup-hot-fill me-2 fs-5" style="color: #fd7e14;"></i> Receso / Descanso
                                            </span>
                                        </td>
                                    }
                                    else
                                    {
                                        @foreach (var dia in diasSemana)
                                        {
                                            var clase = Model.FirstOrDefault(h =>
                                                h.DiaSemana.Equals(dia, StringComparison.OrdinalIgnoreCase) &&
                                                h.HoraInicio == franja.HoraInicio &&
                                                !h.EsDescanso);

                                            <td class="p-2" style="height: 110px; vertical-align: top;">
                                                @if (clase != null)
                                                {
                                                    <div class="card h-100 p-2 text-start border-start border-4 shadow-sm"
                                                         style="border-left-color: #0f2a4a !important; background-color: #f8fafc;">

                                                        <!-- Nombre de la Materia -->
                                                        <span class="fw-bold text-dark d-block mb-1" style="font-size: 0.85rem;">
                                                            <i class="bi bi-journal-bookmark-fill me-1" style="color: #0f2a4a;"></i>@clase.NombreMateria
                                                        </span>

                                                        <!-- Grado / Curso -->
                                                        <span class="badge bg-light text-primary border border-primary mb-1 d-inline-block" style="font-size: 0.75rem;">
                                                            <i class="bi bi-mortarboard-fill me-1"></i>Grado: @clase.NombreCurso
                                                        </span>

                                                        <!-- Salón / Aula -->
                                                        <span class="text-secondary small d-block" style="font-size: 0.78rem;">
                                                            <i class="bi bi-geo-alt-fill me-1 text-danger"></i>@clase.NombreSalon
                                                        </span>
                                                    </div>
                                                }
                                            </td>
                                        }
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <!-- Estado sin horarios (Tarjeta elegante) -->
                <div class="text-center py-5 my-3 rounded-3" style="background-color: #f8fafc; border: 2px dashed #cbd5e1;">
                    <div class="mb-3">
                        <span class="d-inline-block p-4 rounded-circle bg-white shadow-sm">
                            <i class="bi bi-calendar-x-fill text-muted" style="font-size: 3.5rem;"></i>
                        </span>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Aún no hay horarios disponibles</h5>
                    <p class="text-muted small mb-0" style="max-width: 450px; margin: 0 auto;">
                        El administrador aún no ha asignado un horario de clases para este profesor o periodo. Consulta nuevamente más tarde.
                    </p>
                </div>
            }

