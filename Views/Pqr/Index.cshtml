@model IEnumerable<ProyectoPAE.Models.Pqr>
@{
    ViewData["Title"] = "Módulo PQR - Peticiones, Quejas y Reclamos";
    bool esGestor = ViewBag.EsGestor ?? false;
    string rolActual = ViewBag.RolActual ?? "estudiante";
    string busqueda = ViewBag.Busqueda ?? "";
    string tipoFiltro = ViewBag.Tipo ?? "todos";
    string estadoFiltro = ViewBag.Estado ?? "todos";
}

<div class="container-fluid py-3 px-md-4">
    <div class="panel-con-sidebar">
        <!-- Barra lateral contextual según el rol del usuario -->
        @if (rolActual == "admin" || rolActual == "coordinador")
        {
            @await Html.PartialAsync("_SidebarAdmin")
        }
        else if (rolActual == "docente")
        {
            @await Html.PartialAsync("_SidebarDocente")
        }
        else if (rolActual == "acudiente" || rolActual == "padre")
        {
            @await Html.PartialAsync("_SidebarAcudiente")
        }
        else
        {
            @await Html.PartialAsync("_SidebarEstudiante")
        }

        <!-- Contenido Principal del Módulo PQR -->
        <main class="submodulo-activo flex-grow-1" role="main" aria-label="Contenido Módulo PQR">
            <!-- Encabezado del Módulo -->
            <div class="card pae-header-card border-0 mb-4 p-4 shadow-sm" style="background: linear-gradient(135deg, #0d2a4a 0%, #1a3d66 100%);">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <div class="text-white">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="badge bg-warning text-dark px-2.5 py-1 rounded-pill fw-bold">Atención al Ciudadano</span>
                            <small class="text-white-50">Portal PAE &bull; Servicio Institucional</small>
                        </div>
                        <h2 class="h3 fw-bold mb-1 text-white">
                            <i class="bi bi-chat-heart-fill me-2" style="color: #e67e22;"></i>Peticiones, Quejas y Reclamos (PQR)
                        </h2>
                        <p class="text-white-50 mb-0 small">
                            @(esGestor ? "Panel de administración, seguimiento y respuesta oportuna a las solicitudes de la comunidad educativa." : "Radica tus solicitudes, sugerencias o reclamos y haz seguimiento en tiempo real al estado de tu trámite.")
                        </p>
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        <button type="button" class="btn btn-warning text-dark fw-bold rounded-pill px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#modalCrearPqr">
                            <i class="bi bi-plus-circle-fill me-1"></i> Radicar PQR
                        </button>
                        <a href="@Url.Action("Dashboard", "Home")" class="btn btn-outline-light rounded-pill px-3" title="Regresar al Panel Principal">
                            <i class="bi bi-arrow-left me-1"></i> Volver al Panel
                        </a>
                    </div>
                </div>
            </div>

            <!-- Alertas Globales -->
            @if (TempData["Exito"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 d-flex align-items-center gap-2" role="alert" aria-live="polite">
                    <i class="bi bi-check-circle-fill fs-5 text-success"></i>
                    <div>@TempData["Exito"]</div>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 d-flex align-items-center gap-2" role="alert" aria-live="assertive">
                    <i class="bi bi-exclamation-triangle-fill fs-5 text-danger"></i>
                    <div>@TempData["Error"]</div>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                </div>
            }

            <!-- Tarjetas de Resumen / Métricas -->
            <div class="row g-3 mb-4">
                <div class="col-sm-6 col-xl-3">
                    <div class="card border-0 shadow-sm p-3 h-100 rounded-3" style="border-left: 4px solid #0d2a4a !important;">
                        <span class="text-muted small text-uppercase fw-semibold">Total Solicitudes</span>
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <span class="fs-3 fw-bold" style="color: #0d2a4a;">@ViewBag.Total</span>
                            <span class="badge bg-light text-dark border p-2 rounded-circle"><i class="bi bi-inbox-fill text-primary"></i></span>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="card border-0 shadow-sm p-3 h-100 rounded-3" style="border-left: 4px solid #e67e22 !important;">
                        <span class="text-muted small text-uppercase fw-semibold">Recibidas / Pendientes</span>
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <span class="fs-3 fw-bold" style="color: #e67e22;">@ViewBag.TotalRecibidas</span>
                            <span class="badge bg-light text-dark border p-2 rounded-circle"><i class="bi bi-clock-history text-warning"></i></span>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="card border-0 shadow-sm p-3 h-100 rounded-3" style="border-left: 4px solid #0dcaf0 !important;">
                        <span class="text-muted small text-uppercase fw-semibold">En Revisión</span>
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <span class="fs-3 fw-bold text-info">@ViewBag.TotalEnRevision</span>
                            <span class="badge bg-light text-dark border p-2 rounded-circle"><i class="bi bi-search text-info"></i></span>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="card border-0 shadow-sm p-3 h-100 rounded-3" style="border-left: 4px solid #198754 !important;">
                        <span class="text-muted small text-uppercase fw-semibold">Respondidas / Cerradas</span>
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <span class="fs-3 fw-bold text-success">@(ViewBag.TotalRespondidas + ViewBag.TotalCerradas)</span>
                            <span class="badge bg-light text-dark border p-2 rounded-circle"><i class="bi bi-patch-check-fill text-success"></i></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Filtros y Buscador -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-3">
                    <form method="get" asp-action="Index" id="formFiltroPqr" class="row g-2 align-items-center">
                        <div class="col-md-5">
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                                <input type="text" name="busqueda" value="@busqueda" class="form-control border-start-0" placeholder="Buscar por radicado, asunto o contenido..." aria-label="Buscador de solicitudes">
                            </div>
                        </div>
                        <div class="col-md-3">
                            <select name="tipo" class="form-select" onchange="this.form.submit()" aria-label="Filtrar por tipo de solicitud">
                                <option value="todos" selected="@(tipoFiltro == "todos")">Todos los Tipos</option>
                                <option value="Petición" selected="@(tipoFiltro == "Petición")">Petición</option>
                                <option value="Queja" selected="@(tipoFiltro == "Queja")">Queja</option>
                                <option value="Reclamo" selected="@(tipoFiltro == "Reclamo")">Reclamo</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <select name="estado" class="form-select" onchange="this.form.submit()" aria-label="Filtrar por estado">
                                <option value="todos" selected="@(estadoFiltro == "todos")">Todos los Estados</option>
                                <option value="Recibida" selected="@(estadoFiltro == "Recibida")">Recibida</option>
                                <option value="En revisión" selected="@(estadoFiltro == "En revisión")">En revisión</option>
                                <option value="Respondida" selected="@(estadoFiltro == "Respondida")">Respondida</option>
                                <option value="Cerrada" selected="@(estadoFiltro == "Cerrada")">Cerrada</option>
                            </select>
                        </div>
                        <div class="col-md-1 d-flex gap-1">
                            <button type="submit" class="btn btn-primary w-100" title="Aplicar filtros"><i class="bi bi-funnel"></i></button>
                            <a href="@Url.Action("Index", "Pqr")" class="btn btn-outline-secondary" title="Limpiar filtros"><i class="bi bi-x-circle"></i></a>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Tabla de Solicitudes -->
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
                <div class="card-header bg-white py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold" style="color: #0d2a4a;">
                        <i class="bi bi-card-checklist me-2 text-warning"></i>Listado de Solicitudes
                    </h5>
                    <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3 py-1 small">
                        Mostrando @Model.Count() registro(s)
                    </span>
                </div>

                @if (!Model.Any())
                {
                    <div class="text-center py-5 px-3">
                        <div class="mb-3">
                            <i class="bi bi-inbox fs-1 text-muted opacity-50" style="font-size: 3.5rem;"></i>
                        </div>
                        <h5 class="fw-bold text-secondary">No se encontraron solicitudes registradas</h5>
                        <p class="text-muted small mb-3" style="max-width: 450px; margin: 0 auto;">
                            @(string.IsNullOrWhiteSpace(busqueda) && tipoFiltro == "todos" && estadoFiltro == "todos"
                                ? "Aún no has radicado ninguna solicitud de Petición, Queja o Reclamo. Puedes radicar una nueva solicitud en cualquier momento."
                                : "No hay registros que coincidan con los criterios de búsqueda o filtros seleccionados.")
                        </p>
                        <button type="button" class="btn btn-primary rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#modalCrearPqr">
                            <i class="bi bi-plus-circle me-1"></i> Radicar Nueva Solicitud
                        </button>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0" id="tablaPqr">
                            <thead class="table-light">
                                <tr class="small text-uppercase text-muted">
                                    <th class="ps-4 py-3">Radicado</th>
                                    <th class="py-3">Tipo</th>
                                    <th class="py-3">Asunto</th>
                                    @if (esGestor)
                                    {
                                        <th class="py-3">Solicitante</th>
                                    }
                                    <th class="py-3">Fecha</th>
                                    <th class="py-3 text-center">Estado</th>
                                    <th class="pe-4 py-3 text-end">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    string badgeTipo = item.Tipo switch
                                    {
                                        "Petición" => "bg-primary-subtle text-primary border border-primary-subtle",
                                        "Queja" => "bg-warning-subtle text-warning-emphasis border border-warning-subtle",
                                        "Reclamo" => "bg-danger-subtle text-danger border border-danger-subtle",
                                        _ => "bg-light text-dark"
                                    };

                                    string badgeEstado = item.Estado switch
                                    {
                                        "Recibida" => "bg-warning text-dark",
                                        "En revisión" => "bg-info text-dark",
                                        "Respondida" => "bg-success text-white",
                                        "Cerrada" => "bg-secondary text-white",
                                        _ => "bg-light text-dark"
                                    };

                                    <tr>
                                        <td class="ps-4 py-3 fw-bold text-nowrap" style="color: #0d2a4a;">
                                            <i class="bi bi-tag-fill me-1 text-warning"></i>@item.CodigoRadicado
                                        </td>
                                        <td class="py-3">
                                            <span class="badge @badgeTipo rounded-pill px-2.5 py-1">@item.Tipo</span>
                                        </td>
                                        <td class="py-3">
                                            <div class="fw-semibold text-dark text-truncate" style="max-width: 260px;" title="@item.Asunto">
                                                @item.Asunto
                                            </div>
                                            <small class="text-muted text-truncate d-block" style="max-width: 260px;">
                                                @item.Descripcion
                                            </small>
                                        </td>
                                        @if (esGestor)
                                        {
                                            <td class="py-3">
                                                <div class="small fw-medium">@item.NombreUsuario</div>
                                                <span class="badge bg-light text-secondary border" style="font-size: 0.7rem;">@item.RolUsuario</span>
                                            </td>
                                        }
                                        <td class="py-3 text-nowrap small text-muted">
                                            @item.FechaRegistro.ToString("dd/MM/yyyy HH:mm")
                                        </td>
                                        <td class="py-3 text-center">
                                            <span class="badge @badgeEstado rounded-pill px-2.5 py-1">@item.Estado</span>
                                        </td>
                                        <td class="pe-4 py-3 text-end text-nowrap">
                                            <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-2.5 py-1" onclick="verDetallePqr(@item.IdPqr)" title="Ver detalle de la solicitud">
                                                <i class="bi bi-eye-fill me-1"></i> Detalle
                                            </button>

                                            @if (esGestor)
                                            {
                                                <button type="button" class="btn btn-sm btn-warning text-dark rounded-pill px-2.5 py-1 ms-1" onclick="abrirModalResponder(@item.IdPqr, '@item.CodigoRadicado', '@item.Estado')" title="Responder o gestionar solicitud">
                                                    <i class="bi bi-reply-fill me-1"></i> Gestionar
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </main>
    </div>
</div>

<!-- MODAL: RADICAR NUEVA PQR -->
<div class="modal fade" id="modalCrearPqr" tabindex="-1" aria-labelledby="modalCrearPqrTitulo" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header text-white py-3 px-4" style="background: linear-gradient(135deg, #0d2a4a 0%, #1a3d66 100%);">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-file-earmark-plus-fill text-warning fs-4"></i>
                    <h5 class="modal-title fw-bold mb-0" id="modalCrearPqrTitulo">Radicar Solicitud PQR</h5>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <form asp-action="Crear" method="post" id="formRadicarPqr" onsubmit="validarYEnviarPqr(event)">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4 bg-light">
                    <div class="card border-0 shadow-sm p-3 mb-3 bg-white rounded-3">
                        <div class="d-flex align-items-center gap-3">
                            <i class="bi bi-info-circle-fill text-primary fs-3"></i>
                            <div class="small text-secondary">
                                Su solicitud será radicada formalmente bajo el sistema institucional del PAE. Recibirá un <strong>código único de radicado</strong> para consultar las respuestas emitidas por la administración.
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 bg-white p-3 rounded-3 shadow-sm border-0">
                        <!-- Tipo de Solicitud -->
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-dark">Tipo de Solicitud <span class="text-danger">*</span></label>
                            <select name="Tipo" id="crearPqrTipo" class="form-select" required>
                                <option value="Petición">Petición (Solicitud formal de información o trámite)</option>
                                <option value="Queja">Queja (Inconformidad con la atención o servicio)</option>
                                <option value="Reclamo">Reclamo (Disconformidad con un derecho o exigencia)</option>
                            </select>
                        </div>

                        <!-- Asunto -->
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-dark">Asunto / Título Resumido <span class="text-danger">*</span></label>
                            <input type="text" name="Asunto" id="crearPqrAsunto" class="form-control" placeholder="Ej: Solicitud de certificado de notas parciales" minlength="5" maxlength="200" required>
                            <div class="form-text small">Mínimo 5 y máximo 200 caracteres.</div>
                        </div>

                        <!-- Descripción detallada -->
                        <div class="col-12">
                            <label class="form-label fw-bold small text-dark">Descripción Detallada <span class="text-danger">*</span></label>
                            <textarea name="Descripcion" id="crearPqrDescripcion" rows="5" class="form-control" placeholder="Describa con claridad los hechos, razones y la solicitud concreta..." minlength="10" maxlength="4000" required></textarea>
                            <div class="form-text small">Proporcione detalles claros para facilitar una respuesta rápida y precisa.</div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-white border-top px-4 py-3 justify-content-between">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" id="btnEnviarPqr" class="btn btn-warning text-dark fw-bold rounded-pill px-4 shadow-sm">
                        <i class="bi bi-send-fill me-1"></i> Radicar Solicitud
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL: VER DETALLE DE PQR -->
<div class="modal fade" id="modalDetallePqr" tabindex="-1" aria-labelledby="modalDetallePqrTitulo" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header text-white py-3 px-4" style="background: linear-gradient(135deg, #0d2a4a 0%, #1a3d66 100%);">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-warning text-dark px-2.5 py-1 rounded-pill" id="detPqrBadgeRadicado">PQR-xxxx</span>
                    <h5 class="modal-title fw-bold mb-0" id="modalDetallePqrTitulo">Detalle de Solicitud</h5>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body p-4 bg-light">
                <div class="card border-0 shadow-sm p-3 mb-3 bg-white rounded-3">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <span class="badge bg-primary-subtle text-primary me-2" id="detPqrTipo">Petición</span>
                            <span class="badge bg-warning text-dark" id="detPqrEstado">Recibida</span>
                        </div>
                        <small class="text-muted" id="detPqrFecha"><i class="bi bi-clock me-1"></i>--/--/----</small>
                    </div>
                    <h5 class="fw-bold mb-2 text-dark" id="detPqrAsunto">Cargando asunto...</h5>
                    <div class="p-3 bg-light rounded-3 small text-secondary" id="detPqrDescripcion" style="white-space: pre-line; line-height: 1.6;">
                        Cargando contenido...
                    </div>
                    <div class="mt-2 text-muted small" id="detPqrUsuarioRow">
                        <i class="bi bi-person-circle me-1 text-primary"></i> <span id="detPqrUsuario">--</span> (<span id="detPqrRol">--</span>)
                    </div>
                </div>

                <!-- Bloque de Respuesta Institucional -->
                <div class="card border-0 shadow-sm p-3 bg-white rounded-3" id="detPqrRespuestaContainer" style="border-left: 4px solid #198754 !important;">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="fw-bold mb-0 text-success">
                            <i class="bi bi-patch-check-fill me-1"></i>Respuesta y Seguimiento Institucional
                        </h6>
                        <small class="text-muted" id="detPqrFechaRespuesta">--/--/----</small>
                    </div>
                    <div class="p-3 bg-success-subtle rounded-3 small text-dark" id="detPqrRespuestaTexto" style="white-space: pre-line; line-height: 1.6;">
                        Aún no se ha emitido una respuesta formal para esta solicitud.
                    </div>
                    <div class="mt-2 text-muted small" id="detPqrRespondidoPor">
                        <i class="bi bi-shield-check me-1 text-success"></i> Atendido por: <span>--</span>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-white border-top px-4 py-3">
                <button type="button" class="btn btn-primary rounded-pill px-4" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL: GESTIONAR Y RESPONDER (ADMINISTRADORES / COORDINADORES) -->
@if (esGestor)
{
    <div class="modal fade" id="modalGestionarPqr" tabindex="-1" aria-labelledby="modalGestionarPqrTitulo" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header text-white py-3 px-4" style="background: linear-gradient(135deg, #0d2a4a 0%, #1a3d66 100%);">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-reply-all-fill text-warning fs-4"></i>
                        <h5 class="modal-title fw-bold mb-0" id="modalGestionarPqrTitulo">Gestionar y Responder PQR</h5>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <form asp-action="Responder" method="post" id="formResponderPqr" onsubmit="validarYEnviarRespuesta(event)">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="IdPqr" id="respPqrId" />
                    <div class="modal-body p-4 bg-light">
                        <div class="card border-0 shadow-sm p-3 mb-3 bg-white rounded-3">
                            <span class="text-muted small">Solicitud Radicada:</span>
                            <h6 class="fw-bold text-dark mb-0" id="respPqrRadicado">PQR-xxxx</h6>
                        </div>

                        <div class="bg-white p-3 rounded-3 shadow-sm border-0">
                            <div class="mb-3">
                                <label class="form-label fw-bold small text-dark">Nuevo Estado de la Solicitud <span class="text-danger">*</span></label>
                                <select name="Estado" id="respPqrEstado" class="form-select" required>
                                    <option value="En revisión">En revisión</option>
                                    <option value="Respondida" selected>Respondida</option>
                                    <option value="Cerrada">Cerrada</option>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold small text-dark">Dictamen / Respuesta Institucional <span class="text-danger">*</span></label>
                                <textarea name="Respuesta" id="respPqrTexto" rows="5" class="form-control" placeholder="Escriba la respuesta oficial para el usuario solicitante..." minlength="5" maxlength="4000" required></textarea>
                                <div class="form-text small">La respuesta quedará registrada con fecha, hora y su usuario responsable.</div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer bg-white border-top px-4 py-3 justify-content-between">
                        <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" id="btnGuardarRespuestaPqr" class="btn btn-success rounded-pill px-4 shadow-sm">
                            <i class="bi bi-check2-circle me-1"></i> Guardar Respuesta
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        // Ver detalle de una PQR por AJAX
        function verDetallePqr(idPqr) {
            fetch(`/Pqr/Detalle/${idPqr}`, {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(res => res.json())
            .then(data => {
                if (data.success && data.pqr) {
                    const p = data.pqr;
                    document.getElementById('detPqrBadgeRadicado').textContent = p.codigoRadicado;
                    document.getElementById('detPqrTipo').textContent = p.tipo;
                    document.getElementById('detPqrEstado').textContent = p.estado;
                    document.getElementById('detPqrFecha').innerHTML = `<i class="bi bi-clock me-1"></i>${p.fechaRegistro}`;
                    document.getElementById('detPqrAsunto').textContent = p.asunto;
                    document.getElementById('detPqrDescripcion').textContent = p.descripcion;
                    document.getElementById('detPqrUsuario').textContent = p.nombreUsuario;
                    document.getElementById('detPqrRol').textContent = p.rolUsuario;

                    const contResp = document.getElementById('detPqrRespuestaContainer');
                    const txtResp = document.getElementById('detPqrRespuestaTexto');
                    const fechaResp = document.getElementById('detPqrFechaRespuesta');
                    const respPor = document.getElementById('detPqrRespondidoPor');

                    if (p.respuesta) {
                        txtResp.textContent = p.respuesta;
                        fechaResp.textContent = p.fechaRespuesta || '';
                        respPor.innerHTML = `<i class="bi bi-shield-check me-1 text-success"></i> Atendido por: <span>${p.respondidoPor || 'Administración'}</span>`;
                        contResp.style.display = 'block';
                    } else {
                        txtResp.textContent = 'Esta solicitud aún no cuenta con respuesta registrada.';
                        fechaResp.textContent = '';
                        respPor.innerHTML = '<span class="text-muted"><i class="bi bi-hourglass-split me-1 text-warning"></i> En espera de revisión</span>';
                        contResp.style.display = 'block';
                    }

                    const modal = new bootstrap.Modal(document.getElementById('modalDetallePqr'));
                    modal.show();
                } else {
                    if (window.PAE && typeof PAE.error === 'function') {
                        PAE.error('No fue posible cargar el detalle de la solicitud.');
                    } else {
                        alert('No fue posible cargar el detalle.');
                    }
                }
            })
            .catch(() => {
                if (window.PAE && typeof PAE.error === 'function') {
                    PAE.error('Ocurrió un error al consultar el servidor.');
                }
            });
        }

        // Abrir modal de respuesta (Gestores)
        function abrirModalResponder(idPqr, radicado, estadoActual) {
            document.getElementById('respPqrId').value = idPqr;
            document.getElementById('respPqrRadicado').textContent = radicado;
            const selEstado = document.getElementById('respPqrEstado');
            if (selEstado) {
                selEstado.value = (estadoActual === 'Recibida') ? 'Respondida' : estadoActual;
            }
            const txt = document.getElementById('respPqrTexto');
            if (txt) txt.value = '';

            const modal = new bootstrap.Modal(document.getElementById('modalGestionarPqr'));
            modal.show();
        }

        // Evitar dobles envíos y validar
        function validarYEnviarPqr(e) {
            const btn = document.getElementById('btnEnviarPqr');
            if (btn && btn.disabled) {
                e.preventDefault();
                return false;
            }
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Radicando...';
            }
            return true;
        }

        function validarYEnviarRespuesta(e) {
            const btn = document.getElementById('btnGuardarRespuestaPqr');
            if (btn && btn.disabled) {
                e.preventDefault();
                return false;
            }
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Guardando...';
            }
            return true;
        }
    </script>
}
