@model IEnumerable<dynamic>

@{
    ViewData["Title"] = "Reporte de Calificaciones";
    var idsMostrados = new HashSet<int>();

    // Asignación de colores distintivos y llamativos por cada materia
    string ObtenerColorMateria(string materia)
    {
        if (string.IsNullOrWhiteSpace(materia)) return "#6c757d";
        string mat = materia.ToLower();
        
        if (mat.Contains("matemátic") || mat.Contains("matematic") || mat.Contains("álgebra") || mat.Contains("geometr")) 
            return "#e65100"; // Naranja vivo para Matemáticas
        if (mat.Contains("español") || mat.Contains("lengu") || mat.Contains("literatur") || mat.Contains("castellano")) 
            return "#d35400"; // Ámbar tostado para Español
        if (mat.Contains("inglés") || mat.Contains("ingles") || mat.Contains("idioma") || mat.Contains("french")) 
            return "#8e44ad"; // Púrpura / Violeta para Inglés
        if (mat.Contains("cienc") || mat.Contains("biolog") || mat.Contains("químic") || mat.Contains("quimic") || mat.Contains("físic") || mat.Contains("fisic")) 
            return "#16a085"; // Teal / Verde azulado para Ciencias
        if (mat.Contains("social") || mat.Contains("histor") || mat.Contains("geograf")) 
            return "#c0392b"; // Rojo ladrillo para Sociales
        if (mat.Contains("tecnolog") || mat.Contains("informát") || mat.Contains("sistem") || mat.Contains("comput")) 
            return "#0288d1"; // Cyan / Azul para Tecnología
        if (mat.Contains("art") || mat.Contains("músic") || mat.Contains("music") || mat.Contains("danz")) 
            return "#e91e63"; // Rosa para Artes
        if (mat.Contains("física") || mat.Contains("deport") || mat.Contains("educación física")) 
            return "#27ae60"; // Verde para Ed. Física
        if (mat.Contains("étic") || mat.Contains("etic") || mat.Contains("relig") || mat.Contains("filosof")) 
            return "#f39c12"; // Mostaza / Oro para Ética

        // Paleta determinística para cualquier otra materia
        string[] paletaExtra = new[] { "#1e88e5", "#8e44ad", "#16a085", "#d35400", "#c0392b", "#0288d1", "#27ae60", "#e91e63" };
        int hash = Math.Abs(materia.GetHashCode());
        return paletaExtra[hash % paletaExtra.Length];
    }
}

@using Microsoft.AspNetCore.Http
@{
    var rolReporte = Context.Session.GetString("UserRol")?.ToLower() ?? "";
    bool esAdminCoord = (rolReporte == "admin" || rolReporte == "administrador" || rolReporte == "coordinador");
}

<div class="container-fluid py-3 px-md-4">
    <div class="panel-con-sidebar">
        @if (esAdminCoord)
        {
            @await Html.PartialAsync("_SidebarAdmin")
        }
        else
        {
            @await Html.PartialAsync("_SidebarDocente")
        }
        <main class="submodulo-activo flex-grow-1" role="main" aria-label="Reporte de Calificaciones">
            <div class="d-flex align-items-center justify-content-between p-3 rounded-3 text-white mb-4"
                 style="background: var(--pae-gradient-primary);">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center"
                         style="width:50px;height:50px;background:rgba(255,255,255,.18); flex-shrink: 0;">
                        <i class="bi bi-file-earmark-bar-graph fs-3 text-white"></i>
                    </div>
                    <div>
                        <h4 class="mb-0 fw-bold">Reportes Generales</h4>
                        <small class="opacity-75">Consolidado general de calificaciones, estadísticas y promedios por curso y estudiante</small>
                    </div>
                </div>
                <div class="d-flex gap-2">
                    @if (ViewBag.FiltroAplicado == true && Model != null && Model.Any())
                    {
                        <button onclick="window.print()" class="btn btn-outline-light btn-sm rounded-pill px-3">
                            <i class="bi bi-printer me-1"></i> Imprimir PDF
                        </button>
                    }
                    <a href="@Url.Action("Dashboard", "Home")" class="btn btn-pae-volver">
                        Volver al Panel
                    </a>
                </div>
            </div>

            <!-- FILTRO DE BÚSQUEDA PARA REPORTES GENERALES -->
            <div class="card border-0 shadow-sm p-4 mb-4 rounded-4 bg-white">
                <form method="get" asp-action="ReporteGrupal" id="formFiltroReportes">
                    <input type="hidden" name="buscar" value="true" />
                    <div class="row g-3 align-items-end">
                        <div class="col-md-3">
                            <label class="form-label fw-bold small text-dark mb-1">
                                <i class="bi bi-people-fill me-1 text-primary"></i>Curso / Grado
                            </label>
                            <select name="curso" class="form-select form-select-sm">
                                <option value="">-- Todos los cursos --</option>
                                @if (ViewBag.ListaCursos != null)
                                {
                                    foreach (var c in (List<string>)ViewBag.ListaCursos)
                                    {
                                        if (ViewBag.CursoSeleccionado != null && (string)ViewBag.CursoSeleccionado == c)
                                        {
                                            <option value="@c" selected>Curso @c</option>
                                        }
                                        else
                                        {
                                            <option value="@c">Curso @c</option>
                                        }
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label fw-bold small text-dark mb-1">
                                <i class="bi bi-calendar3 me-1 text-primary"></i>Periodo
                            </label>
                            <select name="periodo" class="form-select form-select-sm">
                                <option value="">-- Todos --</option>
                                @for (int p = 1; p <= 4; p++)
                                {
                                    if (ViewBag.PeriodoSeleccionado != null && (int)ViewBag.PeriodoSeleccionado == p)
                                    {
                                        <option value="@p" selected>Periodo @p</option>
                                    }
                                    else
                                    {
                                        <option value="@p">Periodo @p</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold small text-dark mb-1">
                                <i class="bi bi-search me-1 text-primary"></i>Estudiante (Nombre o N° Identidad)
                            </label>
                            <input type="text" name="busqueda" value="@ViewBag.BusquedaSeleccionada" class="form-control form-control-sm" placeholder="Buscar por nombre o número de documento..." />
                        </div>
                        <div class="col-md-3 d-flex gap-2">
                            <button type="submit" class="btn btn-primary btn-sm w-100 fw-bold shadow-sm rounded-pill">
                                <i class="bi bi-funnel-fill me-1"></i> Filtrar Reporte
                            </button>
                            <a href="@Url.Action("ReporteGrupal", "Docente")" class="btn btn-outline-secondary btn-sm rounded-pill px-3" title="Limpiar filtros">
                                <i class="bi bi-arrow-counterclockwise"></i>
                            </a>
                        </div>
                    </div>
                </form>
            </div>

            @if (ViewBag.FiltroAplicado != true)
            {
                <!-- ESTADO INICIAL: ANTES DE APLICAR FILTROS NO DEBE APARECER NADA -->
                <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white my-4">
                    <div class="rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 70px; height: 70px; background-color: #e3f2fd; color: #1565c0;">
                        <i class="bi bi-funnel fs-2"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Consulta de Reportes Generales</h5>
                    <p class="text-muted small mb-0" style="max-width: 520px; margin: 0 auto;">
                        Selecciona el <strong>Curso</strong>, <strong>Periodo</strong> o escribe el <strong>Nombre / Número de Identidad</strong> del estudiante y haz clic en <strong>Filtrar Reporte</strong> para visualizar las calificaciones y consolidados correspondientes.
                    </p>
                </div>
            }
            else if (Model == null || !Model.Any())
            {
                <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white my-4">
                    <div class="rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 70px; height: 70px; background-color: #fff3cd; color: #856404;">
                        <i class="bi bi-search fs-2"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">No se encontraron resultados</h5>
                    <p class="text-muted small mb-0">No se encontraron registros de calificaciones para estudiantes con los criterios de búsqueda aplicados.</p>
                </div>
            }
            else
            {
                <div class="card shadow border-0">
                    <div class="card-body p-4">

                        <div class="row mb-4 justify-content-center">
                            <div class="col-md-8">
                                <canvas id="graficaNotas" style="max-height: 280px;"></canvas>
                            </div>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-hover align-middle" id="tablaReporte">
                                <thead class="table-light">
                                    <tr>
                                        <th>Estudiante</th>
                                        <th>Documento</th>
                                        <th>Curso</th>
                                        <th>Materias</th>
                                        <th>Periodo</th>
                                        <th class="text-center">Promedio Final</th>
                                        <th>Estado</th>
                                        <th>Certificado</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr class="fila-reporte">
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center fw-bold" style="width: 34px; height: 34px; font-size: 0.85rem; flex-shrink: 0;">
                                                        @((!string.IsNullOrEmpty((string)item.NombreEstudiante) ? ((string)item.NombreEstudiante).Substring(0, 1).ToUpper() : "E"))
                                                    </div>
                                                    <div>
                                                        <strong class="text-dark d-block">@item.NombreEstudiante</strong>
                                                    </div>
                                                </div>
                                            </td>
                                            <td><span class="badge bg-light text-dark border">@item.Documento</span></td>
                                            <td><span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2">@item.Curso</span></td>
                                            <td>
                                                @if (item.TotalMaterias > 0)
                                                {
                                                    <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle rounded-pill px-2">
                                                        <i class="bi bi-journal-check me-1"></i>@item.TotalMaterias @(item.TotalMaterias == 1 ? "asignatura" : "asignaturas")
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-light text-muted border rounded-pill px-2">Sin calificaciones</span>
                                                }
                                            </td>
                                            <td>
                                                <span class="badge bg-secondary-subtle text-secondary border rounded-pill px-2">@item.Periodo</span>
                                            </td>
                                            <td class="text-center fw-bold fs-6">
                                                @if (item.TieneNotas)
                                                {
                                                    <span>@Convert.ToDouble(item.Promedio).ToString("F1")</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted fw-normal" style="font-size: 0.85rem;">N/A</span>
                                                }
                                            </td>
                                            <td>
                                                @if (!item.TieneNotas)
                                                {
                                                    <span class="text-muted small"><i class="bi bi-dash-circle me-1"></i> Sin notas</span>
                                                }
                                                else if (Convert.ToDouble(item.Promedio) >= 3.0)
                                                {
                                                    <span class="text-success fw-semibold"><i class="bi bi-check-circle-fill me-1"></i> Aprobado</span>
                                                }
                                                else
                                                {
                                                    <span class="text-danger fw-semibold"><i class="bi bi-x-circle-fill me-1"></i> Reprobado</span>
                                                }
                                            </td>
                                            <td>
                                                <a asp-controller="Certificado" asp-action="Generar"
                                                   asp-route-idEstudiante="@item.IdEstudiante"
                                                   class="btn btn-sm btn-outline-primary fw-semibold rounded-pill px-3 shadow-sm">
                                                    <i class="bi bi-patch-check-fill me-1"></i> Generar
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- BARRA DE PAGINACIÓN REPORTES GENERALES (ESTILO IMAGEN 3) -->
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mt-4 p-2 bg-light rounded border">
                            <p class="text-muted small mb-0" id="infoReportePagina">Cargando...</p>
                            <nav aria-label="Paginación reportes generales">
                                <ul class="pagination pagination-sm mb-0" id="paginacionReporte"></ul>
                            </nav>
                        </div>
                    </div>
                </div>
            }
        </main>
    </div>
</div>

<style>
    #paginacionReporte .page-item .page-link {
        color: #007bff;
        border-color: #dee2e6;
        padding: 0.35rem 0.75rem;
        font-size: 0.9rem;
    }
    #paginacionReporte .page-item.active .page-link {
        background-color: #007bff;
        border-color: #007bff;
        color: #ffffff;
        font-weight: bold;
    }
    #paginacionReporte .page-item.disabled .page-link {
        color: #6c757d;
        background-color: #fff;
        border-color: #dee2e6;
        cursor: not-allowed;
    }
</style>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    // Paginación Client-Side idéntica a Imagen 3
    const filasPorPaginaReporte = 10;
    let repPaginaActual = 1;

    function renderizarPaginacionReporte() {
        const todasFilas = Array.from(document.querySelectorAll('#tablaReporte tbody tr.fila-reporte'));
        const totalFilas = todasFilas.length;
        const totalPaginas = Math.ceil(totalFilas / filasPorPaginaReporte) || 1;

        if (repPaginaActual > totalPaginas) repPaginaActual = totalPaginas;
        if (repPaginaActual < 1) repPaginaActual = 1;

        const inicio = (repPaginaActual - 1) * filasPorPaginaReporte;
        const fin = Math.min(inicio + filasPorPaginaReporte, totalFilas);

        todasFilas.forEach((tr, idx) => {
            tr.style.display = (idx >= inicio && idx < fin) ? '' : 'none';
        });

        const info = document.getElementById('infoReportePagina');
        if (info) {
            if (totalFilas === 0) {
                info.textContent = 'No hay calificaciones para mostrar';
            } else {
                info.textContent = `Mostrando ${inicio + 1}–${fin} de ${totalFilas} registros`;
            }
        }

        const ul = document.getElementById('paginacionReporte');
        if (!ul) return;
        ul.innerHTML = '';

        if (totalPaginas <= 1) return;

        const crearLi = (label, pagina, activo, disabled) => {
            const li = document.createElement('li');
            li.className = `page-item${activo ? ' active' : ''}${disabled ? ' disabled' : ''}`;
            const a = document.createElement('a');
            a.className = 'page-link';
            a.innerHTML = label;
            a.href = '#';
            if (!disabled && !activo) {
                a.addEventListener('click', (e) => {
                    e.preventDefault();
                    repPaginaActual = pagina;
                    renderizarPaginacionReporte();
                });
            }
            li.appendChild(a);
            ul.appendChild(li);
        };

        // Botón anterior «
        crearLi('&laquo;', repPaginaActual - 1, false, repPaginaActual === 1);

        const rango = 2;
        for (let p = 1; p <= totalPaginas; p++) {
            if (p === 1 || p === totalPaginas || (p >= repPaginaActual - rango && p <= repPaginaActual + rango)) {
                crearLi(p.toString(), p, p === repPaginaActual, false);
            } else if (p === repPaginaActual - rango - 1 || p === repPaginaActual + rango + 1) {
                crearLi('...', 0, false, true);
            }
        }

        // Botón siguiente »
        crearLi('&raquo;', repPaginaActual + 1, false, repPaginaActual === totalPaginas);
    }

    document.addEventListener('DOMContentLoaded', () => {
        renderizarPaginacionReporte();
    });
    const ctx = document.getElementById('graficaNotas');
    if (ctx) {
        // Extraemos los datos de C# a JavaScript
        const nombres = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Select(m => (string)m.NombreEstudiante)));
        const notas = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Select(m => (double)m.Promedio)));

        const colores = notas.map(n => n >= 3.0 ? 'rgba(39, 174, 96, 0.5)' : 'rgba(231, 76, 60, 0.5)');
        const bordes = notas.map(n => n >= 3.0 ? 'rgba(39, 174, 96, 1)' : 'rgba(231, 76, 60, 1)');

        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: nombres,
                datasets: [{
                    label: 'Promedio General',
                    data: notas,
                    backgroundColor: colores,
                    borderColor: bordes,
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: { beginAtZero: true, max: 5 }
                }
            }
        });
    }
</script>
