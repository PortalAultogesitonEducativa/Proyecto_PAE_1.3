@model List<ProyectoPAE.Models.Usuario>

@*
    ===================================================================
    VISTA: Planilla.cshtml
    PROPÓSITO: Planilla interactiva para el registro, edición y guardado de
               calificaciones de los estudiantes por asignatura y periodo.
    CARACTERÍSTICAS:
    - Selección dinámica de Grado, Asignatura y Periodo.
    - Notificaciones emergentes (Toasts) mediante SweetAlert2.
    - Cálculo automático de definitivas y estado de aprobación.
    ===================================================================
*@

@{
    ViewData["Title"] = "Planilla de Calificaciones";
    var estGrados = ViewBag.EstudianteGrados as Dictionary<int, string>;
}

<div class="container-fluid mt-4 px-4 pb-5" style="max-width: 1300px; margin: 0 auto;">

    <!-- 1. Encabezado Institucional con Degradado Azul -->
    <div class="card border-0 shadow-sm mb-4 rounded-3 overflow-hidden">
        <div class="d-flex flex-wrap justify-content-between align-items-center px-4 py-3 text-white"
             style="background: linear-gradient(135deg, #0d2a4a 0%, #2980b9 100%);">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle d-flex align-items-center justify-content-center"
                     style="width:48px;height:48px;background:rgba(255,255,255,0.15);">
                    <i class="bi bi-pencil-square fs-4 text-white"></i>
                </div>
                <div>
                    <h4 class="mb-0 fw-bold">Planilla de Calificaciones</h4>
                    <span class="badge bg-light text-dark fw-bold mt-1 px-3 py-1" style="font-size:0.85rem;">
                        <i class="bi bi-person-badge-fill me-1 text-primary"></i> Registro, Edición y Control de Notas
                    </span>
                </div>
            </div>
            <a href="@Url.Action("Dashboard", "Home")" class="btn btn-outline-light btn-sm rounded-pill px-3 shadow-sm mt-2 mt-sm-0">
                <i class="bi bi-arrow-left me-1"></i> Volver al Dashboard
            </a>
        </div>
    </div>

    <!-- 2. Banners de Notificación de Éxito o Error (Toast estilo Notificación) -->
    @if (TempData["MensajeNota"] != null)
    {
        <script>
                document.addEventListener("DOMContentLoaded", function() {
                    Swal.fire({
                        toast: true,
                        position: 'top-end',
                        icon: 'success',
                        title: '@TempData["MensajeNota"]',
                        showConfirmButton: false,
                        timer: 3500,
                        timerProgressBar: true
                    });
                });
        </script>
    }

    @if (TempData["ErrorNota"] != null)
    {
        <script>
                document.addEventListener("DOMContentLoaded", function() {
                    Swal.fire({
                        toast: true,
                        position: 'top-end',
                        icon: 'error',
                        title: '@TempData["ErrorNota"]',
                        showConfirmButton: false,
                        timer: 4000,
                        timerProgressBar: true
                    });
                });
        </script>
    }

    <!-- 3. Filtros de Búsqueda, Grado, Curso, Asignatura y Jornada -->
    <div class="card border-0 shadow-sm p-4 mb-4">
        <div class="row g-3 align-items-end">
            <!-- Buscador por nombre/apellido del estudiante -->
            <div class="col-lg-3 col-md-6">
                <label class="form-label fw-bold text-dark mb-1">
                    <i class="bi bi-search me-1 text-primary"></i>Buscar Estudiante
                </label>
                <div class="input-group">
                    <span class="input-group-text bg-white text-muted border-end-0"><i class="bi bi-person-search"></i></span>
                    <input type="text" class="form-control border-start-0 ps-0" id="inputBuscarEstudiante" placeholder="Escribe nombre o apellido...">
                </div>
            </div>

            <!-- Filtro por Curso / Grupo específico -->
            <div class="col-lg-3 col-md-4 col-sm-6">
                <label class="form-label fw-bold text-dark mb-1">
                    <i class="bi bi-people me-1 text-primary"></i>Curso
                </label>
                <select class="form-select" id="selectGrado" name="selectGrado">
                    <option value="todos">Todos los Cursos</option>
                    @if (ViewBag.Grados != null && ((IEnumerable<string>)ViewBag.Grados).Any())
                    {
                        foreach (var grado in ViewBag.Grados)
                        {
                            <option value="@grado">@grado</option>
                        }
                    }
                    else
                    {
                        <option value="601 M">601 M</option>
                        <option value="602 M">602 M</option>
                        <option value="603 M">603 M</option>
                        <option value="701 M">701 M</option>
                        <option value="702 M">702 M</option>
                        <option value="703 M">703 M</option>
                        <option value="801 M">801 M</option>
                        <option value="802 M">802 M</option>
                        <option value="803 M">803 M</option>
                        <option value="901 M">901 M</option>
                        <option value="902 M">902 M</option>
                        <option value="903 M">903 M</option>
                        <option value="1001 M">1001 M</option>
                        <option value="1002 M">1002 M</option>
                        <option value="1003 M">1003 M</option>
                        <option value="1101 M">1101 M</option>
                        <option value="1102 M">1102 M</option>
                        <option value="1103 M">1103 M</option>
                        <option value="601 T">601 T</option>
                        <option value="602 T">602 T</option>
                        <option value="603 T">603 T</option>
                        <option value="701 T">701 T</option>
                        <option value="702 T">702 T</option>
                        <option value="703 T">703 T</option>
                        <option value="801 T">801 T</option>
                        <option value="802 T">802 T</option>
                        <option value="803 T">803 T</option>
                        <option value="901 T">901 T</option>
                        <option value="902 T">902 T</option>
                        <option value="903 T">903 T</option>
                        <option value="1001 T">1001 T</option>
                        <option value="1002 T">1002 T</option>
                        <option value="1003 T">1003 T</option>
                        <option value="1101 T">1101 T</option>
                        <option value="1102 T">1102 T</option>
                        <option value="1103 T">1103 T</option>
                    }
                </select>
            </div>

            <!-- Filtro por Jornada (Mañana M / Tarde T) -->
            <div class="col-lg-2 col-md-4 col-sm-6">
                <label class="form-label fw-bold text-dark mb-1">
                    <i class="bi bi-clock-history me-1 text-primary"></i>Jornada
                </label>
                <select class="form-select" id="selectJornada" name="selectJornada">
                    <option value="todos">Todas las Jornadas</option>
                    <option value="Mañana" selected>Mañana (M)</option>
                    <option value="Tarde">Tarde (T)</option>
                </select>
            </div>

            <!-- Asignatura -->
            <div class="col-lg-3 col-md-8 col-sm-6">
                <label class="form-label fw-bold text-dark mb-1">
                    <i class="bi bi-book me-1 text-primary"></i>Asignatura
                </label>
                <select class="form-select" id="selectAsignatura" name="selectAsignatura">
                    @if (ViewBag.Asignaturas != null && ((IEnumerable<string>)ViewBag.Asignaturas).Any())
                    {
                        foreach (var nombre in ViewBag.Asignaturas)
                        {
                            <option value="@nombre">@nombre</option>
                        }
                    }
                    else
                    {
                        <option value="" disabled selected>*no hay asignaturas registradas para ingresar notas*</option>
                    }
                </select>
            </div>
        </div>
    </div>

    <!-- 4. Tabla de Calificaciones y Botón Agregar Nota -->
    <div class="card border-0 shadow-sm overflow-hidden mb-4">
        <div class="p-3 border-bottom d-flex align-items-center justify-content-between bg-light">
            <h5 class="fw-bold mb-0 text-dark" id="contadorEstudiantesInscritos">Estudiantes Inscritos (@(Model?.Count ?? 0))</h5>
            <button type="button" class="btn btn-sm btn-success fw-bold" id="btnAgregarNota">
                <i class="bi bi-plus-circle me-1"></i> Agregar Nota
            </button>
        </div>

        <form action="@Url.Action("GuardarNota", "Docente")" method="post" id="formPlanilla">
            @Html.AntiForgeryToken()
            <input type="hidden" name="selectGrado" id="formHiddenGrado" value="" />
            <input type="hidden" name="selectAsignatura" id="formHiddenAsignatura" value="" />
            <input type="hidden" name="selectJornada" id="formHiddenJornada" value="" />
            <input type="hidden" name="selectPeriodo" id="formHiddenPeriodo" value="1" />
            <div class="table-responsive">
                <table class="table align-middle mb-0 table-hover" id="tablaPlanilla">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-3">Estudiante</th>
                            <th class="text-center" style="width: 170px;">
                                <span class="titulo-col">Tarea 1</span>
                                <button type="button" class="btn btn-sm btn-outline-warning text-white p-0 px-1 ms-1 btn-editar-col" title="Renombrar nota">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger text-white p-0 px-1 ms-1 btn-eliminar-col" title="Eliminar nota">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </th>
                            <th class="text-center" style="width: 170px;">
                                <span class="titulo-col">Examen</span>
                                <button type="button" class="btn btn-sm btn-outline-warning text-white p-0 px-1 ms-1 btn-editar-col" title="Renombrar nota">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger text-white p-0 px-1 ms-1 btn-eliminar-col" title="Eliminar nota">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </th>
                            <th class="text-center" style="width: 170px;">
                                <span class="titulo-col">Actitudinal</span>
                                <button type="button" class="btn btn-sm btn-outline-warning text-white p-0 px-1 ms-1 btn-editar-col" title="Renombrar nota">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger text-white p-0 px-1 ms-1 btn-eliminar-col" title="Eliminar nota">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </th>
                            <th class="text-center" style="width: 130px;">Definitiva</th>
                            <th class="text-center" style="width: 140px;">Desempeño</th>
                        </tr>
                    </thead>
                    <tbody id="tbodyPlanilla">
                        @if (Model != null && Model.Any())
                        {
                            foreach (var estudiante in Model)
                            {
                                string gradoEst = "";
                                if (estGrados != null && estGrados.ContainsKey(estudiante.ID_Usuario))
                                {
                                    gradoEst = estGrados[estudiante.ID_Usuario] ?? "";
                                }
                                <tr class="fila-estudiante" data-grado="@gradoEst">
                                    <td class="ps-3 fw-bold">
                                        <input type="hidden" name="estudiante_id" value="@estudiante.ID_Usuario" />
                                        <div class="d-flex align-items-center justify-content-between">
                                            <span>@estudiante.NOMBRES @estudiante.APELLIDOS</span>
                                            @if (!string.IsNullOrEmpty(gradoEst))
                                            {
                                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle ms-2">@gradoEst</span>
                                            }
                                        </div>
                                        @{
                                            var todasMejoras = ViewBag.AccionesMejora as List<ProyectoPAE.Models.AccionMejora> ?? new List<ProyectoPAE.Models.AccionMejora>();
                                            var mejorasEst = todasMejoras.Where(m => m.IdEstudiante == estudiante.ID_Usuario).ToList();
                                        }
                                        @if (mejorasEst.Any())
                                        {
                                            <div class="mt-2 p-2 rounded-3 border accion-mejora-planilla-box" style="background: #fffdf5; border-color: #fde68a !important; font-weight: normal;">
                                                @foreach (var mej in mejorasEst)
                                                {
                                                    string badgeSegColor = mej.EstadoSeguimiento == "Cumplido" ? "success" : mej.EstadoSeguimiento == "No Cumplido" ? "danger" : "warning";
                                                    <div class="mb-1 pb-1 border-bottom border-light">
                                                        <div class="d-flex align-items-center justify-content-between">
                                                            <span class="badge bg-warning text-dark px-2 py-1" style="font-size: 0.72rem;">
                                                                <i class="bi bi-arrow-up-right-circle me-1"></i> Acción de Mejora: @mej.Materia (P@(mej.Periodo))
                                                            </span>
                                                            <span class="badge bg-@badgeSegColor text-white" style="font-size: 0.7rem;">
                                                                Seguimiento: @mej.EstadoSeguimiento
                                                            </span>
                                                        </div>
                                                        <div class="text-muted small mt-1" style="font-size: 0.78rem;">
                                                            <strong>Aspecto:</strong> @mej.AspectoMejorar
                                                        </div>
                                                        <div class="text-dark small" style="font-size: 0.78rem;">
                                                            <strong>Compromiso:</strong> @mej.CompromisoEstudiante
                                                        </div>
                                                        @if (!string.IsNullOrEmpty(mej.ObservacionSeguimiento))
                                                        {
                                                            <div class="text-primary small mt-1" style="font-size: 0.76rem;">
                                                                <strong>Docente Seguimiento:</strong> @mej.ObservacionSeguimiento
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        <div class="input-group input-group-sm nota-group mx-auto" style="width: 95px;">
                                            <input type="text" inputmode="decimal" class="form-control form-control-sm text-center nota-input px-1" value="0.0" maxlength="3" placeholder="0.0">
                                            <div class="input-group-text p-0 d-flex flex-column justify-content-center bg-light border-start-0" style="width: 18px; cursor: pointer;">
                                                <i class="bi bi-chevron-up btn-step-up text-secondary" style="font-size: 8px; line-height: 8px; padding: 2px 0;" title="Aumentar 0.1"></i>
                                                <i class="bi bi-chevron-down btn-step-down text-secondary" style="font-size: 8px; line-height: 8px; padding: 2px 0;" title="Disminuir 0.1"></i>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="input-group input-group-sm nota-group mx-auto" style="width: 95px;">
                                            <input type="text" inputmode="decimal" class="form-control form-control-sm text-center nota-input px-1" value="0.0" maxlength="3" placeholder="0.0">
                                            <div class="input-group-text p-0 d-flex flex-column justify-content-center bg-light border-start-0" style="width: 18px; cursor: pointer;">
                                                <i class="bi bi-chevron-up btn-step-up text-secondary" style="font-size: 8px; line-height: 8px; padding: 2px 0;" title="Aumentar 0.1"></i>
                                                <i class="bi bi-chevron-down btn-step-down text-secondary" style="font-size: 8px; line-height: 8px; padding: 2px 0;" title="Disminuir 0.1"></i>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="input-group input-group-sm nota-group mx-auto" style="width: 95px;">
                                            <input type="text" inputmode="decimal" class="form-control form-control-sm text-center nota-input px-1" value="0.0" maxlength="3" placeholder="0.0">
                                            <div class="input-group-text p-0 d-flex flex-column justify-content-center bg-light border-start-0" style="width: 18px; cursor: pointer;">
                                                <i class="bi bi-chevron-up btn-step-up text-secondary" style="font-size: 8px; line-height: 8px; padding: 2px 0;" title="Aumentar 0.1"></i>
                                                <i class="bi bi-chevron-down btn-step-down text-secondary" style="font-size: 8px; line-height: 8px; padding: 2px 0;" title="Disminuir 0.1"></i>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <input type="hidden" name="nota_valor" class="input-nota-valor" value="0.0" />
                                        <span class="badge bg-danger fs-6 nota-definitiva">0.0</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-danger fs-6 badge-desempeno">Bajo</span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">No hay estudiantes registrados.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- PAGINACIÓN CLIENT-SIDE PLANILLA -->
            <div class="card-footer bg-white d-flex flex-wrap align-items-center justify-content-between gap-2 px-3 py-2 border-top">
                <p class="text-muted small mb-0" id="infoPlanillaPagina">Cargando...</p>
                <nav aria-label="Paginación planilla">
                    <ul class="pagination pagination-sm mb-0" id="paginacionPlanilla"></ul>
                </nav>
            </div>

            <!-- Botón Guardar Calificaciones (CRUD) -->
            <div class="p-3 bg-light text-end border-top">
                <button type="submit" class="btn text-white fw-bold rounded-pill px-4 shadow-sm" style="background-color: #2980b9;" id="btnSubmitPlanilla">
                    <i class="bi bi-save me-2"></i>Guardar Calificaciones
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Lógica interactiva en JavaScript con Confirmación y Caché -->
<script>
    document.addEventListener("DOMContentLoaded", function() {

        const selectGrado = document.getElementById('selectGrado');
        const selectAsignatura = document.getElementById('selectAsignatura');
        const selectJornada = document.getElementById('selectJornada');
        const tabla = document.getElementById('tablaPlanilla');
        const formPlanilla = document.querySelector('form[action*="GuardarNota"]');

        // --- PARSEO Y VALIDACIÓN DE NOTAS (0.0 a 5.0, MÁX 3 CARACTERES) ---
        function parsearNota(valStr) {
            if (valStr === null || valStr === undefined) return NaN;
            let str = valStr.toString().trim().replace(',', '.');
            if (str === '') return NaN;
            return parseFloat(str);
        }

        function validarYFormatearInput(input, mostrarAlerta = true) {
            let rawVal = input.value ? input.value.trim() : '';
            if (rawVal === '') {
                input.value = "0.0";
                return true;
            }

            // Truncar si excede los 3 caracteres
            if (rawVal.length > 3) {
                rawVal = rawVal.substring(0, 3);
                input.value = rawVal;
            }

            let num = parsearNota(rawVal);

            // Rechazar valores NaN, menores a 0.0 (negativos) o mayores a 5.0
            if (isNaN(num) || num < 0.0 || num > 5.0) {
                if (mostrarAlerta) {
                    Swal.fire({
                        toast: true,
                        position: 'top-end',
                        icon: 'error',
                        title: '¡Nota inválida!',
                        text: 'La calificación debe estar entre 0.0 y 5.0 (máximo 3 caracteres).',
                        showConfirmButton: false,
                        timer: 3500,
                        timerProgressBar: true
                    });
                }
                input.value = "0.0";
                return false;
            } else {
                // Formato decimal con punto (ej. 3.5, 5.0)
                input.value = (Math.round(num * 10) / 10).toFixed(1);
                return true;
            }
        }

        // --- A. GESTIÓN DE CACHÉ (LocalStorage) ---
        function obtenerClaveCache() {
            const g = selectGrado ? selectGrado.value : '6A';
            const a = selectAsignatura ? selectAsignatura.value : 'Matematicas';
            const j = selectJornada ? selectJornada.value : 'Manana';
            return `planilla_cache_${g}_${a}_${j}`;
        }

        function guardarEnCache() {
            if (!tabla) return;
            const clave = obtenerClaveCache();

            // 1. Guardar los nombres de las columnas de evaluación
            const columnas = [];
            tabla.querySelectorAll('thead tr th').forEach(th => {
                const span = th.querySelector('.titulo-col');
                if (span) {
                    columnas.push(span.textContent.trim());
                }
            });

            // 2. Guardar las notas por estudiante
            const notasEstudiantes = {};
            tabla.querySelectorAll('tbody tr').forEach(fila => {
                const estIdInput = fila.querySelector('input[name="estudiante_id"]');
                if (!estIdInput) return;
                const estId = estIdInput.value;

                const valores = [];
                fila.querySelectorAll('.nota-input').forEach(input => {
                    valores.push(input.value);
                });
                notasEstudiantes[estId] = valores;
            });

            const datosCache = {
                columnas: columnas,
                notas: notasEstudiantes
            };

            localStorage.setItem(clave, JSON.stringify(datosCache));
        }

        function crearHTMLThNota(titulo) {
            const th = document.createElement('th');
            th.className = 'text-center';
            th.style.width = '170px';
            th.innerHTML = `
                    <span class="titulo-col">${titulo}</span>
                    <button type="button" class="btn btn-sm btn-outline-warning text-white p-0 px-1 ms-1 btn-editar-col" title="Renombrar nota">
                        <i class="bi bi-pencil"></i>
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-danger text-white p-0 px-1 ms-1 btn-eliminar-col" title="Eliminar nota">
                        <i class="bi bi-trash"></i>
                    </button>
                `;
            return th;
        }

        function crearHTMLTdNota(valor = "0.0") {
            const td = document.createElement('td');
            td.innerHTML = `
                    <div class="input-group input-group-sm nota-group mx-auto" style="width: 95px;">
                        <input type="text" inputmode="decimal" class="form-control form-control-sm text-center nota-input px-1" value="${valor}" maxlength="3" placeholder="0.0">
                        <div class="input-group-text p-0 d-flex flex-column justify-content-center bg-light border-start-0" style="width: 18px; cursor: pointer;">
                            <i class="bi bi-chevron-up btn-step-up text-secondary" style="font-size: 8px; line-height: 8px; padding: 2px 0;" title="Aumentar 0.1"></i>
                            <i class="bi bi-chevron-down btn-step-down text-secondary" style="font-size: 8px; line-height: 8px; padding: 2px 0;" title="Disminuir 0.1"></i>
                        </div>
                    </div>
                `;
            return td;
        }

        function cargarDesdeCache() {
            if (!tabla) return;
            const clave = obtenerClaveCache();
            const cache = localStorage.getItem(clave);
            if (!cache) return;

            try {
                const datosCache = JSON.parse(cache);
                if (!datosCache) return;

                const columnasGuardadas = datosCache.columnas || [];
                const notasEstudiantes = datosCache.notas || (typeof datosCache === 'object' && !datosCache.columnas ? datosCache : {});

                // Reconstruir columnas del Header si existen en el caché
                if (columnasGuardadas.length > 0) {
                    const trHeader = tabla.querySelector('thead tr');
                    if (trHeader) {
                        const thsActuales = Array.from(trHeader.querySelectorAll('th'));
                        thsActuales.forEach(th => {
                            if (th.querySelector('.titulo-col')) {
                                th.remove();
                            }
                        });

                        const thDefinitiva = Array.from(trHeader.children).find(th => th.textContent.trim().includes('Definitiva')) || trHeader.lastElementChild;

                        columnasGuardadas.forEach(titulo => {
                            const nuevoTh = crearHTMLThNota(titulo);
                            trHeader.insertBefore(nuevoTh, thDefinitiva);
                        });
                    }

                    // Reconstruir celdas de nota en cada fila de estudiante
                    tabla.querySelectorAll('tbody tr').forEach(fila => {
                        const tdsActuales = Array.from(fila.children);
                        tdsActuales.forEach(td => {
                            if (td.querySelector('.nota-input')) {
                                td.remove();
                            }
                        });

                        const tdDefinitiva = Array.from(fila.children).find(td => td.querySelector('.nota-definitiva')) || fila.lastElementChild;

                        columnasGuardadas.forEach(() => {
                            const nuevoTd = crearHTMLTdNota("0.0");
                            fila.insertBefore(nuevoTd, tdDefinitiva);
                        });
                    });
                }

                // Cargar valores de notas guardados
                tabla.querySelectorAll('tbody tr').forEach(fila => {
                    const estIdInput = fila.querySelector('input[name="estudiante_id"]');
                    if (!estIdInput) return;
                    const estId = estIdInput.value;

                    if (notasEstudiantes[estId]) {
                        const inputs = fila.querySelectorAll('.nota-input');
                        notasEstudiantes[estId].forEach((val, idx) => {
                            if (inputs[idx]) {
                                let cleanVal = val ? val.toString().replace(',', '.') : "0.0";
                                let num = parseFloat(cleanVal);
                                if (isNaN(num) || num < 0.0 || num > 5.0) {
                                    cleanVal = "0.0";
                                } else {
                                    cleanVal = (Math.round(num * 10) / 10).toFixed(1);
                                }
                                inputs[idx].value = cleanVal;
                            }
                        });
                    }
                    calcularDefinitiva(fila);
                });
            } catch (e) {
                console.error("Error al cargar caché de notas:", e);
            }
        }

        // --- B. CÁLCULO DE DEFINITIVA Y DESEMPEÑO ---
        function calcularDefinitiva(fila) {
            const inputs = fila.querySelectorAll('.nota-input');
            const badgeDefinitiva = fila.querySelector('.nota-definitiva');
            const badgeDesempeno = fila.querySelector('.badge-desempeno');
            const hiddenValor = fila.querySelector('.input-nota-valor');

            if (!inputs.length || !badgeDefinitiva) return;

            let suma = 0;
            let cantidad = 0;

            inputs.forEach(input => {
                let val = parsearNota(input.value);

                if (!isNaN(val)) {
                    suma += val;
                    cantidad++;
                }
            });

            if (cantidad > 0) {
                const promedio = suma / cantidad;
                const promedioStr = promedio.toFixed(1);
                badgeDefinitiva.textContent = promedioStr;

                if (hiddenValor) {
                    hiddenValor.value = promedioStr;
                }

                badgeDefinitiva.className = promedio >= 3.0
                    ? "badge bg-success fs-6 nota-definitiva"
                    : "badge bg-danger fs-6 nota-definitiva";

                // --- DESEMPEÑO (No modificable) ---
                if (badgeDesempeno) {
                    const promRedondeado = Math.round(promedio * 10) / 10;

                    if (promRedondeado >= 5.0) {
                        badgeDesempeno.textContent = "Superior";
                        badgeDesempeno.className = "badge bg-success fs-6 badge-desempeno";
                    } else if (promRedondeado >= 4.0) {
                        badgeDesempeno.textContent = "Alto";
                        badgeDesempeno.className = "badge bg-primary fs-6 badge-desempeno";
                    } else if (promRedondeado >= 3.0) {
                        badgeDesempeno.textContent = "Básico";
                        badgeDesempeno.className = "badge bg-warning text-dark fs-6 badge-desempeno";
                    } else {
                        badgeDesempeno.textContent = "Bajo";
                        badgeDesempeno.className = "badge bg-danger fs-6 badge-desempeno";
                    }
                }
            }
        }

        // Inicializar tabla y cargar caché existente
        if (tabla) {
            cargarDesdeCache();
            tabla.querySelectorAll('tbody tr').forEach(fila => {
                fila.querySelectorAll('.nota-input').forEach(input => {
                    validarYFormatearInput(input, false);
                });
                calcularDefinitiva(fila);
            });

            // Auto-selección completa del texto al enfocar o hacer clic
            // Permite al docente escribir directamente la nota reemplazando el "0.0" sin tener que borrarlo manualmente
            tabla.addEventListener('focusin', function(e) {
                if (e.target.classList.contains('nota-input')) {
                    setTimeout(function() {
                        e.target.select();
                    }, 20);
                }
            });

            tabla.addEventListener('click', function(e) {
                if (e.target.classList.contains('nota-input')) {
                    e.target.select();
                }
            });

            // Formatear y validar al salir del campo (blur), restaurando "0.0" si la casilla queda vacía
            tabla.addEventListener('blur', function(e) {
                if (e.target.classList.contains('nota-input')) {
                    validarYFormatearInput(e.target, true);
                    const fila = e.target.closest('tr');
                    calcularDefinitiva(fila);
                    guardarEnCache();
                }
            }, true);

            // Control de flechitas de incremento y decremento (▲ y ▼)
            tabla.addEventListener('click', function(e) {
                const btnUp = e.target.closest('.btn-step-up');
                const btnDown = e.target.closest('.btn-step-down');

                if (btnUp || btnDown) {
                    const group = e.target.closest('.nota-group');
                    if (!group) return;
                    const input = group.querySelector('.nota-input');
                    if (!input) return;

                    let val = parseFloat(input.value.replace(',', '.')) || 0.0;
                    if (btnUp) {
                        val = Math.min(5.0, Math.round((val + 0.1) * 10) / 10);
                    } else if (btnDown) {
                        val = Math.max(0.0, Math.round((val - 0.1) * 10) / 10);
                    }
                    input.value = val.toFixed(1);
                    const fila = input.closest('tr');
                    calcularDefinitiva(fila);
                    guardarEnCache();
                }
            });

            // Control de teclas de navegación (flecha arriba / abajo en teclado)
            tabla.addEventListener('keydown', function(e) {
                if (e.target.classList.contains('nota-input')) {
                    if (e.key === 'ArrowUp' || e.key === 'ArrowDown') {
                        e.preventDefault();
                        let val = parseFloat(e.target.value.replace(',', '.')) || 0.0;
                        if (e.key === 'ArrowUp') {
                            val = Math.min(5.0, Math.round((val + 0.1) * 10) / 10);
                        } else {
                            val = Math.max(0.0, Math.round((val - 0.1) * 10) / 10);
                        }
                        e.target.value = val.toFixed(1);
                        const fila = e.target.closest('tr');
                        calcularDefinitiva(fila);
                        guardarEnCache();
                    }
                }
            });

            tabla.addEventListener('change', function(e) {
                if (e.target.classList.contains('nota-input')) {
                    validarYFormatearInput(e.target, true);
                    const fila = e.target.closest('tr');
                    calcularDefinitiva(fila);
                    guardarEnCache();
                }
            });

            // Validación inmediata MIENTRAS el docente escribe
            tabla.addEventListener('input', function(e) {
                if (e.target.classList.contains('nota-input')) {
                    let valStr = e.target.value.replace(',', '.');

                    if (valStr.length > 3) {
                        valStr = valStr.substring(0, 3);
                        e.target.value = valStr;
                    }

                    let num = parseFloat(valStr);

                    if (!isNaN(num) && (num > 5.0 || num < 0.0)) {
                        Swal.fire({
                            toast: true,
                            position: 'top-end',
                            icon: 'error',
                            title: '¡Nota fuera de rango!',
                            text: 'La calificación no puede ser mayor a 5.0 ni menor a 0.0.',
                            showConfirmButton: false,
                            timer: 2500,
                            timerProgressBar: true
                        });
                        e.target.value = "0.0";
                    }

                    const fila = e.target.closest('tr');
                    calcularDefinitiva(fila);
                }
            });
        }

        // --- FILTRADO POR BUSCADOR, GRADO NIVEL, CURSO Y JORNADA CLIENT-SIDE ---
        let planillaPaginaActual = 1;
        const PLANILLA_POR_PAGINA = 20;

        const inputBuscarEst = document.getElementById('inputBuscarEstudiante');

        function getFilasPlanillaFiltradas() {
            const term = (inputBuscarEst ? inputBuscarEst.value : '').toLowerCase().trim();
            const valGrado = (selectGrado ? selectGrado.value : 'todos').toLowerCase().trim();
            const valJornada = (selectJornada ? selectJornada.value : 'todos').toLowerCase().trim();

            const todasFilas = Array.from(document.querySelectorAll('#tablaPlanilla tbody tr.fila-estudiante'));
            return todasFilas.filter(fila => {
                const nombreEst = (fila.querySelector('td:first-child')?.textContent || '').toLowerCase();
                const gradoFila = (fila.getAttribute('data-grado') || '').toLowerCase().trim();

                // 1. Filtro por texto / nombre de estudiante
                if (term !== '' && !nombreEst.includes(term)) {
                    return false;
                }

                // 2. Filtro por Jornada (M = Mañana / T = Tarde)
                if (valJornada !== 'todos') {
                    const esManana = valJornada.includes('mañana') || valJornada.includes('manana') || valJornada.startsWith('m');
                    const esTarde = valJornada.includes('tarde') || valJornada.startsWith('t');

                    if (esManana) {
                        const esFilaM = gradoFila.endsWith('m') || gradoFila.includes(' m') || gradoFila.includes('m') || gradoFila.includes('mañana');
                        if (!esFilaM && gradoFila !== '') return false;
                    } else if (esTarde) {
                        const esFilaT = gradoFila.endsWith('t') || gradoFila.includes(' t') || gradoFila.includes('t') || gradoFila.includes('tarde');
                        if (!esFilaT && gradoFila !== '') return false;
                    }
                }



                // 4. Filtro por Curso Específico
                if (valGrado !== 'todos' && valGrado !== '') {
                    const matchExacto = gradoFila === valGrado || gradoFila.includes(valGrado) || valGrado.includes(gradoFila);
                    if (!matchExacto) return false;
                }

                return true;
            });
        }

        function renderizarPaginacionPlanilla() {
            const filasFiltradas = getFilasPlanillaFiltradas();
            const totalFilas = filasFiltradas.length;
            const totalPaginas = Math.max(1, Math.ceil(totalFilas / PLANILLA_POR_PAGINA));

            if (planillaPaginaActual > totalPaginas) planillaPaginaActual = totalPaginas;

            // Ocultar todas las filas
            document.querySelectorAll('#tablaPlanilla tbody tr.fila-estudiante').forEach(f => f.style.display = 'none');

            // Mostrar las de la página actual
            const inicio = (planillaPaginaActual - 1) * PLANILLA_POR_PAGINA;
            const fin = Math.min(inicio + PLANILLA_POR_PAGINA, totalFilas);
            for (let i = inicio; i < fin; i++) {
                filasFiltradas[i].style.display = '';
            }

            // Info de paginación y contador superior
            const info = document.getElementById('infoPlanillaPagina');
            if (info) {
                if (totalFilas === 0) {
                    info.textContent = 'Sin estudiantes para los filtros seleccionados';
                } else {
                    info.textContent = `Mostrando ${inicio + 1}–${fin} de ${totalFilas} estudiantes`;
                }
            }

            const contador = document.getElementById('contadorEstudiantesInscritos');
            if (contador) {
                contador.textContent = `Estudiantes Filtrados (${totalFilas})`;
            }

            // Barra de navegación
            const ul = document.getElementById('paginacionPlanilla');
            if (!ul) return;
            ul.innerHTML = '';

            if (totalPaginas <= 1) return;

            const crearLi = (label, pagina, activo, disabled) => {
                const li = document.createElement('li');
                li.className = `page-item${activo ? ' active' : ''}${disabled ? ' disabled' : ''}`;
                const a = document.createElement('a');
                a.className = 'page-link';
                a.innerHTML = label;
                a.href = '#';
                if (!disabled && !activo) {
                    a.addEventListener('click', (e) => {
                        e.preventDefault();
                        planillaPaginaActual = pagina;
                        renderizarPaginacionPlanilla();
                    });
                }
                li.appendChild(a);
                ul.appendChild(li);
            };

            crearLi('&laquo;', planillaPaginaActual - 1, false, planillaPaginaActual === 1);

            const rango = 2;
            for (let p = 1; p <= totalPaginas; p++) {
                if (p === 1 || p === totalPaginas || (p >= planillaPaginaActual - rango && p <= planillaPaginaActual + rango)) {
                    crearLi(p, p, p === planillaPaginaActual, false);
                } else if (p === planillaPaginaActual - rango - 1 || p === planillaPaginaActual + rango + 1) {
                    crearLi('...', p, false, true);
                }
            }

            crearLi('&raquo;', planillaPaginaActual + 1, false, planillaPaginaActual === totalPaginas);
        }

        function filtrarPlanilla() {
            planillaPaginaActual = 1;
            renderizarPaginacionPlanilla();
        }

        // Filtrado dinámico de opciones de Cursos según la Jornada (Mañana -> M / Tarde -> T) y Grado Nivel
        function filtrarOpcionesCursos() {
            if (!selectGrado) return;

            const jornada = selectJornada ? (selectJornada.value || '') : '';
            const esManana = jornada.toLowerCase().includes('mañana') || jornada.toLowerCase().includes('manana') || jornada.toLowerCase().startsWith('m');
            const esTarde = jornada.toLowerCase().includes('tarde') || jornada.toLowerCase().startsWith('t');
            const esTodosJornada = !jornada || jornada.toLowerCase() === 'todos';

            let seleccionadoVisible = false;

            Array.from(selectGrado.options).forEach(opt => {
                const txt = opt.text.trim();
                const val = opt.value.trim();
                let mostrar = true;

                if (val === 'todos' || txt.toLowerCase().includes('todos')) {
                    mostrar = true;
                } else {
                    // Filtrar estrictamente por jornada (M vs T)
                    if (!esTodosJornada) {
                        const esOpcionM = txt.endsWith('M') || val.endsWith('M') || txt.includes(' M') || val.includes(' M');
                        const esOpcionT = txt.endsWith('T') || val.endsWith('T') || txt.includes(' T') || val.includes(' T');

                        if (esManana && !esOpcionM) {
                            mostrar = false;
                        } else if (esTarde && !esOpcionT) {
                            mostrar = false;
                        }
                    }
                }

                opt.hidden = !mostrar;
                opt.disabled = !mostrar;
                opt.style.display = mostrar ? '' : 'none';

                if (mostrar && opt.selected) {
                    seleccionadoVisible = true;
                }
            });

            if (!seleccionadoVisible) {
                const primerVisible = Array.from(selectGrado.options).find(opt => !opt.hidden && !opt.disabled);
                if (primerVisible) {
                    selectGrado.value = primerVisible.value;
                }
            }
        }

        // Listeners para todos los filtros
        if (inputBuscarEst) {
            inputBuscarEst.addEventListener('input', filtrarPlanilla);
        }

        if (selectJornada) {
            selectJornada.addEventListener('change', function() {
                filtrarOpcionesCursos();
                filtrarPlanilla();
                cargarDesdeCache();
            });
        }

        if (selectGrado) {
            selectGrado.addEventListener('change', function() {
                filtrarPlanilla();
                cargarDesdeCache();
            });
        }

        if (selectAsignatura) {
            selectAsignatura.addEventListener('change', cargarDesdeCache);
        }

        // Ejecutar filtrado inicial y paginación al cargar la vista
        filtrarOpcionesCursos();
        renderizarPaginacionPlanilla();

        // --- C. CONFIRMACIÓN ANTES DE GUARDAR FORMULARIO ---
        if (formPlanilla) {
            formPlanilla.addEventListener('submit', function(e) {
                let hayErrores = false;
                tabla.querySelectorAll('.nota-input').forEach(input => {
                    if (!validarYFormatearInput(input, false)) {
                        hayErrores = true;
                    }
                });

                if (hayErrores) {
                    e.preventDefault();
                    Swal.fire({
                        toast: true,
                        position: 'top-end',
                        icon: 'error',
                        title: '¡Calificación inválida!',
                        text: 'Existen notas con formato o rango incorrecto (0.0 a 5.0, máx 3 caracteres).',
                        showConfirmButton: false,
                        timer: 3500,
                        timerProgressBar: true
                    });
                    return;
                }

                if (formPlanilla.dataset.confirmado === "true") return;

                e.preventDefault();

                Swal.fire({
                    title: '¿Guardar Calificaciones?',
                    text: '¿Deseas guardar los cambios realizados en la planilla actual?',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#0d6efd',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: '<i class="bi bi-save me-1"></i> Sí, guardar',
                    cancelButtonText: 'Cancelar'
                }).then((result) => {
                    if (result.isConfirmed) {
                        guardarEnCache(); // Asegurar guardado en caché antes de enviar

                        // Sincronizar inputs ocultos con los valores seleccionados
                        const hGrado = document.getElementById('formHiddenGrado');
                        const hAsig = document.getElementById('formHiddenAsignatura');
                        const hJornada = document.getElementById('formHiddenJornada');
                        if (hGrado && selectGrado) hGrado.value = selectGrado.value;
                        if (hAsig && selectAsignatura) hAsig.value = selectAsignatura.value;
                        if (hJornada && selectJornada) hJornada.value = selectJornada.value;

                        // Si hay filtro activo, solo enviar las filas filtradas para mayor velocidad y precisión
                        const filasFiltradas = getFilasPlanillaFiltradas();
                        const setFiltradas = new Set(filasFiltradas);
                        document.querySelectorAll('#tablaPlanilla tbody tr.fila-estudiante').forEach(fila => {
                            const pertenece = setFiltradas.has(fila);
                            fila.querySelectorAll('input').forEach(inp => {
                                inp.disabled = !pertenece;
                            });
                        });

                        formPlanilla.dataset.confirmado = "true";
                        formPlanilla.submit();
                    }
                });
            });
        }

        // --- D. AGREGAR COLUMNA ---
        let contadorNotas = 2;
        const btnAgregar = document.getElementById('btnAgregarNota');

        if (btnAgregar) {
            btnAgregar.addEventListener('click', function() {
                Swal.fire({
                    title: 'Agregar Calificación',
                    text: 'Escriba el nombre de la nueva columna/evaluación:',
                    input: 'text',
                    inputValue: `Nota ${contadorNotas}`,
                    showCancelButton: true,
                    confirmButtonText: '<i class="bi bi-check-lg"></i> Agregar',
                    cancelButtonText: 'Cancelar',
                    confirmButtonColor: '#198754',
                    inputValidator: (value) => {
                        if (!value || !value.trim()) {
                            return '¡Debes ingresar un nombre!';
                        }
                    }
                }).then((result) => {
                    if (result.isConfirmed && result.value) {
                        const tituloFinal = result.value.trim();
                        contadorNotas++;

                        const trHeader = document.querySelector('#tablaPlanilla thead tr');
                        const thDefinitiva = Array.from(trHeader.children).find(th => th.textContent.trim().includes('Definitiva')) || trHeader.lastElementChild;

                        const nuevoTh = document.createElement('th');
                        nuevoTh.className = 'text-center';
                        nuevoTh.style.width = '170px';
                        nuevoTh.innerHTML = `
                                <span class="titulo-col">${tituloFinal}</span>
                                <button type="button" class="btn btn-sm btn-outline-warning text-white p-0 px-1 ms-1 btn-editar-col" title="Renombrar nota">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger text-white p-0 px-1 ms-1 btn-eliminar-col" title="Eliminar nota">
                                    <i class="bi bi-trash"></i>
                                </button>
                            `;

                        trHeader.insertBefore(nuevoTh, thDefinitiva);

                        const filasBody = document.querySelectorAll('#tablaPlanilla tbody tr');
                        filasBody.forEach(fila => {
                            const tdDefinitiva = Array.from(fila.children).find(td => td.querySelector('.nota-definitiva')) || fila.lastElementChild;
                            const nuevoTd = document.createElement('td');
                            nuevoTd.innerHTML = `
                                    <div class="input-group input-group-sm nota-group mx-auto" style="width: 95px;">
                                        <input type="text" inputmode="decimal" class="form-control form-control-sm text-center nota-input px-1" value="0.0" maxlength="3" placeholder="0.0">
                                        <div class="input-group-text p-0 d-flex flex-column justify-content-center bg-light border-start-0" style="width: 18px; cursor: pointer;">
                                            <i class="bi bi-chevron-up btn-step-up text-secondary" style="font-size: 8px; line-height: 8px; padding: 2px 0;" title="Aumentar 0.1"></i>
                                            <i class="bi bi-chevron-down btn-step-down text-secondary" style="font-size: 8px; line-height: 8px; padding: 2px 0;" title="Disminuir 0.1"></i>
                                        </div>
                                    </div>
                                `;
                            fila.insertBefore(nuevoTd, tdDefinitiva);
                            calcularDefinitiva(fila);
                        });

                        guardarEnCache();
                    }
                });
            });
        }

        // --- E. RENOMBRAR Y ELIMINAR COLUMNAS ---
        document.addEventListener('click', function(e) {
            const btnEditar = e.target.closest('.btn-editar-col');
            if (btnEditar) {
                const th = btnEditar.closest('th');
                const spanTitulo = th.querySelector('.titulo-col');
                const tituloActual = spanTitulo ? spanTitulo.textContent.trim() : 'Nota';

                Swal.fire({
                    title: 'Renombrar Calificación',
                    text: 'Ingrese el nuevo nombre para esta columna:',
                    input: 'text',
                    inputValue: tituloActual,
                    showCancelButton: true,
                    confirmButtonText: 'Guardar',
                    cancelButtonText: 'Cancelar',
                    confirmButtonColor: '#ffc107',
                    inputValidator: (value) => {
                        if (!value || !value.trim()) {
                            return 'El nombre no puede estar vacío';
                        }
                    }
                }).then((result) => {
                    if (result.isConfirmed && result.value) {
                        if (spanTitulo) {
                            spanTitulo.textContent = result.value.trim();
                            guardarEnCache();
                        }
                    }
                });
            }

            const btnEliminar = e.target.closest('.btn-eliminar-col');
            if (btnEliminar) {
                const th = btnEliminar.closest('th');
                const spanTitulo = th.querySelector('.titulo-col');
                const nombreCol = spanTitulo ? spanTitulo.textContent.trim() : 'esta nota';
                const colIndex = th.cellIndex;

                Swal.fire({
                    title: '¿Eliminar columna?',
                    text: `¿Está seguro de eliminar "${nombreCol}"? Se perderán las notas de esta columna.`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#dc3545',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Sí, eliminar',
                    cancelButtonText: 'Cancelar'
                }).then((result) => {
                    if (result.isConfirmed) {
                        th.remove();
                        document.querySelectorAll('#tablaPlanilla tbody tr').forEach(fila => {
                            if (fila.cells[colIndex]) {
                                fila.cells[colIndex].remove();
                                calcularDefinitiva(fila);
                            }
                        });
                        guardarEnCache();
                    }
                });
            }
        });
    });
</script>




