@model List<ProyectoPAE.Models.Usuario>
@{
    ViewData["Title"] = "Planilla de Notas";
}

<div class="p-4" style="max-width:1200px;margin:0 auto;">

    <!-- Encabezado / Banner superior -->
    <div class="rounded-3 mb-4 p-4 d-flex justify-content-between align-items-center" style="background-color:#0d2a4a;">
        <div>
            <h1 class="text-white fw-bold mb-1">Planilla de Calificaciones</h1>
            <p class="text-white mb-0" style="opacity:0.8;">Gestiona las notas de tus estudiantes en tiempo real.</p>
        </div>
        <a href="@Url.Action("Dashboard", "Home")" class="btn btn-outline-light btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Volver al Dashboard
        </a>
    </div>

    <!-- Tabla de Calificaciones -->
    <div class="bg-white rounded-3 shadow-sm border overflow-hidden">
        <div class="p-3 border-bottom d-flex align-items-center justify-content-between" style="background-color:#f8f9fa;">
            <h5 class="fw-bold mb-0 text-dark">Estudiantes Inscritos (@(Model?.Count ?? 0))</h5>
        </div>

        <div class="table-responsive">
            <table class="table align-middle mb-0 table-hover" id="tablaPlanilla">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-3">Estudiante</th>
                        <th class="text-center" style="width: 150px;">Tarea 1</th>
                        <th class="text-center" style="width: 150px;">Examen</th>
                        <th class="text-center" style="width: 150px;">Actitudinal</th>
                        <th class="text-center" style="width: 130px;">Definitiva</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var estudiante in Model)
                        {
                            <tr>
                                <td class="ps-3 fw-bold">@estudiante.NOMBRES @estudiante.APELLIDOS</td>
                                <td>
                                    <input type="number" class="form-control form-control-sm text-center nota-input" value="0.0" step="0.1" min="0" max="5">
                                </td>
                                <td>
                                    <input type="number" class="form-control form-control-sm text-center nota-input" value="0.0" step="0.1" min="0" max="5">
                                </td>
                                <td>
                                    <input type="number" class="form-control form-control-sm text-center nota-input" value="0.0" step="0.1" min="0" max="5">
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-danger fs-6 nota-definitiva">0.0</span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">No hay estudiantes registrados.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="p-3 bg-light text-end border-top">
            <button class="btn btn-primary fw-bold" style="background-color:#0d2a4a; border:none;">
                <i class="bi bi-save me-2"></i>Guardar Calificaciones
            </button>
        </div>
    </div>
</div>

<!-- Script de cálculo automático de notas definitivas -->
<script>
    document.addEventListener("DOMContentLoaded", function () {

        // Función que calcula el promedio de notas para la fila de un estudiante
        function calcularDefinitiva(fila) {
            const inputs = fila.querySelectorAll('.nota-input');
            const badgeDefinitiva = fila.querySelector('.nota-definitiva');
            
            if (!inputs.length || !badgeDefinitiva) return;

            let suma = 0;
            let cantidad = 0;

            inputs.forEach(input => {
                // Convierte la nota a decimal soportando coma y punto ("4,5" o "4.5")
                const val = parseFloat(input.value.toString().replace(',', '.'));
                if (!isNaN(val)) {
                    suma += val;
                    cantidad++;
                }
            });

            if (cantidad > 0) {
                // Calcula el promedio a 1 decimal
                const promedio = (suma / cantidad).toFixed(1);
                badgeDefinitiva.textContent = promedio;

                // Asigna verde si aprueba (>= 3.0) o rojo si reprueba (< 3.0)
                badgeDefinitiva.className = parseFloat(promedio) >= 3.0 
                    ? "badge bg-success fs-6 nota-definitiva" 
                    : "badge bg-danger fs-6 nota-definitiva";
            }
        }

        const tabla = document.getElementById('tablaPlanilla');
        if (tabla) {
            // 1. Calcula las definitivas al cargar la pantalla
            tabla.querySelectorAll('tbody tr').forEach(fila => calcularDefinitiva(fila));

            // 2. Recalcula automáticamente al escribir (input) o usar las flechas del mouse (change)
            ['input', 'change'].forEach(evento => {
                tabla.addEventListener(evento, function (e) {
                    if (e.target.classList.contains('nota-input')) {
                        calcularDefinitiva(e.target.closest('tr'));
                    }
                });
            });
        }
    });
</script>