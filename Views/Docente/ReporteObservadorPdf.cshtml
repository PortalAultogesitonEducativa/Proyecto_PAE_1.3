@model ProyectoPAE.Models.ObservadorPdfViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Observador del Alumno - @Model.EstudianteNombre</title>
    <style>
        @@page {
            size: A4 portrait;
            margin: 1.2cm 1.2cm 1.2cm 1.2cm;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            font-size: 11px;
            color: #111;
            margin: 0;
            padding: 0;
            line-height: 1.3;
        }

        .header-container {
            width: 100%;
            margin-bottom: 10px;
            border-bottom: 2px solid #000;
            padding-bottom: 6px;
        }

        .header-table {
            width: 100%;
            border-collapse: collapse;
        }

        .header-table td {
            vertical-align: middle;
        }

        .logo-box {
            width: 85px;
            text-align: left;
        }

        .logo-img {
            width: 75px;
            height: auto;
            display: block;
        }

        .header-titles {
            text-align: center;
        }

        .header-titles h2 {
            margin: 0;
            font-size: 15px;
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #0b3c5d;
        }

        .header-titles h3 {
            margin: 3px 0;
            font-size: 11.5px;
            font-weight: bold;
            text-transform: uppercase;
            color: #444;
        }

        .header-titles h4 {
            margin: 4px 0 0 0;
            font-size: 13px;
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #0b3c5d;
        }

        /* Tabla de InformaciÃ³n del Estudiante */
        .info-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 12px;
        }

        .info-table td, .info-table th {
            border: 1px solid #333;
            padding: 4px 6px;
            font-size: 10.5px;
        }

        .info-label {
            font-weight: bold;
            background-color: #f7f7f7;
            width: 22%;
        }

        .info-value {
            background-color: #fff;
            width: 28%;
        }

        .estudiante-destacado {
            background-color: #eef4f8;
            font-weight: bold;
            font-size: 11px;
        }

        /* Tabla de Observaciones por Periodo */
        .observaciones-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 8px;
        }

        .observaciones-table th {
            border: 1px solid #333;
            background-color: #d9e2ec;
            padding: 5px 6px;
            font-size: 11px;
            font-weight: bold;
            text-align: center;
            color: #0b3c5d;
        }

        .observaciones-table td {
            border: 1px solid #333;
            padding: 6px 8px;
            vertical-align: top;
            font-size: 10.5px;
        }

        .periodo-header-row {
            background-color: #e9ecef;
            font-weight: bold;
            text-align: center;
            letter-spacing: 1px;
            font-size: 11px;
            padding: 4px !important;
            color: #111;
        }

        .fecha-col {
            width: 110px;
            text-align: center;
            font-weight: 600;
        }

        .obs-contenido {
            position: relative;
            padding-bottom: 8px;
        }

        .firma-sigla {
            text-align: right;
            font-style: italic;
            color: #444;
            font-size: 9.5px;
            margin-top: 4px;
        }

        .aspectos-box {
            margin-top: 4px;
            padding: 3px 6px;
            background-color: #fff8e6;
            border-left: 3px solid #f59e0b;
            font-size: 10px;
        }

        .sin-observaciones {
            text-align: center;
            color: #777;
            font-style: italic;
            padding: 8px !important;
        }

        .footer-note {
            margin-top: 15px;
            font-size: 9px;
            color: #666;
            text-align: center;
            border-top: 1px dashed #bbb;
            padding-top: 6px;
        }
    </style>
</head>
<body>

    <!-- 1. Encabezado Institucional -->
    <div class="header-container">
        <table class="header-table">
            <tr>
                <td class="logo-box">
                    <img src="data:image/png;base64," class="logo-img" alt="Logo PAE" />
                </td>
                <td class="header-titles">
                    <h2>PORTAL DE AUTOGESTI&Oacute;N EDUCATIVA</h2>
                    <h3>@Model.Sede</h3>
                    <h4>OBSERVADOR DEL ALUMNO</h4>
                </td>
                <td class="logo-box" style="width: 85px;"></td>
            </tr>
        </table>
    </div>

    <!-- 2. Informacion del Estudiante -->
    <table class="info-table">
        <tr>
            <td class="info-label">Ciudad:</td>
            <td class="info-value">@Model.Ciudad</td>
            <td class="info-label">Jornada:</td>
            <td class="info-value">@Model.Jornada</td>
        </tr>
        <tr>
            <td class="info-label">Grupo:</td>
            <td class="info-value">@Model.Grupo</td>
            <td class="info-label">A&ntilde;o Lectivo:</td>
            <td class="info-value">@Model.AnoLectivo</td>
        </tr>
        <tr>
            <td class="info-label">Dir. Grupo:</td>
            <td class="info-value">@Model.DirGrupo</td>
            <td class="info-label">Calendario:</td>
            <td class="info-value">@Model.Calendario</td>
        </tr>
        <tr>
            <td class="info-label estudiante-destacado" colspan="4">
                Estudiante: <span style="color: #0b3c5d; font-size: 11.5px;">@Model.EstudianteNombre.ToUpper()</span>
            </td>
        </tr>
        <tr>
            <td class="info-label">C&oacute;digo:</td>
            <td class="info-value">@Model.Codigo</td>
            <td class="info-label">Matr&iacute;cula No.:</td>
            <td class="info-value">@Model.MatriculaNo</td>
        </tr>
        <tr>
            <td class="info-label">Lugar de Nacimiento:</td>
            <td class="info-value">@Model.LugarNacimiento</td>
            <td class="info-label">Fecha de Nacimiento:</td>
            <td class="info-value">@Model.FechaNacimiento</td>
        </tr>
        <tr>
            <td class="info-label">Identificaci&oacute;n:</td>
            <td class="info-value" colspan="3">@Model.Identificacion</td>
        </tr>
        <tr>
            <td class="info-label">Acudiente:</td>
            <td class="info-value">@Model.Acudiente</td>
            <td class="info-label">Identificaci&oacute;n:</td>
            <td class="info-value">@Model.IdentificacionAcudiente</td>
        </tr>
        <tr>
            <td class="info-label">Direcci&oacute;n:</td>
            <td class="info-value">@Model.Direccion</td>
            <td class="info-label">Tel&eacute;fonos:</td>
            <td class="info-value">@Model.Telefonos</td>
        </tr>
    </table>

    <!-- 3. Registro Cronologico de Observaciones por Periodo -->
    <table class="observaciones-table">
        <thead>
            <tr>
                <th class="fecha-col">FECHA</th>
                <th>OBSERVACIONES</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Periodos != null && Model.Periodos.Any())
            {
                foreach (var periodo in Model.Periodos)
                {
                    <tr>
                        <td colspan="2" class="periodo-header-row">@periodo.NombrePeriodo.ToUpper()</td>
                    </tr>
                    @if (periodo.Observaciones != null && periodo.Observaciones.Any())
                    {
                        foreach (var obs in periodo.Observaciones)
                        {
                            <tr>
                                <td class="fecha-col">@obs.Fecha</td>
                                <td>
                                    <div class="obs-contenido">
                                        @if (!string.IsNullOrEmpty(obs.TipoNota))
                                        {
                                            <span style="font-weight: bold; color: #0b3c5d;">[@obs.TipoNota]: </span>
                                        }
                                        <span>@obs.Descripcion</span>

                                        @if (!string.IsNullOrEmpty(obs.AspectosMejorar))
                                        {
                                            <div class="aspectos-box">
                                                <strong>Aspectos a mejorar:</strong> @obs.AspectosMejorar
                                            </div>
                                        }

                                        <div class="firma-sigla">
                                            <span>@(string.IsNullOrWhiteSpace(obs.FirmaDocente) ? "Docente" : obs.FirmaDocente)</span>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="2" class="sin-observaciones">No se registran novedades o anotaciones en este periodo.</td>
                        </tr>
                    }
                }
            }
            else
            {
                <tr>
                    <td colspan="2" class="periodo-header-row">PRIMER PERIODO</td>
                </tr>
                <tr>
                    <td colspan="2" class="sin-observaciones">El estudiante no registra llamados de atenci&oacute;n ni anotaciones en el observador.</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="footer-note">
        Documento Oficial generado por el Portal de Autogesti&oacute;n Educativa PAE &copy; @DateTime.Now.Year.
    </div>

</body>
</html>